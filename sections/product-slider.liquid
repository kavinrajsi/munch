<div class="product-slider section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="product-slider__header">
      <h2 class="product-slider__title">{{ section.settings.title }}</h2>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="product-slider__view-all">{{ 'sections.product_slider.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <div class="product-slider__track splide" data-product-slider>
      <div class="splide__track">
        <div class="splide__list">
          {%- liquid
            if section.settings.source == 'collection' and section.settings.collection != blank
              assign products_list = section.settings.collection.products
            endif
          -%}

          {%- if section.settings.source == 'collection' and section.settings.collection != blank -%}
            {%- for product in products_list limit: section.settings.products_to_show -%}
              <div class="splide__slide">
                {% render 'product-card', product: product, collection: section.settings.collection %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.product != blank -%}
                <div class="splide__slide">
                  {% render 'product-card', product: block.settings.product %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Slider",
  "tag": "section",
  "class": "product-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Bestsellers"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Product Source",
      "options": [
        { "value": "collection", "label": "From Collection" },
        { "value": "manual", "label": "Manual Selection" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides per View (Desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides per View (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Slider",
      "settings": {
        "title": "Our Bestsellers"
      }
    }
  ]
}
{% endschema %}
