{% comment %}
  Shopify Section: Product Slider
  -------------------------------

  📌 Purpose:
  - Displays a responsive product carousel from a selected collection.
  - Highlights the latest products with customizable slider behavior.

  🧱 Structure:
  - Optional heading text
  - Slick carousel with up to 8 products
  - Previous/Next navigation buttons

  🛠 Admin Settings:
  - Heading text field
  - Collection picker
  - Color picker for background
  - Slides to show/scroll
  - Responsive breakpoints and settings

  🎨 Styling:
  - Background color applied dynamically using inline CSS

  🔁 Preset:
  - Name: "Latest Products Slider"
{% endcomment %}

{% schema %}
{
  "name": "Product Slider",
  "tag": "section",
  "class": "product-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a combo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "number",
      "id": "slides_to_show",
      "label": "Slides to Show (Desktop)",
      "default": 4
    },
    {
      "type": "number",
      "id": "slides_to_scroll",
      "label": "Slides to Scroll",
      "default": 1
    },
    {
      "type": "number",
      "id": "breakpoint_1",
      "label": "First Breakpoint (px)",
      "default": 1024
    },
    {
      "type": "number",
      "id": "slides_to_show_bp1",
      "label": "Slides to Show at First Breakpoint",
      "default": 3
    },
    {
      "type": "number",
      "id": "breakpoint_2",
      "label": "Second Breakpoint (px)",
      "default": 768
    },
    {
      "type": "number",
      "id": "slides_to_show_bp2",
      "label": "Slides to Show at Second Breakpoint",
      "default": 2
    },
    {
      "type": "number",
      "id": "breakpoint_3",
      "label": "Third Breakpoint (px)",
      "default": 480
    },
    {
      "type": "number",
      "id": "slides_to_show_bp3",
      "label": "Slides to Show at Third Breakpoint",
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Latest Products Slider"
    }
  ]
}
{% endschema %}

<div
  class="layout__grid-box product-slider-section"
  id="slider-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }};"
>
  {% if section.settings.heading %}
    <div class="product-slider-heading-wrapper">
      <h2 class="heading--2 product-slider-heading">{{ section.settings.heading }}</h2>
      <div class="sliderButton">
        <button type="button" class="slick-prev">
          <!-- SVG left arrow -->
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="20" fill="#F5F3F4"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M30 20a1 1 0 0 0-1-1H13.32l4.27-4.27a1 1 0 1 0-1.42-1.42l-6.42 6.42a1 1 0 0 0 0 1.42l6.42 6.42a1 1 0 0 0 1.42-1.42L13.32 21H29a1 1 0 0 0 1-1Z" fill="#C61D23"/>
          </svg>
        </button>
        <button type="button" class="slick-next">
          <!-- SVG right arrow -->
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="20" transform="matrix(-1 0 0 1 40 0)" fill="#F5F3F4"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10 20a1 1 0 0 1 1-1h15.68l-4.27-4.27a1 1 0 1 1 1.42-1.42l6.42 6.42a1 1 0 0 1 0 1.42l-6.42 6.42a1 1 0 1 1-1.42-1.42L26.68 21H11a1 1 0 0 1-1-1Z" fill="#C61D23"/>
          </svg>
        </button>
      </div>
    </div>
  {% endif %}

  {% assign products = section.settings.collection.products | sort: 'created_at' | reverse | slice: 0, 8 %}

  <div class="product-slider-wrapper">
    <div
      class="slider-track slick-slider"
     data-slick='{ "slidesToShow": {{ section.settings.slides_to_show }}, "slidesToScroll": {{ section.settings.slides_to_scroll }}, "infinite": false, "dots": false, "arrows": true, "prevArrow": "#slider-{{ section.id }} .slick-prev", "nextArrow": "#slider-{{ section.id }} .slick-next", "responsive": [ { "breakpoint": {{ section.settings.breakpoint_1 }}, "settings": { "slidesToShow": {{ section.settings.slides_to_show_bp1 }}, "slidesToScroll": {{ section.settings.slides_to_scroll }} } }, { "breakpoint": {{ section.settings.breakpoint_2 }}, "settings": { "slidesToShow": {{ section.settings.slides_to_show_bp2 }}, "slidesToScroll": {{ section.settings.slides_to_scroll }} } }, { "breakpoint": {{ section.settings.breakpoint_3 }}, "settings": { "slidesToShow": {{ section.settings.slides_to_show_bp3 }}, "slidesToScroll": {{ section.settings.slides_to_scroll }} } } ] }'
    >
      {% for product in products %}
        {% assign current_variant = product.selected_or_first_available_variant %}
        {% assign featured_media = current_variant.featured_media | default: product.featured_image %}

        <div class="product__slider--card" data-product-id="{{ product.id }}">
          <!-- Product image or media preview -->
          <a href="{{ product.url }}">
            {% if featured_media.media_type == 'image' or featured_media.media_type == blank %}
              <picture>
                <source srcset="{{ featured_media | image_url: width: 265, format: 'pjpg' }}" type="image/pjpg">
                <source srcset="{{ featured_media | image_url: width: 265, format: 'webp' }}" type="image/webp">
                <img
                  src="{{ featured_media | image_url: width: 265 }}"
                  width="265"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  alt="{{ product.title }}"
                >
              </picture>
            {% endif %}
          </a>

          <!-- Product information block -->
          <div class="product__info">
            <h4 class="heading--4 product__title">{{ product.title }}</h4>

            <!-- Compare at price (if discounted) -->
            <div class="prpdice">
              {% if product.compare_at_price > product.price %}
                <span class="product__compare-price">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
            </div>

            <!-- Current price -->
            <div class="product__price">
              {% if product.price < product.compare_at_price %}
                <span class="product__sale-price">
                  {{ product.price | money }}
                </span>
              {% else %}
                <span class="product__regular-price">
                  {{ product.price | money }}
                </span>
              {% endif %}
            </div>

            <!-- Select Option button for multi-variant products -->

            <button
              class="product__select-option-button select-option-button"
              data-product-handle="{{ product.handle }}"
              type="button"
            >
              Select Option
            </button>
          </div>

          <!-- Product JSON for JS -->
          <script type="application/json" id="ProductJson-{{ product.id }}">
            {{ product | json }}
          </script>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
