{% schema %}
{
  "name": "Product Slider",
  "tag": "section",
  "class": "product-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a combo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Latest Products Slider"
    }
  ]
}
{% endschema %}

<style>

</style>

<div class="product-slider-section">
  {% if section.settings.heading %}
    <h2 class="product-slider-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% assign products = section.settings.collection.products | sort: 'created_at' | reverse | slice: 0, 8 %}

  <div class="product-slider-wrapper">
    <div id="slider-track" class="slider-track">
      {% for product in products %}
        <div class="slider-card">
          <a href="{{ product.url }}">
            <img
              src="{{ product.featured_image | image_url: width: 400 }}"
              alt="{{ product.title }}"
              width="400"
              height="400"
              loading="lazy"
              decoding="async"
            >
          </a>
          <div class="slider-info">
            <strong>{{ product.title }}</strong>
            {% if product.price %}
              <div>{{ product.price | money }}</div>
            {% endif %}
            {% if product.variants.size > 1 %}
              <a href="{{ product.url }}" class="select-option-link">Select Option</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="slider-arrow left" onclick="moveSlider(-1)" aria-label="Previous">&#8592;</button>
    <button class="slider-arrow right" onclick="moveSlider(1)" aria-label="Next">&#8594;</button>
  </div>
</div>

<script>
  let position = 0;
  const visibleCards = 4;
  const cardWidth = 260;

  function moveSlider(direction) {
    const track = document.getElementById('slider-track');
    const maxScroll = (track.children.length - visibleCards) * cardWidth;
    position += direction * cardWidth;
    if (position < 0) position = 0;
    if (position > maxScroll) position = maxScroll;
    track.style.transform = `translateX(-${position}px)`;
  }
</script>
