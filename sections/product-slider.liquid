{% schema %}
{
  "name": "Product Slider",
  "tag": "section",
  "class": "product-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a combo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Latest Products Slider"
    }
  ]
}
{% endschema %}

<div class="product-slider-section">
  {% if section.settings.heading %}
    <h2 class="product-slider-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% assign products = section.settings.collection.products | sort: 'created_at' | reverse | slice: 0, 8 %}

  <div class="product-slider-wrapper">
    <div
      class="slider-track slick-slider"
      data-slick='{"slidesToShow": 4, "slidesToScroll": 1, "infinite": false, "dots": false, "arrows": true, "responsive": [{"breakpoint": 1024, "settings": {"slidesToShow": 3, "slidesToScroll": 1}}, {"breakpoint": 768, "settings": {"slidesToShow": 2, "slidesToScroll": 1}}, {"breakpoint": 480, "settings": {"slidesToShow": 1, "slidesToScroll": 1}}]}'
    >
      {% for product in products %}
        <div class="product__slider--card">
          <a href="{{ product.url }}">
            <img
              src="{{ product.featured_image | image_url: width: 265, height: 320 }}"
              alt="{{ product.title }}"
              width="265"
              height="320"
              loading="lazy"
              decoding="async"
            >
          </a>
          <div class="product__info">
            <strong class="product__title">{{ product.title }}</strong>
            {% comment %}
               {% if product.variants.size > 1 %}
                <div>{{ product.price_min | money }}<sup>+</sup></div>
              {% else %}
                <div>{{ product.price | money }}</div>
              {% endif %}
            {% endcomment %}
            {% if product.variants.size > 1 %}
              <button
                class="product__select-option-button select-option-button"
                data-product-handle="{{ product.handle }}"
                type="button"
              >
                Select Option
              </button>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
