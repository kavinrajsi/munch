<div class="feat-coll-editorial" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="feat-coll-editorial__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="feat-coll-editorial__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="feat-coll-editorial__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.collection != blank -%}
    {%- assign all_products = section.settings.collection.products -%}
    {%- assign featured = all_products.first -%}
    {%- assign secondary_limit = section.settings.products_to_show | minus: 1 -%}

    <div class="feat-coll-editorial__grid">
      <div class="feat-coll-editorial__featured" data-aos="fade-right">
        {%- if featured != blank -%}
          <a href="{{ featured.url }}" class="feat-coll-editorial__link">
            <div class="feat-coll-editorial__image-wrapper">
              {%- if featured.featured_image != blank -%}
                {{ featured.featured_image
                  | image_url: width: 1100
                  | image_tag:
                      widths: '165, 360, 535, 750, 940, 1100',
                      sizes: '313px',
                      loading: 'lazy',
                      fetchpriority: 'low',
                      class: 'm:w-full m:h-full',
                      alt: featured.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'feat-coll-editorial__placeholder' }}
              {%- endif -%}
            </div>
            <div class="feat-coll-editorial__content">
              {%- if section.settings.show_vendor -%}
                <p class="feat-coll-editorial__vendor">{{ featured.vendor }}</p>
              {%- endif -%}
              <h3 class="feat-coll-editorial__title">{{ featured.title }}</h3>
              {%- if section.settings.show_price -%}
                <p class="feat-coll-editorial__price">{{ featured.price | money }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}
      </div>

      <div class="feat-coll-editorial__secondary">
        {%- for product in all_products limit: secondary_limit offset: 1 -%}
          <a href="{{ product.url }}" class="feat-coll-editorial__secondary-item" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 100 }}">
            <div class="feat-coll-editorial__secondary-image">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image
                  | image_url: width: 1100
                  | image_tag:
                      widths: '165, 360, 535, 750, 940, 1100',
                      sizes: '313px',
                      loading: 'lazy',
                      fetchpriority: 'low',
                      class: 'm:w-full m:h-full',
                      alt: product.title
                }}
              {%- else -%}
                {{ 'product-2' | placeholder_svg_tag: 'feat-coll-editorial__placeholder' }}
              {%- endif -%}
            </div>
            <div class="feat-coll-editorial__secondary-content">
              <h4 class="feat-coll-editorial__secondary-title">{{ product.title }}</h4>
              {%- if section.settings.show_price -%}
                <p class="feat-coll-editorial__secondary-price">{{ product.price | money }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="feat-coll-editorial__grid">
      <div class="feat-coll-editorial__featured feat-coll-editorial__featured--placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'feat-coll-editorial__placeholder' }}
        <h3 class="feat-coll-editorial__title">Featured product title</h3>
      </div>
      <div class="feat-coll-editorial__secondary">
        {%- for i in (1..3) -%}
          <div class="feat-coll-editorial__secondary-item">
            {{ 'product-2' | placeholder_svg_tag: 'feat-coll-editorial__placeholder' }}
            <h4 class="feat-coll-editorial__secondary-title">Product title</h4>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="feat-coll-editorial__footer">
      <a href="{{ section.settings.collection.url }}" class="btn btn--secondary">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured: Editorial",
  "tag": "section",
  "class": "featured-coll-editorial-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 2,
      "default": 4
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection: Editorial",
      "category": "Products"
    }
  ]
}
{% endschema %}
