{% render 'breadcrumbs' %}
{% render 'json-ld-store', store_blocks: section.blocks %}

<div class="store-locator section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <h1 class="text-center" style="margin-bottom:32px;">{{ section.settings.title }}</h1>

    <div class="store-locator__grid">
      {%- if section.settings.map_embed != blank -%}
        <div class="store-locator__map">
          {{ section.settings.map_embed }}
        </div>
      {%- endif -%}

      <div class="store-locator__locations">
        {%- for block in section.blocks -%}
          <div class="store-locator__card" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.name }}</h4>
            {%- if block.settings.address != blank -%}
              <p>{{ block.settings.address }}</p>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <p>Phone: <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a></p>
            {%- endif -%}
            {%- if block.settings.hours != blank -%}
              <p>{{ block.settings.hours }}</p>
            {%- endif -%}
            {%- if block.settings.directions_url != blank -%}
              <a href="{{ block.settings.directions_url }}" target="_blank" rel="noopener" class="store-locator__directions">
                {{ 'sections.store_locator.directions' | t }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
  "class": "main-store-locator-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Stores"
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Map Embed Code",
      "info": "Paste Google Maps embed iframe"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Store Name",
          "default": "Main Store"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Working Hours",
          "default": "Mon-Sat: 9am - 8pm"
        },
        {
          "type": "url",
          "id": "directions_url",
          "label": "Directions Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Locator",
      "blocks": [
        { "type": "location", "settings": { "name": "Main Store" } }
      ]
    }
  ],
  "max_blocks": 50
}
{% endschema %}
