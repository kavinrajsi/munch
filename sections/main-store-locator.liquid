{% render 'breadcrumbs' %}
{% render 'json-ld-store', store_blocks: section.blocks %}

<div class="store-locator" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if section.settings.title != blank -%}
      <h1 class="store-locator__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.map_embed != blank -%}
      <div class="store-locator__map">
        {{ section.settings.map_embed }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="store-locator__grid">
        {%- for block in section.blocks -%}
          <div data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 | at_most: 500 }}">
            {%- render 'store-card', block: block -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
  "class": "main-store-locator-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Stores"
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Map Embed Code",
      "info": "Paste Google Maps embed iframe"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Store Name",
          "default": "Main Store"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Working Hours",
          "default": "Mon-Sat: 9am - 8pm"
        },
        {
          "type": "url",
          "id": "directions_url",
          "label": "Directions Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Locator",
      "blocks": [
        { "type": "location", "settings": { "name": "Main Store" } }
      ]
    }
  ],
  "max_blocks": 50
}
{% endschema %}
