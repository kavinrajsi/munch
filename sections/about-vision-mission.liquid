          {%- endif -%}
        </div>
        <div class="about-page__vm-content">
          <h3 class="about-page__vm-title">{{ section.settings.mission_title | default: 'Mission' }}</h3>
          {%- if section.settings.mission_text != blank -%}
            <p class="about-page__vm-text">{{ section.settings.mission_text }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Vision & Mission",
  "tag": "section",
  "class": "about-page-section",
  "settings": [
    {
      "type": "text",
      "id": "vision_title",
      "label": "Vision title",
      "default": "Vision"
    },
    {
      "type": "textarea",
      "id": "vision_text",
      "label": "Vision text",
      "default": "We dream of a world where every celebration begins on a sweet note. Our goal is to be South India's favourite destination for sweets and savouries, making every small victory and large celebration more delightful and memorable."
    },
    {
      "type": "textarea",
      "id": "vision_icon",
      "label": "Vision icon SVG"
    },
    {
      "type": "text",
      "id": "mission_title",
      "label": "Mission title",
      "default": "Mission"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission text",
      "default": "At Nithya Amirtham, our mission is straightforward but passionate—deliver exceptional food that enhances moods and enriches celebrations. We aim to be everywhere there is a need for quality sweets and reliable catering, from intimate family gatherings to large-scale corporate events."
    },
    {
      "type": "textarea",
      "id": "mission_icon",
      "label": "Mission icon SVG"
    }
  ],
  "presets": [
    {
      "name": "About Vision & Mission",
      "category": "Pages"
    }
  ]
}
{% endschema %}
