<div
  class="related-products{% if section.settings.container_type == 'box' %} page-width{% endif %}"
  data-related-products-section="{{ section.id }}"
  data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=8"
  style="
    --rp-pt: {{ section.settings.padding_top_mobile }}px;
    --rp-pb: {{ section.settings.padding_bottom_mobile }}px;
    --rp-pt-desktop: {{ section.settings.padding_top }}px;
    --rp-pb-desktop: {{ section.settings.padding_bottom }}px;
    --rp-bg: {{ section.settings.background_color }};
    --rp-gap: {{ section.settings.grid_gap }}px;
  "
>
  {%- if section.settings.section_title != blank -%}
    <div
      class="related-products__header page-width"
      style="
        --rp-title-color: {{ section.settings.title_color }};
        --rp-title-align: {{ section.settings.title_text_align }};
        --rp-title-font-size: {{ section.settings.title_font_size }}px;
        --rp-title-pb: {{ section.settings.title_padding_bottom }}px;
      "
    >
      <h2>{{ section.settings.section_title }}</h2>
    </div>
  {%- endif -%}

  <div class="related-products__grid page-width">
    {%- if recommendations and recommendations.products_count > 0 -%}
      {%- for p in recommendations.products limit: 8 -%}
        <div class="related-products__item">
          {% render 'product-card', product: p %}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var container = document.querySelector('[data-related-products-section="{{ section.id }}"]');
    if (!container) return;
    var url = container.getAttribute('data-recommendations-url');
    if (!url) return;

    fetch(url)
      .then(function (response) { return response.text(); })
      .then(function (text) {
        var temp = document.createElement('div');
        temp.innerHTML = text;
        var replacement = temp.querySelector('[data-related-products-section="{{ section.id }}"]');
        if (!replacement) return;
        if (!replacement.querySelector('.related-products__item')) return;
        container.outerHTML = replacement.outerHTML;
      })
      .catch(function () {});
  })();
</script>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "Related Products"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "options": [
        { "value": "box", "label": "Box" },
        { "value": "fluid", "label": "Fluid" }
      ],
      "default": "fluid"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#C61D23"
    },
    {
      "type": "select",
      "id": "title_text_align",
      "label": "Title text align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size (desktop)",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_padding_bottom",
      "label": "Title padding bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
