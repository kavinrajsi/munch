<div
  class="feat-collection-carousel"
  style="
    --fcc-bg: {{ section.settings.bg_color }};
    --fcc-pt-desktop: {{ section.settings.padding_top_desktop }}px;
    --fcc-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --fcc-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --fcc-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --fcc-title-gap-desktop: {{ section.settings.title_gap_desktop }}px;
    --fcc-title-gap-mobile: {{ section.settings.title_gap_mobile }}px;
  "
  data-related-products-section
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
  {{ section.shopify_attributes }}
>
  <div class="{{ section.settings.container_type }}">
    {%- if section.settings.heading != blank -%}
      <div>
        {%- render 'section-heading',
          title: section.settings.heading,
          heading_tag: 'h2',
          show_left_line: true,
          show_left_icon: true,
          show_right_icon: true,
          show_right_line: true
        -%}
      </div>
    {%- endif -%}

    <div data-related-products-container>
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="feat-collection-carousel__track splide" data-related-products-carousel>
          <div class="splide__track">
            <div class="splide__list">
              {%- for product in recommendations.products -%}
                <div class="splide__slide">
                  {%- render 'fcc-product-card',
                    product: product,
                    show_vendor: section.settings.show_vendor,
                    show_price: section.settings.show_price
                  -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "class": "related-products-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" }
      ],
      "default": "container"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the Meal"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Title Spacing"
    },
    {
      "type": "range",
      "id": "title_gap_desktop",
      "label": "Space after title — desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_gap_mobile",
      "label": "Space after title — mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    }
  ]
}
{% endschema %}
