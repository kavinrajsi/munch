{% comment %}
  Shopify About Highlight Section
  -------------------------------

  📌 Purpose:
  - Displays a promotional highlight section with a heading, description, and image.

  🧱 Structure:
  - Heading (rich text, supports HTML)
  - Description (rich text, supports HTML and paragraphs)
  - Image (supports WebP and PJPG with fallback using <picture> element)

  🛠 Admin Settings:
  - Rich text field for heading
  - Rich text field for description
  - Image picker for highlight image

  🖼 Image Handling:
  - Uses <picture> for modern format support (WebP, PJPG, fallback)
  - Includes dynamic alt text and aspect-ratio from image metadata

  ✅ Accessibility:
  - Descriptive alt attribute for image (auto-populated from admin)
  - Lazy loading and aspect-ratio for performance and layout stability

  🔁 Preset:
  - Name: "About Highlight Block"
{% endcomment %}

<div class="about-highlight__wrapper layout__grid-box">
  <div class="about-highlight__text">
    <div class="about-highlight__heading">
      {{ section.settings.heading }}
    </div>
    <div class="about-highlight__description">
      {{ section.settings.description }}
    </div>
  </div>
  <div class="about-highlight__image">
    {% if section.settings.image %}
      <picture>
        <source
          srcset="{{ section.settings.image | image_url: width: 800, format: 'webp' }}"
          type="image/webp"
        >
        <source
          srcset="{{ section.settings.image | image_url: width: 800, format: 'pjpg' }}"
          type="image/jpeg"
        >
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          style="aspect-ratio: {{ section.settings.image.width }} / {{ section.settings.image.height }};"
          loading="lazy"
          decoding="async"
        >
      </picture>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "About Highlight",
  "tag": "section",
  "class": "about-highlight",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>Nithya Amirtham – Chennai’s Finest Sweets, Now Delivered All Across India!</h2>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Your description goes here.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "About Highlight Block"
    }
  ]
}
{% endschema %}
