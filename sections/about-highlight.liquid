{% schema %}
{
  "name": "About Highlight",
  "tag": "section",
  "class": "about-highlight",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>Nithya Amirtham – Chennai’s Finest Sweets, Now Delivered All Across India!</h2>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Your description goes here.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "About Highlight Block"
    }
  ]
}
{% endschema %}

<div class="about-highlight-wrapper">
  <div class="about-highlight-content">
    <div class="about-highlight-text">
      <div class="richtext-heading">
        {{ section.settings.heading }}
      </div>
      <div class="richtext-description">
        {{ section.settings.description }}
      </div>
    </div>
    <div class="about-highlight-image">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="About Image"
          width="800"
          height="{{ section.settings.image.height }}"
          loading="lazy"
          decoding="async"
        >
      {% endif %}
    </div>
  </div>
</div>
