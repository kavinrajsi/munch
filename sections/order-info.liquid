{% schema %}
{
  "name": "Order Info Section",
  "tag": "section",
  "class": "order-info",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Order Information"
    }
  ],
  "blocks": [
    {
      "type": "info_block",
      "name": "Info Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping Information"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "We process and ship orders within 2–3 business days."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Order Info",
      "blocks": [
        {
          "type": "info_block"
        },
        {
          "type": "info_block"
        }
      ]
    }
  ]
}
{% endschema %}

<section style="max-width: 1000px; margin: 0 auto; padding: 2rem;">
  <h1>{{ section.settings.heading }}</h1>

  {% for block in section.blocks %}
    {% if block.type == "info_block" %}
      <div style="margin-bottom: 2rem;">
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.content }}</p>
      </div>
    {% endif %}
  {% endfor %}
</section>
