<div class="password-page" style="--password-bg: {{ section.settings.background_color }};--password-text: {{ section.settings.text_color }};{% if section.settings.background_image %}background-image:url('{{ section.settings.background_image | image_url: width: 1920 }}');{% endif %}">
  <div class="password-page__inner">

    {%- comment -%} Logo {%- endcomment -%}
    <div class="password-page__logo">
      {%- if section.settings.logo -%}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name | escape }}"
          width="300"
          height="{{ 300 | divided_by: section.settings.logo.aspect_ratio | round }}"
          loading="eager"
        >
      {%- elsif settings.logo -%}
        <img
          src="{{ settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name | escape }}"
          width="300"
          height="{{ 300 | divided_by: settings.logo.aspect_ratio | round }}"
          loading="eager"
        >
      {%- else -%}
        <h1 class="password-page__shop-name">{{ shop.name }}</h1>
      {%- endif -%}
    </div>

    {%- comment -%} Heading {%- endcomment -%}
    <h2 class="password-page__heading">{{ section.settings.heading }}</h2>

    {%- if section.settings.subheading != blank -%}
      <p class="password-page__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- comment -%} Newsletter signup {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class="password-page__newsletter">
        {% form 'customer', class: 'password-page__form' %}
          <input type="hidden" name="contact[tags]" value="password-page">
          {%- if form.posted_successfully? -%}
            <p class="password-page__success">{{ section.settings.success_message }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="password-page__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <div class="password-page__form-row">
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.placeholder_text }}"
              required
              autocomplete="email"
              class="password-page__input"
              {%- if form.errors %} aria-invalid="true"{% endif -%}
            >
            <button type="submit" class="password-page__submit">{{ section.settings.button_text }}</button>
          </div>
        {% endform %}
      </div>
    {%- endif -%}

    {%- comment -%} Social links {%- endcomment -%}
    {%- if section.settings.show_social -%}
      <div class="password-page__social">
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Enter using password {%- endcomment -%}
    <div class="password-page__login">
      <button type="button" class="password-page__login-toggle" data-password-toggle>
        {{ section.settings.login_text }}
      </button>

      <div class="password-page__login-form" data-password-form>
        {% form 'storefront_password' %}
          {%- if form.errors -%}
            <p class="password-page__error">{{ form.errors.messages.password }}</p>
          {%- endif -%}
          <div class="password-page__form-row">
            <input
              type="password"
              name="password"
              placeholder="Password"
              required
              class="password-page__input"
              {%- if form.errors %} aria-invalid="true"{% endif -%}
            >
            <button type="submit" class="password-page__submit">Enter</button>
          </div>
        {% endform %}
      </div>
    </div>

    {%- comment -%} Powered by Shopify {%- endcomment -%}
    {%- if section.settings.show_powered_by -%}
      <p class="password-page__powered-by">{{ powered_by_link }}</p>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var toggle = document.querySelector('[data-password-toggle]');
    var form = document.querySelector('[data-password-form]');
    if (!toggle || !form) return;

    // Auto-open if there are password errors
    if (form.querySelector('[aria-invalid="true"]')) {
      form.classList.add('is-open');
    }

    toggle.addEventListener('click', function () {
      form.classList.toggle('is-open');
      if (form.classList.contains('is-open')) {
        form.querySelector('input[type="password"]').focus();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Password Page",
  "tag": "section",
  "class": "main-password-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to theme logo if not set"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFF7F3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0B090A"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening Soon"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We are working hard to bring you something amazing. Stay tuned!"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Notify Me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We'll notify you when we launch."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true,
      "info": "Uses social links from theme settings"
    },
    {
      "type": "header",
      "content": "Password Login"
    },
    {
      "type": "text",
      "id": "login_text",
      "label": "Login link text",
      "default": "Enter using password"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered by Shopify",
      "default": false
    }
  ]
}
{% endschema %}
