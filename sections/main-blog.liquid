<div class="blog-page" {{ section.shopify_attributes }}>
  <div class="container">

    {%- comment -%} Decorated heading {%- endcomment -%}
    {% render 'section-heading',
      title: blog.title,
      heading_tag: 'h1',
      show_left_line: true,
      show_left_icon: true,
      show_right_icon: true,
      show_right_line: true,
      margin_bottom_desktop: 24,
      margin_bottom_mobile: 16
    %}

    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <div class="blog-page__tags">
        <a href="{{ blog.url }}" class="{% unless current_tags %}is-active{% endunless %}">All</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="{% if current_tags contains tag %}is-active{% endif %}">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      <div class="blog-page__grid">
        {%- for article in blog.articles -%}
          <div data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 | at_most: 200 }}">
            {% render 'blog-card', article: article %}
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="blog-page__pagination" aria-label="Blog pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="blog-page__pagination-arrow" aria-label="Previous page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="{% if part.title == paginate.current_page %}is-active{% endif %}">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="blog-page__pagination-arrow" aria-label="Next page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>

{% schema %}
{
  "name": "Blog Page",
  "tag": "section",
  "class": "main-blog-section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per Page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show Tags",
      "default": false
    }
  ]
}
{% endschema %}
