<div class="blog section-padding">
  <div class="page-width">
    <h1>{{ blog.title }}</h1>

    {%- paginate blog.articles by 12 -%}
      <div class="blog__grid">
        {%- for article in blog.articles -%}
          <div class="blog__item">
            {%- if article.image -%}
              <a href="{{ article.url }}">
                <img
                  src="{{ article.image | image_url: width: 400 }}"
                  alt="{{ article.image.alt | escape }}"
                  width="400"
                  height="auto"
                  loading="lazy"
                >
              </a>
            {%- endif -%}
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p>{{ article.published_at | date: '%B %d, %Y' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {{ paginate | default_pagination: next: '&raquo;', previous: '&laquo;' }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": []
}
{% endschema %}
