{%- style -%}
  .blog-page {
    --blog-bg-color: {{ section.settings.background_color }};
    --blog-padding-top: {{ section.settings.padding_top }}px;
    --blog-padding-bottom: {{ section.settings.padding_bottom }}px;
    --blog-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --blog-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --blog-page-title-color: {{ section.settings.page_title_color }};
    --blog-page-title-font-size: {{ section.settings.page_title_font_size }}px;
    --blog-page-title-line-height: {{ section.settings.page_title_line_height }}px;
    --blog-page-title-font-size-mobile: {{ section.settings.page_title_font_size_mobile }}px;
    --blog-page-title-line-height-mobile: {{ section.settings.page_title_line_height_mobile }}px;

    --blog-grid-cols: {{ section.settings.grid_columns }};
    --blog-grid-cols-mobile: {{ section.settings.grid_columns_mobile }};
    --blog-grid-gap: {{ section.settings.grid_gap }}px;
    --blog-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px;

    --blog-card-img-radius: {{ section.settings.image_border_radius }}px;
    --blog-card-img-radius-mobile: {{ section.settings.image_border_radius_mobile }}px;

    --blog-title-color: {{ section.settings.article_title_color }};
    --blog-title-font-size: {{ section.settings.article_title_font_size }}px;
    --blog-title-line-height: {{ section.settings.article_title_line_height }}px;
    --blog-title-font-size-mobile: {{ section.settings.article_title_font_size_mobile }}px;
    --blog-title-line-height-mobile: {{ section.settings.article_title_line_height_mobile }}px;

    --blog-desc-color: {{ section.settings.description_color }};
    --blog-desc-font-size: {{ section.settings.description_font_size }}px;
    --blog-desc-line-height: {{ section.settings.description_line_height }}px;
    --blog-desc-font-size-mobile: {{ section.settings.description_font_size_mobile }}px;
    --blog-desc-line-height-mobile: {{ section.settings.description_line_height_mobile }}px;

    --blog-meta-font-size: {{ section.settings.meta_font_size }}px;
    --blog-meta-line-height: {{ section.settings.meta_line_height }}px;
    --blog-meta-font-size-mobile: {{ section.settings.meta_font_size_mobile }}px;
    --blog-meta-line-height-mobile: {{ section.settings.meta_line_height_mobile }}px;
    --blog-date-color: {{ section.settings.date_color }};
    --blog-author-color: {{ section.settings.author_color }};
    --blog-tag-color: {{ section.settings.tag_color }};
    --blog-comments-color: {{ section.settings.comments_color }};

    --blog-readmore-color: {{ section.settings.read_more_color }};
    --blog-readmore-font-size: {{ section.settings.read_more_font_size }}px;
    --blog-readmore-line-height: {{ section.settings.read_more_line_height }}px;
    --blog-readmore-font-size-mobile: {{ section.settings.read_more_font_size_mobile }}px;
    --blog-readmore-line-height-mobile: {{ section.settings.read_more_line_height_mobile }}px;
  }
{%- endstyle -%}

<div class="blog-page">
  <div class="{% if section.settings.container_type == 'boxed' %}page-width{% endif %}">
    {%- if section.settings.show_page_title -%}
      <h1 class="blog-page__title">
        {%- if section.settings.page_title != blank -%}
          {{ section.settings.page_title }}
        {%- else -%}
          {{ blog.title }}
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      <div class="blog-page__grid">
        {%- for article in blog.articles -%}
          {%- render 'blog-card',
            article: article,
            show_image: section.settings.show_image,
            show_title: section.settings.show_title,
            show_description: section.settings.show_description,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_tag: section.settings.show_tag,
            show_comments: section.settings.show_comments,
            show_read_more: section.settings.show_read_more,
            title_line_clamp: section.settings.title_line_clamp,
            description_line_clamp: section.settings.description_line_clamp,
            read_more_icon: section.settings.read_more_icon
          -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="blog-page__pagination">
          {{ paginate | default_pagination: next: '&raquo;', previous: '&laquo;' }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

