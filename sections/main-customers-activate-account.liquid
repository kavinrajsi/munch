<div class="customer-activate section-padding">
  <div class="page-width">
    <h1>{{ 'customer.activate_account.title' | t }}</h1>
    <p>{{ 'customer.activate_account.subtext' | t }}</p>

    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}

      <div class="field">
        <label class="field__label" for="Password">{{ 'customer.activate_account.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="Password">
      </div>

      <div class="field">
        <label class="field__label" for="PasswordConfirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input class="field__input" type="password" name="customer[password_confirmation]" id="PasswordConfirmation">
      </div>

      <button type="submit" class="btn btn--primary">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn--secondary">{{ 'customer.activate_account.cancel' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Activate",
  "tag": "section",
  "settings": []
}
{% endschema %}
