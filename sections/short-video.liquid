{% schema %}
{
  "name": "Short Video Grid",
  "tag": "section",
  "class": "short-video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tasty in Action"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        {
          "type": "video_url",
          "id": "product_description_video",
          "label": "YouTube or Vimeo video",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "image_picker",
          "id": "video_url",
          "label": "Shopify video file",
          "info": "Select an uploaded MP4 video from your Shopify Files"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image (for video or fallback)"
        },
        {
          "type": "checkbox",
          "id": "loop",
          "label": "Loop video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "preload",
          "label": "Preload video",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Short Video Grid",
      "blocks": []
    }
  ]
}
{% endschema %}

<div class="short-video-wrapper" style="max-width: 1440px; margin: auto; padding: 2rem;">
  <h2 style="color: #7c0f13;">{{ section.settings.heading }}</h2>
  <div class="short-video-grid" style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
    {% for block in section.blocks %}
      <div class="video-card" style="flex: 1 1 250px; max-width: 300px; border-radius: 12px; overflow: hidden;">

        {% comment %} Shopify file-hosted MP4 (takes priority) {% endcomment %}
        {% if block.settings.video_url %}
          <video
            src="{{ block.settings.video_url }}"
            {% if block.settings.poster %}
              poster="{{ block.settings.poster | image_url: width: 600 }}"
              width="{{ block.settings.poster.width }}"
              height="{{ block.settings.poster.height }}"
            {% endif %}
            {% if block.settings.loop %} loop {% endif %}
            {% if block.settings.preload %} preload="auto" {% else %} preload="metadata" {% endif %}
            muted
            autoplay
            playsinline
            fetchpriority="high"
            style="width: 100%; height: auto; display: block; border-radius: 12px;"
          ></video>

        {% elsif block.settings.product_description_video %}
          {% assign embed_url = block.settings.product_description_video | strip %}
          {% if embed_url contains "watch?v=" %}
            {% assign embed_url = embed_url | replace: "watch?v=", "embed/" %}
          {% elsif embed_url contains "youtu.be/" %}
            {% assign video_id = embed_url | split: "/" | last %}
            {% assign embed_url = "https://www.youtube.com/embed/" | append: video_id %}
          {% else %}
            {% assign embed_url = embed_url %}
          {% endif %}

          <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px;">
            <iframe
              src="{{ embed_url }}"
              frameborder="0"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="Embedded video"
              style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
            ></iframe>
          </div>

        {% elsif block.settings.poster %}
          <img
            src="{{ block.settings.poster | image_url: width: 600 }}"
            alt="{{ section.settings.heading | default: 'Video preview' }}"
            width="{{ block.settings.poster.width }}"
            height="{{ block.settings.poster.height }}"
            style="width: 100%; display: block; border-radius: 12px;">
        {% endif %}

      </div>
    {% endfor %}
  </div>
</div>
