{% schema %}
{
  "name": "Short Video Grid",
  "tag": "section",
  "class": "short-video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tasty in Action"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Shopify video file",
          "info": "Select an uploaded MP4 video from your Shopify Files"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image (for video or fallback)"
        },
        {
          "type": "checkbox",
          "id": "loop",
          "label": "Loop video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "preload",
          "label": "Preload video",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Short Video Grid",
      "blocks": []
    }
  ]
}
{% endschema %}

<div class="short-video-wrapper">
  <h2 class="short-video-heading">{{ section.settings.heading }}</h2>
  <div class="short-video-grid">
    {% for block in section.blocks %}
      <div class="video-card">

        {% if block.settings.video_url %}
          <video
            src="{{ block.settings.video_url }}"
            {% if block.settings.poster %}
              poster="{{ block.settings.poster | image_url: width: 265 }}"

            {% endif %}
            {% if block.settings.loop %} loop {% endif %}
            {% if block.settings.preload %} preload="auto" {% else %} preload="metadata" {% endif %}
            muted
            autoplay
            playsinline
            fetchpriority="high"
            class="video-element"
          ></video>

        {% elsif block.settings.poster %}
          <img
            src="{{ block.settings.poster | image_url: width: 600 }}"
            alt="{{ section.settings.heading | default: 'Video preview' }}"
            width="{{ block.settings.poster.width }}"
            height="{{ block.settings.poster.height }}"
            class="video-poster"
          >
        {% endif %}

      </div>
    {% endfor %}
  </div>
</div>
