<div class="testimonials section-padding" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="testimonials__header">
      {%- if section.settings.title != blank -%}
        <h2>{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p style="color:var(--color-secondary);margin-top:8px;">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.layout == 'slider' -%}
      <div class="testimonials__slider" data-testimonial-slider>
        {%- for block in section.blocks -%}
          {% render 'testimonial-card', block: block %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="testimonials__grid">
        {%- for block in section.blocks -%}
          {% render 'testimonial-card', block: block %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "grid"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial Text",
          "default": "The sweets are absolutely delicious! Tastes just like homemade."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Happy Customer"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Chennai, India"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Storytelling",
      "blocks": [
        { "type": "testimonial", "settings": { "text": "The sweets are absolutely divine! Reminds me of my grandmother's kitchen.", "author": "Priya R.", "location": "Chennai", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Best online sweet shop. Fresh, authentic, and delivered on time.", "author": "Karthik M.", "location": "Bangalore", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Ordered for Diwali and everyone loved the gift boxes!", "author": "Anitha S.", "location": "Mumbai", "rating": 5 } }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
