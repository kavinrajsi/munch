<div
  class="testimonials{% if section.settings.container_type == 'box' %} page-width{% endif %}"
  style="
    --testimonials-pt: {{ section.settings.padding_top_mobile }}px;
    --testimonials-pb: {{ section.settings.padding_bottom_mobile }}px;
    --testimonials-pt-desktop: {{ section.settings.padding_top }}px;
    --testimonials-pb-desktop: {{ section.settings.padding_bottom }}px;
    --testimonials-bg: {{ section.settings.background_color }};
    --testimonials-gap: {{ section.settings.slide_gap }}px;
    --testimonials-card-bg: {{ section.settings.card_bg_color }};
    --testimonials-card-radius: {{ section.settings.card_border_radius_mobile }}px;
    --testimonials-card-radius-desktop: {{ section.settings.card_border_radius }}px;
    --testimonials-card-padding: {{ section.settings.card_padding_mobile }}px;
    --testimonials-card-padding-desktop: {{ section.settings.card_padding }}px;
    --testimonials-star-color: {{ section.settings.star_color }};
    --testimonials-star-size: {{ section.settings.star_size }}px;
    --testimonials-content-color: {{ section.settings.content_color }};
    --testimonials-content-font-size: {{ section.settings.content_font_size }}px;
    --testimonials-content-line-height: {{ section.settings.content_line_height }}px;
    --testimonials-content-font-size-mobile: {{ section.settings.content_font_size_mobile }}px;
    --testimonials-content-line-height-mobile: {{ section.settings.content_line_height_mobile }}px;
    --testimonials-name-color: {{ section.settings.name_color }};
    --testimonials-name-font-size: {{ section.settings.name_font_size }}px;
    --testimonials-handle-color: {{ section.settings.handle_color }};
    --testimonials-handle-font-size: {{ section.settings.handle_font_size }}px;
    --testimonials-avatar-size: {{ section.settings.avatar_size }}px;
  "
>
{%- if section.settings.section_title != blank -%}
  <div
    class="testimonials__header page-width"
    style="
      --testimonials-title-color: {{ section.settings.title_color }};
      --testimonials-title-align: {{ section.settings.title_text_align }};
      --testimonials-title-align-mobile: {{ section.settings.title_text_align_mobile }};
      --testimonials-title-font-size: {{ section.settings.title_font_size }}px;
      --testimonials-title-line-height: {{ section.settings.title_line_height }}px;
      --testimonials-title-font-size-mobile: {{ section.settings.title_font_size_mobile }}px;
      --testimonials-title-line-height-mobile: {{ section.settings.title_line_height_mobile }}px;
      --testimonials-title-pb: {{ section.settings.title_padding_bottom_mobile }}px;
      --testimonials-title-pb-desktop: {{ section.settings.title_padding_bottom }}px;
    "
  >
    <h2>{{ section.settings.section_title }}</h2>
  </div>
{%- endif -%}

<div class="testimonials__wrapper">
  {%- if section.blocks.size > 1 and section.settings.enable_arrows -%}
    <button type="button" class="testimonials__nav testimonials__nav--prev" data-slider-prev aria-label="Previous">
      {{ section.settings.prev_arrow_svg }}
    </button>
    <button type="button" class="testimonials__nav testimonials__nav--next" data-slider-next aria-label="Next">
      {{ section.settings.next_arrow_svg }}
    </button>
  {%- endif -%}

  <div
    class="testimonials__slider"
    {%- if section.blocks.size > 1 -%}
      data-slick='{
        "slidesToShow": {{ section.settings.slides_desktop }},
        "slidesToScroll": 1,
        "arrows": false,
        "dots": {{ section.settings.enable_dots }},
        "infinite": {{ section.settings.enable_loop }},
        "autoplay": {{ section.settings.enable_autoplay }},
        "autoplaySpeed": {{ section.settings.autoplay_speed | times: 1000 }},
        "responsive": [
          {
            "breakpoint": 768,
            "settings": {
              "slidesToShow": {{ section.settings.slides_mobile | plus: 0 }}
            }
          }
        ]
      }'
    {%- endif -%}
  >
    {%- for block in section.blocks -%}
      <div class="testimonials__slide">
        {% render 'testimonial-card', block: block %}
      </div>
    {%- endfor -%}
  </div>
</div>

{%- if section.blocks.size > 1 -%}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof jQuery !== 'undefined' && typeof jQuery.fn.slick !== 'undefined') {
        jQuery('.testimonials__slider').not('.slick-initialized').each(function() {
          var $slider = jQuery(this);
          var $wrapper = $slider.closest('.testimonials__wrapper');
          $slider.slick();

          $wrapper.find('[data-slider-prev]').on('click', function() {
            $slider.slick('slickPrev');
          });
          $wrapper.find('[data-slider-next]').on('click', function() {
            $slider.slick('slickNext');
          });
        });
      }
    });
  </script>
{%- endif -%}
</div>

