<div class="testimonials" style="--tm-pt-desktop: {{ section.settings.padding_top_desktop }}px; --tm-pb-desktop: {{ section.settings.padding_bottom_desktop }}px; --tm-pt-mobile: {{ section.settings.padding_top_mobile }}px; --tm-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;" {{ section.shopify_attributes }}>
  <div class="{{ section.settings.container_type }}">
    {%- if section.settings.title != blank -%}
      <div class="">
        {%- render 'section-heading',
          title: section.settings.title,
          heading_tag: 'h2',
          show_left_line: true,
          show_left_icon: true,
          show_right_icon: true,
          show_right_line: true
        -%}
      </div>
    {%- endif -%}

    <div
      class="testimonials__track splide"
      data-testimonial-slider
      data-show-dots="{{ section.settings.show_dots }}"
    >
      <div class="splide__track">
        <div class="splide__list">
          {%- for block in section.blocks -%}
            <div class="splide__slide" data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 }}">
              {% render 'testimonial-card', block: block %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" }
      ],
      "default": "container"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "range",
      "id": "slides_to_show",
      "label": "Slides visible at once",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial Text",
          "default": "The sweets are absolutely delicious! Tastes just like homemade."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Happy Customer"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Chennai, India"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Storytelling",
      "blocks": [
        { "type": "testimonial", "settings": { "text": "The sweets are absolutely divine! Reminds me of my grandmother's kitchen. Every bite takes me back to childhood memories.", "author": "Priya R.", "location": "Chennai", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Best online sweet shop. Fresh, authentic, and delivered on time. The packaging was beautiful too!", "author": "Karthik M.", "location": "Bangalore", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Ordered for Diwali and everyone loved the gift boxes! Will definitely order again for every festival.", "author": "Anitha S.", "location": "Mumbai", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Living outside Chennai, I was thrilled to find Nithya Amirtham delivering nationwide! The Butter Murku is a must-try!", "author": "Kumar", "location": "Hyderabad", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "The Mysore Pak melts in your mouth. Authentic taste that you won't find anywhere else online. Highly recommend!", "author": "Lakshmi V.", "location": "Coimbatore", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Sent a sweet box to my parents in India and they were so happy. The quality was perfect even after shipping.", "author": "Ravi K.", "location": "Singapore", "rating": 4 } },
        { "type": "testimonial", "settings": { "text": "Their Kaju Katli is the best I've ever tasted. Pure ghee sweets with no artificial flavours. Outstanding quality!", "author": "Meena D.", "location": "Delhi", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Ordered the snack combo pack and it was gone in two days! The Ribbon Pakoda and Thattai are incredibly addictive.", "author": "Suresh P.", "location": "Pune", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "We order from Nithya Amirtham for every family function. Consistent quality and the sweets always arrive fresh.", "author": "Divya R.", "location": "Trichy", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "The Badusha was so soft and perfectly sweet. My kids loved it! Great to find traditional sweets available online.", "author": "Arun M.", "location": "Madurai", "rating": 4 } },
        { "type": "testimonial", "settings": { "text": "Impressed by the freshness and taste. The Laddu and Jangiri were just like what you get at the shop. Five stars!", "author": "Sangeetha L.", "location": "Erode", "rating": 5 } },
        { "type": "testimonial", "settings": { "text": "Wonderful experience from ordering to delivery. Customer service was very responsive and the sweets were top-notch.", "author": "Ganesh B.", "location": "Vizag", "rating": 5 } }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
