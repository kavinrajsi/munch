<div class="customer-account section-padding" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="customer-account__header">
      <h1>{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="btn btn--ghost btn--small">{{ 'customer.account.logout' | t }}</a>
    </div>

    <div class="customer-account__orders">
      <h3>{{ 'customer.account.orders' | t }}</h3>

      {%- if customer.orders.size > 0 -%}
        <table class="customer-account__order-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Date</th>
              <th>Payment</th>
              <th>Fulfillment</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%B %d, %Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p>{{ 'customer.account.no_orders' | t }}</p>
      {%- endif -%}
    </div>

    <div class="customer-account__details">
      <h3>{{ 'customer.account.details' | t }}</h3>
      <p>{{ customer.name }}</p>
      <p>{{ customer.email }}</p>
      {%- if customer.default_address -%}
        <p>{{ customer.default_address | format_address }}</p>
      {%- endif -%}
      <a href="{{ routes.account_addresses_url }}" style="color:var(--color-primary);font-size:14px;margin-top:8px;display:inline-block;">
        {{ 'customer.account.addresses' | t }} →
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Account",
  "tag": "section",
  "class": "main-customers-account-section",
  "settings": []
}
{% endschema %}
