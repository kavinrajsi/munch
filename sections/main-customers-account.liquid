<div class="customer-profile" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="customer-profile__card-header" style="margin-bottom: 24px;">
      <h1 class="customer-profile__title" style="margin: 0;">Profile</h1>
      <a href="{{ routes.account_logout_url }}" class="customer-profile__logout">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </div>

    {%- comment -%} Profile Info Card {%- endcomment -%}
    <div class="customer-profile__card">
      <div class="customer-profile__card-header">
        <div class="customer-profile__card-header-left">
          <h2 class="customer-profile__card-title">{{ customer.name }}</h2>
          <span class="customer-profile__edit-btn" aria-label="Edit profile">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
            </svg>
          </span>
        </div>
      </div>
      <div class="customer-profile__info-grid">
        <div>
          <p class="customer-profile__info-label">Email</p>
          <p class="customer-profile__info-value">{{ customer.email }}</p>
        </div>
        {%- if customer.phone != blank -%}
          <div>
            <p class="customer-profile__info-label">Phone number</p>
            <p class="customer-profile__info-value">{{ customer.phone }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Addresses Card {%- endcomment -%}
    {%- if customer.addresses.size > 0 -%}
      <div class="customer-profile__card">
        <div class="customer-profile__card-header">
          <div class="customer-profile__card-header-left">
            <h2 class="customer-profile__card-title">Addresses</h2>
            <a href="{{ routes.account_addresses_url }}" class="customer-profile__add-btn">+ Add</a>
          </div>
        </div>
        <div class="customer-profile__addresses-grid">
          {%- for address in customer.addresses -%}
            <div class="customer-profile__address-item">
              {%- if address == customer.default_address -%}
                <p class="customer-profile__address-label">Default address</p>
              {%- endif -%}
              <div class="customer-profile__address-top">
                <div>
                  <p class="customer-profile__address-text">
                    {%- if address.name != blank -%}{{ address.name }}<br>{%- endif -%}
                    {%- if address.address1 != blank -%}{{ address.address1 }}<br>{%- endif -%}
                    {%- if address.address2 != blank -%}{{ address.address2 }}<br>{%- endif -%}
                    {%- if address.city != blank or address.province != blank -%}
                      {{ address.city }}{% if address.city != blank and address.province != blank %}, {% endif %}{{ address.province }}<br>
                    {%- endif -%}
                    {%- if address.zip != blank -%}{{ address.zip }} {%- endif -%}
                    {%- if address.country != blank -%}{{ address.country }}<br>{%- endif -%}
                    {%- if address.phone != blank -%}{{ address.phone }}{%- endif -%}
                  </p>
                </div>
                <a href="{{ routes.account_addresses_url }}" class="customer-profile__edit-btn" aria-label="Edit address">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                  </svg>
                </a>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="customer-profile__card">
        <div class="customer-profile__card-header">
          <div class="customer-profile__card-header-left">
            <h2 class="customer-profile__card-title">Addresses</h2>
            <a href="{{ routes.account_addresses_url }}" class="customer-profile__add-btn">+ Add</a>
          </div>
        </div>
        <p class="customer-profile__info-value">No addresses saved yet.</p>
      </div>
    {%- endif -%}

    {%- comment -%} Wishlist Card {%- endcomment -%}
    <div class="customer-profile__card customer-profile__wishlist-card">
      <a href="/pages/wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        My Wishlist
      </a>
    </div>

    {%- comment -%} Orders Card {%- endcomment -%}
    <div class="customer-profile__orders-card">
      <div class="customer-profile__card-header">
        <h2 class="customer-profile__card-title">Order History</h2>
      </div>

      {%- if customer.orders.size > 0 -%}
        <table class="customer-account__order-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Date</th>
              <th>Payment</th>
              <th>Fulfillment</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td data-label="Order"><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td data-label="Date">{{ order.created_at | date: '%B %d, %Y' }}</td>
                <td data-label="Payment">{{ order.financial_status_label }}</td>
                <td data-label="Fulfillment">{{ order.fulfillment_status_label }}</td>
                <td data-label="Total">{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p class="customer-profile__info-value">You haven't placed any orders yet.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Account",
  "tag": "section",
  "class": "main-customers-account-section",
  "settings": []
}
{% endschema %}
