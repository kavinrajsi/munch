{%- liquid
  assign show_arrows = false
  assign show_dots   = false
  if section.settings.carousel_nav == 'arrow'
    assign show_arrows = true
  elsif section.settings.carousel_nav == 'dot'
    assign show_dots = true
  endif
-%}

<div
  class="collection-list{% if section.settings.carousel_on_mobile %} collection-list--mobile-carousel{% endif %}"
  style="
    --cl-columns: {{ section.settings.columns }};
    --cl-gap-h: {{ section.settings.gap_horizontal }}px;
    --cl-gap-v: {{ section.settings.gap_vertical }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  {%- if section.settings.heading != blank -%}
    <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div
    class="collection-list__grid"
    {% if section.settings.carousel_on_mobile %}data-collection-list-carousel{% endif %}
  >
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
        <div class="collection-list__item">
          <a href="{{ product.url }}" class="collection-list__link">
            <div class="collection-list__image-wrapper">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 832, height: 1032, crop: 'center' }}"
                  srcset="
                    {{ product.featured_image | image_url: width: 416, height: 516, crop: 'center' }} 416w,
                    {{ product.featured_image | image_url: width: 624, height: 774, crop: 'center' }} 624w,
                    {{ product.featured_image | image_url: width: 832, height: 1032, crop: 'center' }} 832w
                  "
                  sizes="(max-width: 749px) 80vw, calc(100vw / {{ section.settings.columns }})"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="832"
                  height="1032"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'collection-list__placeholder' }}
              {%- endif -%}
            </div>
            <p class="collection-list__title">{{ product.title }}</p>
          </a>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.product_count) -%}
        <div class="collection-list__item collection-list__item--placeholder">
          <div class="collection-list__image-wrapper">
            {{ 'product-1' | placeholder_svg_tag: 'collection-list__placeholder' }}
          </div>
          <p class="collection-list__title">Product name</p>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="collection-list__footer">
      <a href="{{ section.settings.collection.url }}" class="btn btn--secondary">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.carousel_on_mobile -%}
  <script>
    (function () {
      if (window.innerWidth > 749) return;
      var el = document.querySelector('[data-collection-list-carousel]');
      if (!el || typeof $ === 'undefined') return;
      $(el).slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: {{ show_arrows }},
        dots: {{ show_dots }},
        infinite: false
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "collection-list-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Type: List"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Carousel on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Product count",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "Horizontal gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "Vertical gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "carousel_nav",
      "label": "Carousel navigation icon",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "dot",   "label": "Dot" },
        { "value": "none",  "label": "None" }
      ],
      "default": "arrow",
      "info": "Applies when carousel on mobile is enabled"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "category": "Collection"
    }
  ]
}
{% endschema %}
