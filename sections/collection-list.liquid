{%- liquid
  assign show_arrows = false
  assign show_dots   = false
  if section.settings.carousel_nav == 'arrow'
    assign show_arrows = true
  elsif section.settings.carousel_nav == 'dot'
    assign show_dots = true
  endif
-%}

<div
  class="collection-list{% if section.settings.carousel_on_mobile %} collection-list--mobile-carousel{% endif %}"
  style="
    --cl-columns: {{ section.settings.columns }};
    --cl-gap-h: {{ section.settings.gap_horizontal }}px;
    --cl-gap-v: {{ section.settings.gap_vertical }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  {%- if section.settings.heading != blank -%}
    <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div
    class="collection-list__grid"
    {% if section.settings.carousel_on_mobile %}data-collection-list-carousel{% endif %}
  >
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
        {%- liquid
          assign fv = product.selected_or_first_available_variant
          assign has_compare = false
          assign discount_pct = 0
          if fv.compare_at_price > fv.price
            assign has_compare = true
            assign diff = fv.compare_at_price | minus: fv.price
            assign discount_pct = diff | times: 100 | divided_by: fv.compare_at_price
          endif
          assign has_range = false
          if product.price_min != product.price_max
            assign has_range = true
          endif
        -%}

        <div class="collection-card" data-product-card data-first-variant-selected="{{ section.settings.first_variant_selected }}">
          <script type="application/json" data-product-json>
            {
              "variants": [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id }},
                    "title": {{ variant.title | json }},
                    "price": {{ variant.price }},
                    "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                    "available": {{ variant.available }},
                    "options": [{% for opt in variant.options %}{{ opt | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }
          </script>

          <a href="{{ product.url }}" class="collection-card__media-link" tabindex="-1" aria-hidden="true">
            <div class="collection-card__media">
              {%- render 'card-image', product: product, columns: section.settings.columns -%}
            </div>
          </a>

          <div class="collection-card__body">

            <div class="collection-card__header">
              <h3 class="collection-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              {%- render 'card-price', product: product, fv: fv, has_range: has_range, has_compare: has_compare, discount_pct: discount_pct, price_display: section.settings.price_display -%}
            </div>

            {%- unless product.has_only_default_variant -%}
              <div class="collection-card__options">
                {%- for option in product.options_with_values -%}
                  <div
                    class="collection-card__option-group"
                    data-option-group
                    data-option-position="{{ option.position }}"
                  >
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="collection-card__option-button{% if forloop.first and section.settings.first_variant_selected %} is-selected{% endif %}"
                        data-option-btn
                        data-option-position="{{ option.position }}"
                        data-option-value="{{ value | escape }}"
                        aria-label="{{ option.name | escape }}: {{ value | escape }}"
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <div class="collection-card__actions">
              <div class="collection-card__quantity">
                <button type="button" class="collection-card__quantity-button" data-qty-minus aria-label="Decrease quantity">−</button>
                <input
                  type="number"
                  class="collection-card__quantity-input"
                  value="1"
                  min="1"
                  max="99"
                  readonly
                  data-qty-input
                  aria-label="Quantity"
                >
                <button type="button" class="collection-card__quantity-button" data-qty-plus aria-label="Increase quantity">+</button>
              </div>

              <form action="{{ routes.cart_add_url }}" method="post" class="collection-card__form" data-card-form>
                <input type="hidden" name="id" value="{{ fv.id }}" data-variant-id>
                <input type="hidden" name="quantity" value="1" data-qty-value>
                <button type="submit" class="collection-card__add-to-cart btn btn--primary">Add to cart</button>
              </form>

              <button type="button" class="collection-card__buy-now btn btn--secondary" data-buy-now-btn>
                Buy now
              </button>
            </div>

          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.product_count) -%}
        <div class="collection-card collection-card--placeholder">
          <div class="collection-card__media">
            {{ 'product-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
          </div>
          <div class="collection-card__body">
            <div class="collection-card__header">
              <h3 class="collection-card__title">Product name</h3>
              <div class="collection-card__price">
                <span class="collection-card__price-regular">Rs. 000</span>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="collection-list__footer">
      <a href="{{ section.settings.collection.url }}" class="btn btn--secondary">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.carousel_on_mobile -%}
  <script>
    (function () {
      if (window.innerWidth > 749) return;
      var el = document.querySelector('[data-collection-list-carousel]');
      if (!el || typeof $ === 'undefined') return;
      $(el).slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: {{ show_arrows }},
        dots: {{ show_dots }},
        infinite: false
      });
    })();
  </script>
{%- endif -%}

<script>
  (function () {
    document.querySelectorAll('[data-product-card]').forEach(function (card) {
      var jsonEl = card.querySelector('[data-product-json]');
      if (!jsonEl) return;

      var data       = JSON.parse(jsonEl.textContent);
      var variants   = data.variants;
      var firstVariantSelected = card.dataset.firstVariantSelected === 'true';
      var selOpts    = (firstVariantSelected && variants[0]) ? variants[0].options.slice() : [];

      var variantIdInput = card.querySelector('[data-variant-id]');
      var qtyValueInput  = card.querySelector('[data-qty-value]');
      var qtyInput       = card.querySelector('[data-qty-input]');
      var buyNowBtn      = card.querySelector('[data-buy-now-btn]');
      var priceCurrentEl = card.querySelector('[data-price-current]');
      var priceCompareEl = card.querySelector('[data-price-compare]');
      var priceBadgeEl   = card.querySelector('[data-price-badge]');

      function getVariant() {
        return variants.find(function (v) {
          return v.options.every(function (opt, i) { return opt === selOpts[i]; });
        });
      }

      function formatMoney(cents) {
        return 'Rs.\u00a0' + (cents / 100).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }

      function updatePrice(v) {
        if (!v || !priceCurrentEl) return;
        if (v.compare_at_price > v.price) {
          priceCurrentEl.textContent = formatMoney(v.price);
          if (priceCompareEl) { priceCompareEl.textContent = formatMoney(v.compare_at_price); priceCompareEl.hidden = false; }
          if (priceBadgeEl) {
            var pct = Math.round((v.compare_at_price - v.price) * 100 / v.compare_at_price);
            priceBadgeEl.textContent = '-' + pct + '%';
            priceBadgeEl.hidden = false;
          }
        } else {
          priceCurrentEl.textContent = formatMoney(v.price);
          if (priceCompareEl) priceCompareEl.hidden = true;
          if (priceBadgeEl)   priceBadgeEl.hidden   = true;
        }
      }

      function updateInputs(v) {
        if (!v) return;
        if (variantIdInput) variantIdInput.value = v.id;
      }

      card.querySelectorAll('[data-option-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var pos = parseInt(btn.dataset.optionPosition, 10) - 1;
          selOpts[pos] = btn.dataset.optionValue;
          btn.closest('[data-option-group]').querySelectorAll('[data-option-btn]').forEach(function (b) {
            b.classList.toggle('is-selected', b.dataset.optionValue === selOpts[pos]);
          });
          var v = getVariant();
          updatePrice(v);
          updateInputs(v);
        });
      });

      if (qtyInput) {
        card.querySelector('[data-qty-minus]').addEventListener('click', function () {
          var val = Math.max(1, parseInt(qtyInput.value, 10) - 1);
          qtyInput.value = val;
          if (qtyValueInput) qtyValueInput.value = val;
        });
        card.querySelector('[data-qty-plus]').addEventListener('click', function () {
          var val = Math.min(99, parseInt(qtyInput.value, 10) + 1);
          qtyInput.value = val;
          if (qtyValueInput) qtyValueInput.value = val;
        });
      }

      if (buyNowBtn) {
        buyNowBtn.addEventListener('click', function () {
          var id  = variantIdInput ? variantIdInput.value : variants[0].id;
          var qty = qtyInput ? qtyInput.value : 1;
          var fd  = new FormData();
          fd.append('id', id);
          fd.append('quantity', qty);
          fetch('/cart/add.js', { method: 'POST', body: fd })
            .then(function () { window.location.href = '/checkout'; })
            .catch(function () { window.location.href = '/checkout'; });
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "collection-list-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "first_variant_selected",
      "label": "Pre-select first variant",
      "default": true
    },
    {
      "type": "select",
      "id": "price_display",
      "label": "Price display",
      "options": [
        { "value": "auto",  "label": "Auto" },
        { "value": "min",   "label": "Min price" },
        { "value": "range", "label": "Price range" }
      ],
      "default": "auto",
      "info": "Auto follows product pricing logic. Min price shows the lowest price. Price range shows min – max."
    },
    {
      "type": "header",
      "content": "Type: List"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Carousel on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Product count",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "Horizontal gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "Vertical gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "carousel_nav",
      "label": "Carousel navigation icon",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "dot",   "label": "Dot" },
        { "value": "none",  "label": "None" }
      ],
      "default": "arrow",
      "info": "Applies when carousel on mobile is enabled"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "category": "Collection"
    }
  ]
}
{% endschema %}
