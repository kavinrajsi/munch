{% render 'breadcrumbs' %}

<div class="contact-page section-padding" {{ section.shopify_attributes }}>
  <h1 class="contact-page__title">{{ page.title }}</h1>

  {%- if page.content != blank -%}
    <div class="rte" style="margin-bottom:32px;">{{ page.content }}</div>
  {%- endif -%}

  {% form 'contact', class: 'contact-page__form' %}
    {%- if form.posted_successfully? -%}
      <p class="contact-page__success">{{ 'templates.contact.form.success' | t }}</p>
    {%- endif -%}

    {%- if form.errors -%}
      <div class="customer-form__errors">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="form-row">
      <div class="form-group">
        <label for="ContactName">{{ 'templates.contact.form.name' | t }}</label>
        <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" required>
      </div>
      <div class="form-group">
        <label for="ContactEmail">{{ 'templates.contact.form.email' | t }}</label>
        <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required>
      </div>
    </div>
    <div class="form-group">
      <label for="ContactPhone">{{ 'templates.contact.form.phone' | t }}</label>
      <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}">
    </div>
    <div class="form-group">
      <label for="ContactMessage">{{ 'templates.contact.form.message' | t }}</label>
      <textarea id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="btn btn--primary">{{ 'templates.contact.form.submit' | t }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "main-contact-section",
  "settings": []
}
{% endschema %}
