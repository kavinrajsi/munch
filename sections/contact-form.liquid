{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "contact-form",
  "settings": [],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}

<section style="page__contact layout__grid-box">
  <h1 class="heading--2">Contact Us</h1>
  <div class="page__contact-form">
    <h2>We'd love to hear from you</h2>
    <p>Please use the form to send us your message or ideas.</p>
    {% form 'contact' %}
      {{ form.errors | default_errors }}
      <div class="contact-input name">
        <label for="name">Full Name <sup>*</sup></label>
        <input type="text" name="contact[name]" id="name" placeholder="Full Name" required>
      </div>
      <div class="contact-input email">
        <label for="email">Email Address <sup>*</sup></label>
        <input type="email" name="contact[email]" id="email" placeholder="Email Address" required>
      </div>
      <div class="contact-input phone">
        <label for="phone">Phone Number <sup>*</sup></label>
        <input type="tel" name="contact[phone]" id="phone" placeholder="Phone Number" required>
      </div>
      <div class="contact-input message">
        <label for="message">Message</label>
        <textarea name="contact[body]" class="textarea" id="message" placeholder="Message"></textarea>
      </div>
      <div class="contact-input submit">
        <input class="button" type="submit" value="Submit">
      </div>
    {% endform %}

    {% if form.posted_successfully? %}
      <p style="color: green;">Thank you! Your message has been sent.</p>
    {% elsif form.errors %}
      <p style="color: red;">There was a problem submitting the form. Please check the fields and try again.</p>
    {% endif %}
  </div>
  <div class="page__contact-info">
    <h3>Address</h3>
    <address>
      Nithya Amirtham Indian Food Pvt Ltd<br>
      Old No 41 New No 2/52A, Karuneegar Street, Nerkundram,<br>
      Tamil Nadu,<br>
      Chennai-600107
    </address>
    <h3>Informations</h3>
    <nav>
      <a href="tel:+918754401444" target="_blank">+91 87544 01444</a>
      <a href="mail:feedback@nithyaamirtham.com" target="_blank">feedback@nithyaamirtham.com</a>
    </nav>
    <h3>Social Media</h3>
    <nav>
      <a href="https://www.instagram.com/nithyaamirtham" target="_blank">Instagram</a>
      <a href="https://www.facebook.com/nithyaamirtham" target="_blank">Facebook</a>
      <a href="https://www.youtube.com/channel/UC1b2f3g4h5i6j7k8l9m0n1o2" target="_blank">YouTube</a>
    </nav>
  </div>
</section>
