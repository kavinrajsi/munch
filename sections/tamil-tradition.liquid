<div class="tamil-tradition section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="tamil-tradition__inner{% if section.settings.image_position == 'right' %}" style="direction:rtl;{% endif %}">
      <div class="tamil-tradition__media" data-aos="fade-right" style="direction:ltr;">
        {%- if section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.title | default: 'Tamil Tradition' | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>

      <div class="tamil-tradition__content" data-aos="fade-left" data-aos-delay="200" style="direction:ltr;">
        {%- if section.settings.subtitle != blank -%}
          <p class="tamil-tradition__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="tamil-tradition__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="tamil-tradition__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign features = section.blocks | where: 'type', 'feature' -%}
        {%- if features.size > 0 -%}
          <div class="tamil-tradition__features">
            {%- for block in features -%}
              <div class="tamil-tradition__feature" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                {{ block.settings.text }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tamil Tradition",
  "tag": "section",
  "class": "tamil-tradition-section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "A Taste of Tamil Tradition"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our sweets are crafted using time-honoured recipes passed down through generations. Each piece carries the authentic flavours of Tamil Nadu, made with pure ghee, fresh ingredients, and love.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% Pure Ghee"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tamil Tradition",
      "blocks": [
        { "type": "feature", "settings": { "text": "100% Pure Ghee" } },
        { "type": "feature", "settings": { "text": "No Preservatives" } },
        { "type": "feature", "settings": { "text": "Traditional Recipes" } },
        { "type": "feature", "settings": { "text": "Small Batch Crafted" } }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
