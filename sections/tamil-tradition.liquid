<div
  class="tamil-tradition{% if section.settings.container_type == 'box' %} page-width{% endif %}"
  style="
    --tt-pt: {{ section.settings.padding_top_mobile }}px;
    --tt-pb: {{ section.settings.padding_bottom_mobile }}px;
    --tt-pt-desktop: {{ section.settings.padding_top }}px;
    --tt-pb-desktop: {{ section.settings.padding_bottom }}px;
    --tt-bg: {{ section.settings.background_color }};
    --tt-title-color: {{ section.settings.title_color }};
    --tt-title-align: {{ section.settings.title_text_align }};
    --tt-title-align-mobile: {{ section.settings.title_text_align_mobile }};
    --tt-title-font-size: {{ section.settings.title_font_size }}px;
    --tt-title-line-height: {{ section.settings.title_line_height }}px;
    --tt-title-font-size-mobile: {{ section.settings.title_font_size_mobile }}px;
    --tt-title-line-height-mobile: {{ section.settings.title_line_height_mobile }}px;
    --tt-title-pb: {{ section.settings.title_padding_bottom_mobile }}px;
    --tt-title-pb-desktop: {{ section.settings.title_padding_bottom }}px;
    --tt-gap: {{ section.settings.slide_gap }}px;
    --tt-card-bg: {{ section.settings.card_bg_color }};
    --tt-card-radius: {{ section.settings.card_border_radius_mobile }}px;
    --tt-card-radius-desktop: {{ section.settings.card_border_radius }}px;
    --tt-card-padding: {{ section.settings.card_padding_mobile }}px;
    --tt-card-padding-desktop: {{ section.settings.card_padding }}px;
    --tt-card-title-color: {{ section.settings.card_title_color }};
    --tt-card-title-size: {{ section.settings.card_title_font_size }}px;
    --tt-card-text-color: {{ section.settings.card_text_color }};
    --tt-card-text-size: {{ section.settings.card_text_font_size }}px;
    --tt-card-text-line-height: {{ section.settings.card_text_line_height }}px;
  "
>
{%- if section.settings.section_title != blank -%}
  <div
    class="tamil-tradition__header page-width"
  >
    <h2>{{ section.settings.section_title }}</h2>
  </div>
{%- endif -%}

<div class="tamil-tradition__wrapper">
  {%- if section.blocks.size > 1 and section.settings.enable_arrows -%}
    <button type="button" class="tamil-tradition__nav tamil-tradition__nav--prev" data-slider-prev aria-label="Previous">
      {{ section.settings.prev_arrow_svg }}
    </button>
    <button type="button" class="tamil-tradition__nav tamil-tradition__nav--next" data-slider-next aria-label="Next">
      {{ section.settings.next_arrow_svg }}
    </button>
  {%- endif -%}

  <div
    class="tamil-tradition__slider"
    {%- if section.blocks.size > 1 -%}
      data-slick='{
        "slidesToShow": {{ section.settings.slides_desktop }},
        "slidesToScroll": 1,
        "arrows": false,
        "dots": {{ section.settings.enable_dots }},
        "infinite": {{ section.settings.enable_loop }},
        "autoplay": {{ section.settings.enable_autoplay }},
        "autoplaySpeed": {{ section.settings.autoplay_speed | times: 1000 }},
        "responsive": [
          {
            "breakpoint": 768,
            "settings": {
              "slidesToShow": {{ section.settings.slides_mobile | plus: 0 }}
            }
          }
        ]
      }'
    {%- endif -%}
  >
    {%- for block in section.blocks -%}
      <div class="tamil-tradition__slide" {{ block.shopify_attributes }}>
        <div class="tamil-tradition__card">
          {%- if block.settings.image != blank -%}
            <div class="tamil-tradition__card-media">
              <picture>
                <source type="image/avif" srcset="{{ block.settings.image | image_url: width: 600, format: 'avif' }}">
                <source type="image/webp" srcset="{{ block.settings.image | image_url: width: 600, format: 'webp' }}">
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              </picture>
            </div>
          {%- endif -%}
          <div class="tamil-tradition__card-body">
            {%- if block.settings.heading != blank -%}
              <h3 class="tamil-tradition__card-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.content != blank -%}
              <p class="tamil-tradition__card-text">{{ block.settings.content }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{%- if section.blocks.size > 1 -%}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof jQuery !== 'undefined' && typeof jQuery.fn.slick !== 'undefined') {
        jQuery('.tamil-tradition__slider').not('.slick-initialized').each(function() {
          var $slider = jQuery(this);
          var $wrapper = $slider.closest('.tamil-tradition__wrapper');
          $slider.slick();

          $wrapper.find('[data-slider-prev]').on('click', function() {
            $slider.slick('slickPrev');
          });
          $wrapper.find('[data-slider-next]').on('click', function() {
            $slider.slick('slickNext');
          });
        });
      }
    });
  </script>
{%- endif -%}
</div>

{% schema %}
