  "max_blocks": 12,
  "presets": [
    {
      "name": "Tamil Tradition",
      "settings": {},
      "blocks": [
        {
          "type": "tradition",
          "settings": {
            "heading": "Pongal",
            "content": "Pongal is the most celebrated harvest festival of Tamil Nadu, dedicated to the Sun God. Families prepare the traditional Pongal dish in clay pots as it overflows — symbolising abundance and prosperity."
          }
        },
        {
          "type": "tradition",
          "settings": {
            "heading": "Bharatanatyam",
            "content": "One of the oldest classical dance forms in India, Bharatanatyam originated in the temples of Tamil Nadu. This sacred art combines expressive storytelling, rhythmic footwork, and intricate hand gestures."
          }
        },
        {
          "type": "tradition",
          "settings": {
            "heading": "Temple Architecture",
            "content": "Tamil Nadu is home to magnificent Dravidian temples with towering gopurams adorned with thousands of colourful sculptures, showcasing centuries of devotion, craftsmanship, and architectural brilliance."
          }
        },
        {
          "type": "tradition",
          "settings": {
            "heading": "Traditional Sweets",
            "content": "Tamil sweet-making is an age-old art passed through generations. From Mysore Pak to Adhirasam, every sweet carries a story of festive celebrations, family gatherings, and the rich culinary heritage of the land."
