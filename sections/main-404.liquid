<div class="section-padding" {{ section.shopify_attributes }}>
  <div class="container text-center" style="padding:60px 20px;">
    <h1>{{ 'templates.404.title' | t }}</h1>
    <p style="color:var(--color-secondary);margin:12px 0 24px;">{{ 'templates.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">{{ 'templates.404.button' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "main-404-section",
  "settings": []
}
{% endschema %}
