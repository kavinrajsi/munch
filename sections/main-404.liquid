<div class="error-404" style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;{% if section.settings.background_color != blank %} background-color: {{ section.settings.background_color }};{% endif %}" {{ section.shopify_attributes }}>
<style>
  @media (min-width: 750px) {
    .main-404-section .error-404 {
      padding-top: {{ section.settings.padding_top_desktop }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px !important;
    }
  }
</style>

  <div class="{{ section.settings.container_type }}">
    <div class="error-404__content">

      {%- if section.settings.image != blank -%}
        <div class="error-404__image">
          <img
            src="{{ section.settings.image | image_url: width: 400 }}"
            alt="Page not found"
            width="400"
            height="{{ 400 | divided_by: section.settings.image.aspect_ratio | round }}"
            loading="eager"
          >
        </div>
      {%- else -%}
        <div class="error-404__code">404</div>
      {%- endif -%}

      <h1 class="error-404__heading">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="error-404__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <div class="error-404__search">
          <form action="{{ routes.search_url }}" method="get" role="search" class="error-404__search-form">
            <input
              type="search"
              name="q"
              placeholder="{{ section.settings.search_placeholder }}"
              aria-label="Search"
              class="error-404__search-input"
              autocomplete="off"
            >
            <input type="hidden" name="type" value="product,article,page">
            <button type="submit" class="error-404__search-btn" aria-label="Search">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            </button>
          </form>
        </div>
      {%- endif -%}

      <div class="error-404__actions">
        <a href="{{ routes.root_url }}" class="btn btn--primary">{{ section.settings.button_text }}</a>
        {%- if section.settings.show_collections_link -%}
          <a href="{{ routes.collections_url }}" class="btn btn--ghost">{{ section.settings.collections_button_text }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_popular_products -%}
      {%- assign featured_collection = collections[section.settings.popular_collection] -%}
      {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
        <div class="error-404__products">
          <h2 class="error-404__products-heading">{{ section.settings.products_heading }}</h2>
          <div class="error-404__products-grid">
            {%- for product in featured_collection.products limit: section.settings.products_limit -%}
              <div data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 | at_most: 300 }}">
                {%- render 'fcc-product-card',
                  product: product,
                  show_vendor: false,
                  show_price: true
                -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "main-404-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" }
      ],
      "default": "container"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shows '404' text if no image is set"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page Not Found"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sorry, the page you're looking for doesn't exist or has been moved."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Back to Home"
    },
    {
      "type": "checkbox",
      "id": "show_collections_link",
      "label": "Show Collections Button",
      "default": true
    },
    {
      "type": "text",
      "id": "collections_button_text",
      "label": "Collections Button Text",
      "default": "Browse Collections"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search for products..."
    },
    {
      "type": "header",
      "content": "Popular Products"
    },
    {
      "type": "checkbox",
      "id": "show_popular_products",
      "label": "Show Popular Products",
      "default": true
    },
    {
      "type": "collection",
      "id": "popular_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products Heading",
      "default": "You Might Like"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
