<div
  class="feat-collection-carousel"
  style="
    --fcc-bg: {{ section.settings.bg_color }};
    --fcc-pt-desktop: {{ section.settings.padding_top_desktop }}px;
    --fcc-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --fcc-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --fcc-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --fcc-title-gap-desktop: {{ section.settings.title_gap_desktop }}px;
    --fcc-title-gap-mobile: {{ section.settings.title_gap_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="{{ section.settings.container_type }}">
  {%- if section.settings.heading != blank -%}
    <div class="">
      {%- render 'section-heading',
        title: section.settings.heading,
        heading_tag: 'h2',
        show_left_line: true,
        show_left_icon: true,
        show_right_icon: true,
        show_right_line: true
      -%}
    </div>
  {%- endif -%}

  <div class="feat-collection-carousel__track splide" data-feat-collection-carousel>
    <div class="splide__track">
      <div class="splide__list">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <div class="splide__slide" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 100 }}">
          {%- render 'fcc-product-card',
            product: product,
            show_vendor: section.settings.show_vendor,
            show_price: section.settings.show_price
          -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="feat-collection-carousel__item feat-collection-carousel__item--placeholder splide__slide">
          <div class="feat-collection-carousel__image-wrapper">
            {{ 'product-1' | placeholder_svg_tag: 'feat-collection-carousel__placeholder' }}
          </div>
          <div class="feat-collection-carousel__content">
            <h3 class="feat-collection-carousel__title">Product title</h3>
            <p class="feat-collection-carousel__price">$0.00</p>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="feat-collection-carousel__footer">
      <a href="{{ section.settings.collection.url }}" class="btn btn--secondary">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  {%- endif -%}
  </div>
</div>


{% schema %}
{
  "name": "Feat Collection: Carousel",
  "tag": "section",
  "class": "feat-collection-carousel-section",
  "settings": [
    {
      "type": "select",
      "id": "container_type",
      "label": "Container Type",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container Fluid" }
      ],
      "default": "container"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "slides_to_show",
      "label": "Slides visible at once",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Title Spacing"
    },
    {
      "type": "range",
      "id": "title_gap_desktop",
      "label": "Space after title — desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_gap_mobile",
      "label": "Space after title — mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Feat Collection: Carousel",
      "category": "Products"
    }
  ]
}
{% endschema %}
