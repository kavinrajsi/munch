<div
  class="feat-collection-carousel"
  style="
    --fcc-bg: {{ section.settings.bg_color }};
    --fcc-pt-desktop: {{ section.settings.padding_top_desktop }}px;
    --fcc-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --fcc-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --fcc-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --fcc-title-gap-desktop: {{ section.settings.title_gap_desktop }}px;
    --fcc-title-gap-mobile: {{ section.settings.title_gap_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="{{ section.settings.container_type }}">
  {%- if section.settings.heading != blank -%}
    <div class="feat-collection-carousel__header">
      <h2 class="feat-collection-carousel__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="feat-collection-carousel__track" data-feat-collection-carousel>
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <div class="feat-collection-carousel__item">
          <a href="{{ product.url }}" class="feat-collection-carousel__link">
            <div class="feat-collection-carousel__image-wrapper">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image
                  | image_url: width: 1100
                  | image_tag:
                      widths: '165, 360, 535, 750, 940, 1100',
                      sizes: '313px',
                      loading: 'lazy',
                      fetchpriority: 'low',
                      class: 'm:w-full m:h-full',
                      alt: product.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'feat-collection-carousel__placeholder' }}
              {%- endif -%}
            </div>
            <div class="feat-collection-carousel__content">
              {%- if section.settings.show_vendor -%}
                <p class="feat-collection-carousel__vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <h3 class="feat-collection-carousel__title">{{ product.title }}</h3>
              {%- if section.settings.show_price -%}
                <p class="feat-collection-carousel__price">{{ product.price | money }}</p>
              {%- endif -%}
            </div>
          </a>
          <div class="fcc-controls" data-fcc-controls>
            <div class="fcc-variants-qty">
              {%- if product.variants.size > 1 -%}
                <div class="fcc-variants">
                  {%- for variant in product.variants -%}
                    <button
                      type="button"
                      class="fcc-variants__btn{% if forloop.first %} fcc-variants__btn--active{% endif %}"
                      data-fcc-variant-btn
                      data-variant-id="{{ variant.id }}"
                      data-variant-price="{{ variant.price | money }}"
                      data-variant-available="{{ variant.available }}"
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="fcc-qty-cart">
                <div class="fcc-qty">
                  <button type="button" class="fcc-qty__btn" data-fcc-qty-minus>-</button>
                  <input type="number" class="fcc-qty__input" value="1" min="1" data-fcc-qty-input readonly>
                  <button type="button" class="fcc-qty__btn" data-fcc-qty-plus>+</button>
                </div>
              </div>
            </div>

            {%- if product.available -%}
              <button
                class="fcc-atc"
                type="button"
                data-variant-id="{{ product.first_available_variant.id }}"
                data-fcc-add-to-cart
              >
                Add to cart
              </button>
            {%- else -%}
              <button class="fcc-atc fcc-atc--sold-out" type="button" disabled>
                Sold Out
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="feat-collection-carousel__item feat-collection-carousel__item--placeholder">
          <div class="feat-collection-carousel__image-wrapper">
            {{ 'product-1' | placeholder_svg_tag: 'feat-collection-carousel__placeholder' }}
          </div>
          <div class="feat-collection-carousel__content">
            <h3 class="feat-collection-carousel__title">Product title</h3>
            <p class="feat-collection-carousel__price">$0.00</p>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="feat-collection-carousel__footer">
      <a href="{{ section.settings.collection.url }}" class="btn btn--secondary">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  {%- endif -%}
  </div>
</div>


{% schema %}
{
  "name": "Feat Collection: Carousel",
  "tag": "section",
  "class": "feat-collection-carousel-section",
  "settings": [
    {
      "type": "select",
      "id": "container_type",
      "label": "Container Type",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container Fluid" }
      ],
      "default": "container"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "slides_to_show",
      "label": "Slides visible at once",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Title Spacing"
    },
    {
      "type": "range",
      "id": "title_gap_desktop",
      "label": "Space after title — desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_gap_mobile",
      "label": "Space after title — mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Feat Collection: Carousel",
      "category": "Products"
    }
  ]
}
{% endschema %}
