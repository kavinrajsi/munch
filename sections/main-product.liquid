<div class="product section-padding">
  <div class="page-width">
    {% render 'breadcrumbs' %}
    <div class="product__wrapper">
      <div class="product__media">
        {%- if product.images.size > 0 -%}
          <div class="product__gallery">
            {%- if product.images.size > 1 -%}
              <div class="product__thumbs">
                {%- for image in product.images -%}
                  <button
                    type="button"
                    class="product__thumb{% if forloop.first %} product__thumb--active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    aria-label="View image {{ forloop.index }}"
                  >
                    <picture>
                      <source type="image/webp" srcset="{{ image | image_url: width: 120, format: 'webp' }}">
                      <img
                        src="{{ image | image_url: width: 120 }}"
                        alt="{{ image.alt | default: product.title | escape }}"
                        width="60"
                        height="60"
                        loading="lazy"
                      >
                    </picture>
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="product__main-image" id="ProductMainImage">
              {%- for image in product.images -%}
                <a href="{{ image | image_url: width: 1600 }}"
                   data-pswp-width="{{ image.width }}"
                   data-pswp-height="{{ image.height }}"
                   class="product__gallery-link{% if forloop.first %} product__gallery-link--active{% endif %}"
                   data-image-index="{{ forloop.index0 }}">
                  <picture>
                    <source type="image/webp" srcset="{{ image | image_url: width: 900, format: 'webp' }}">
                    <img
                      src="{{ image | image_url: width: 900 }}"
                      alt="{{ image.alt | default: product.title | escape }}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    >
                  </picture>
                </a>
              {%- endfor -%}
              <span class="product__zoom-hint" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              </span>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- assign sorted_variants = product.variants | sort: 'price' -%}
        {%- assign cheapest = sorted_variants | first -%}

        <h1 class="product__title">{{ product.title }}</h1>

        {%- if product.description != blank -%}
          <div class="product__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- assign has_ingredients = product.metafields.custom.ingredients | default: blank -%}
        {%- assign has_additives = product.metafields.custom.additives_declaration | default: blank -%}
        {%- assign has_allergens = product.metafields.custom.allergens_declaration | default: blank -%}
        {%- assign has_nutritional = product.metafields.custom.nutritional_values | default: blank -%}
        {%- assign has_shelf_life = product.metafields.custom.shelf_life | default: blank -%}
        {%- assign has_taste = product.metafields.custom.taste | default: blank -%}

        {%- if has_ingredients != blank or has_additives != blank or has_allergens != blank or has_nutritional != blank or has_shelf_life != blank or has_taste != blank -%}
          <div class="product__accordions">
            {%- if has_ingredients != blank -%}
              <div class="product__accordion">
                <button type="button" class="product__accordion-header">
                  <span>Ingredients</span>
                  <svg class="product__accordion-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="product__accordion-content rte">
                  {{ product.metafields.custom.ingredients | metafield_tag }}
                </div>
              </div>
            {%- endif -%}

            {%- if has_additives != blank -%}
              <div class="product__accordion">
                <button type="button" class="product__accordion-header">
                  <span>Additives Declaration</span>
                  <svg class="product__accordion-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="product__accordion-content rte">
                  {{ product.metafields.custom.additives_declaration | metafield_tag }}
                </div>
              </div>
            {%- endif -%}

            {%- if has_allergens != blank -%}
              <div class="product__accordion">
                <button type="button" class="product__accordion-header">
                  <span>Allergens Declaration</span>
                  <svg class="product__accordion-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="product__accordion-content">
                  {{ product.metafields.custom.allergens_declaration | metafield_tag }}
                </div>
              </div>
            {%- endif -%}

            {%- if has_nutritional != blank -%}
              <div class="product__accordion">
                <button type="button" class="product__accordion-header">
                  <span>Nutritional Values</span>
                  <svg class="product__accordion-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="product__accordion-content">
                  {%- assign nv = product.metafields.custom.nutritional_values.value -%}
                  {%- if nv -%}
                    <table class="product__nutrition-table">
                      {%- if nv.title -%}
                        <tr>
                          <th colspan="4" class="nutrition-table__header">{{ nv.title }}</th>
                        </tr>
                      {%- endif -%}
                      {%- if nv.serving_size or nv.servings_per_pack -%}
                        <tr class="nutrition-table__serving">
                          <td colspan="2">{{ nv.serving_size }}</td>
                          <td colspan="2" class="text-right">{{ nv.servings_per_pack }}</td>
                        </tr>
                      {%- endif -%}
                      {%- if nv.columns -%}
                        <tr class="nutrition-table__columns">
                          {%- for col in nv.columns -%}
                            <th>{{ col }}</th>
                          {%- endfor -%}
                        </tr>
                      {%- endif -%}
                      {%- if nv.rows -%}
                        {%- for row in nv.rows -%}
                          <tr>
                            <td>{{ row.nutrient }}</td>
                            <td>{{ row.per_100g }}</td>
                            <td>{{ row.per_serving }}</td>
                            <td>{{ row.rda }}</td>
                          </tr>
                        {%- endfor -%}
                      {%- endif -%}
                      {%- if nv.notes -%}
                        {%- for note in nv.notes -%}
                          <tr>
                            <td colspan="4" class="nutrition-table__note">{{ note }}</td>
                          </tr>
                        {%- endfor -%}
                      {%- endif -%}
                    </table>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if has_taste != blank -%}
              <div class="product__accordion">
                <button type="button" class="product__accordion-header">
                  <span>Taste</span>
                  <svg class="product__accordion-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="product__accordion-content">
                  {{ product.metafields.custom.taste }}
                </div>
              </div>
            {%- endif -%}

            {%- if has_shelf_life != blank -%}
              <div class="product__accordion">
                <button type="button" class="product__accordion-header">
                  <span>Shelf Life</span>
                  <svg class="product__accordion-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="product__accordion-content">
                  {{ product.metafields.custom.shelf_life }}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="product__pricing" id="ProductPricing">
          {%- if cheapest.compare_at_price > cheapest.price -%}
            {%- assign save_pct = cheapest.compare_at_price | minus: cheapest.price | times: 100 | divided_by: cheapest.compare_at_price -%}
            <span class="product__compare-price">{{ cheapest.compare_at_price | money }}</span>
            <span class="product__sale-price">{{ cheapest.price | money }}</span>
            <span class="product__save">Save {{ save_pct }}%</span>
          {%- else -%}
            <span class="product__regular-price">{{ cheapest.price | money }}</span>
          {%- endif -%}
        </div>

        {%- form 'product', product, data-product-form: '', data-ajax-cart: '' -%}
          <input type="hidden" name="id" value="{{ cheapest.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            <div class="product__variants">
              {%- for option in product.options_with_values -%}
                {%- assign option_index = forloop.index0 -%}
                <div class="product__variant-group">
                  <span class="product__variant-label">{{ option.name }}</span>
                  <div class="product__variant-options">
                    {%- assign seen = '|||' -%}
                    {%- assign first_value = true -%}
                    {%- for variant in sorted_variants -%}
                      {%- assign opt_val = variant.options[option_index] -%}
                      {%- assign check = '|||' | append: opt_val | append: '|||' -%}
                      {%- unless seen contains check -%}
                        {%- assign seen = seen | append: opt_val | append: '|||' -%}
                        <button
                          type="button"
                          class="product__variant-btn{% if first_value %} product__variant-btn--active{% endif %}"
                          data-option-index="{{ option_index }}"
                          data-value="{{ opt_val }}"
                        >
                          {{ opt_val }}
                        </button>
                        {%- assign first_value = false -%}
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="product__qty">
            <button type="button" class="product__qty-btn" data-product-qty-minus>-</button>
            <input type="number" name="quantity" value="1" min="1" class="product__qty-input" data-product-qty-input readonly>
            <button type="button" class="product__qty-btn" data-product-qty-plus>+</button>
          </div>

          <div class="product__actions">
            <button type="submit" class="product__atc btn btn--primary" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}
                Add to cart
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>
            {%- if product.available -%}
              <button type="button" class="product__buy-now btn btn--secondary" data-product-buy-now>
                Buy it now
              </button>
            {%- endif -%}
          </div>
        {%- endform -%}

        <script type="application/json" data-product-page-variants>
          {{ product.variants | json }}
        </script>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'photoswipe-lightbox.umd.min.js' | asset_url }}"></script>
<script src="{{ 'photoswipe.umd.min.js' | asset_url }}"></script>
<script src="{{ 'product-page.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": []
}
{% endschema %}
