
<div class="main-product" style="--product-pt-desktop: {{ section.settings.padding_top_desktop }}px; --product-pb-desktop: {{ section.settings.padding_bottom_desktop }}px; --product-pt-mobile: {{ section.settings.padding_top_mobile }}px; --product-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;" {{ section.shopify_attributes }}>
  <div class="{{ section.settings.container_type }}">

    {%- comment -%} Breadcrumbs {%- endcomment -%}
    <nav class="main-product__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <svg viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <polyline points="1 1 5 5 1 9"/>
      </svg>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- elsif product.collections.size > 0 -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      {%- endif -%}
      <svg viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <polyline points="1 1 5 5 1 9"/>
      </svg>
      <span class="current">{{ product.title }}</span>
    </nav>

    {%- comment -%} Product Grid: Media + Info {%- endcomment -%}
    <div class="main-product__grid">

      {%- comment -%} Media Column {%- endcomment -%}
      <div class="main-product__media">
        <div id="ProductGallery" data-product-gallery>
          <div class="main-product__gallery-main" data-gallery-main>
            {%- if product.featured_media -%}
              <a href="{{ product.featured_media.preview_image | image_url: width: 1600 }}" data-pswp-image data-pswp-width="{{ product.featured_media.preview_image.width }}" data-pswp-height="{{ product.featured_media.preview_image.height }}">
                <img
                  src="{{ product.featured_media.preview_image | image_url: width: 800 }}"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  width="{{ product.featured_media.preview_image.width }}"
                  height="{{ product.featured_media.preview_image.height }}"
                  id="ProductMainImage"
                >
              </a>
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>

          {%- liquid
            assign has_extra_thumbs = false
            if product.media.size > 1
              assign has_extra_thumbs = true
            endif
          -%}
          {%- if has_extra_thumbs -%}
            <div class="main-product__gallery-thumbs" data-gallery-thumbs>
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' -%}
                  <button
                    type="button"
                    data-thumb-index="{{ forloop.index0 }}"
                    data-media-type="image"
                    data-full-src="{{ media | image_url: width: 800 }}"
                    data-zoom-src="{{ media | image_url: width: 1600 }}"
                    data-zoom-width="{{ media.width }}"
                    data-zoom-height="{{ media.height }}"
                    class="{% if forloop.first %}is-active{% endif %}"
                    aria-label="View image {{ forloop.index }}"
                  >
                    <img
                      src="{{ media | image_url: width: 128 }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      loading="lazy"
                    >
                  </button>
                {%- elsif media.media_type == 'video' -%}
                  <button
                    type="button"
                    class="main-product__gallery-thumb--video"
                    data-thumb-index="{{ forloop.index0 }}"
                    data-media-type="video"
                    data-video-sources='{{ media.sources | json }}'
                    aria-label="Play video {{ forloop.index }}"
                  >
                    <img
                      src="{{ media.preview_image | image_url: width: 128 }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      loading="lazy"
                    >
                    <span class="main-product__play-icon">▶</span>
                  </button>
                {%- elsif media.media_type == 'external_video' -%}
                  <button
                    type="button"
                    class="main-product__gallery-thumb--video"
                    data-thumb-index="{{ forloop.index0 }}"
                    data-media-type="external_video"
                    data-video-host="{{ media.host }}"
                    data-video-id="{{ media.external_id }}"
                    aria-label="Play video {{ forloop.index }}"
                  >
                    <img
                      src="{{ media.preview_image | image_url: width: 128 }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      loading="lazy"
                    >
                    <span class="main-product__play-icon">▶</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}

            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Video Modal {%- endcomment -%}
        <div class="product-video-modal" data-video-modal>
          <div class="product-video-modal__overlay" data-video-modal-close></div>
          <div class="product-video-modal__content" data-video-modal-content></div>
          <button class="product-video-modal__close" data-video-modal-close aria-label="Close video">&#10005;</button>
        </div>
      </div>

      {%- comment -%} Info Column {%- endcomment -%}
      <div class="main-product__info">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="main-product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="main-product__title">{{ product.title }}</h1>

        {%- if section.settings.show_description and product.description != blank -%}
          <div class="main-product__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        <div class="main-product__price" data-product-price>
          {%- if product.compare_at_price > product.price -%}
            <span class="sale-price">{{ product.price | money }}</span>
            <span class="compare-price">{{ product.compare_at_price | money }}</span>
          {%- else -%}
            <span class="regular-price">{{ product.price | money }}</span>
          {%- endif -%}

          {%- if product.selected_or_first_available_variant.unit_price -%}
            <span class="unit-price">
              {{ product.selected_or_first_available_variant.unit_price | money }} / {{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
            </span>
          {%- endif -%}
        </div>

        {%- comment -%} Meta Badges (Shelf Life, Sweetness, etc.) {%- endcomment -%}
        {%- assign badge_1_text = product.metafields.custom.badge_1_text | default: section.settings.meta_badge_1_text -%}
        {%- assign badge_2_text = product.metafields.custom.badge_2_text | default: section.settings.meta_badge_2_text -%}
        {%- if badge_1_text != blank or badge_2_text != blank -%}
          <div class="main-product__meta">
            {%- if badge_1_text != blank -%}
              <div class="main-product__meta-item">
                {%- if section.settings.meta_badge_1_icon != blank -%}
                  {{ section.settings.meta_badge_1_icon }}
                {%- endif -%}
                <span>{{ badge_1_text }}</span>
              </div>
            {%- endif -%}
            {%- if badge_2_text != blank -%}
              <div class="main-product__meta-item">
                {%- if section.settings.meta_badge_2_icon != blank -%}
                  {{ section.settings.meta_badge_2_icon }}
                {%- endif -%}
                <span>{{ badge_2_text }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Variant Buttons {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          <div class="main-product__variants" data-product-variants>
            {%- for option in product.options_with_values -%}
              <div class="main-product__variant-group">
                <label>{{ option.name }} : {{ option.selected_value }}</label>
                <div class="main-product__variant-buttons" data-option-group data-option-position="{{ option.position }}">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="main-product__variant-btn{% if value == option.selected_value %} is-selected{% endif %}"
                      data-option-btn
                      data-option-position="{{ option.position }}"
                      data-option-value="{{ value | escape }}"
                      aria-label="{{ option.name | escape }}: {{ value | escape }}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- comment -%} Quantity + ATC Row {%- endcomment -%}
        {%- form 'product', product, id: 'ProductForm', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

          <div class="main-product__buy-row">
            {%- if section.settings.show_quantity -%}
              <div class="main-product__quantity">
                <label>Quantity</label>
                <div class="main-product__quantity-box">
                  <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
                  <input type="number" name="quantity" value="1" min="1" max="99" readonly data-qty-input aria-label="Quantity">
                  <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                </div>
              </div>
            {%- endif -%}

            <div class="main-product__add-to-cart">
              <button
                type="submit"
                {% unless product.available %}disabled{% endunless %}
                data-add-to-cart
              >
                {%- if product.available -%}
                  Add to cart
                {%- else -%}
                  Sold out
                {%- endif -%}
              </button>
            </div>
          </div>
        {%- endform -%}

        {%- comment -%} In-Store Pickup Card {%- endcomment -%}
        {%- liquid
          assign pickup_stores_meta = product.metafields.custom.pickup_stores | default: ''
          assign pickup_store_names = pickup_stores_meta | split: ',' | compact
          assign pickup_count = 0
          for block in section.blocks
            if block.type == 'pickup_store'
              assign trimmed_name = block.settings.store_name | strip
              for meta_name in pickup_store_names
                assign trimmed_meta = meta_name | strip
                if trimmed_meta == trimmed_name
                  assign pickup_count = pickup_count | plus: 1
                  break
                endif
              endfor
            endif
          endfor
        -%}
        {%- if pickup_count > 0 -%}
          <div class="pickup-card">
            <div class="pickup-card__header">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Available for pickup at
            </div>
            <div class="pickup-card__stores">
              {%- for block in section.blocks -%}
                {%- if block.type == 'pickup_store' -%}
                  {%- liquid
                    assign trimmed_name = block.settings.store_name | strip
                    assign store_matches = false
                    for meta_name in pickup_store_names
                      assign trimmed_meta = meta_name | strip
                      if trimmed_meta == trimmed_name
                        assign store_matches = true
                        break
                      endif
                    endfor
                  -%}
                  {%- if store_matches -%}
                    <div class="pickup-card__store" {{ block.shopify_attributes }}>
                      <div class="pickup-card__store-left">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                          <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>
                        </svg>
                        <div>
                          <div class="pickup-card__store-name">{{ block.settings.store_name }}</div>
                          <button type="button" class="pickup-card__store-details-btn" data-pickup-open-drawer data-store-index="{{ forloop.index0 }}">+ Store details</button>
                        </div>
                      </div>
                      {%- if block.settings.store_ready_text != blank -%}
                        <div class="pickup-card__store-ready">{{ block.settings.store_ready_text }}</div>
                      {%- else -%}
                        <div class="pickup-card__store-ready">Usually ready in 24 hours</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="pickup-card__footer">
              <button type="button" class="pickup-card__check-all" data-pickup-open-drawer>Check availability at other stores</button>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Back-in-Stock Alert {%- endcomment -%}
        {%- if settings.bis_enabled -%}
          <div
            class="bis-alert{% if product.available %} is-hidden{% endif %}"
            data-bis-alert
            data-bis-mode="{{ settings.bis_mode }}"
            data-bis-klaviyo-key="{{ settings.bis_klaviyo_key }}"
            data-bis-webhook-url="{{ settings.bis_webhook_url }}"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          >
            <p class="bis-alert__heading">{{ settings.bis_heading | default: 'Get notified when this is back in stock' }}</p>
            <div class="bis-alert__form-wrap" data-bis-form-wrap>
              <div class="bis-alert__row">
                <input
                  type="email"
                  class="bis-alert__input"
                  placeholder="{{ settings.bis_placeholder | default: 'Your email' }}"
                  required
                  autocomplete="email"
                  aria-label="Email for back-in-stock notification"
                  data-bis-email
                >
                <button type="button" class="bis-alert__submit" data-bis-submit>
                  {{ settings.bis_button_text | default: 'Notify Me' }}
                </button>
              </div>
              <p class="bis-alert__error" data-bis-error></p>
            </div>
            <div class="bis-alert__success" data-bis-success>
              <p>{{ settings.bis_success_text | default: "We'll email you when this product is back in stock." }}</p>
            </div>
          </div>
        {%- endif -%}


        {%- if settings.judgeme_enabled -%}
          <div class="main-product__reviews-badge">
            <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
              {{ product.metafields.judgeme.badge }}
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_share -%}
          <div class="main-product__share">
            <span>Share:</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ product.url | prepend: shop.url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?url={{ product.url | prepend: shop.url }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Twitter">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if settings.judgeme_enabled -%}
  <div class="container" style="margin-top: 40px; margin-bottom: 40px;">
    {% assign has_legacy = false %}
    {% if product.metafields.judgeme.widget.size > 20 %}
      {% assign has_legacy = true %}
    {% endif %}
    <div style="clear:both"></div>
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget"
      data-product-title="{{ product.title | escape }}"
      data-id="{{ product.id }}"
      data-product-id="{{ product.id }}"
      data-widget="review"
      data-auto-install="false"
      data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
      data-entry-point="review_widget.js"
      data-entry-key="review-widget/main.js"
    >
      {% if has_legacy %}
        <div class="jdgm-legacy-widget-content" style="display: none;">
          {{ product.metafields.judgeme.widget }}
        </div>
      {% endif %}
    </div>
    {% if product.metafields.judgeme.review_widget_data %}
      <script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>
    {% endif %}
  </div>
{%- endif -%}

{%- comment -%} Pickup Drawer {%- endcomment -%}
{%- if pickup_count > 0 -%}
  <div class="pickup-drawer__overlay" data-pickup-overlay></div>
  <div class="pickup-drawer" data-pickup-drawer>
    <div class="pickup-drawer__header">
      <div>
        <h3 class="pickup-drawer__title">{{ product.title }}</h3>
        {%- unless product.has_only_default_variant -%}
          <div class="pickup-drawer__variant" data-pickup-drawer-variant>
            {{ product.selected_or_first_available_variant.title }}
          </div>
        {%- endunless -%}
      </div>
      <button type="button" class="pickup-drawer__close" data-pickup-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="pickup-drawer__body">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pickup_store' -%}
          {%- liquid
            assign trimmed_name = block.settings.store_name | strip
            assign is_available = false
            for meta_name in pickup_store_names
              assign trimmed_meta = meta_name | strip
              if trimmed_meta == trimmed_name
                assign is_available = true
                break
              endif
            endfor
          -%}
          <div class="pickup-drawer__store">
            <div class="pickup-drawer__store-name">{{ block.settings.store_name }}</div>
            <div class="pickup-drawer__store-status">
              {%- if is_available -%}
                <span class="pickup-drawer__dot pickup-drawer__dot--available"></span>
                Available for pickup
              {%- else -%}
                <span class="pickup-drawer__dot pickup-drawer__dot--unavailable"></span>
                Unavailable for pickup
              {%- endif -%}
            </div>
            {%- if is_available -%}
              <div class="pickup-drawer__store-ready">
                {{ block.settings.store_ready_text | default: 'Usually ready in 24 hours' }}
              </div>
            {%- endif -%}
            {%- if block.settings.store_address != blank -%}
              <div class="pickup-drawer__store-address">{{ block.settings.store_address }}</div>
            {%- endif -%}
            {%- if block.settings.store_phone != blank -%}
              <div class="pickup-drawer__store-phone">
                <a href="tel:{{ block.settings.store_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ block.settings.store_phone }}</a>
              </div>
            {%- endif -%}
            {%- if block.settings.store_directions_url != blank -%}
              <a href="{{ block.settings.store_directions_url }}" target="_blank" rel="noopener" class="pickup-drawer__store-directions">
                Get Directions →
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<script type="application/json" data-product-json>
  {{ product | json }}
</script>

<script>
  (function () {
    var productJson = JSON.parse(document.querySelector('[data-product-json]').textContent);
    var variants = productJson.variants;
    var selectedOptions = productJson.selected_variant
      ? productJson.selected_variant.options.slice()
      : (variants[0] ? variants[0].options.slice() : []);

    var variantIdInput = document.querySelector('[data-variant-id]');
    var qtyInput       = document.querySelector('[data-qty-input]');
    var priceEl        = document.querySelector('[data-product-price]');
    var atcBtn         = document.querySelector('[data-add-to-cart]');
    var bisAlert       = document.querySelector('[data-bis-alert]');

    function getVariant() {
      return variants.find(function (v) {
        return v.options.every(function (opt, i) { return opt === selectedOptions[i]; });
      });
    }

    function formatMoney(cents) {
      return 'Rs.\u00a0' + (cents / 100).toFixed(2);
    }

    function updatePrice(v) {
      if (!v || !priceEl) return;
      if (v.compare_at_price && v.compare_at_price > v.price) {
        priceEl.innerHTML = '<span class="sale-price">' + formatMoney(v.price) + '</span><span class="compare-price">' + formatMoney(v.compare_at_price) + '</span>';
      } else {
        priceEl.innerHTML = '<span class="regular-price">' + formatMoney(v.price) + '</span>';
      }
    }

    function updateVariantId(v) {
      if (!v || !variantIdInput) return;
      variantIdInput.value = v.id;
      // Update URL
      var url = new URL(window.location.href);
      url.searchParams.set('variant', v.id);
      window.history.replaceState({}, '', url.toString());
    }

    function updateVariantLabel(pos, value) {
      var group = document.querySelector('[data-option-group][data-option-position="' + pos + '"]');
      if (!group) return;
      var label = group.closest('.main-product__variant-group').querySelector('label');
      if (label) {
        var optionName = label.textContent.split(' : ')[0];
        label.textContent = optionName + ' : ' + value;
      }
    }

    // Variant button clicks
    document.querySelectorAll('[data-option-btn]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var pos = parseInt(btn.dataset.optionPosition, 10) - 1;
        selectedOptions[pos] = btn.dataset.optionValue;

        btn.closest('[data-option-group]').querySelectorAll('[data-option-btn]').forEach(function (b) {
          b.classList.toggle('is-selected', b.dataset.optionValue === selectedOptions[pos]);
        });

        updateVariantLabel(btn.dataset.optionPosition, btn.dataset.optionValue);

        var v = getVariant();
        updatePrice(v);
        updateVariantId(v);
        updateAvailability(v);
      });
    });

    function updateAvailability(v) {
      if (!atcBtn) return;
      if (v && v.available) {
        atcBtn.disabled = false;
        atcBtn.textContent = 'Add to cart';
        if (bisAlert) bisAlert.classList.add('is-hidden');
      } else {
        atcBtn.disabled = true;
        atcBtn.textContent = 'Sold out';
        if (bisAlert) {
          bisAlert.classList.remove('is-hidden');
          bisAlert.dataset.variantId = v ? v.id : '';
        }
      }
    }

    // Quantity buttons
    if (qtyInput) {
      document.querySelector('[data-qty-minus]').addEventListener('click', function () {
        qtyInput.value = Math.max(1, parseInt(qtyInput.value, 10) - 1);
      });
      document.querySelector('[data-qty-plus]').addEventListener('click', function () {
        qtyInput.value = Math.min(99, parseInt(qtyInput.value, 10) + 1);
      });
    }

    // Pickup drawer
    var pickupDrawer = document.querySelector('[data-pickup-drawer]');
    var pickupOverlay = document.querySelector('[data-pickup-overlay]');
    if (pickupDrawer) {
      function openPickupDrawer() {
        pickupDrawer.classList.add('is-open');
        pickupOverlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
      function closePickupDrawer() {
        pickupDrawer.classList.remove('is-open');
        pickupOverlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
      document.querySelectorAll('[data-pickup-open-drawer]').forEach(function(btn) {
        btn.addEventListener('click', openPickupDrawer);
      });
      document.querySelector('[data-pickup-close]').addEventListener('click', closePickupDrawer);
      pickupOverlay.addEventListener('click', closePickupDrawer);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && pickupDrawer.classList.contains('is-open')) closePickupDrawer();
      });
    }

    // Video modal
    var videoModal = document.querySelector('[data-video-modal]');
    var videoModalContent = document.querySelector('[data-video-modal-content]');

    function openVideoModal(html) {
      if (!videoModal || !videoModalContent) return;
      videoModalContent.innerHTML = html;
      videoModal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
      if (!videoModal || !videoModalContent) return;
      videoModal.classList.remove('is-open');
      videoModalContent.innerHTML = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-video-modal-close]').forEach(function (el) {
      el.addEventListener('click', closeVideoModal);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && videoModal && videoModal.classList.contains('is-open')) {
        closeVideoModal();
      }
    });

    // Gallery thumbs
    document.querySelectorAll('[data-gallery-thumbs] button').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var mediaType = thumb.dataset.mediaType;

        // Video thumbs → open modal
        if (mediaType === 'video') {
          var sources = JSON.parse(thumb.dataset.videoSources || '[]');
          var src = sources.length ? sources[0].url : '';
          if (src) {
            openVideoModal('<video controls autoplay playsinline><source src="' + src + '"></video>');
          }
          return;
        }

        if (mediaType === 'external_video' || mediaType === 'external_setting') {
          var host = thumb.dataset.videoHost;
          var id = thumb.dataset.videoId;
          var embedUrl = '';
          if (host === 'youtube') {
            embedUrl = 'https://www.youtube.com/embed/' + id + '?autoplay=1';
          } else if (host === 'vimeo') {
            embedUrl = 'https://player.vimeo.com/video/' + id + '?autoplay=1';
          }
          if (embedUrl) {
            openVideoModal('<iframe src="' + embedUrl + '" allow="autoplay; fullscreen" allowfullscreen></iframe>');
          }
          return;
        }

        // Image thumbs → swap main image
        var mainImg = document.getElementById('ProductMainImage');
        if (mainImg) {
          mainImg.src = thumb.dataset.fullSrc;
          var link = mainImg.parentElement;
          if (link && link.tagName === 'A') {
            link.href = thumb.dataset.zoomSrc;
            link.dataset.pswpWidth = thumb.dataset.zoomWidth;
            link.dataset.pswpHeight = thumb.dataset.zoomHeight;
          }
        }
        thumb.closest('[data-gallery-thumbs]').querySelectorAll('button').forEach(function (b) {
          b.classList.toggle('is-active', b === thumb);
        });
      });
    });
    // Back-in-stock alert
    if (bisAlert) {
      var bisSubmit = bisAlert.querySelector('[data-bis-submit]');
      var bisEmail = bisAlert.querySelector('[data-bis-email]');
      var bisError = bisAlert.querySelector('[data-bis-error]');
      var bisFormWrap = bisAlert.querySelector('[data-bis-form-wrap]');
      var bisSuccess = bisAlert.querySelector('[data-bis-success]');
      var bisMode = bisAlert.dataset.bisMode;

      function bisShowError(msg) {
        if (bisError) { bisError.textContent = msg; bisError.classList.add('is-visible'); }
      }
      function bisClearError() {
        if (bisError) bisError.classList.remove('is-visible');
      }

      if (bisSubmit) {
        bisSubmit.addEventListener('click', function () {
          bisClearError();
          var email = bisEmail ? bisEmail.value.trim() : '';
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            bisShowError('Please enter a valid email address.');
            return;
          }

          var varId = bisAlert.dataset.variantId;

          if (bisMode === 'builtin') {
            var formData = new FormData();
            formData.append('form_type', 'customer');
            formData.append('customer[email]', email);
            formData.append('customer[tags]', 'back-in-stock, bis-' + bisAlert.dataset.productHandle);
            fetch('/account', { method: 'POST', body: formData })
              .then(function () { bisOnSuccess(); })
              .catch(function () { bisShowError('Something went wrong. Please try again.'); });

          } else if (bisMode === 'klaviyo') {
            var klaviyoKey = bisAlert.dataset.bisKlaviyoKey;
            if (!klaviyoKey) { bisShowError('Klaviyo is not configured.'); return; }
            fetch('https://a.klaviyo.com/api/v2/list/' + klaviyoKey + '/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ profiles: [{ email: email }] })
            }).then(function () { bisOnSuccess(); })
              .catch(function () {
                fetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' + klaviyoKey, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
                  body: JSON.stringify({
                    data: {
                      type: 'back-in-stock-subscription',
                      attributes: { channels: ['EMAIL'], profile: { data: { type: 'profile', attributes: { email: email } } } },
                      relationships: { variant: { data: { type: 'catalog-variant', id: '$shopify:::$default:::' + varId } } }
                    }
                  })
                }).then(function () { bisOnSuccess(); })
                  .catch(function () { bisShowError('Something went wrong. Please try again.'); });
              });

          } else if (bisMode === 'webhook') {
            var webhookUrl = bisAlert.dataset.bisWebhookUrl;
            if (!webhookUrl) { bisShowError('Webhook is not configured.'); return; }
            fetch(webhookUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: email,
                variant_id: varId,
                product_handle: bisAlert.dataset.productHandle,
                product_title: bisAlert.dataset.productTitle
              })
            }).then(function () { bisOnSuccess(); })
              .catch(function () { bisShowError('Something went wrong. Please try again.'); });
          }
        });
      }

      function bisOnSuccess() {
        if (bisFormWrap) bisFormWrap.classList.add('is-hidden');
        if (bisSuccess) bisSuccess.classList.add('is-visible');
      }
    }
  })();
</script>

