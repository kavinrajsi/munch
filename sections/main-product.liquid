<section class="product-section" itemscope itemtype="https://schema.org/Product" aria-labelledby="product-title">

  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'gallery' %}
        <div class="product-gallery" role="region" aria-label="Product gallery">
          {% for media in product.media %}
            {% case media.media_type %}
              {% when 'image' %}
                <img
                  src="{{ media | image_url: width: 800 }}"
                  alt="{{ media.alt | escape }}"
                  width="800"
                  height="600"
                  loading="lazy">
              {% when 'video' %}
                <video controls preload="metadata" width="800" height="600">
                  <source src="{{ media.sources[0].url }}" type="video/mp4">
                </video>
            {% endcase %}
          {% endfor %}
        </div>

      {% when 'buy_box' %}
        <div class="product-info">
          <h1 class="product-title" id="product-title">{{ product.title }}</h1>

          {% assign is_on_sale = product.compare_at_price_max > product.price %}
          {% assign percent_off = 0 %}
          {% if is_on_sale and product.variants.first.compare_at_price > 0 %}
            {% assign discount = product.variants.first.compare_at_price | minus: product.variants.first.price %}
            {% assign percent_off = discount | times: 100 | divided_by: product.variants.first.compare_at_price %}
          {% endif %}

          {% if is_on_sale %}
            <span class="sale-badge">
              {{ section.settings.sale_badge_text }}{% if section.settings.show_percent_off %} — {{ percent_off | round }}% Off{% endif %}
            </span>
          {% endif %}

          {% if section.settings.show_meta_info %}
            <div class="product-meta">
              {% if product.vendor %}<div><strong>Vendor:</strong> {{ product.vendor }}</div>{% endif %}
              {% if product.type %}<div><strong>Type:</strong> {{ product.type }}</div>{% endif %}
              {% if product.metafields.custom.category %}
                <div><strong>Category:</strong> {{ product.metafields.custom.category.value }}</div>
              {% endif %}
              <div><strong>Template:</strong> {{ template.name }}</div>
              {% if product.tags.size > 0 %}
                <div><strong>Tags:</strong> {{ product.tags | join: ', ' }}</div>
              {% endif %}
            </div>
          {% endif %}

          <div class="product-price">
            {% if is_on_sale %}
              <span class="compare-price">{{ product.compare_at_price_max | money }}</span>
              <span class="price-display">{{ product.price | money }}</span>
            {% else %}
              <span class="price-display">{{ product.price | money }}</span>
            {% endif %}
          </div>

          {% if section.settings.show_stock_status %}
            <div class="stock-status">
              <span class="stock-label {% if product.available %}in-stock{% else %}out-of-stock{% endif %}">
                {% if product.available %}In stock{% else %}Out of stock{% endif %}
              </span>
            </div>
          {% endif %}

          <form method="post" action="{{ routes.cart_add_url }}">
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">

            {% for option in product.options_with_values %}
              <fieldset>
                <legend>{{ option.name }}</legend>
                {% for value in option.values %}
                  {% assign lower = option.name | downcase %}
                  {% if lower contains 'color' %}
                    <label class="swatch-label">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %}>
                      <span class="swatch" style="background-color: {{ value | downcase }}"></span>
                    </label>
                  {% else %}
                    <label>
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %}>
                      {{ value }}
                    </label>
                  {% endif %}
                {% endfor %}
              </fieldset>
            {% endfor %}

            <div class="quantity-controls">
              <button type="button" class="qty-btn qty-minus">−</button>
              <input type="number" id="quantity" name="quantity" value="1" min="1">
              <button type="button" class="qty-btn qty-plus">+</button>
            </div>

            <button type="submit" class="add-to-cart-btn">Add to Cart</button>
          </form>
        </div>
    {% endcase %}
  {% endfor %}

  {% if section.settings.show_sticky_cart %}
    <div class="sticky-bar" id="sticky-bar">
      <span id="sticky-product-title">{{ product.title }}</span>
      <span id="sticky-product-price">{{ product.price | money }}</span>
      <form method="post" action="{{ routes.cart_add_url }}">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <button type="submit" class="add-to-cart-btn">Add to Cart</button>
      </form>
    </div>
  {% endif %}

  {% assign is_on_sale = product.compare_at_price_max > product.price %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "{{ product.title | escape }}",
    "image": [{% for media in product.media %}"{{ media | image_url: width: 800 }}"{% unless forloop.last %}, {% endunless %}{% endfor %}],
    "description": "{{ product.description | strip_html | escape }}",
    "sku": "{{ product.variants.first.sku }}",
    "brand": {
      "@type": "Brand",
      "name": "{{ product.vendor }}"
    },
    "offers": {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ product.url }}",
      "priceCurrency": "{{ shop.currency }}",
      "price": "{{ product.variants.first.price | divided_by: 100.0 }}",
      {% if is_on_sale %}
        "salePrice": "{{ product.variants.first.price | divided_by: 100.0 }}",
        "priceValidUntil": "2025-07-13",
      {% endif %}
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
    }
  }
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelector('.qty-minus').addEventListener('click', () => {
        const qty = document.getElementById('quantity');
        qty.value = Math.max(1, parseInt(qty.value) - 1);
      });

      document.querySelector('.qty-plus').addEventListener('click', () => {
        const qty = document.getElementById('quantity');
        qty.value = parseInt(qty.value) + 1;
      });

      const sticky = document.getElementById('sticky-bar');
      const btn = document.querySelector('.add-to-cart-btn');
      if (sticky && btn) {
        window.addEventListener('scroll', () => {
          sticky.style.display = btn.getBoundingClientRect().bottom < 0 ? 'flex' : 'none';
        });
      }
    });
  </script>
</section>

{% schema %}
{
  "name": "Product Section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_meta_info",
      "default": true,
      "label": "Show product meta info"
    },
    {
      "type": "checkbox",
      "id": "show_stock_status",
      "default": true,
      "label": "Show stock status"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_cart",
      "default": true,
      "label": "Enable sticky add to cart"
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "default": "On Sale!",
      "label": "Sale badge text"
    },
    {
      "type": "checkbox",
      "id": "show_percent_off",
      "default": true,
      "label": "Show percent off in badge"
    }
  ],
  "blocks": [
    {
      "type": "gallery",
      "name": "Product Gallery"
    },
    {
      "type": "buy_box",
      "name": "Buy Box"
    }
  ],
  "presets": [
    {
      "name": "Default Product Section",
      "category": "Product"
    }
  ]
}
{% endschema %}
