{% render 'breadcrumbs' %}

<div class="main-product section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="main-product__grid">
      {%- comment -%} Product Media {%- endcomment -%}
      <div class="main-product__media">
        <div class="main-product__gallery" id="ProductGallery" data-product-gallery>
          <div class="main-product__gallery-main" data-gallery-main>
            {%- if product.featured_image -%}
              <a href="{{ product.featured_image | image_url: width: 1600 }}" data-pswp-image data-pswp-width="{{ product.featured_image.width }}" data-pswp-height="{{ product.featured_image.height }}">
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  id="ProductMainImage"
                >
              </a>
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>

          {%- if product.images.size > 1 -%}
            <div class="main-product__gallery-thumbs" data-gallery-thumbs>
              {%- for image in product.images -%}
                <button
                  type="button"
                  data-thumb-index="{{ forloop.index0 }}"
                  data-full-src="{{ image | image_url: width: 800 }}"
                  data-zoom-src="{{ image | image_url: width: 1600 }}"
                  data-zoom-width="{{ image.width }}"
                  data-zoom-height="{{ image.height }}"
                  class="{% if forloop.first %}is-active{% endif %}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 128 }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    loading="lazy"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="main-product__info">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="main-product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="main-product__title">{{ product.title }}</h1>

        <div class="main-product__price" data-product-price>
          {%- if product.compare_at_price > product.price -%}
            <span class="sale-price">{{ product.price | money }}</span>
            <span class="compare-price">{{ product.compare_at_price | money }}</span>
          {%- else -%}
            <span>{{ product.price | money }}</span>
          {%- endif -%}

          {%- if product.selected_or_first_available_variant.unit_price -%}
            <span class="unit-price">
              {{ product.selected_or_first_available_variant.unit_price | money }} / {{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
            </span>
          {%- endif -%}
        </div>

        {%- unless product.has_only_default_variant -%}
          <div class="main-product__variants" data-product-variants>
            {%- for option in product.options_with_values -%}
              <div class="main-product__variant-group">
                <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                <select
                  id="Option-{{ section.id }}-{{ forloop.index0 }}"
                  data-option-index="{{ forloop.index0 }}"
                  data-option-select
                >
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- form 'product', product, id: 'ProductForm', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

          {%- if section.settings.show_quantity -%}
            <div class="main-product__quantity">
              <label>{{ 'products.product.quantity.label' | t }}</label>
              <button type="button" data-qty-minus aria-label="{{ 'products.product.quantity.decrease' | t }}">−</button>
              <input type="number" name="quantity" value="1" min="1" data-qty-input>
              <button type="button" data-qty-plus aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
            </div>
          {%- endif -%}

          <div class="main-product__add-to-cart">
            <button
              type="submit"
              class="btn btn--primary btn--full"
              {% unless product.available %}disabled{% endunless %}
              data-add-to-cart
            >
              {%- if product.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        {%- if section.settings.show_description and product.description != blank -%}
          <div class="main-product__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <div class="main-product__accordion" {{ block.shopify_attributes }}>
              <button class="main-product__accordion-trigger" type="button" data-accordion-trigger>
                {{ block.settings.title }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="main-product__accordion-content" data-accordion-content>
                {%- if block.settings.content_source == 'metafield' and block.settings.metafield_key != blank -%}
                  {{ product.metafields.custom[block.settings.metafield_key] | metafield_tag }}
                {%- elsif block.settings.text != blank -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_share -%}
          <div class="main-product__share">
            <span>{{ 'products.product.share' | t }}:</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ product.url | prepend: shop.url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.share_on_facebook' | t }}">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?url={{ product.url | prepend: shop.url }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.share_on_twitter' | t }}">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script type="application/json" data-product-json>
  {{ product | json }}
</script>

{% schema %}
{
  "name": "Product Page",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show Quantity Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show Share Buttons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Details"
        },
        {
          "type": "select",
          "id": "content_source",
          "label": "Content Source",
          "options": [
            { "value": "text", "label": "Custom Text" },
            { "value": "metafield", "label": "Product Metafield" }
          ],
          "default": "text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Custom Text"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Metafield Key",
          "info": "From custom namespace"
        }
      ]
    }
  ]
}
{% endschema %}
