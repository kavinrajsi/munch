<div class="customer-login section-padding">
  <div class="page-width">
    <h1>{{ 'customer.login.title' | t }}</h1>

    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}

      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input class="field__input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email">
      </div>

      <div class="field">
        <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="CustomerPassword">
      </div>

      <button type="submit" class="btn btn--primary">{{ 'customer.login.sign_in' | t }}</button>

      <p>
        <a href="{{ routes.account_recover_url }}">{{ 'customer.login.forgot_password' | t }}</a>
      </p>
      <p>
        <a href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a>
      </p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Login",
  "tag": "section",
  "settings": []
}
{% endschema %}
