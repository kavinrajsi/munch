<div class="customer-form section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div id="CustomerLogin">
      <h1 class="customer-form__title">{{ 'customer.login.title' | t }}</h1>

      {% form 'customer_login' %}
        {%- if form.errors -%}
          <div class="customer-form__errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group">
          <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="form-group">
          <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">{{ 'customer.login.sign_in' | t }}</button>
      {% endform %}

      <div class="customer-form__footer">
        <a href="#RecoverPassword" id="RecoverLink" onclick="document.getElementById('RecoverForm').style.display='block';document.getElementById('CustomerLogin').style.display='none';return false;">
          {{ 'customer.login.forgot_password' | t }}
        </a>
        <br>
        <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
      </div>
    </div>

    <div id="RecoverForm" style="display:none;">
      <h1 class="customer-form__title">{{ 'customer.recover_password.title' | t }}</h1>
      <p class="customer-form__subtext">{{ 'customer.recover_password.subtext' | t }}</p>

      {% form 'recover_customer_password' %}
        {%- if form.posted_successfully? -%}
          <p class="contact-page__success">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}

        <div class="form-group">
          <label for="RecoverEmail">{{ 'customer.recover_password.email' | t }}</label>
          <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">{{ 'customer.recover_password.submit' | t }}</button>
      {% endform %}

      <div class="customer-form__footer">
        <a href="#" onclick="document.getElementById('RecoverForm').style.display='none';document.getElementById('CustomerLogin').style.display='block';return false;">
          {{ 'customer.recover_password.cancel' | t }}
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Login",
  "tag": "section",
  "class": "main-customers-login-section",
  "settings": []
}
{% endschema %}
