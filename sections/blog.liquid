{% comment %}
  Shopify Blog Section
  --------------------------------

  📌 Purpose:
  - Displays a paginated list of blog articles.
  - Provides flexibility for merchants to show/hide metadata like author, date, tags, etc.
  - Allows for content truncation and blog customization.

  🧱 Structure:
  - Section heading (customizable)
  - Article loop:
    - Featured image
    - Title
    - Author (toggle)
    - Published date (toggle)
    - Excerpt or truncated content (toggle + length control)
    - Tags list (toggle)
    - "Read more" link (toggle)
    - Comments count (toggle)
  - Pagination navigation

  🛠 Admin Settings:
  - Custom heading text
  - Articles per page (1–12)
  - Toggle visibility:
    - Author
    - Date
    - Tags
    - Excerpt/content
    - Read more link
    - Comments count
  - Truncate length control for content fallback

  ✅ Accessibility:
  - ARIA labels on read more links and pagination buttons

  🔁 Preset:
  - Name: "Blog listing with filters"
{% endcomment %}

<div class="blog-page layout__grid-box">
  {%- comment -%} Section Title {%- endcomment -%}
  {% if section.settings.blog_title != blank %}
    <h1 class="heading--1 blog-feed__title">{{ section.settings.blog_title }}</h1>
  {% endif %}

  {%- comment -%} Section Description {%- endcomment -%}
  {% if section.settings.blog_description != blank %}
    <div class="blog-feed__description">{{ section.settings.blog_description }}</div>
  {% endif %}

  {% paginate blog.articles by section.settings.articles_per_page %}
    <ul class="blog-feed__list">
      {% for article in blog.articles %}
        <li class="blog-feed__item">
          <article class="blog-feed__card">
            {%- comment -%} Article Image {%- endcomment -%}
            <div class="blog-feed__image-wrapper">
              <a
                href="{{ article.url }}"
                class="blog-feed__image-link"
                aria-label="Read article: {{ article.title | escape }}"
              >
                {% if article.image %}
                  <div class="blog-feed__image">
                    <picture>
                      <source
                        srcset="
                          {{ article.image | image_url: width: 720, height: 220, format: 'webp' }} 2x,
                          {{ article.image | image_url: width: 360, height: 220, format: 'webp' }} 1x
                        "
                        type="image/webp"
                      >
                      <source
                        srcset="
                          {{ article.image | image_url: width: 720, height: 220 }} 2x,
                          {{ article.image | image_url: width: 360, height: 220 }} 1x
                        "
                        type="image/jpeg"
                      >
                      <img
                        src="{{ article.image | image_url: width: 360, height: 220 }}"
                        alt="{{ article.image.alt | default: article.title | escape }}"
                        width="360"
                        height="220"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        {% if forloop.first %}
                          fetchpriority="high"
                        {% endif %}
                        class="blog-feed__img"
                      >
                    </picture>
                  </div>
                {% elsif section.settings.placeholder_image %}
                  <div class="blog-feed__image">
                    <img
                      src="{{ section.settings.placeholder_image | image_url: width: 360, height: 220 }}"
                      alt="Blog placeholder image"
                      width="360"
                      height="220"
                      loading="lazy"
                      class="blog-feed__img"
                    >
                  </div>
                {% else %}
                  <div class="blog-feed__image blog-feed__image--placeholder">
                    {{ 'image' | placeholder_svg_tag: 'blog-feed__placeholder-svg' }}
                  </div>
                {% endif %}
              </a>
            </div>

            {%- comment -%} Article Content {%- endcomment -%}
            <div class="blog-feed__content">
              {%- comment -%} Article Title {%- endcomment -%}
              <h3 class="blog-feed__article-title">
                <a href="{{ article.url }}" class="blog-feed__title-link">
                  {{ article.title }}
                </a>
              </h3>

              {%- comment -%} Meta Information {%- endcomment -%}
              {% if section.settings.show_author or section.settings.show_date %}
                <div class="blog-feed__meta">
                  {% if section.settings.show_author %}
                    <span class="blog-feed__author">
                      <svg
                        class="blog-feed__icon"
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path d="M7 7C8.933 7 10.5 5.433 10.5 3.5S8.933 0 7 0 3.5 1.567 3.5 3.5 5.067 7 7 7zm0 1.75c-2.347 0-7 1.179-7 3.5V14h14v-1.75c0-2.321-4.653-3.5-7-3.5z" fill="currentColor"/>
                      </svg>
                      By {{ article.author }}
                    </span>
                  {% endif %}

                  {% if section.settings.show_date %}
                    <time
                      class="blog-feed__date"
                      datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
                    >
                      <svg
                        class="blog-feed__icon"
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path d="M11.667 1.556h-.778V0H9.333v1.556H4.667V0H3.111v1.556h-.778A1.55 1.55 0 00.778 3.111L.77 12.444a1.556 1.556 0 001.556 1.556h9.333a1.562 1.562 0 001.556-1.556V3.111a1.562 1.562 0 00-1.556-1.555zm0 10.888H2.333V5.444h9.334v7z" fill="currentColor"/>
                      </svg>
                      {{ article.published_at | date: '%B %d, %Y' }}
                    </time>
                  {% endif %}
                </div>
              {% endif %}

              {%- comment -%} Article Excerpt {%- endcomment -%}
              {% if section.settings.show_excerpt %}
                <div class="blog-feed__excerpt">
                  {% if article.excerpt.size > 0 %}
                    {{ article.excerpt | strip_html | truncate: section.settings.truncate_length }}
                  {% else %}
                    {{ article.content | strip_html | truncate: section.settings.truncate_length }}
                  {% endif %}
                </div>
              {% endif %}

              {%- comment -%} Article Tags {%- endcomment -%}
              {% if section.settings.show_tags and article.tags.size > 0 %}
                <nav class="blog-feed__tags" aria-label="Article tags">
                  {% for tag in article.tags limit: 3 %}
                    <a
                      href="{{ section.settings.blog.url }}/tagged/{{ tag | handle }}"
                      class="blog-feed__tag"
                    >
                      #{{ tag }}
                    </a>
                  {% endfor %}
                  {% if article.tags.size > 3 %}
                    <span class="blog-feed__tag-more">+{{ article.tags.size | minus: 3 }}</span>
                  {% endif %}
                </nav>
              {% endif %}

              {%- comment -%} Article Footer {%- endcomment -%}
              <div class="blog-feed__footer">
                {% if section.settings.show_read_more %}
                  <a
                    href="{{ article.url }}"
                    class="blog-feed__read-more"
                    aria-label="Read full article: {{ article.title | escape }}"
                  >
                    {{ section.settings.read_more_text }}
                    <svg
                      class="blog-feed__arrow"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d="M8 0L6.59 1.41 12.17 7H0v2h12.17l-5.58 5.59L8 16l8-8z" fill="currentColor"/>
                    </svg>
                  </a>
                {% endif %}

                {% if section.settings.show_comments_count
                  and article.comments_enabled?
                  and article.comments_count > 0
                %}
                  <a
                    href="{{ article.url }}#comments"
                    class="blog-feed__comments"
                    aria-label="{{ article.comments_count }} {{ article.comments_count | pluralize: 'comment', 'comments' }} on this article"
                  >
                    <svg
                      class="blog-feed__icon"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d="M14 0H2C.9 0 .01.9.01 2L0 16l4-4h10c1.1 0 2-.9 2-2V2c0-1.1-.9-2-2-2zM4 7h8v2H4V7zm6-3h2v2h-2V4zM4 4h5v2H4V4z" fill="currentColor"/>
                    </svg>
                    {{ article.comments_count }}
                  </a>
                {% endif %}
              </div>
            </div>
          </article>
        </li>
      {% endfor %}
    </ul>

    <!-- Pagination controls -->
    <nav class="pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="pagination__button--prev" aria-label="Previous">
          <!-- Left arrow SVG -->
          <svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16.4304 12.5429L8.07094 20.5079C7.93145 20.6409 7.74614 20.7151 7.55344 20.7151C7.36073 20.7151 7.17542 20.6409 7.03594 20.5079L7.02694 20.4989C6.95908 20.4345 6.90505 20.3569 6.86813 20.2709C6.83121 20.1849 6.81217 20.0923 6.81217 19.9987C6.81217 19.9051 6.83121 19.8125 6.86813 19.7265C6.90505 19.6405 6.95908 19.5629 7.02694 19.4984L14.8989 11.9984L7.02694 4.50144C6.95908 4.43698 6.90505 4.35939 6.86813 4.27339C6.83121 4.1874 6.81217 4.09478 6.81217 4.00119C6.81217 3.9076 6.83121 3.81499 6.86813 3.72899C6.90505 3.64299 6.95908 3.5654 7.02694 3.50094L7.03594 3.49194C7.17542 3.35898 7.36073 3.2848 7.55344 3.2848C7.74614 3.2848 7.93145 3.35898 8.07094 3.49194L16.4304 11.4569C16.504 11.527 16.5625 11.6112 16.6025 11.7046C16.6425 11.7979 16.6631 11.8984 16.6631 11.9999C16.6631 12.1015 16.6425 12.202 16.6025 12.2953C16.5625 12.3887 16.504 12.4729 16.4304 12.5429Z" fill="#660808"/>
          </svg>
        </a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {% if part.title == '&hellip;' %}
          <span class="pagination__page--decorative">…</span>
        {% elsif part.is_link %}
          <a class="pagination__page" href="{{ part.url }}">{{ part.title }}</a>
        {% else %}
          <span class="pagination__page--current">{{ part.title }}</span>
        {% endif %}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="pagination__button--next" aria-label="Next">
          <!-- Right arrow SVG -->
          <svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8.56963 11.4571L16.9291 3.4921C17.0686 3.35909 17.2539 3.28491 17.4466 3.28491C17.6393 3.28491 17.8246 3.35909 17.9641 3.4921L17.9731 3.5011C18.041 3.5655 18.095 3.64308 18.1319 3.72909C18.1688 3.81509 18.1878 3.9077 18.1878 4.00129C18.1878 4.09488 18.1688 4.1875 18.1319 4.2735C18.095 4.3595 18.041 4.43708 17.9731 4.50154L10.1011 12.0015L17.9731 19.4985C18.041 19.5629 18.095 19.6405 18.1319 19.7265C18.1688 19.8125 18.1878 19.9051 18.1878 19.9987C18.1878 20.0923 18.1688 20.1849 18.1319 20.2709C18.095 20.3569 18.041 20.4345 17.9731 20.4989L17.9641 20.5079C17.8246 20.6409 17.6393 20.7151 17.4466 20.7151C17.2539 20.7151 17.0686 20.6409 16.9291 20.5079L8.56963 12.5429C8.49601 12.4728 8.4375 12.3886 8.39748 12.2952C8.35746 12.2019 8.33687 12.1014 8.33687 11.9999C8.33687 11.8983 8.35746 11.7978 8.39748 11.7045C8.4375 11.6111 8.49601 11.5269 8.56963 11.4571Z" fill="#660808"/>
          </svg>
        </a>
      {%- endif -%}
    </nav>
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "blog-feed",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "blog_title",
      "label": "Section title",
      "default": "From Our Blog"
    },
    {
      "type": "richtext",
      "id": "blog_description",
      "label": "Section description"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of articles to show"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns (desktop)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1",
      "label": "Columns (mobile)"
    },
    {
      "type": "header",
      "content": "Article Display"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "truncate_length",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "label": "Excerpt length (characters)"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments_count",
      "label": "Show comments count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show 'Read more' link",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "'Read more' text",
      "default": "Read more"
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "'View all' text",
      "default": "View all articles"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "placeholder_image",
      "label": "Placeholder image"
    },
    {
      "type": "header",
      "content": "Empty State"
    },
    {
      "type": "text",
      "id": "empty_state_text",
      "label": "Empty state message",
      "default": "No blog articles found. Please select a blog with published articles."
    }
  ],
  "presets": [
    {
      "name": "Blog Feed - Index",
      "category": "Blog"
    }
  ]
}
{% endschema %}
