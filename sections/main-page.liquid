  <div class="container">
    <h1 class="text-center" style="margin-bottom:32px;">{{ page.title }}</h1>
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "main-page-section",
  "settings": []
}
{% endschema %}
