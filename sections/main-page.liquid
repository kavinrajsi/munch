{% schema %}
{
  "name": "Main Page",
  "tag": "section",
  "class": "main-page",
  "settings": [],
  "presets": [
    {
      "name": "Page content"
    }
  ]
}
{% endschema %}

<section style="max-width: 800px; margin: 0 auto; padding: 2rem;">
  <h1>{{ page.title }}</h1>

  {% if page.content != blank %}
    <div class="rte">
      {{ page.content }}
    </div>
  {% else %}
    <p>No content added yet. Edit this page in your Shopify admin.</p>
  {% endif %}
</section>
