<div class="about-page" style="
  --about-bg: {{ section.settings.bg_color }};
  --about-pt-d: {{ section.settings.padding_top }}px;
  --about-pb-d: {{ section.settings.padding_bottom }}px;
  --about-pt-m: {{ section.settings.padding_top_mobile }}px;
  --about-pb-m: {{ section.settings.padding_bottom_mobile }}px;
" {{ section.shopify_attributes }}>
  {%- if section.settings.hero_image != blank -%}
    <div class="about-page__hero">
      {{ section.settings.hero_image
        | image_url: width: 1440
        | image_tag:
          widths: '750, 1100, 1440',
          sizes: '100vw',
          class: 'about-page__hero-img',
          loading: 'eager'
      }}
    </div>
  {%- else -%}
    <div class="about-page__hero about-page__hero--placeholder"></div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "About Hero",
  "tag": "section",
  "class": "about-page-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFF7F3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "About Hero",
      "category": "Pages"
    }
  ]
}
{% endschema %}
