<div class="hero" data-animate="fade-in" {{ section.shopify_attributes }}>
  {%- if section.settings.link != blank -%}
    <a
      href="{{ section.settings.link }}"
      class="hero__link"
      {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
      aria-label="{{ section.settings.desktop_image.alt | default: shop.name | escape }}"
    >
  {%- endif -%}

  {%- if section.settings.desktop_image != blank -%}
    <picture class="hero__picture">
      {%- if section.settings.mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ section.settings.mobile_image | image_url: width: 400 }} 400w,
            {{ section.settings.mobile_image | image_url: width: 600 }} 600w,
            {{ section.settings.mobile_image | image_url: width: 800 }} 800w
          "
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
        >
      {%- endif -%}
      <img
        src="{{ section.settings.desktop_image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.desktop_image | image_url: width: 800 }} 800w,
          {{ section.settings.desktop_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.desktop_image | image_url: width: 1600 }} 1600w,
          {{ section.settings.desktop_image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ section.settings.desktop_image.alt | default: shop.name | escape }}"
        width="{{ section.settings.desktop_image.width }}"
        height="{{ section.settings.desktop_image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
  {%- else -%}
    <div class="hero__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder-svg' }}
    </div>
  {%- endif -%}

  {%- if section.settings.link != blank -%}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Section link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Banner"
    }
  ]
}
{% endschema %}