{% render 'breadcrumbs' %}

<div class="collection section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="collection__header">
      <div>
        <h1 class="collection__title">{{ collection.title }}</h1>
        {%- if collection.description != blank and section.settings.show_description -%}
          <div class="rte" style="margin-top:8px;">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      <span class="collection__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
    </div>

    <div class="collection__toolbar">
      {%- if section.settings.show_filters -%}
        <div class="collection__filters">
          {%- for tag in collection.all_tags -%}
            {%- if current_tags contains tag -%}
              <a href="{{ tag | link_to_remove_tag: tag }}" class="is-active">{{ tag }}</a>
            {%- else -%}
              <a href="{{ tag | link_to_tag: tag }}">{{ tag }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_sort -%}
        <div class="collection__sort">
          <label for="SortBy">Sort by:</label>
          <select id="SortBy" data-sort-by>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="collection__grid" style="--product-card-gap: {{ section.settings.grid_gap }}px;">
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- for product in collection.products -%}
            {% render 'product-card', product: product, collection: collection %}
          {%- endfor -%}

          {%- if paginate.pages > 1 -%}
            <div class="pagination" style="grid-column: 1 / -1;">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                </a>
              {%- endif -%}

              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  <span class="{% if part.title == paginate.current_page %}is-active{% endif %}">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}

              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="next" aria-label="{{ 'accessibility.next_slide' | t }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    {%- else -%}
      <div class="collection__empty">
        <p>No products found in this collection.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Browse All Products</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Page",
  "tag": "section",
  "class": "main-collection-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Collection Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Tag Filters",
      "default": false
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per Page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 16,
      "unit": "px"
    }
  ]
}
{% endschema %}
