{%- comment -%} Banner {%- endcomment -%}
{%- if section.settings.banner_image != blank -%}
  <div class="collection-banner">
    {{ section.settings.banner_image
      | image_url: width: 1920
      | image_tag:
          widths: '750, 1100, 1440, 1920',
          sizes: '100vw',
          loading: 'eager',
          class: '',
          alt: collection.title
    }}
  </div>
{%- endif -%}

<div class="collection section-padding" {{ section.shopify_attributes }}>
  <div class="container">

    {%- comment -%} Decorated heading {%- endcomment -%}
    {% render 'section-heading',
      title: collection.title,
      heading_tag: 'h1',
      show_left_line: true,
      show_left_icon: true,
      show_right_icon: true,
      show_right_line: true,
      margin_bottom_desktop: 24,
      margin_bottom_mobile: 16
    %}

    {%- comment -%} Toolbar: breadcrumbs + filter/sort {%- endcomment -%}
    <div class="collection__toolbar">
      <nav class="collection__breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <svg viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <polyline points="1 1 5 5 1 9"/>
        </svg>
        <span>{{ collection.title }}</span>
      </nav>

      <div class="collection__controls">
        {%- if section.settings.show_filters and collection.all_tags.size > 0 -%}
          <div class="collection__filter-dropdown">
            <button type="button" class="collection__control-btn" data-filter-toggle aria-expanded="false">
              Filter
              <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <polyline points="1 1 5 5 9 1"/>
              </svg>
            </button>
            <div class="collection__filter-menu" data-filter-menu>
              {%- for tag in collection.all_tags -%}
                {%- if current_tags contains tag -%}
                  <a href="{{ tag | link_to_remove_tag: tag }}" class="is-active">{{ tag }}</a>
                {%- else -%}
                  <a href="{{ tag | link_to_tag: tag }}">{{ tag }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <span class="collection__controls-separator"></span>
        {%- endif -%}

        {%- if section.settings.show_sort -%}
          <div class="collection__sort-dropdown">
            <button type="button" class="collection__control-btn" data-sort-toggle aria-expanded="false">
              {%- assign current_sort_label = 'Sort' -%}
              {%- for option in collection.sort_options -%}
                {%- if collection.sort_by == option.value -%}
                  {%- assign current_sort_label = option.name -%}
                {%- endif -%}
              {%- endfor -%}
              {{ current_sort_label }}
              <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <polyline points="1 1 5 5 9 1"/>
              </svg>
            </button>
            <div class="collection__sort-menu" data-sort-menu>
              {%- for option in collection.sort_options -%}
                <button type="button" data-sort-value="{{ option.value }}" class="{% if collection.sort_by == option.value %}is-active{% endif %}">
                  {{ option.name }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Product Grid {%- endcomment -%}
    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="collection__grid">
          {%- for product in collection.products -%}
            {%- liquid
              assign fv = product.selected_or_first_available_variant
              assign has_compare = false
              assign discount_pct = 0
              if fv.compare_at_price > fv.price
                assign has_compare = true
                assign diff = fv.compare_at_price | minus: fv.price
                assign discount_pct = diff | times: 100 | divided_by: fv.compare_at_price
              endif
              assign has_range = false
              if product.price_min != product.price_max
                assign has_range = true
              endif
            -%}

            <div class="collection-card" data-product-card data-first-variant-selected="true">
              <script type="application/json" data-product-json>
                {
                  "variants": [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id }},
                        "title": {{ variant.title | json }},
                        "price": {{ variant.price }},
                        "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                        "available": {{ variant.available }},
                        "options": [{% for opt in variant.options %}{{ opt | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
                      }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                }
              </script>

              <a href="{{ product.url }}" class="collection-card__media-link" tabindex="-1" aria-hidden="true">
                <div class="collection-card__media">
                  {%- render 'card-image', product: product, columns: 4 -%}
                </div>
              </a>

              <div class="collection-card__body">
                <div class="collection-card__header">
                  <h3 class="collection-card__title">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>
                  {%- render 'card-price', product: product, fv: fv, has_range: has_range, has_compare: has_compare, discount_pct: discount_pct, price_display: 'auto' -%}
                </div>

                {%- unless product.has_only_default_variant -%}
                  <div class="collection-card__options">
                    {%- for option in product.options_with_values -%}
                      <div
                        class="collection-card__option-group"
                        data-option-group
                        data-option-position="{{ option.position }}"
                      >
                        {%- for value in option.values -%}
                          <button
                            type="button"
                            class="collection-card__option-button{% if forloop.first %} is-selected{% endif %}"
                            data-option-btn
                            data-option-position="{{ option.position }}"
                            data-option-value="{{ value | escape }}"
                            aria-label="{{ option.name | escape }}: {{ value | escape }}"
                          >{{ value }}</button>
                        {%- endfor -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

                <div class="collection-card__quantity">
                  <button type="button" class="collection-card__quantity-button" data-qty-minus aria-label="Decrease quantity">−</button>
                  <input
                    type="number"
                    class="collection-card__quantity-input"
                    value="1"
                    min="1"
                    max="99"
                    readonly
                    data-qty-input
                    aria-label="Quantity"
                  >
                  <button type="button" class="collection-card__quantity-button" data-qty-plus aria-label="Increase quantity">+</button>
                </div>

                <form action="{{ routes.cart_add_url }}" method="post" class="collection-card__form" data-card-form>
                  <input type="hidden" name="id" value="{{ fv.id }}" data-variant-id>
                  <input type="hidden" name="quantity" value="1" data-qty-value>
                  <button type="submit" class="collection-card__add-to-cart">Add to cart</button>
                </form>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Pagination {%- endcomment -%}
        {%- if paginate.pages > 1 -%}
          <nav class="collection__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="collection__pagination-arrow" aria-label="Previous page">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
              </a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="{% if part.title == paginate.current_page %}is-active{% endif %}">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="collection__pagination-arrow" aria-label="Next page">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="collection__empty">
        <p>No products found in this collection.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Browse All Products</a>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    /* ── Variant selection, quantity, and price update ── */
    document.querySelectorAll('[data-product-card]').forEach(function (card) {
      var jsonEl = card.querySelector('[data-product-json]');
      if (!jsonEl) return;

      var data     = JSON.parse(jsonEl.textContent);
      var variants = data.variants;
      var firstVariantSelected = card.dataset.firstVariantSelected === 'true';
      var selOpts  = (firstVariantSelected && variants[0]) ? variants[0].options.slice() : [];

      var variantIdInput = card.querySelector('[data-variant-id]');
      var qtyValueInput  = card.querySelector('[data-qty-value]');
      var qtyInput       = card.querySelector('[data-qty-input]');
      var priceCurrentEl = card.querySelector('[data-price-current]');
      var priceCompareEl = card.querySelector('[data-price-compare]');
      var priceBadgeEl   = card.querySelector('[data-price-badge]');

      function getVariant() {
        return variants.find(function (v) {
          return v.options.every(function (opt, i) { return opt === selOpts[i]; });
        });
      }

      function formatMoney(cents) {
        return 'Rs.\u00a0' + (cents / 100).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }

      function updatePrice(v) {
        if (!v || !priceCurrentEl) return;
        if (v.compare_at_price > v.price) {
          priceCurrentEl.textContent = formatMoney(v.price);
          if (priceCompareEl) { priceCompareEl.textContent = formatMoney(v.compare_at_price); priceCompareEl.hidden = false; }
          if (priceBadgeEl) {
            var pct = Math.round((v.compare_at_price - v.price) * 100 / v.compare_at_price);
            priceBadgeEl.textContent = '-' + pct + '%';
            priceBadgeEl.hidden = false;
          }
        } else {
          priceCurrentEl.textContent = formatMoney(v.price);
          if (priceCompareEl) priceCompareEl.hidden = true;
          if (priceBadgeEl)   priceBadgeEl.hidden   = true;
        }
      }

      function updateInputs(v) {
        if (!v) return;
        if (variantIdInput) variantIdInput.value = v.id;
      }

      card.querySelectorAll('[data-option-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var pos = parseInt(btn.dataset.optionPosition, 10) - 1;
          selOpts[pos] = btn.dataset.optionValue;
          btn.closest('[data-option-group]').querySelectorAll('[data-option-btn]').forEach(function (b) {
            b.classList.toggle('is-selected', b.dataset.optionValue === selOpts[pos]);
          });
          var v = getVariant();
          updatePrice(v);
          updateInputs(v);
        });
      });

      if (qtyInput) {
        card.querySelector('[data-qty-minus]').addEventListener('click', function () {
          var val = Math.max(1, parseInt(qtyInput.value, 10) - 1);
          qtyInput.value = val;
          if (qtyValueInput) qtyValueInput.value = val;
        });
        card.querySelector('[data-qty-plus]').addEventListener('click', function () {
          var val = Math.min(99, parseInt(qtyInput.value, 10) + 1);
          qtyInput.value = val;
          if (qtyValueInput) qtyValueInput.value = val;
        });
      }
    });

    /* ── Filter dropdown toggle ── */
    var filterToggle = document.querySelector('[data-filter-toggle]');
    var filterMenu   = document.querySelector('[data-filter-menu]');
    if (filterToggle && filterMenu) {
      filterToggle.addEventListener('click', function () {
        var open = filterMenu.classList.toggle('is-open');
        filterToggle.setAttribute('aria-expanded', open);
      });
    }

    /* ── Sort dropdown toggle + navigation ── */
    var sortToggle = document.querySelector('[data-sort-toggle]');
    var sortMenu   = document.querySelector('[data-sort-menu]');
    if (sortToggle && sortMenu) {
      sortToggle.addEventListener('click', function () {
        var open = sortMenu.classList.toggle('is-open');
        sortToggle.setAttribute('aria-expanded', open);
      });
      sortMenu.querySelectorAll('[data-sort-value]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var url = new URL(window.location.href);
          url.searchParams.set('sort_by', btn.dataset.sortValue);
          window.location.href = url.toString();
        });
      });
    }

    /* ── Close dropdowns on outside click ── */
    document.addEventListener('click', function (e) {
      if (filterToggle && !filterToggle.contains(e.target) && filterMenu && !filterMenu.contains(e.target)) {
        filterMenu.classList.remove('is-open');
        filterToggle.setAttribute('aria-expanded', 'false');
      }
      if (sortToggle && !sortToggle.contains(e.target) && sortMenu && !sortMenu.contains(e.target)) {
        sortMenu.classList.remove('is-open');
        sortToggle.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Page",
  "tag": "section",
  "class": "main-collection-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Collection Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Tag Filters",
      "default": false
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per Page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 20,
      "unit": "px"
    }
  ]
}
{% endschema %}
