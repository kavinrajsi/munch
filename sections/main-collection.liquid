{% schema %}
{
  "name": "Main Collection",
  "tag": "section",
  "class": "main-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    }
  ],
  "presets": [
    {
      "name": "Collection product grid"
    }
  ]
}
{% endschema %}

<div class="collection-page">
  {% if collection.title != blank %}
    <h1>{{ collection.title }}</h1>
  {% endif %}
  {%- if collection.description != blank -%}
    <p>{{ collection.description }}</p>
  {%- endif -%}

  <div class="grid-box">
    {% if collection.image %}
      <div class="collection-image">
        <img
          src="{{ collection.image | image_url: width: 2048, height: 2048 }}"
          width="2048"
          height="2048"
          alt="{{ collection.title }}"
        >
      </div>
    {% endif %}
  </div>
  <section class="grid-box">
    {% paginate collection.products by 8 %}
      <div
        class="collection-list-grid"
        collection-list-mobile="2"
        collection-list-tablet="3"
        collection-list-desktop="4"
      >
        {% for product in collection.products limit: 28 %}
          <div class="product__slider--card">
            <a href="{{ product.url }}">
              <img
                src="{{ product.featured_image | image_url: width: 265, height: 320 }}"
                alt="{{ product.title }}"
                width="265"
                height="320"
                loading="lazy"
                decoding="async"
              >
            </a>
            <div class="product__info">
              <strong class="product__title">{{ product.title }}</strong>

              {% if product.variants.size > 1 %}
                <div>
                  {{ product.price_min | money -}}
                  <sup>+</sup>
                </div>
              {% else %}
                <div>{{ product.price | money }}</div>
              {% endif %}

              {% if product.variants.size > 1 %}
                <button
                  id="productInfoAnchor"
                  class="product__select-option-button select-option-button"
                  data-product-handle="{{ product.handle }}"
                  type="button"
                >
                  Select Option
                </button>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="pagination--number">
        {{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}
      </div>
    {% endpaginate %}
  </section>
</div>



<script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"ItemList",
    "itemListElement":[
    {% for product in collection.products limit: 9 %}
    {
      "@type":"ListItem",
      "position": {{ forloop.index }},
      "name": "{{ product.title }}",
      "url":"{{ shop.secure_url}}{{ product.url}}"
    },
    {% endfor %}
    {% for product in collection.products offset:2 limit: 1 %}
    {
      "@type":"ListItem",
      "position": 10,
      "name": "{{ product.title }}",
      "url":"{{ shop.secure_url}}{{ product.url}}"
    }
    {% endfor %}
    ]
  }
</script>
