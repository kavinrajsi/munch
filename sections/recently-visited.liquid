<div class="product-slider section-padding" id="RecentlyVisited" data-recently-visited style="display:none;" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="product-slider__header">
      <h2 class="product-slider__title">{{ section.settings.title }}</h2>
    </div>

    <div class="product-slider__track" data-recently-visited-products></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var container = document.querySelector('[data-recently-visited]');
    if (!container) return;

    var productsContainer = container.querySelector('[data-recently-visited-products]');
    var currentProductId = '{{ product.id }}';

    try {
      var visited = JSON.parse(localStorage.getItem('recently_visited') || '[]');
      visited = visited.filter(function(item) { return item.id != currentProductId; });

      if (visited.length === 0) return;

      container.style.display = 'block';

      visited.slice(0, {{ section.settings.products_to_show }}).forEach(function(item) {
        var card = document.createElement('div');
        card.className = 'product-card';
        card.innerHTML = '<div class="product-card__media"><a href="' + item.url + '">' +
          (item.image ? '<img src="' + item.image + '" alt="' + item.title + '" loading="lazy">' : '') +
          '</a></div>' +
          '<div class="product-card__info">' +
          '<h3 class="product-card__title"><a href="' + item.url + '">' + item.title + '</a></h3>' +
          '<div class="product-card__price"><span>' + item.price + '</span></div>' +
          '</div>';
        productsContainer.appendChild(card);
      });

      if (typeof jQuery !== 'undefined' && jQuery.fn.slick) {
        jQuery(productsContainer).slick({
          slidesToShow: 4,
          slidesToScroll: 1,
          arrows: true,
          dots: false,
          responsive: [
            { breakpoint: 1024, settings: { slidesToShow: 3 } },
            { breakpoint: 768, settings: { slidesToShow: 2 } }
          ]
        });
      }
    } catch(e) {}

    // Store current product
    if (currentProductId && '{{ request.page_type }}' === 'product') {
      try {
        var visited = JSON.parse(localStorage.getItem('recently_visited') || '[]');
        visited = visited.filter(function(item) { return item.id != currentProductId; });
        visited.unshift({
          id: currentProductId,
          title: {{ product.title | json }},
          url: '{{ product.url }}',
          image: '{{ product.featured_image | image_url: width: 480 }}',
          price: '{{ product.price | money }}'
        });
        visited = visited.slice(0, 20);
        localStorage.setItem('recently_visited', JSON.stringify(visited));
      } catch(e) {}
    }
  });
</script>

{% schema %}
{
  "name": "Recently Visited",
  "tag": "section",
  "class": "recently-visited-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
