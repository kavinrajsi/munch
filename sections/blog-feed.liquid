{% comment %}
  Shopify Blog Feed Section
  ----------------------------------------------

  📌 Purpose:
  - Displays a feed of blog articles from a selected blog.
  - Includes structured data for SEO.

  🛠 Admin Settings:
  - Show author
  - Show date
  - Show tags
  - Show comments
  - Use content instead of excerpt
  - Select blog
  - Article limit
  - Truncate length
  - Blog title
  - Blog type/template metadata

  ✅ Accessibility:
  - Alt text on images
  - ARIA labels

  🔁 Preset:
  - Name: Blog Feed
  - Category: Blog
{% endcomment %}

<section class="blog-feed layout__grid-box" data-template="{{ section.settings.blog_template }}" data-type="{{ section.settings.blog_type }}">
  {% if section.settings.blog.articles.size > 0 %}
    {% if section.settings.blog_title != blank %}
      <h2 class="heading--2 blog-feed__title">{{ section.settings.blog_title }}</h2>
    {% endif %}
     <ul class="blog-feed--lists">
      {% for article in section.settings.blog.articles limit: section.settings.articles_limit %}
        <li class="blog-feed--list">
          <!-- Article Image -->
          <div class="blog-feed--blog__image">
            <a href="{{ article.url }}">
              {% if article.image %}
                <picture>
                  <source
                    srcset="{{ article.image | image_url: width: 360, height: 320, format: 'pjpg' }}"
                    type="image/pjpg"
                  >
                  <source
                    srcset="{{ article.image | image_url: width: 360, height: 320, format: 'webp' }}"
                    type="image/webp"
                  >
                  <img
                    src="{{ article.image | image_url: width: 360, height: 320 }}"
                    alt="{{ article.title | escape }}"
                    width="360"
                    height="320"
                    loading="lazy"
                  >
                </picture>
                <noscript>
                  <p>{{ article.image | image_url: width: 455, height: 300 | image_tag: article.title }}</p>
                </noscript>
              {% else %}
                <!-- Placeholder image if no article.image -->
                {% if section.settings.placeholder_image %}
                  <img
                    src="{{ section.settings.placeholder_image | image_url: width: 360, height: 320 }}"
                    alt="Placeholder image"
                    width="360"
                    height="320"
                    loading="lazy"
                  >
                {% endif %}
              {% endif %}
            </a>
          </div>

          <!-- Article Title -->
          <h2 class="blog-feed--blog__title">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h2>

          <!-- Author (optional) -->
          {% comment %} {% if section.settings.show_author %}
            <span class="blog-feed--blog__author">By {{ article.author }}</span>
          {% endif %} {% endcomment %}

          <!-- Date (optional) -->
          {% if section.settings.show_date %}
            <span class="blog-feed--blog__date">{{ article.published_at | time_tag: '%B %d, %Y' }}</span>
          {% endif %}

          <!-- Content or Excerpt (optional) -->
          {% comment %} {% if section.settings.show_excerpt %}
            <p class="blog-feed--blog__content">
              {% if article.excerpt.size > 0 %}
                {{ article.excerpt }}
              {% else %}
                {{ article.content | strip_html | truncate: section.settings.truncate_length }}
              {% endif %}
            </p>
          {% endif %} {% endcomment %}

          <!-- Tags (optional) -->
          {% comment %} {% if section.settings.show_tags %}
            <nav class="blog-feed--blog__tags">
              {% if article.tags.size == 0 %}
                <span>No tags</span>
              {% else %}
                {% for tag in article.tags %}
                  {% if forloop.first %}
                    <span class="blog-feed--blog__tag">Tag: </span>
                  {% endif %}
                  <a class="blog-feed--blog__tag" href="{{ blog.url }}?tag={{ tag | url_encode }}">{{ tag }}</a>
                  {%- unless forloop.last %},{% endunless %}
                {% endfor %}
              {% endif %}
            </nav>
          {% endif %} {% endcomment %}

          <!-- Read more & Comments count -->
          {% comment %} <ul>
            {% if section.settings.show_read_more %}
              <li>
                <a href="{{ article.url }}" aria-label="Read more: {{ article.title }}">Read more</a>
              </li>
            {% endif %}
            {% if section.settings.show_comments_count
              and section.settings.blog.comments_enabled?
              and article.comments_count > 0
            %}
              <li>
                <a href="{{ article.url }}#comments">{{ article.comments_count }}</a>
              </li>
            {% endif %}
          </ul> {% endcomment %}
        </li>
      {% endfor %}
    </ul>


    <!-- ItemList Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Blog Article List",
        "itemListElement": [
          {% for article in section.settings.blog.articles limit: section.settings.articles_limit %}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": "{{ article.url | prepend: shop.url }}"
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>

  {% else %}
    <p class="blog-feed__empty">No blog articles found.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Blog Articles",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "blog_title",
      "label": "Blog section title",
      "default": "Blog"
    },
    {
      "type": "checkbox",
      "id": "blog_show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show article tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show comments count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_article_content",
      "label": "Use full content instead of excerpt",
      "default": false
    },
    {
      "type": "range",
      "id": "truncate_length",
      "label": "Excerpt truncate length (characters)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "articles_limit",
      "label": "Number of articles to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Blog Feed",
      "category": "Blog"
    }
  ]
}
{% endschema %}
