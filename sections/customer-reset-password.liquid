{% schema %}
{
  "name": "Customer Reset Password",
  "tag": "section",
  "class": "customer-reset-password",
  "settings": [],
  "presets": [
    {
      "name": "Reset Password"
    }
  ]
}
{% endschema %}

<section style="max-width: 500px; margin: 0 auto; padding: 2rem;">
  <h1>Reset Your Password</h1>

  {% form 'reset_customer_password' %}
    {% if form.errors %}
      <div style="color: red;">
        <ul>
          {% for field in form.errors %}
            <li>{{ field | capitalize }}: {{ form.errors.messages[field] }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <label for="ResetPassword">New Password</label>
    <input type="password" name="customer[password]" id="ResetPassword" required>

    <label for="ResetPasswordConfirmation">Confirm New Password</label>
    <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirmation" required>

    <button type="submit" class="btn">Reset Password</button>
  {% endform %}
</section>
