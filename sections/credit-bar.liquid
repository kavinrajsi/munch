<div
  class="credit-bar"
  style="
    --credit-bar-bg: {{ section.settings.bg_color }};
    --credit-bar-text: {{ section.settings.text_color }};
    --credit-bar-link: {{ section.settings.link_color }};
    --credit-bar-pt-desktop: {{ section.settings.padding_top_desktop }}px;
    --credit-bar-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --credit-bar-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --credit-bar-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --credit-bar-font-weight: {{ section.settings.font_weight }};
    --credit-bar-font-size: {{ section.settings.font_size }}px;
    --credit-bar-line-height: {{ section.settings.line_height }}px;
    --credit-bar-credit-gap: {{ section.settings.credit_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="credit-bar__inner {% if section.settings.container_type == 'container-fluid' %}container-fluid{% else %}container{% endif %}">
    <p class="credit-bar__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.store_name | default: shop.name }}. All rights reserved.
    </p>
    {%- if section.settings.credit_text != blank -%}
      <p class="credit-bar__credit">
        Made by
        {%- if section.settings.credit_link != blank -%}
          {%- liquid
            assign credit_url = section.settings.credit_link
            assign utm_source = shop.permanent_domain | url_encode
            assign utm_medium = 'referral'
            assign utm_campaign = 'theme-credit'
            if credit_url contains '?'
              assign credit_url = credit_url | append: '&utm_source=' | append: utm_source | append: '&utm_medium=' | append: utm_medium | append: '&utm_campaign=' | append: utm_campaign
            else
              assign credit_url = credit_url | append: '?utm_source=' | append: utm_source | append: '&utm_medium=' | append: utm_medium | append: '&utm_campaign=' | append: utm_campaign
            endif
          -%}
          <a href="{{ credit_url }}" class="credit-bar__link" target="{{ section.settings.credit_link_target }}" rel="noopener">
            {{ section.settings.credit_text }}
          </a>
        {%- else -%}
          <span class="credit-bar__name">{{ section.settings.credit_text }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  {%- if section.settings.show_scroll_to_top -%}
    <button
      class="credit-bar__scroll-top"
      type="button"
      aria-label="Scroll to top"
      style="
        --scroll-top-size: {{ section.settings.scroll_top_size }}px;
        --scroll-top-bg: {{ section.settings.scroll_top_bg }};
        --scroll-top-color: {{ section.settings.scroll_top_color }};
        --scroll-top-bottom: {{ section.settings.scroll_top_bottom }}px;
        --scroll-top-right: {{ section.settings.scroll_top_right }}px;
      "
    >
      {%- if section.settings.scroll_top_svg != blank -%}
        {{ section.settings.scroll_top_svg }}
      {%- else -%}
        {% render 'icon-chevron-up' %}
      {%- endif -%}
    </button>

    <script>
      (function () {
        const btn = document.querySelector('.credit-bar__scroll-top');
        if (!btn) return;

        window.addEventListener('scroll', function () {
          btn.classList.toggle('is-visible', window.scrollY > 300);
        });

        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Credit Bar",
  "tag": "section",
  "class": "credit-bar-section",
  "settings": [
    {
      "type": "select",
      "id": "container_type",
      "label": "Container Type",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Container Fluid"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#C61D23"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "info": "Leave blank to use the default shop name"
    },
    {
      "type": "text",
      "id": "credit_text",
      "label": "Credit Text",
      "default": "Madarth"
    },
    {
      "type": "url",
      "id": "credit_link",
      "label": "Credit Link"
    },
    {
      "type": "select",
      "id": "credit_link_target",
      "label": "Credit Link Target",
      "options": [
        {
          "value": "_blank",
          "label": "New Tab"
        },
        {
          "value": "_self",
          "label": "Same Tab"
        }
      ],
      "default": "_blank"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Font Weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "credit_gap",
      "label": "Credit Gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Scroll to Top"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_to_top",
      "label": "Show Scroll to Top Button",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_top_size",
      "label": "Button Size",
      "min": 30,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "html",
      "id": "scroll_top_svg",
      "label": "Custom Icon SVG Code",
      "info": "Paste SVG code for a custom icon. Leave blank to use the default chevron."
    },
    {
      "type": "color",
      "id": "scroll_top_bg",
      "label": "Button Background",
      "default": "#C61D23"
    },
    {
      "type": "color",
      "id": "scroll_top_color",
      "label": "Button Icon Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "scroll_top_bottom",
      "label": "Bottom Offset",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "scroll_top_right",
      "label": "Right Offset",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
