{% schema %}
{
  "name": "Highlight Features",
  "tag": "section",
  "class": "highlight-features",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG code",
          "info": "Paste the full raw SVG markup here (takes priority)"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (PNG, JPG, etc.)",
          "info": "Used only if no SVG code is provided"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Feature description text goes here."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Feature Highlights",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "True to Taste",
            "text": "Our sweets are crafted from age-old recipes handed down through generations.",
            "icon_svg": "<svg xmlns='http://www.w3.org/2000/svg' fill='#8b0000' viewBox='0 0 24 24' width='48' height='48'><circle cx='12' cy='12' r='10'/></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Freshness Guaranteed",
            "text": "Every sweet and snack is freshly made for unbeatable taste.",
            "icon_image": "shopify://shop_images/your-icon.png"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Order Online",
            "text": "Order from anywhere and get delicious sweets delivered to your home."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="highlight-features">
  <div class="highlight-features__wrapper">
    {% for block in section.blocks %}
      <div class="highlight-features__item">
        {% if block.settings.icon_svg != blank %}
          <div class="highlight-features__icon">
            {{ block.settings.icon_svg }}
          </div>
        {% elsif block.settings.icon_image != blank %}
          <img
            src="{{ block.settings.icon_image | image_url: width: 64, height: 64 }}"
            alt="{{ block.settings.title }}"
            width="64"
            height="64"
            class="highlight-features__icon-image"
          >
        {% endif %}
        <div class="highlight-features__content">
          <h3 class="highlight-features__title">{{ block.settings.title }}</h3>
          <p class="highlight-features__text">{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
