{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "main-cart",
  "settings": [],
  "presets": [
    {
      "name": "Cart contents"
    }
  ]
}
{% endschema %}

<div class="page-cart grid-box">
  <h1 class="page-title">Your Cart</h1>

  <div id="cart-container">
    {% if cart.item_count == 0 %}
      <p>Your cart is currently empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn" style="margin-top: 1rem;">Continue Shopping</a>
    {% else %}
      <div class="cart-container">
        <div class="cart-header">
          <div class="cart-col product-col">Product</div>
          <div class="cart-col price-col">Price</div>
          <div class="cart-col qty-col">Quantity</div>
          <div class="cart-col total-col">Total</div>
        </div>

        <div id="cart-items">
          {% for item in cart.items %}
            <div class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.variant_id }}">
              <div class="wrapper">
              <!-- Product Info -->
              <div class="cart-col product-col">
                <div class="product-info">
                  {% if item.image %}
                    <picture>
                      <source
                        srcset="{{ item.image | image_url: width: 95, height: 100, crop: 'center', format: 'avif' }}"
                        type="image/avif"
                      >
                      <source
                        srcset="{{ item.image | image_url: width: 95, height: 100, crop: 'center', format: 'webp' }}"
                        type="image/webp"
                      >
                      <img
                        src="{{ item.image | image_url: width: 95, height: 100, crop: 'center' }}"
                        alt="{{ item.title }}"
                        class="product-image"
                        width="95"
                        height="100"
                      >
                    </picture>
                  {% endif %}
                  <div class="product-text">
                    <div class="product-titleWrapper">
                      <a href="{{ item.url }}">
                        {{- item.product.title }}
                      </a>
                      <small>{{ item.variant.title }}</small>
                    </div>
                    <!-- Remove Button -->
                    <div class="remove-col"><span class="remove-btn">Remove</span></div>
                  </div>
                </div>
              </div>

              <!-- Price -->
              <div class="cart-col price-col unit-price">
                {{ item.original_price | money }}
              </div>

              <!-- Quantity Controls -->
              <div class="cart-col qty-col">
                <div class="qty-changer">
                  <button type="button" class="qty-btn qty-decrease">−</button>
                  <input type="text" class="cart-qty-input" value="{{ item.quantity }}" min="1">
                  <button type="button" class="qty-btn qty-increase">+</button>
                </div>
              </div>
            </div>
              <!-- Line Total -->
              <div class="cart-col total-col line-total">
                {{ item.line_price | money }}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-footer">
          <div class="cart-footer-subtotal">
          <p>
            <strong>Subtotal:</strong>
            <small>Tax included. Shipping calculated at checkout.</small>
          </p>
          <p>
             <span id="cart-subtotal">{{ cart.total_price | money }}</span>
          </p>
          </div>
          <div>
            <a href="{{ routes.checkout_url }}" class="cart-footer-checkout">Checkout</a>
            <a href="{{ routes.all_products_collection_url }}" class="cart-footer-continue">Continue Shopping</a>
          </div>
        </div>

      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function formatMoney(cents) {
      if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents);
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function updateCartUI(cart) {
      document.getElementById('cart-subtotal').innerHTML = formatMoney(cart.total_price);

      if (cart.item_count === 0) {
        document.getElementById('cart-container').innerHTML = `
          <p>Your cart is currently empty.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn" style="margin-top: 1rem;">Continue Shopping</a>
        `;
      }
    }

    // 🛠 Unbind existing events by replacing elements
    document.querySelectorAll('.qty-btn, .remove-btn').forEach((btn) => {
      btn.replaceWith(btn.cloneNode(true));
    });

    // 🔁 Re-select clean elements
    document.querySelectorAll('.qty-btn').forEach((btn) => {
      btn.addEventListener('click', function () {
        const row = this.closest('.cart-item');
        const input = row.querySelector('.cart-qty-input');
        const key = row.getAttribute('data-key');
        const decreaseBtn = row.querySelector('.qty-decrease');

        let qty = parseInt(input.value);

        if (this.classList.contains('qty-increase')) {
          qty += 1;
        } else if (this.classList.contains('qty-decrease') && qty > 1) {
          qty -= 1;
        }

        input.value = qty;

        if (qty <= 1) {
          decreaseBtn.classList.add('qty-disabled');
        } else {
          decreaseBtn.classList.remove('qty-disabled');
        }

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(key), quantity: qty }),
        })
          .then((res) => {
            if (!res.ok) throw new Error('Network response was not ok');
            return res.json();
          })
          .then((cart) => {
            const updatedItem = cart.items.find((i) => i.variant_id === Number(key));
            if (updatedItem) {
              row.querySelector('.line-total').innerHTML = formatMoney(updatedItem.line_price);
            }
            updateCartUI(cart);
          })
          .catch((err) => {
            console.error(err);
            alert('Failed to update quantity. Please refresh.');
          });
      });
    });

    document.querySelectorAll('.remove-btn').forEach((btn) => {
      btn.addEventListener('click', function () {
        const row = this.closest('.cart-item');
        const key = row.getAttribute('data-key');

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(key), quantity: 0 }),
        })
          .then((res) => {
            if (!res.ok) throw new Error('Network response was not ok');
            return res.json();
          })
          .then((cart) => {
            row.remove();
            updateCartUI(cart);
          })
          .catch((err) => {
            console.error(err);
            alert('Failed to remove item. Please refresh.');
          });
      });
    });

    // Disable minus button if quantity is 1
    document.querySelectorAll('.cart-qty-input').forEach((input) => {
      const row = input.closest('.cart-item');
      const minusBtn = row.querySelector('.qty-decrease');
      if (parseInt(input.value) <= 1) {
        minusBtn.classList.add('qty-disabled');
      }
    });
  });
</script>
