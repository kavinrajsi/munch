{% render 'breadcrumbs' %}

<div class="cart-page section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if cart.item_count > 0 -%}
      <h1>{{ 'cart.general.title' | t }} ({{ cart.item_count }})</h1>

      <form action="{{ routes.cart_url }}" method="post" data-cart-form>
        <table class="cart-page__table">
          <thead>
            <tr>
              <th colspan="2">{{ 'cart.items.product' | t }}</th>
              <th>{{ 'cart.items.price' | t }}</th>
              <th>{{ 'cart.items.quantity' | t }}</th>
              <th>{{ 'cart.items.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr data-cart-item data-line="{{ forloop.index }}">
                <td>
                  <a href="{{ item.url }}" class="cart-page__item-image">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" loading="lazy">
                    {%- endif -%}
                  </a>
                </td>
                <td>
                  <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                  {%- if item.variant.title != 'Default Title' -%}
                    <p class="cart-page__item-variant">{{ item.variant.title }}</p>
                  {%- endif -%}
                </td>
                <td class="cart-page__item-price">{{ item.original_price | money }}</td>
                <td>
                  <div class="cart-page__item-quantity">
                    <button type="button" data-qty-minus aria-label="{{ 'products.product.quantity.decrease' | t }}">−</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-qty-input aria-label="{{ 'products.product.quantity.label' | t }}">
                    <button type="button" data-qty-plus aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
                  </div>
                  <button type="button" class="cart-page__item-remove" data-remove-item>{{ 'cart.general.remove' | t }}</button>
                </td>
                <td class="cart-page__item-price">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-page__footer">
          {%- if section.settings.show_note -%}
            <div class="cart-page__note form-group">
              <label for="CartNote">{{ 'cart.general.note' | t }}</label>
              <textarea id="CartNote" name="note" placeholder="{{ 'cart.general.note_placeholder' | t }}">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-page__subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-page__shipping-note">{{ 'cart.general.taxes_and_shipping' | t }}</p>

          <div class="cart-page__actions">
            <button type="submit" name="checkout" class="btn btn--primary btn--full">{{ 'cart.general.checkout' | t }}</button>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost btn--full">{{ 'cart.general.continue_shopping' | t }}</a>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-page__empty">
        <h2>{{ 'cart.general.title' | t }}</h2>
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "class": "main-cart-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show Order Note",
      "default": true
    }
  ]
}
{% endschema %}
