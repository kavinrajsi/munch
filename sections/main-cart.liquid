<div class="cart section-padding">
  <div class="page-width">
    <h1>{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        <table class="cart__table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- unless item.variant.title == 'Default Title' -%}
                    <span>{{ item.variant.title }}</span>
                  {%- endunless -%}
                </td>
                <td>{{ item.price | money }}</td>
                <td>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}">
                </td>
                <td>{{ item.line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart__footer">
          <p class="cart__total">
            <strong>Total: {{ cart.total_price | money }}</strong>
          </p>
          <button type="submit" name="update" class="btn btn--secondary">Update cart</button>
          <button type="submit" name="checkout" class="btn btn--primary">Checkout</button>
        </div>
      </form>
    {%- else -%}
      <p>Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue shopping</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
