<div class="cart-page" style="--cart-pt-desktop: {{ section.settings.padding_top_desktop }}px; --cart-pb-desktop: {{ section.settings.padding_bottom_desktop }}px; --cart-pt-mobile: {{ section.settings.padding_top_mobile }}px; --cart-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;" {{ section.shopify_attributes }}>
  <div class="{{ section.settings.container_type }}">
    {%- comment -%} Section Heading {%- endcomment -%}
    {%- render 'section-heading',
      title: 'Shopping Cart' | t,
      heading_tag: 'h1',
      show_left_line: true,
      show_left_icon: true,
      show_right_icon: true,
      show_right_line: true,
      margin_bottom_desktop: 40,
      margin_bottom_mobile: 24
    -%}

    {%- comment -%} Breadcrumbs {%- endcomment -%}
    <nav class="cart-page__breadcrumbs cart-page__breadcrumbs--center" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
        <li aria-hidden="true">&gt;</li>
        <li aria-current="page">{{ 'cart.general.your_shopping_cart' | t }}</li>
      </ol>
    </nav>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" data-cart-form>
        {%- comment -%} Desktop Table {%- endcomment -%}
        <div class="cart-page__table-wrap">
          <table class="cart-page__table">
            <thead>
              <tr>
                <th class="cart-page__th cart-page__th--product">{{ 'cart.items.product' | t }}</th>
                <th class="cart-page__th cart-page__th--price">{{ 'cart.items.price' | t }}</th>
                <th class="cart-page__th cart-page__th--qty">{{ 'cart.items.quantity' | t }}</th>
                <th class="cart-page__th cart-page__th--total">{{ 'cart.items.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for item in cart.items -%}
                <tr class="cart-page__row" data-cart-item data-line="{{ forloop.index }}" data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 | at_most: 300 }}">
                  {%- comment -%} Product {%- endcomment -%}
                  <td class="cart-page__cell cart-page__cell--product">
                    <a href="{{ item.url }}" class="cart-page__product-img">
                      {%- if item.image -%}
                        <img
                          src="{{ item.image | image_url: width: 200 }}"
                          srcset="{{ item.image | image_url: width: 100 }} 100w, {{ item.image | image_url: width: 200 }} 200w"
                          sizes="95px"
                          alt="{{ item.title | escape }}"
                          width="95"
                          height="100"
                          loading="lazy"
                        >
                      {%- endif -%}
                    </a>
                    <div class="cart-page__product-info">
                      <a href="{{ item.url }}" class="cart-page__product-title">{{ item.product.title }}</a>
                      {%- if item.variant.title != 'Default Title' -%}
                        <p class="cart-page__product-variant">
                          {{ 'cart.general.weight' | t }} <span>{{ item.variant.title }}</span>
                        </p>
                      {%- endif -%}
                      <button type="button" class="cart-page__remove" data-remove-item>{{ 'cart.general.remove' | t }}</button>
                    </div>
                  </td>

                  {%- comment -%} Price {%- endcomment -%}
                  <td class="cart-page__cell cart-page__cell--price" data-label="{{ 'cart.items.price' | t }}">
                    {{ item.original_price | money }}
                  </td>

                  {%- comment -%} Quantity {%- endcomment -%}
                  <td class="cart-page__cell cart-page__cell--qty" data-label="{{ 'cart.items.quantity' | t }}">
                    <div class="cart-page__qty">
                      <button type="button" class="cart-page__qty-btn" data-qty-minus aria-label="{{ 'products.product.quantity.decrease' | t }}">−</button>
                      <input
                        type="number"
                        class="cart-page__qty-input"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        data-qty-input
                        aria-label="{{ 'products.product.quantity.label' | t }}"
                      >
                      <button type="button" class="cart-page__qty-btn" data-qty-plus aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
                    </div>
                  </td>

                  {%- comment -%} Total {%- endcomment -%}
                  <td class="cart-page__cell cart-page__cell--total" data-label="{{ 'cart.items.total' | t }}">
                    {{ item.final_line_price | money }}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        {%- comment -%} Mobile Cards {%- endcomment -%}
        <div class="cart-page__mobile-items">
          {%- for item in cart.items -%}
            <div class="cart-page__mobile-card" data-cart-item data-line="{{ forloop.index }}" data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 | at_most: 300 }}">
              <a href="{{ item.url }}" class="cart-page__mobile-img">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    srcset="{{ item.image | image_url: width: 100 }} 100w, {{ item.image | image_url: width: 200 }} 200w"
                    sizes="95px"
                    alt="{{ item.title | escape }}"
                    width="95"
                    height="100"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>
              <div class="cart-page__mobile-details">
                <a href="{{ item.url }}" class="cart-page__product-title">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <p class="cart-page__product-variant">
                    {{ 'cart.general.weight' | t }} <span>{{ item.variant.title }}</span>
                  </p>
                {%- endif -%}
                <p class="cart-page__mobile-price">{{ item.original_price | money }}</p>
                <div class="cart-page__mobile-bottom">
                  <div class="cart-page__qty">
                    <button type="button" class="cart-page__qty-btn" data-qty-minus aria-label="{{ 'products.product.quantity.decrease' | t }}">−</button>
                    <input
                      type="number"
                      class="cart-page__qty-input"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      data-qty-input
                      aria-label="{{ 'products.product.quantity.label' | t }}"
                    >
                    <button type="button" class="cart-page__qty-btn" data-qty-plus aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
                  </div>
                  <button type="button" class="cart-page__remove" data-remove-item>{{ 'cart.general.remove' | t }}</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Footer {%- endcomment -%}
        <div class="cart-page__footer">
          {%- if section.settings.show_note -%}
            <div class="cart-page__note">
              <label for="CartNote">{{ 'cart.general.note' | t }}</label>
              <textarea id="CartNote" name="note" placeholder="{{ 'cart.general.note_placeholder' | t }}">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-page__summary">
            <div class="cart-page__subtotal">
              <div class="cart-page__subtotal-label">
                <span>{{ 'cart.general.subtotal' | t }}</span>
                <span class="cart-page__tax-note">{{ 'cart.general.tax_included_shipping' | t }}</span>
              </div>
              <span class="cart-page__subtotal-amount">{{ cart.total_price | money }}</span>
            </div>
            <button type="submit" name="checkout" class="cart-page__checkout-btn">{{ 'cart.general.check_out' | t }}</button>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-page__empty">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="cart-page__checkout-btn">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "class": "main-cart-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show Order Note",
      "default": true
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
