{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "main-cart",
  "settings": [],
  "presets": [
    {
      "name": "Cart contents"
    }
  ]
}
{% endschema %}

<style>
  .qty-changer {
    display: flex;
    align-items: center;
  }

  .qty-changer button {
    padding: 0.3rem 0.6rem;
    font-size: 1rem;
    background: #eee;
    border: none;
    cursor: pointer;
  }

  .qty-changer input {
    width: 50px;
    text-align: center;
    margin: 0 5px;
  }

  .qty-disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
  }

  .remove-btn {
    display: inline-block;
    margin-top: 0.5rem;
    color: red;
    font-size: 0.9rem;
    cursor: pointer;
  }
</style>

<div class="cart-page" style="max-width: 800px; margin: 0 auto; padding: 2rem;">
  <h1>Your Cart</h1>

  <div id="cart-container">
    {% if cart.item_count == 0 %}
      <p>Your cart is currently empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn" style="margin-top: 1rem;">Continue Shopping</a>
    {% else %}
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem;">
        <thead>
          <tr>
            <th style="text-align: left;">Product</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="cart-items">
          {% for item in cart.items %}
            <tr class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.variant_id }}">
              <td>
                <a href="{{ item.url }}">
                  {% if item.image %}
                    <img
                      src="{{ item.image | image_url: width: 100, height: 100, crop: 'center' }}"
                      alt="{{ item.title }}"
                      width="50"
                      height="50"
                      style="width: 50px; margin-right: 10px; vertical-align: middle;"
                    >
                  {% endif %}
                  {{ item.product.title }}<br>
                  <small>{{ item.variant.title }}</small>
                </a>
              </td>
              <td class="unit-price">{{ item.original_price | money }}</td>
              <td>
                <div class="qty-changer">
                  <button type="button" class="qty-btn qty-decrease">−</button>
                  <input type="number" class="cart-qty-input" value="{{ item.quantity }}" min="1">
                  <button type="button" class="qty-btn qty-increase">+</button>
                </div>
              </td>
              <td class="line-total">{{ item.line_price | money }}</td>
              <td>
                <span class="remove-btn">Remove</span>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <p><strong>Subtotal:</strong> <span id="cart-subtotal">{{ cart.total_price | money }}</span></p>

      <div style="margin-top: 1rem;">
        <a href="{{ routes.all_products_collection_url }}" class="btn">Continue Shopping</a>
        <a href="{{ routes.checkout_url }}" class="btn" style="margin-left: 1rem;">Checkout</a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function formatMoney(cents) {
      if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents);
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function updateCartUI(cart) {
      document.getElementById('cart-subtotal').innerHTML = formatMoney(cart.total_price);

      if (cart.item_count === 0) {
        document.getElementById('cart-container').innerHTML = `
          <p>Your cart is currently empty.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn" style="margin-top: 1rem;">Continue Shopping</a>
        `;
      }
    }

    // 🛠 Unbind existing events by replacing elements
    document.querySelectorAll('.qty-btn, .remove-btn').forEach(btn => {
      btn.replaceWith(btn.cloneNode(true));
    });

    // 🔁 Re-select clean elements
    document.querySelectorAll('.qty-btn').forEach(btn => {
      btn.addEventListener('click', function () {
        const row = this.closest('.cart-item');
        const input = row.querySelector('.cart-qty-input');
        const key = row.getAttribute('data-key');
        const decreaseBtn = row.querySelector('.qty-decrease');

        let qty = parseInt(input.value);

        if (this.classList.contains('qty-increase')) {
          qty += 1;
        } else if (this.classList.contains('qty-decrease') && qty > 1) {
          qty -= 1;
        }

        input.value = qty;

        if (qty <= 1) {
          decreaseBtn.classList.add('qty-disabled');
        } else {
          decreaseBtn.classList.remove('qty-disabled');
        }

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(key), quantity: qty })
        })
        .then(res => {
          if (!res.ok) throw new Error('Network response was not ok');
          return res.json();
        })
        .then(cart => {
          const updatedItem = cart.items.find(i => i.variant_id === Number(key));
          if (updatedItem) {
            row.querySelector('.line-total').innerHTML = formatMoney(updatedItem.line_price);
          }
          updateCartUI(cart);
        })
        .catch(err => {
          console.error(err);
          alert('Failed to update quantity. Please refresh.');
        });
      });
    });

    document.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', function () {
        const row = this.closest('.cart-item');
        const key = row.getAttribute('data-key');

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(key), quantity: 0 })
        })
        .then(res => {
          if (!res.ok) throw new Error('Network response was not ok');
          return res.json();
        })
        .then(cart => {
          row.remove();
          updateCartUI(cart);
        })
        .catch(err => {
          console.error(err);
          alert('Failed to remove item. Please refresh.');
        });
      });
    });

    // Disable minus button if quantity is 1
    document.querySelectorAll('.cart-qty-input').forEach(input => {
      const row = input.closest('.cart-item');
      const minusBtn = row.querySelector('.qty-decrease');
      if (parseInt(input.value) <= 1) {
        minusBtn.classList.add('qty-disabled');
      }
    });
  });
</script>
