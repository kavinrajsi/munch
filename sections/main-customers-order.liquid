<div class="customer-order section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="customer-order__header">
      <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
      <p>{{ 'customer.order.date' | t: date: order.created_at | date: '%B %d, %Y' }}</p>
    </div>

    {%- if order.cancelled -%}
      <div class="customer-order__cancelled">
        {{ 'customer.order.cancelled' | t: date: order.cancelled_at | date: '%B %d, %Y' }}
        <br>
        {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
      </div>
    {%- endif -%}

    <table class="customer-order__table">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.sku' | t }}</th>
          <th>{{ 'customer.order.price' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {%- if line_item.image -%}
                <span class="customer-order__item-image">
                  <img src="{{ line_item.image | image_url: width: 96 }}" alt="{{ line_item.title | escape }}" loading="lazy">
                </span>
              {%- endif -%}
              <a href="{{ line_item.product.url }}">{{ line_item.title }}</a>
              {%- if line_item.fulfillment -%}
                <div class="customer-order__fulfillment-info">
                  {{ 'customer.order.fulfilled_at' | t: date: line_item.fulfillment.created_at | date: '%B %d, %Y' }}
                  {%- if line_item.fulfillment.tracking_url -%}
                    — <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track_shipment' | t }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </td>
            <td>{{ line_item.sku | default: '-' }}</td>
            <td>{{ line_item.original_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div class="customer-order__totals">
      <div class="customer-order__totals-row">
        <span>{{ 'customer.order.subtotal' | t }}</span>
        <span>{{ order.line_items_subtotal_price | money }}</span>
      </div>
      {%- for discount_application in order.discount_applications -%}
        <div class="customer-order__totals-row">
          <span>{{ 'customer.order.discount' | t }} ({{ discount_application.title }})</span>
          <span>-{{ discount_application.total_allocated_amount | money }}</span>
        </div>
      {%- endfor -%}
      {%- for shipping_method in order.shipping_methods -%}
        <div class="customer-order__totals-row">
          <span>{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</span>
          <span>{{ shipping_method.price | money }}</span>
        </div>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <div class="customer-order__totals-row">
          <span>{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
          <span>{{ tax_line.price | money }}</span>
        </div>
      {%- endfor -%}
      <div class="customer-order__totals-row">
        <span>{{ 'customer.order.total' | t }}</span>
        <span>{{ order.total_price | money }}</span>
      </div>
    </div>

    <div class="customer-order__addresses">
      <div>
        <h3>{{ 'customer.order.billing_address' | t }}</h3>
        <p>{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        <p>{{ order.billing_address | format_address }}</p>
      </div>
      <div>
        <h3>{{ 'customer.order.shipping_address' | t }}</h3>
        <p>{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        <p>{{ order.shipping_address | format_address }}</p>
      </div>
    </div>

    <div class="customer-order__back">
      <a href="{{ routes.account_url }}" class="btn btn--ghost">← {{ 'customer.account.return' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Order",
  "tag": "section",
  "class": "main-customers-order-section",
  "settings": []
}
{% endschema %}
