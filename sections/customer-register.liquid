{% schema %}
{
  "name": "Customer Register",
  "tag": "section",
  "class": "customer-register",
  "settings": [],
  "presets": [
    {
      "name": "Register Form"
    }
  ]
}
{% endschema %}

<section style="max-width: 500px; margin: 0 auto; padding: 2rem;">
  <h1>Create Account</h1>

  {% form 'create_customer' %}
    {% if form.errors %}
      <div style="color: red;">
        <ul>
          {% for field in form.errors %}
            <li>{{ field | capitalize }}: {{ form.errors.messages[field] }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <label for="RegisterFirstName">First Name</label>
    <input type="text" name="customer[first_name]" id="RegisterFirstName" required>

    <label for="RegisterLastName">Last Name</label>
    <input type="text" name="customer[last_name]" id="RegisterLastName" required>

    <label for="RegisterEmail">Email</label>
    <input type="email" name="customer[email]" id="RegisterEmail" required>

    <label for="RegisterPassword">Password</label>
    <input type="password" name="customer[password]" id="RegisterPassword" required>

    <button type="submit" class="btn">Create Account</button>
  {% endform %}

  <p style="margin-top: 1rem;">
    Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a>
  </p>
</section>
