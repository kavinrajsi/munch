{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image",
      "info": "Recommended: apply border-radius directly to the image design if needed."
    },
    {
      "type": "image_picker",
      "id": "image_tablet",
      "label": "Tablet Image",
      "info": "Recommended: apply border-radius directly to the image design if needed."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image",
      "info": "Recommended: apply border-radius directly to the image design if needed."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop our latest collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

{%- comment -%}
NOTE for developer: For border radius, please add it directly to the image. Sorry for not using CSS.
{%- endcomment -%}

<div class="hero">
  {% if section.settings.link %}
    <a href="{{ section.settings.link }}">
  {% endif %}

  <picture>
    {% if section.settings.image_mobile %}
      <source
        media="(max-width: 767px)"
        srcset="{{ section.settings.image_mobile | image_url: width: 768 }}"
        width="{{ section.settings.image_mobile.width }}"
        height="{{ section.settings.image_mobile.height }}">
    {% endif %}
    {% if section.settings.image_tablet %}
      <source
        media="(max-width: 1024px)"
        srcset="{{ section.settings.image_tablet | image_url: width: 1024 }}"
        width="{{ section.settings.image_tablet.width }}"
        height="{{ section.settings.image_tablet.height }}">
    {% endif %}
    {% if section.settings.image_desktop %}
      <img
        src="{{ section.settings.image_desktop | image_url: width: 1600 }}"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image_desktop.width }}"
        height="{{ section.settings.image_desktop.height }}"
        loading="eager"
        fetchpriority="high"
        style="width: 100%; height: auto; display: block;">
    {% endif %}
  </picture>

  {% if section.settings.link %}
    </a>
  {% endif %}

  <div class="hero-content" style="text-align: center; margin-top: 2rem;">
    {% if section.settings.heading %}
      <h1>{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_link and section.settings.button_label %}
      <a href="{{ section.settings.button_link }}" class="btn" style="margin-top: 1rem;">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>
