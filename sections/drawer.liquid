            </svg>
          </button>
        </div>

        <div class="drawer__content" id="cart__drawer">
          <div class="cart-item-no" id="cart-item-empty" hidden>
            Your shopping bag is empty.
          </div>
          <div class="cartpopup-body cart__drawer_items" id="cart__drawer_items"></div>
        </div>

        <div class="drawer__footer">
          <div class="cartpopup-total">
            <span>Subtotal</span>
            <span class="price "  id="cart__total_price">Rs. 0.00</span>
            {% comment %} <span class="price" id="">Rs. 0.00</span> {% endcomment %}
          </div>
          <div class="cartpopup-buttons">
            <button class="button-solid" type="submit" name="checkout">Check Out</button>
            <a class="button-outline" href="{{ routes.cart_url }}">View Cart</a>
          </div>
        </div>
      </form>
    </div>
  </section>

  <div id="loader" style="display: none;">
    <div class="spinner"></div>
  </div>
