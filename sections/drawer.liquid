<section class="drawer" id="drawer-name" data-drawer-target>
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__wrapper">
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="drawer__header">
        <div class="drawer__title">Cart</div>
        <button class="drawer__close" data-drawer-close aria-label="Close Drawer"></button>
      </div>

      <div class="drawer__content" id="cart__drawer">
        <div
          class="cart-item-no"
          {% if cart.item_count > 0 %}
            hidden
          {% endif %}
        >
          Your shopping bag is empty.
        </div>

        <div class="cartpopup-body" id="cart__drawer_items">
          {% for item in cart.items %}
            <div class="cart-item" data-variant-id="{{ item.variant_id }}">
              <div class="cart-item__details">
                <p class="cart-item__title">{{ item.product.title }}</p>
                <p class="cart-item__variant">{{ item.variant.title }}</p>
                <p class="cart-item__price">{{ item.line_price | money }}</p>
              </div>

              <div class="cart-item__qty">
                <button type="button" class="qty-btn qty-decrease" data-variant-id="{{ item.variant_id }}">−</button>
                <input
                  type="number"
                  name="updates[]"
                  class="cart-qty-input"
                  value="{{ item.quantity }}"
                  min="1"
                  data-variant-id="{{ item.variant_id }}"
                  aria-label="Item quantity"
                >
                <button type="button" class="qty-btn qty-increase" data-variant-id="{{ item.variant_id }}">+</button>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="drawer__footer">
        <p>Shipping & taxes calculated at checkout</p>
        <br>
        <div class="cartpopup-total">
          <span>Total</span>
          <span class="price" data-hulkapps-cart-total class="cart__total-price">
            {{ cart.total_price | money }}
          </span>
        </div>
        <div class="cartpopup-buttons">
          <a class="button button-outline-maroon" href="{{ routes.cart_url }}">Your Cart</a>
          <button class="button button-solid-maroon" type="submit" name="checkout">PROCEED TO CHECKOUT</button>
        </div>
      </div>
    </form>
  </div>
</section>
