<div class="blog-post-grid" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="blog-post-grid__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="blog-post-grid__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="blog-post-grid__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="blog-post-grid__grid"
    style="--blog-grid-columns: {{ section.settings.columns_desktop }}; --blog-grid-columns-mobile: {{ section.settings.columns_mobile }};"
  >
    {%- if section.settings.blog != blank -%}
      {%- for article in section.settings.blog.articles limit: section.settings.posts_to_show -%}
        <article class="blog-post-grid__item">
          <a href="{{ article.url }}" class="blog-post-grid__link">
            {%- if article.image != blank -%}
              <div class="blog-post-grid__image-wrapper">
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  srcset="
                    {{ article.image | image_url: width: 300 }} 300w,
                    {{ article.image | image_url: width: 400 }} 400w,
                    {{ article.image | image_url: width: 600 }} 600w
                  "
                  sizes="(max-width: 749px) calc(100vw / {{ section.settings.columns_mobile }}), calc(100vw / {{ section.settings.columns_desktop }})"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              </div>
            {%- else -%}
              <div class="blog-post-grid__image-wrapper">
                {{ 'image' | placeholder_svg_tag: 'blog-post-grid__placeholder' }}
              </div>
            {%- endif -%}

            <div class="blog-post-grid__content">
              {%- if section.settings.show_date or section.settings.show_author -%}
                <div class="blog-post-grid__meta">
                  {%- if section.settings.show_date -%}
                    <span class="blog-post-grid__date">{{ article.published_at | date: '%b %d, %Y' }}</span>
                  {%- endif -%}
                  {%- if section.settings.show_author -%}
                    <span class="blog-post-grid__author">{{ article.author }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <h3 class="blog-post-grid__title">{{ article.title }}</h3>

              {%- if section.settings.show_excerpt and article.excerpt != blank -%}
                <p class="blog-post-grid__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {%- endif -%}

              {%- if section.settings.show_read_more -%}
                <span class="blog-post-grid__read-more">{{ section.settings.read_more_label }}</span>
              {%- endif -%}
            </div>
          </a>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.posts_to_show) -%}
        <article class="blog-post-grid__item blog-post-grid__item--placeholder">
          <div class="blog-post-grid__image-wrapper">
            {{ 'image' | placeholder_svg_tag: 'blog-post-grid__placeholder' }}
          </div>
          <div class="blog-post-grid__content">
            <div class="blog-post-grid__meta">
              <span class="blog-post-grid__date">Jan 01, 2025</span>
            </div>
            <h3 class="blog-post-grid__title">Blog post title</h3>
            <p class="blog-post-grid__excerpt">Add a short description for your blog post here.</p>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and section.settings.blog != blank -%}
    <div class="blog-post-grid__footer">
      <a
        href="{{ section.settings.blog.url }}"
        class="btn btn--secondary"
      >
        {{ section.settings.view_all_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Blog post: Grid",
  "tag": "section",
  "class": "blog-post-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From our blog"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Posts to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Post details"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show read more link",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all posts"
    }
  ],
  "presets": [
    {
      "name": "Blog post: Grid",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
