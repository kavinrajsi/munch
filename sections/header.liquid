<header class="header{% if section.settings.sticky %} header--sticky{% endif %}" data-header {{ section.shopify_attributes }}>
  <div class="{% if section.settings.container_type == 'container-fluid' %}container-fluid{% else %}container{% endif %}">
    <div class="header__inner">
      {%- comment -%} Mobile menu toggle {%- endcomment -%}
      <button class="header__icon header__menu-toggle" data-mobile-menu-toggle aria-label="{{ 'sections.header.menu' | t }}" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      {%- comment -%} Logo {%- endcomment -%}
      <div class="header__logo" style="--logo-width: {{ section.settings.logo_width }}px; --logo-width-mobile: {{ section.settings.logo_width_mobile }}px;">
        <a href="{{ routes.root_url }}" class="header__logo-link">
          {%- if section.settings.logo_type == 'image' and section.settings.logo -%}
            <img
              class="header__logo-img"
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              loading="eager"
            >
          {%- elsif section.settings.logo_type == 'svg' and section.settings.logo_svg != blank -%}
            <div class="header__logo-svg">
              {{ section.settings.logo_svg }}
            </div>
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      {%- comment -%} Desktop Navigation {%- endcomment -%}
      <nav class="header__nav" aria-label="Main navigation">
        {%- for link in section.settings.menu.links -%}
          <div class="header__nav-item">
            <a href="{{ link.url }}" class="header__nav-link{% if link.active %} header__nav-link--active{% endif %}">
              {{- link.title -}}
              {%- if link.links.size > 0 -%}
                <svg class="header__nav-chevron" width="10" height="9" viewBox="0 0 10 9" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M0.112982 4.1049C0.148705 4.07165 0.191143 4.04527 0.237865 4.02727C0.284586 4.00927 0.334673 4 0.385258 4C0.435842 4 0.485929 4.00927 0.532651 4.02727C0.579373 4.04527 0.62181 4.07165 0.657534 4.1049L5.0001 8.13744L9.34267 4.1049C9.37842 4.0717 9.42087 4.04537 9.46759 4.0274C9.51431 4.00943 9.56438 4.00019 9.61494 4.00019C9.66551 4.00019 9.71558 4.00943 9.7623 4.0274C9.80902 4.04537 9.85146 4.0717 9.88722 4.1049C9.92298 4.13809 9.95134 4.17751 9.97069 4.22088C9.99004 4.26425 10 4.31074 10 4.35769C10 4.40464 9.99004 4.45113 9.97069 4.4945C9.95134 4.53787 9.92298 4.57729 9.88722 4.61048L5.27238 8.8951C5.23665 8.92835 5.19422 8.95473 5.14749 8.97273C5.10077 8.99073 5.05068 9 5.0001 9C4.94952 9 4.89943 8.99073 4.85271 8.97273C4.80599 8.95473 4.76355 8.92835 4.72783 8.8951L0.112982 4.61048C0.0771683 4.57732 0.0487541 4.53791 0.0293668 4.49454C0.00997949 4.45116 0 4.40465 0 4.35769C0 4.31073 0.00997949 4.26422 0.0293668 4.22084C0.0487541 4.17747 0.0771683 4.13806 0.112982 4.1049Z" fill="currentColor"/></svg>
              {%- endif -%}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="header__dropdown">
                <a href="{{ link.url }}" class="header__dropdown-link header__dropdown-link--primary">{{ 'sections.header.shop_all' | t }}</a>
                {%- for child_link in link.links -%}
                  <a href="{{ child_link.url }}" class="header__dropdown-link">{{ child_link.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>

      {%- comment -%} Icon bar {%- endcomment -%}
      <div class="header__icons">
        {%- if section.settings.show_search -%}
          <button class="header__icon" data-search-toggle aria-label="{{ 'sections.header.search' | t }}" type="button">
            {%- if section.settings.search_icon_svg != blank -%}
              {{ section.settings.search_icon_svg }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            {%- endif -%}
          </button>
        {%- endif -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon" aria-label="{{ 'sections.header.account' | t }}">
            {%- if section.settings.account_icon_svg != blank -%}
              {{ section.settings.account_icon_svg }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          <button class="header__icon" data-cart-toggle aria-label="{{ 'sections.header.cart' | t }} ({{ cart.item_count }})" type="button">
            {%- if section.settings.cart_icon_svg != blank -%}
              {{ section.settings.cart_icon_svg }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            {%- endif -%}
            {%- if cart.item_count > 0 -%}
              <span class="header__cart-count" data-cart-count-badge>{{ cart.item_count }}</span>
            {%- endif -%}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

{%- comment -%} Mobile Menu {%- endcomment -%}
<div class="mobile-menu" id="MobileMenu" data-mobile-menu>
  <div class="mobile-menu__overlay" data-mobile-menu-close></div>
  <div class="mobile-menu__panel">

    {%- comment -%} Header with logo + close {%- endcomment -%}
    <div class="mobile-menu__header">
      <div class="mobile-menu__logo">
        <a href="{{ routes.root_url }}" class="header__logo-link">
          {%- if section.settings.logo_type == 'image' and section.settings.logo -%}
            <img
              class="header__logo-img"
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              loading="lazy"
              style="max-width: var(--logo-width-mobile, 100px);"
            >
          {%- elsif section.settings.logo_type == 'svg' and section.settings.logo_svg != blank -%}
            <div class="header__logo-svg" style="max-width: var(--logo-width-mobile, 100px);">
              {{ section.settings.logo_svg }}
            </div>
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
      <button class="mobile-menu__close" data-mobile-menu-close aria-label="{{ 'accessibility.close' | t }}" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    {%- comment -%} Main navigation {%- endcomment -%}
    <nav class="mobile-menu__nav">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="mobile-menu__nav-item mobile-menu__nav-item--has-children">
            <button type="button" class="mobile-menu__nav-link" data-mobile-submenu-trigger>
              {{ link.title }}
              <svg class="mobile-menu__chevron" width="10" height="16" viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="2 2 8 8 2 14"/>
              </svg>
            </button>

            {%- comment -%} Level 2 submenu {%- endcomment -%}
            <div class="mobile-menu__submenu" data-mobile-submenu>
              <div class="mobile-menu__submenu-header">
                <button type="button" class="mobile-menu__back" data-mobile-back>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                  {{ link.title }}
                </button>
              </div>
              <div class="mobile-menu__submenu-body">
                {%- for child_link in link.links -%}
                  {%- if child_link.links.size > 0 -%}
                    <div class="mobile-menu__nav-item mobile-menu__nav-item--has-children">
                      <button type="button" class="mobile-menu__submenu-link" data-mobile-submenu-trigger>
                        {{ child_link.title }}
                        <svg class="mobile-menu__chevron" width="10" height="16" viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="2 2 8 8 2 14"/>
                        </svg>
                      </button>

                      {%- comment -%} Level 3 submenu {%- endcomment -%}
                      <div class="mobile-menu__submenu" data-mobile-submenu>
                        <div class="mobile-menu__submenu-header">
                          <button type="button" class="mobile-menu__back" data-mobile-back>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="15 18 9 12 15 6"/>
                            </svg>
                            {{ child_link.title }}
                          </button>
                        </div>
                        <div class="mobile-menu__submenu-body">
                          {%- for grandchild_link in child_link.links -%}
                            <a href="{{ grandchild_link.url }}" class="mobile-menu__submenu-link">{{ grandchild_link.title }}</a>
                          {%- endfor -%}
                        </div>
                      </div>
                    </div>
                  {%- else -%}
                    <a href="{{ child_link.url }}" class="mobile-menu__submenu-link">{{ child_link.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="mobile-menu__nav-item">
            <a href="{{ link.url }}" class="mobile-menu__nav-link">{{ link.title }}</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} Account section at bottom {%- endcomment -%}
    {%- if shop.customer_accounts_enabled -%}
      <div class="mobile-menu__account">
        <h3 class="mobile-menu__account-title">My Account</h3>
        {%- if customer -%}
          <a href="{{ routes.account_url }}" class="mobile-menu__account-btn btn btn--primary btn--full">My Account</a>
          <a href="{{ routes.account_logout_url }}" class="mobile-menu__account-btn btn btn--ghost btn--full">Log out</a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}" class="mobile-menu__account-btn btn btn--primary btn--full">Log in</a>
          <a href="{{ routes.account_register_url }}" class="mobile-menu__account-btn btn btn--ghost btn--full">Register</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

{%- if section.settings.sticky -%}
<script>
  (function () {
    var header = document.querySelector('[data-header]');
    if (!header) return;

    var lastScroll = 0;
    var customThreshold = {{ section.settings.sticky_threshold }};
    var threshold = customThreshold > 0 ? customThreshold : window.innerHeight;

    window.addEventListener('scroll', function () {
      var currentScroll = window.scrollY;

      if (currentScroll > threshold) {
        header.classList.add('header--fixed');

        if (currentScroll < lastScroll) {
          header.classList.add('header--visible');
        } else {
          header.classList.remove('header--visible');
        }
      } else {
        header.classList.remove('header--fixed', 'header--visible');
      }

      lastScroll = currentScroll;
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "header-section",
  "settings": [
    {
      "type": "select",
      "id": "container_type",
      "label": "Container Type",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Container Fluid"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_type",
      "label": "Logo Type",
      "options": [
        {
          "value": "text",
          "label": "Store Name"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "svg",
          "label": "SVG Code"
        }
      ],
      "default": "svg"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "textarea",
      "id": "logo_svg",
      "label": "Logo SVG Code"
    },
    {
      "type": "header",
      "content": "Logo Width"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Mobile",
      "min": 30,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky Header",
      "default": true
    },
    {
      "type": "range",
      "id": "sticky_threshold",
      "label": "Show sticky after (px)",
      "info": "0 = use viewport height",
      "min": 0,
      "max": 2000,
      "step": 50,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search",
      "default": true
    },
    {
      "type": "html",
      "id": "search_icon_svg",
      "label": "Search Icon SVG",
      "info": "Leave blank to use default icon"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "html",
      "id": "account_icon_svg",
      "label": "Account Icon SVG",
      "info": "Leave blank to use default icon"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    },
    {
      "type": "html",
      "id": "cart_icon_svg",
      "label": "Cart Icon SVG",
      "info": "Leave blank to use default icon"
    }
  ]
}
{% endschema %}
