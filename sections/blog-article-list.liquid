<section class="grid-box blog-feed">
  {% if section.settings.blog.articles.size > 0 %}
    <h2 class="blog-feed--title">Blog</h2>
    <ul class="blog-feed--lists">
      {% for article in section.settings.blog.articles limit: section.settings.articles_limit %}
        <li class="blog-feed--list">
          <div class="blog-feed--blog__image">
            <a href="{{ article.url }}">
              {% if article.image %}
                <picture>
                  <source
                    srcset="{{ article.image | image_url: width: 360, height: 320, format: 'pjpg' }}"
                    type="image/pjpg"
                  >
                  <source
                    srcset="{{ article.image | image_url: width: 360, height: 320, format: 'webp' }}"
                    type="image/webp"
                  >
                  <img
                    src="{{ article.image | image_url: width: 360, height: 320 }}"
                    alt="{{ article.title | escape }}"
                    width="360"
                    height="320"
                    loading="lazy"
                  >
                </picture>
                <noscript>
                  <p>
                    {{ article.image | image_url: width: 455, height: 300, scale: 2 | image_tag: article.title }}
                  </p>
                </noscript>
              {% endif %}
            </a>
          </div>
          <h2 class="blog-feed--blog__title">
            <a href="{{ article.url }}">
              {{ article.title }}
            </a>
          </h2>

          {% comment %}
            {% if section.settings.blog_show_author %}
              <span class="blog-feed--blog__author">By {{ article.author }}</span>
            {% endif %}
          {% endcomment %}

          {% if section.settings.blog_show_date %}
            <span class="blog-feed--blog__date"> {{ article.published_at | time_tag: '%B %d, %Y' }}</span>
          {% endif %}

          {% comment %}
            <p class="blog-feed--blog__content">
              {% if article.excerpt.size > 0 %}
                {{ article.excerpt }}
              {% else %}
                {{ article.content | strip_html | truncate: 150 }}
              {% endif %}
            </p>
          {% endcomment %}

          {% comment %}
            {% if article.tags.size > 0 %}
              <ul>
                <li>
                  {{ 'blogs.article.posted_in' }}
                  {% for tag in article.tags %}
                    <a href="{{ section.settings.blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
                    {%- unless forloop.last %}, {% endunless %}
                  {% endfor %}
                </li>
              </ul>
            {% endif %}
          {% endcomment %}

          {% comment %}
            <ul>
              <li>
                <a href="{{ article.url }}" aria-label="Read more: {{ article.title }}">Read more</a>
              </li>
              {% if section.settings.blog.comments_enabled? and article.comments_count > 0 %}
                <li>
                  <a href="{{ article.url }}#comments">
                    {{ article.comments_count }}
                  </a>
                </li>
              {% endif %}
            </ul>
          {% endcomment %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No blog articles found.</p>
  {% endif %}
</section>
{% schema %}
{
  "name": "Blog Articles",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "blog_show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "articles_limit",
      "label": "Number of articles to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Blog Articles",
      "category": "Blog"
    }
  ]
}
{% endschema %}
