{% if section.settings.blog.articles.size > 0 %}
  <h1>{{ section.settings.blog.title }}</h1>
  <ul>
    {% for article in section.settings.blog.articles limit: section.settings.articles_limit %}
      <li>
        <h2>
          <a href="{{ article.url }}">
            {% if article.image %}
              <img src="{{ article.image | img_url: '300x300' }}" alt="{{ article.title | escape }}">
              <noscript>
                <p>
                  {{ article | img_url: '455x300', scale: 2 | img_tag: article.title }}
                </p>
              </noscript>
            {% endif %}
            {{ article.title }}
          </a>
        </h2>

        {% if section.settings.blog_show_author %}
          <span>By {{ article.author }}</span>
        {% endif %}

        {% if section.settings.blog_show_date %}
          <span>{{ article.published_at | time_tag: '%B %d, %Y' }}</span>
        {% endif %}

        <p>
          {% if article.excerpt.size > 0 %}
            {{ article.excerpt }}
          {% else %}
            {{ article.content | strip_html | truncate: 150 }}
          {% endif %}
        </p>

        {% if article.tags.size > 0 %}
          <ul>
            <li>
              {{ 'blogs.article.posted_in' }}
              {% for tag in article.tags %}
                <a href="{{ section.settings.blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
              {% endfor %}
            </li>
          </ul>
        {% endif %}

        <ul>
          <li>
            <a href="{{ article.url }}" aria-label="Read more: {{ article.title }}">Read more</a>
          </li>
          {% if section.settings.blog.comments_enabled? and article.comments_count > 0 %}
            <li>
              <a href="{{ article.url }}#comments">
                {{ article.comments_count }}
              </a>
            </li>
          {% endif %}
        </ul>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p>No blog articles found.</p>
{% endif %}

{% schema %}
{
  "name": "Blog Articles",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "blog_show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "articles_limit",
      "label": "Number of articles to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Blog Articles",
      "category": "Blog"
    }
  ]
}
{% endschema %}
