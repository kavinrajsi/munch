{%- style -%}
  .faq {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 750px) {
    .faq {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="faq color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div>
        {%- render 'section-heading',
          title: section.settings.title,
          heading_tag: 'h2',
          show_left_line: true,
          show_left_icon: true,
          show_right_icon: true,
          show_right_line: true
        -%}
      </div>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="faq-description rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    <div class="faq-list">
      {%- for block in section.blocks -%}
        <div class="faq-item" data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 50 }}" {{ block.shopify_attributes }}>
          <button class="faq-item__trigger" type="button" data-faq-trigger>
            {{ block.settings.question }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-item__content" data-faq-content>
            <div class="rte">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | strip_html | json }}
                }
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    var section = document.querySelector('[{{ section.shopify_attributes }}]');
    if (!section) return;
    section.querySelectorAll('[data-faq-trigger]').forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        this.classList.toggle('is-active');
        var content = this.nextElementSibling;
        if (content) content.classList.toggle('is-open');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We accept returns within 7 days of delivery. Please contact our support team for assistance.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "category": "Informational",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What are your delivery timings?",
            "answer": "<p>We deliver fresh sweets and snacks across India. Orders placed before 2 PM are dispatched the same day. Delivery typically takes 2–5 business days depending on your location.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do you ensure freshness?",
            "answer": "<p>All our sweets and snacks are prepared fresh and packed in food-grade, airtight packaging to ensure they reach you in perfect condition.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer bulk or corporate orders?",
            "answer": "<p>Yes! We offer special pricing for bulk and corporate orders, especially during festive seasons. Please reach out to us through our contact page for a custom quote.</p>"
          }
        }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
