<div
  class="promo-banner"
  style="
    --pb-bg: {{ section.settings.bg_color }};
    --pb-pt-desktop: {{ section.settings.padding_top_desktop }}px;
    --pb-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --pb-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    {%- if section.settings.pattern_image != blank -%}
      --pb-pattern: url('{{ section.settings.pattern_image | image_url: width: 600 }}');
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>

  <div class="container">
    <div class="promo-banner__inner">
      <div class="promo-banner__content" data-animate="fade-right">
        {%- if section.settings.heading != blank -%}
          <h2 class="promo-banner__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="promo-banner__description">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="promo-banner__btn"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="promo-banner__media" data-animate="fade-left" data-animate-delay="200">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image
            | image_url: width: 1100
            | image_tag:
                widths: '375, 550, 750, 1100',
                sizes: '(min-width: 750px) 50vw, 100vw',
                loading: 'lazy',
                class: 'promo-banner__image',
                alt: section.settings.heading | escape
          }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'promo-banner__placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "promo-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sweets for Every Celebration"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From festive gatherings to family functions, every moment deserves something sweet. Our traditional recipes bring authentic taste to your celebrations."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "pattern_image",
      "label": "Background pattern"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#C61D23"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
