<div class="search section-padding">
  <div class="page-width">
    <h1>{{ 'general.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search">
      <div class="field">
        <input
          class="field__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p>{{ search.results_count }} results for "{{ search.terms }}"</p>
        <div class="search__results">
          {%- for result in search.results -%}
            <div class="search__item">
              <h3><a href="{{ result.url }}">{{ result.title }}</a></h3>
              <p>{{ result.content | strip_html | truncatewords: 30 }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>No results found for "{{ search.terms }}".</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": []
}
{% endschema %}
