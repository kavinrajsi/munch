<div class="video-list section-padding" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="video-list__header">
      {%- if section.settings.title != blank -%}
        <h2>{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p style="color:var(--color-secondary);margin-top:8px;">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="video-list__grid">
      {%- for block in section.blocks -%}
        {% render 'video-card', block: block %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video List",
  "tag": "section",
  "class": "video-list-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Watch Our Videos"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Video Title"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Custom Thumbnail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video List",
      "category": "Storytelling",
      "blocks": [
        { "type": "video", "settings": { "title": "Our Story" } },
        { "type": "video", "settings": { "title": "Making of Mysore Pak" } },
        { "type": "video", "settings": { "title": "Festival Specials" } }
      ]
    }
  ],
  "max_blocks": 9
}
{% endschema %}
