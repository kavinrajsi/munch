<div class="blog-list section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="blog-list__header">
      {%- if section.settings.title != blank -%}
        <h2 class="blog-list__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="blog-list__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="blog-list__grid">
      {%- if section.settings.blog != blank -%}
        {%- for article in section.settings.blog.articles limit: section.settings.articles_to_show -%}
          <div data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 100 }}">
            {% render 'blog-card', article: article %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="blog-card">
            <div class="blog-card__image">{{ 'image' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="blog-card__meta"><span class="blog-card__date">Jan 01, 2025</span></div>
            <h3 class="blog-card__title">Sample Blog Post {{ i }}</h3>
            <p class="blog-card__excerpt">This is a sample blog post excerpt to show what the blog card looks like.</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.blog != blank -%}
      <div class="blog-list__view-all">
        <a href="{{ section.settings.blog.url }}" class="btn btn--secondary">View All Posts</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog List",
  "tag": "section",
  "class": "blog-list-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "From Our Blog"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to Show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Blog List",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
