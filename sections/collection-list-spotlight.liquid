<div class="collection-spotlight" {{ section.shopify_attributes }}>

  {%- liquid
    assign first_block = section.blocks[0]
    assign first_collection = first_block.settings.collection
    assign first_image = first_block.settings.image | default: first_collection.featured_image
    assign first_title = first_collection.title
    assign first_url = first_collection.url | default: '#'
  -%}

  {%- if first_block != blank -%}
    <div class="collection-spotlight__featured" data-aos="fade-right" {{ first_block.shopify_attributes }}>
      <a href="{{ first_url }}" class="collection-spotlight__link" aria-label="{{ first_title | escape }}">
        <div class="collection-spotlight__image-wrapper">
          {%- if first_image != blank -%}
            <img
              src="{{ first_image | image_url: width: 832, height: 1032, crop: 'center' }}"
              srcset="
                {{ first_image | image_url: width: 416, height: 516, crop: 'center' }} 416w,
                {{ first_image | image_url: width: 624, height: 774, crop: 'center' }} 624w,
                {{ first_image | image_url: width: 832, height: 1032, crop: 'center' }} 832w
              "
              sizes="(max-width: 749px) 100vw, 60vw"
              alt="{{ first_image.alt | default: first_title | escape }}"
              width="832"
              height="1032"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-spotlight__placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if first_title != blank -%}
          <p class="collection-spotlight__title collection-spotlight__title--featured">{{ first_title }}</p>
        {%- endif -%}
      </a>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 1 -%}
    <div class="collection-spotlight__secondary">
      {%- for block in section.blocks -%}
        {%- unless forloop.first -%}
          {%- liquid
            assign collection = block.settings.collection
            assign image = block.settings.image | default: collection.featured_image
            assign title = collection.title
            assign url = collection.url | default: '#'
          -%}
          <div class="collection-spotlight__item" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 100 }}" {{ block.shopify_attributes }}>
            <a href="{{ url }}" class="collection-spotlight__link" aria-label="{{ title | escape }}">
              <div class="collection-spotlight__image-wrapper">
                {%- if image != blank -%}
                  <img
                    src="{{ image | image_url: width: 832, height: 1032, crop: 'center' }}"
                    srcset="
                      {{ image | image_url: width: 416, height: 516, crop: 'center' }} 416w,
                      {{ image | image_url: width: 624, height: 774, crop: 'center' }} 624w,
                      {{ image | image_url: width: 832, height: 1032, crop: 'center' }} 832w
                    "
                    sizes="(max-width: 749px) 50vw, 20vw"
                    alt="{{ image.alt | default: title | escape }}"
                    width="832"
                    height="1032"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'collection-spotlight__placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- if title != blank -%}
                <p class="collection-spotlight__title">{{ title }}</p>
              {%- endif -%}
            </a>
          </div>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Collections: Spotlight",
  "tag": "section",
  "class": "collection-spotlight-section",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the collection image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections: Spotlight",
      "category": "Collection",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
