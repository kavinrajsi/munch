{%- comment -%}
  Hero Slider Section
  ───────────────────
  A full-width image slider with optional text overlay per slide.

  Structure:
    .hero-slider               – Slider wrapper (data-hero-slider for JS init)
      .hero-slider__slide      – Individual slide (one per block)
        .hero-slider__image    – Responsive <picture> element
        .hero-slider__overlay  – Color overlay with configurable opacity
        .hero-slider__content  – Optional text content (heading, subheading, CTA)

  Images (mobile-first):
    - <picture> always renders; desktop_image and mobile_image are independent.
    - <img> serves mobile_image (800px) as the default source.
    - <source min-width: 768px> swaps to desktop_image (1920px) on larger screens.
    - If no mobile_image is set, desktop_image is used as fallback at all sizes.
    - First slide loads eagerly with high fetchpriority; rest are lazy-loaded.

  Overlay:
    - Uses CSS custom properties --hero-overlay (opacity) and
      --hero-overlay-bg (background color) set via inline styles.

  Content:
    - Toggled per slide via the "Enable Content" checkbox (show_content).
    - Supports heading (h2), subheading (p), and a CTA button with link.

  Section settings: autoplay, autoplay speed, show dots, show arrows.
  Block settings:   mobile_image, desktop_image, content toggle, heading,
                    subheading, button text/link, overlay opacity/color.
  Max blocks: 6
{%- endcomment -%}

{%- capture hero_classes -%}
  hero-slider
  {%- unless section.settings.show_dots_desktop %} hero-slider--hide-dots-desktop{%- endunless -%}
  {%- unless section.settings.show_dots_mobile %} hero-slider--hide-dots-mobile{%- endunless -%}
  {%- unless section.settings.show_arrows_desktop %} hero-slider--hide-arrows-desktop{%- endunless -%}
  {%- unless section.settings.show_arrows_mobile %} hero-slider--hide-arrows-mobile{%- endunless -%}
{%- endcapture -%}

<div
  class="{{ hero_classes | strip_newlines | strip }} splide"
  data-hero-slider
  data-slides-desktop="{{ section.settings.slides_desktop }}"
  data-slides-mobile="{{ section.settings.slides_mobile }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  style="
    --hero-slider-height-desktop: {{ section.settings.slider_height_desktop }}px;
    --hero-slider-height-mobile: {{ section.settings.slider_height_mobile }}px;
    --hero-dots-bottom: {{ section.settings.dots_bottom_position }}px;
    --hero-dot-width: {{ section.settings.dot_width }}px;
    --hero-dot-height: {{ section.settings.dot_height }}px;
    --hero-dot-bg: {{ section.settings.dot_bg_color }};
    --hero-dot-active-bg: {{ section.settings.dot_active_bg_color }};
    --hero-dot-border-color: {{ section.settings.dot_border_color }};
    --hero-dot-active-border-color: {{ section.settings.dot_active_border_color }};
    --hero-arrow-bg: {{ section.settings.arrow_bg_color }};
    --hero-arrow-border-color: {{ section.settings.arrow_border_color }};
    --hero-arrow-border-radius: {{ section.settings.arrow_border_radius }}px;
    --hero-arrow-width: {{ section.settings.arrow_width }}px;
    --hero-arrow-height: {{ section.settings.arrow_height }}px;
    --hero-arrow-gap: {{ section.settings.arrow_gap }}px;
    --hero-arrow-svg-width: {{ section.settings.arrow_svg_width }}px;
    --hero-arrow-svg-height: {{ section.settings.arrow_svg_height }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="splide__track">
    <div class="splide__list">
      {%- for block in section.blocks -%}
        <div class="hero-slider__slide splide__slide" style="{% if block.settings.slide_bg_color != blank %}background-color: {{ block.settings.slide_bg_color }};{% endif %}" {{ block.shopify_attributes }}>

          {%- comment -%} Slide image – mobile-first responsive <picture> with optional link {%- endcomment -%}
          <div class="hero-slider__image">
            {%- if block.settings.image_link != blank -%}
              <a href="{{ block.settings.image_link }}" class="hero-slider__image-link">
            {%- endif -%}
              <picture>
                {%- if block.settings.desktop_image -%}
                  <!-- Desktop Image -->
                  <source
                    media="(min-width: 768px)"
                    srcset="{{ block.settings.desktop_image | image_url: width: 1920 }}">
                {%- endif -%}

                {%- if block.settings.mobile_image -%}
                  <!-- Mobile Image (default / fallback) -->
                  <img
                    class="hero-slider__img"
                    src="{{ block.settings.mobile_image | image_url: width: 800 }}"
                    alt="{{ block.settings.heading | default: shop.name | escape }}"
                    width="{{ block.settings.mobile_image.width }}"
                    height="{{ block.settings.mobile_image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                  >
                {%- else -%}
                  <!-- Fallback to desktop if no mobile image -->
                  <img
                    class="hero-slider__img"
                    src="{{ block.settings.desktop_image | image_url: width: 800 }}"
                    alt="{{ block.settings.heading | default: shop.name | escape }}"
                    width="{{ block.settings.desktop_image.width }}"
                    height="{{ block.settings.desktop_image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                  >
                {%- endif -%}
              </picture>
            {%- if block.settings.image_link != blank -%}
              </a>
            {%- endif -%}
          </div>

          {%- comment -%} Overlay: color + opacity via CSS custom properties {%- endcomment -%}
          {%- if block.settings.show_overlay -%}
            <div class="hero-slider__overlay" style="--hero-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }}; --hero-overlay-bg: {{ block.settings.overlay_color }};"></div>
          {%- endif -%}

          {%- comment -%} Text content: only rendered when "Enable Content" is checked {%- endcomment -%}
          {%- if block.settings.show_content -%}
            <div class="hero-slider__content container">
              {%- if block.settings.heading != blank -%}
                <h2 class="hero-slider__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="hero-slider__subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}
              {%- if block.settings.button_text != blank -%}
                <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--primary btn--large">
                  {{ block.settings.button_text }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "hero-slider-section",
  "settings": [
    {
      "type": "range",
      "id": "slider_height_desktop",
      "label": "Slider Height Desktop",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "slider_height_mobile",
      "label": "Slider Height Mobile",
      "min": 150,
      "max": 600,
      "step": 10,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "No. of Images on Desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "No. of Images on Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Dots Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_dots_desktop",
      "label": "Show Dots on Desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots_mobile",
      "label": "Show Dots on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Dot Settings"
    },
    {
      "type": "range",
      "id": "dot_width",
      "label": "Dot Width",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "dot_height",
      "label": "Dot Height",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "dot_bg_color",
      "label": "Dot Background Color",
      "default": "#D3D3D3"
    },
    {
      "type": "color",
      "id": "dot_active_bg_color",
      "label": "Dot Active Background Color",
      "default": "#C61D23"
    },
    {
      "type": "color",
      "id": "dot_border_color",
      "label": "Dot Border Color",
      "default": "#D3D3D3"
    },
    {
      "type": "color",
      "id": "dot_active_border_color",
      "label": "Dot Active Border Color",
      "default": "#C61D23"
    },
    {
      "type": "range",
      "id": "dots_bottom_position",
      "label": "Dots Bottom Position",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Arrows Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_arrows_desktop",
      "label": "Show Arrows on Desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show Arrows on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Arrow Settings"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow Background Color",
      "default": "#F5F3F4"
    },
    {
      "type": "color",
      "id": "arrow_border_color",
      "label": "Arrow Border Color",
      "default": "#F5F3F4"
    },
    {
      "type": "range",
      "id": "arrow_border_radius",
      "label": "Arrow Border Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "arrow_width",
      "label": "Arrow Width",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "arrow_height",
      "label": "Arrow Height",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "arrow_gap",
      "label": "Gap Between Arrows",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "arrow_svg_width",
      "label": "Arrow Icon Width",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 19,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "arrow_svg_height",
      "label": "Arrow Icon Height",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 13,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image Link"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "checkbox",
          "id": "show_content",
          "label": "Enable Content",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Welcome to Nithyaamirtham"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Authentic South Indian sweets & snacks"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Enable Overlay",
          "default": true
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 30,
          "unit": "%"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay Background Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "slide_bg_color",
          "label": "Slide Background Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "category": "Banner",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Welcome to Nithyaamirtham", "subheading": "Authentic South Indian sweets & snacks crafted with love", "button_text": "Shop Now" } },
        { "type": "slide", "settings": { "heading": "Festive Gift Boxes", "subheading": "Share the sweetness with beautifully curated gift boxes", "button_text": "View Collection" } }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
