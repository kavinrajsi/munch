<div class="hero-slider" data-hero-slider {{ section.shopify_attributes }}>
  {%- for block in section.blocks -%}
    <div class="hero-slider__slide" {{ block.shopify_attributes }}>
      <div class="hero-slider__image">
        {%- if block.settings.image -%}
          <picture>
            {%- if block.settings.mobile_image -%}
              <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 800 }}">
            {%- endif -%}
            <img
              src="{{ block.settings.image | image_url: width: 1920 }}"
              alt="{{ block.settings.heading | default: shop.name | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
            >
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>

      <div class="hero-slider__overlay" style="--hero-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }}"></div>

      <div class="hero-slider__content page-width" style="text-align: {{ block.settings.text_alignment }};">
        {%- if block.settings.heading != blank -%}
          <h2 class="hero-slider__heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.subheading != blank -%}
          <p class="hero-slider__subheading">{{ block.settings.subheading }}</p>
        {%- endif -%}
        {%- if block.settings.button_text != blank -%}
          <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--primary btn--large">
            {{ block.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "hero-slider-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Welcome to Nithyaamirtham"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Authentic South Indian sweets & snacks"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 30,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "category": "Banner",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Welcome to Nithyaamirtham", "subheading": "Authentic South Indian sweets & snacks crafted with love", "button_text": "Shop Now" } },
        { "type": "slide", "settings": { "heading": "Festive Gift Boxes", "subheading": "Share the sweetness with beautifully curated gift boxes", "button_text": "View Collection" } }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
