{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "hero-slider",
  "settings": [
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Desktop Image" },
        { "type": "image_picker", "id": "image_tablet", "label": "Tablet Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "subheading", "label": "Subheading" },
        { "type": "text", "id": "button_label", "label": "Button Label" },
        { "type": "url", "id": "button_link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": []
    }
  ]
}
{% endschema %}

<div class="hero-slider-wrapper slick-slider" data-slick='{"slidesToShow": 1, "slidesToScroll": 1}'>

  {% for block in section.blocks %}
    {% if block.type == 'slide' %}
      {% if block.settings.button_link %}
        <div class="hero-slide item">
          <picture>
            {% if block.settings.image_mobile %}
              <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 768 }}">
            {% endif %}
            {% if block.settings.image_tablet %}
              <source media="(max-width: 1024px)" srcset="{{ block.settings.image_tablet | image_url: width: 1024 }}">
            {% endif %}
            {% if block.settings.image_desktop %}
              <img
                src="{{ block.settings.image_desktop | image_url: width: 1600 }}"
                alt="{{ block.settings.heading | escape }}"
                width="{{ block.settings.image_desktop.width }}"
                height="{{ block.settings.image_desktop.height }}"
                loading="eager"
                fetchpriority="high"
                style="width: 100%; height: auto; display: block;"
              >
            {% endif %}
          </picture>
      </div>
        {% endif %}
    {% endif %}
  {% endfor %}
</div>
