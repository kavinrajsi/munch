<div
  class="hero-slider"
  {%- if section.blocks.size > 1 -%}
    data-slick='{
      "slidesToShow": {{ section.settings.slides_desktop }},
      "slidesToScroll": 1,
      "arrows": {{ section.settings.enable_arrows }},
      "dots": {{ section.settings.enable_dots }},
      "infinite": {{ section.settings.enable_loop }},
      "autoplay": {{ section.settings.enable_autoplay }},
      "autoplaySpeed": {{ section.settings.autoplay_speed | times: 1000 }},
      "responsive": [
        {
          "breakpoint": 768,
          "settings": {
            "slidesToShow": {{ section.settings.slides_mobile }}
          }
        }
      ]
    }'
  {%- endif -%}
  style="--slider-gap: {{ section.settings.slide_gap }}px;"
>
  {%- for block in section.blocks -%}
    <div class="hero-slider__item" {{ block.shopify_attributes }}>
      {%- if block.settings.button_url != blank -%}
        <a href="{{ block.settings.button_url }}" class="hero-slider__link">
      {%- endif -%}

      <picture class="hero-slider__picture">
        {%- if block.settings.mobile_image -%}
          <source
            media="(max-width: 767px)"
            type="image/avif"
            srcset="{{ block.settings.mobile_image | image_url: width: 800, format: 'avif' }}"
          >
          <source
            media="(max-width: 767px)"
            type="image/webp"
            srcset="{{ block.settings.mobile_image | image_url: width: 800, format: 'webp' }}"
          >
          <source
            media="(max-width: 767px)"
            srcset="{{ block.settings.mobile_image | image_url: width: 800 }}"
          >
        {%- endif -%}

        {%- if block.settings.desktop_image -%}
          <source
            type="image/avif"
            srcset="{{ block.settings.desktop_image | image_url: width: 1600, format: 'avif' }}"
          >
          <source
            type="image/webp"
            srcset="{{ block.settings.desktop_image | image_url: width: 1600, format: 'webp' }}"
          >
          <img
            src="{{ block.settings.desktop_image | image_url: width: 1600 }}"
            alt="{{ block.settings.alt_text | escape }}"
            width="1600"
            height="auto"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {%- else -%}
          <img
            src="{{ 'demo-slider-' | append: forloop.index | append: '.png' | asset_url }}"
            alt="Placeholder image"
            width="1600"
            height="auto"
            class="hero-slider__placeholder"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {%- endif -%}
      </picture>

      {%- if block.settings.button_url != blank -%}
        </a>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{%- if section.blocks.size > 1 -%}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof jQuery !== 'undefined' && typeof jQuery.fn.slick !== 'undefined') {
        jQuery('.hero-slider').slick();
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides to show (desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides to show (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Space between slides",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Enable arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_dots",
      "label": "Enable dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Enable infinite loop",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Slide link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
