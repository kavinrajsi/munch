<div class="customer-addresses section-padding">
  <div class="page-width">

    {%- comment -%} Header {%- endcomment -%}
    <div class="customer-addresses__header">
      <h1 class="customer-addresses__title">
        Your Addresses ({{ customer.addresses_count }})
      </h1>
      <button type="button" class="btn btn--primary customer-addresses__add-btn" data-toggle-add>
        Add New Address
      </button>
    </div>

    {%- comment -%} Add new address form {%- endcomment -%}
    <div class="customer-addresses__form-wrap" id="add-address-form" style="display: none;">
      <h2 class="customer-addresses__form-title">Add a New Address</h2>
      {%- form 'customer_address', customer.new_address -%}
        <div class="customer-addresses__form-grid">
          <div class="field">
            <label class="field__label" for="AddressFirstName">First name</label>
            <input class="field__input" type="text" name="address[first_name]" id="AddressFirstName" autocomplete="given-name">
          </div>
          <div class="field">
            <label class="field__label" for="AddressLastName">Last name</label>
            <input class="field__input" type="text" name="address[last_name]" id="AddressLastName" autocomplete="family-name">
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="AddressCompany">Company</label>
          <input class="field__input" type="text" name="address[company]" id="AddressCompany" autocomplete="organization">
        </div>
        <div class="field">
          <label class="field__label" for="AddressAddress1">Address</label>
          <input class="field__input" type="text" name="address[address1]" id="AddressAddress1" autocomplete="address-line1">
        </div>
        <div class="field">
          <label class="field__label" for="AddressAddress2">Apartment, suite, etc.</label>
          <input class="field__input" type="text" name="address[address2]" id="AddressAddress2" autocomplete="address-line2">
        </div>
        <div class="customer-addresses__form-grid">
          <div class="field">
            <label class="field__label" for="AddressCity">City</label>
            <input class="field__input" type="text" name="address[city]" id="AddressCity" autocomplete="address-level2">
          </div>
          <div class="field">
            <label class="field__label" for="AddressZip">PIN code</label>
            <input class="field__input" type="text" name="address[zip]" id="AddressZip" autocomplete="postal-code">
          </div>
        </div>
        <div class="customer-addresses__form-grid">
          <div class="field">
            <label class="field__label" for="AddressCountry">Country</label>
            <select class="field__input" name="address[country]" id="AddressCountry" data-default="{{ form.country }}">
              {{ all_country_option_tags }}
            </select>
          </div>
          <div class="field">
            <label class="field__label" for="AddressProvince">State</label>
            <select class="field__input" name="address[province]" id="AddressProvince" data-default="{{ form.province }}"></select>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="AddressPhone">Phone</label>
          <input class="field__input" type="tel" name="address[phone]" id="AddressPhone" autocomplete="tel">
        </div>
        <div class="customer-addresses__form-checkbox">
          <input type="checkbox" name="address[default]" id="AddressDefault" value="1">
          <label for="AddressDefault">Set as default address</label>
        </div>
        <div class="customer-addresses__form-actions">
          <button type="submit" class="btn btn--primary">Add Address</button>
          <button type="button" class="btn btn--secondary" data-toggle-add>Cancel</button>
        </div>
      {%- endform -%}
    </div>

    {%- comment -%} Address list {%- endcomment -%}
    {%- if customer.addresses_count > 0 -%}
      <div class="customer-addresses__list">
        {%- for address in customer.addresses -%}
          <div class="customer-addresses__card" data-address-id="{{ address.id }}">

            {%- comment -%} Address display {%- endcomment -%}
            <div class="customer-addresses__card-view" id="view-{{ address.id }}">
              {%- if address == customer.default_address -%}
                <span class="customer-addresses__default-badge">Default</span>
              {%- endif -%}
              <div class="customer-addresses__card-address">
                {{ address | format_address }}
              </div>
              <div class="customer-addresses__card-actions">
                <button type="button" class="customer-addresses__edit-btn" data-toggle-edit="{{ address.id }}">Edit</button>
                <button type="button" class="customer-addresses__delete-btn" data-delete-address="{{ address.id }}">Delete</button>
              </div>
            </div>

            {%- comment -%} Inline edit form {%- endcomment -%}
            <div class="customer-addresses__card-edit" id="edit-{{ address.id }}" style="display: none;">
              <h3 class="customer-addresses__form-title">Edit Address</h3>
              {%- form 'customer_address', address -%}
                <div class="customer-addresses__form-grid">
                  <div class="field">
                    <label class="field__label" for="EditFirstName-{{ address.id }}">First name</label>
                    <input class="field__input" type="text" name="address[first_name]" id="EditFirstName-{{ address.id }}" value="{{ address.first_name }}" autocomplete="given-name">
                  </div>
                  <div class="field">
                    <label class="field__label" for="EditLastName-{{ address.id }}">Last name</label>
                    <input class="field__input" type="text" name="address[last_name]" id="EditLastName-{{ address.id }}" value="{{ address.last_name }}" autocomplete="family-name">
                  </div>
                </div>
                <div class="field">
                  <label class="field__label" for="EditCompany-{{ address.id }}">Company</label>
                  <input class="field__input" type="text" name="address[company]" id="EditCompany-{{ address.id }}" value="{{ address.company }}" autocomplete="organization">
                </div>
                <div class="field">
                  <label class="field__label" for="EditAddress1-{{ address.id }}">Address</label>
                  <input class="field__input" type="text" name="address[address1]" id="EditAddress1-{{ address.id }}" value="{{ address.address1 }}" autocomplete="address-line1">
                </div>
                <div class="field">
                  <label class="field__label" for="EditAddress2-{{ address.id }}">Apartment, suite, etc.</label>
                  <input class="field__input" type="text" name="address[address2]" id="EditAddress2-{{ address.id }}" value="{{ address.address2 }}" autocomplete="address-line2">
                </div>
                <div class="customer-addresses__form-grid">
                  <div class="field">
                    <label class="field__label" for="EditCity-{{ address.id }}">City</label>
                    <input class="field__input" type="text" name="address[city]" id="EditCity-{{ address.id }}" value="{{ address.city }}" autocomplete="address-level2">
                  </div>
                  <div class="field">
                    <label class="field__label" for="EditZip-{{ address.id }}">PIN code</label>
                    <input class="field__input" type="text" name="address[zip]" id="EditZip-{{ address.id }}" value="{{ address.zip }}" autocomplete="postal-code">
                  </div>
                </div>
                <div class="customer-addresses__form-grid">
                  <div class="field">
                    <label class="field__label" for="EditCountry-{{ address.id }}">Country</label>
                    <select class="field__input" name="address[country]" id="EditCountry-{{ address.id }}" data-default="{{ address.country }}">
                      {{ all_country_option_tags }}
                    </select>
                  </div>
                  <div class="field">
                    <label class="field__label" for="EditProvince-{{ address.id }}">State</label>
                    <select class="field__input" name="address[province]" id="EditProvince-{{ address.id }}" data-default="{{ address.province }}"></select>
                  </div>
                </div>
                <div class="field">
                  <label class="field__label" for="EditPhone-{{ address.id }}">Phone</label>
                  <input class="field__input" type="tel" name="address[phone]" id="EditPhone-{{ address.id }}" value="{{ address.phone }}" autocomplete="tel">
                </div>
                <div class="customer-addresses__form-checkbox">
                  <input type="checkbox" name="address[default]" id="EditDefault-{{ address.id }}" value="1" {% if address == customer.default_address %}checked{% endif %}>
                  <label for="EditDefault-{{ address.id }}">Set as default address</label>
                </div>
                <div class="customer-addresses__form-actions">
                  <button type="submit" class="btn btn--primary">Update Address</button>
                  <button type="button" class="btn btn--secondary" data-toggle-edit="{{ address.id }}">Cancel</button>
                </div>
              {%- endform -%}
            </div>

          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="customer-addresses__empty">You haven't saved any addresses yet.</p>
    {%- endif -%}

  </div>
</div>

<script>
  (function() {
    // Toggle add new address form
    document.querySelectorAll('[data-toggle-add]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var form = document.getElementById('add-address-form');
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
      });
    });

    // Toggle edit forms
    document.querySelectorAll('[data-toggle-edit]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = this.dataset.toggleEdit;
        var view = document.getElementById('view-' + id);
        var edit = document.getElementById('edit-' + id);
        if (edit.style.display === 'none') {
          view.style.display = 'none';
          edit.style.display = 'block';
        } else {
          edit.style.display = 'none';
          view.style.display = 'block';
        }
      });
    });

    // Delete address
    document.querySelectorAll('[data-delete-address]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!confirm('Are you sure you want to delete this address?')) return;
        var id = this.dataset.deleteAddress;
        fetch('/account/addresses/' + id, {
          method: 'DELETE',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).then(function() {
          window.location.reload();
        });
      });
    });

    // Country/Province selector — Shopify provides Shopify.CountryProvinceSelector
    if (typeof Shopify !== 'undefined' && typeof Shopify.CountryProvinceSelector === 'function') {
      new Shopify.CountryProvinceSelector('AddressCountry', 'AddressProvince', { hideElement: 'AddressProvinceContainer' });
      // Init edit form selectors
      document.querySelectorAll('[data-address-id]').forEach(function(card) {
        var id = card.dataset.addressId;
        new Shopify.CountryProvinceSelector('EditCountry-' + id, 'EditProvince-' + id, { hideElement: 'EditProvinceContainer-' + id });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Customer Addresses",
  "tag": "section",
  "settings": []
}
{% endschema %}
