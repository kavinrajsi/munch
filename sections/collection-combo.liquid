{% comment %}
  Shopify Section: Product Slider
  -------------------------------

  📌 Purpose:
  - Displays a responsive product carousel from a selected collection.
  - Highlights the latest products with navigation arrows.

  🧱 Structure:
  - Optional heading text
  - Slick carousel with up to 8 products
  - Previous/Next navigation buttons

  🛠 Admin Settings:
  - Heading text field
  - Collection picker to choose products
  - Color picker for dynamic background color

  🎨 Styling:
  - Background color applied dynamically using inline CSS from section settings

  📦 JSON-LD Schema:
  - None (can be added separately for SEO if needed)

  ✅ Accessibility:
  - SVG buttons with visible labels (can be enhanced with `aria-label` if needed)

  🔁 Preset:
  - Name: "Latest Products Slider"
{% endcomment %}

{% schema %}
{
  "name": "Product Slider",
  "tag": "section",
  "class": "product-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a combo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Latest Products Slider"
    }
  ]
}
{% endschema %}

<div
  class="layout__grid-box product-slider-section"
  id="slider-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }};"
>
  {% if section.settings.heading %}
    <div class="product-slider-heading-wrapper">
      <h2 class="heading--2 product-slider-heading">{{ section.settings.heading }}</h2>
      <div class="sliderButton">
        <button type="button" class="slick-prev">
          <!-- SVG for previous arrow -->
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="20" fill="#F5F3F4"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M30 19.9999C30 19.82 29.9285 19.6474 29.8013 19.5202C29.674 19.3929 29.5014 19.3214 29.3215 19.3214H13.3177L17.5884 15.0521C17.6515 14.989 17.7015 14.9141 17.7356 14.8317C17.7698 14.7493 17.7874 14.6609 17.7874 14.5717C17.7874 14.4825 17.7698 14.3942 17.7356 14.3117C17.7015 14.2293 17.6515 14.1544 17.5884 14.0913C17.5253 14.0282 17.4504 13.9782 17.368 13.944C17.2855 13.9099 17.1972 13.8923 17.108 13.8923C17.0187 13.8923 16.9304 13.9099 16.848 13.944C16.7655 13.9782 16.6907 14.0282 16.6276 14.0913L11.1993 19.5195C11.1362 19.5826 11.086 19.6575 11.0518 19.7399C11.0176 19.8223 11 19.9107 11 19.9999C11 20.0892 11.0176 20.1776 11.0518 20.26C11.086 20.3424 11.1362 20.4173 11.1993 20.4803L16.6276 25.9086C16.6907 25.9717 16.7655 26.0217 16.848 26.0558C16.9304 26.09 17.0187 26.1076 17.108 26.1076C17.1972 26.1076 17.2855 26.09 17.368 26.0558C17.4504 26.0217 17.5253 25.9717 17.5884 25.9086C17.6515 25.8455 17.7015 25.7706 17.7356 25.6882C17.7698 25.6057 17.7874 25.5174 17.7874 25.4282C17.7874 25.339 17.7698 25.2506 17.7356 25.1682C17.7015 25.0858 17.6515 25.0109 17.5884 24.9478L13.3177 20.6785H29.3215C29.5014 20.6785 29.674 20.607 29.8013 20.4797C29.9285 20.3525 30 20.1799 30 19.9999Z" fill="#C61D23"/>
          </svg>
        </button>
        <button type="button" class="slick-next">
          <!-- SVG for next arrow -->
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="20" transform="matrix(-1 0 0 1 40 0)" fill="#F5F3F4"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10 19.9999C10 19.82 10.0715 19.6474 10.1987 19.5202C10.326 19.3929 10.4986 19.3214 10.6785 19.3214H26.6823L22.4116 15.0521C22.3485 14.989 22.2985 14.9141 22.2644 14.8317C22.2302 14.7493 22.2126 14.6609 22.2126 14.5717C22.2126 14.4825 22.2302 14.3942 22.2644 14.3117C22.2985 14.2293 22.3485 14.1544 22.4116 14.0913C22.4747 14.0282 22.5496 13.9782 22.632 13.944C22.7145 13.9099 22.8028 13.8923 22.892 13.8923C22.9813 13.8923 23.0696 13.9099 23.152 13.944C23.2345 13.9782 23.3093 14.0282 23.3724 14.0913L28.8007 19.5195C28.8638 19.5826 28.914 19.6575 28.9482 19.7399C28.9824 19.8223 29 19.9107 29 19.9999C29 20.0892 28.9824 20.1776 28.9482 20.26C28.914 20.3424 28.8638 20.4173 28.8007 20.4803L23.3724 25.9086C23.3093 25.9717 23.2345 26.0217 23.152 26.0558C23.0696 26.09 22.9813 26.1076 22.892 26.1076C22.8028 26.1076 22.7145 26.09 22.632 26.0558C22.5496 26.0217 22.4747 25.9717 22.4116 25.9086C22.3485 25.8455 22.2985 25.7706 22.2644 25.6882C22.2302 25.6057 22.2126 25.5174 22.2126 25.4282C22.2126 25.339 22.2302 25.2506 22.2644 25.1682C22.2985 25.0858 22.3485 25.0109 22.4116 24.9478L26.6823 20.6785H10.6785C10.4986 20.6785 10.326 20.607 10.1987 20.4797C10.0715 20.3525 10 20.1799 10 19.9999Z" fill="#C61D23"/>
          </svg>
        </button>
      </div>
    </div>
  {% endif %}

  {% assign products = section.settings.collection.products | sort: 'created_at' | reverse | slice: 0, 8 %}

  <div class="product-slider-wrapper">
    <div
      class="slider-track slick-slider"
      data-slick='{
        "slidesToShow": 4,
        "slidesToScroll": 1,
        "infinite": false,
        "dots": false,
        "arrows": true,
        "prevArrow": "#slider-{{ section.id }} .slick-prev",
        "nextArrow": "#slider-{{ section.id }} .slick-next",
        "responsive": [
          { "breakpoint": 1024, "settings": { "slidesToShow": 3, "slidesToScroll": 1 }},
          { "breakpoint": 768, "settings": { "slidesToShow": 2, "slidesToScroll": 1 }},
          { "breakpoint": 480, "settings": { "slidesToShow": 1, "slidesToScroll": 1 }}
        ]
      }'
    >
      {% for product in products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</div>

<div class="collection-page">
  <!-- Collection image -->
  <div class="layout__grid-fluid padding--left-0 padding--right-0">
    {% if collection.image %}
      <div class="collection-image">
        <img
          src="{{ collection.image | image_url: width: 2048, height: 2048 }}"
          width="2048"
          height="2048"
          alt="{{ collection.title }}"
        >
      </div>
    {% endif %}
  </div>

  <section class="layout__grid-box">
    {% if collection.title != blank %}
      <h1 class="heading--2 collection--title">{{ collection.title }}</h1>
    {% endif %}

    {% if collection.description != blank %}
      <p>{{ collection.description }}</p>
    {% endif %}

    <!-- Sort and Filter controls -->
    {% assign show_sort = section.settings.enable_sorting %}
    {% assign show_filter = section.settings.enable_filtering %}
    {% assign show_pagination = section.settings.enable_pagination %}

    {% if show_sort or show_filter %}
      <div class="collection-toolbar">
        {% if show_sort %}
          <div class="collection-sort">
            <label for="SortBy">Sort by:</label>
            <select name="sort_by" id="SortBy" onchange="this.form.submit()">
              <option value="manual">Featured</option>
              <option value="best-selling">Best Selling</option>
              <option value="title-ascending">Alphabetically, A-Z</option>
              <option value="title-descending">Alphabetically, Z-A</option>
              <option value="price-ascending">Price, low to high</option>
              <option value="price-descending">Price, high to low</option>
              <option value="created-descending">Date, new to old</option>
              <option value="created-ascending">Date, old to new</option>
            </select>
          </div>
        {% endif %}

        {% if show_filter %}
          <div class="collection-filters">
            <label for="FilterBy">Filter by tag:</label>
            <select id="FilterBy" onchange="location = this.value;">
              <option value="{{ collection.url }}">All</option>
              {% for tag in collection.all_tags %}
                <option value="{{ collection.url | append: '?constraint=' | append: tag }}">
                  {{ tag }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% paginate collection.products by 8 %}
      <div class="collection-list-grid" collection-list-mobile="2" collection-list-tablet="3" collection-list-desktop="4">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>

      {% if show_pagination %}
        <div class="pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="pagination__button--prev" aria-label="Previous">
              <svg width="25" height="24" viewBox="0 0 25 24" fill="none"><path d="M16.4304 12.5429L8.07094 20.5079 ..."/></svg>
            </a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {% if part.title == '&hellip;' %}
              <span class="page pagination__page--decorative">…</span>
            {% elsif part.is_link %}
              <span class="pagination__page"><a href="{{ part.url }}">{{ part.title }}</a></span>
            {% else %}
              <span class="page pagination__page--current">{{ part.title }}</span>
            {% endif %}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="pagination__button--next" aria-label="Next">
              <svg width="25" height="24" viewBox="0 0 25 24" fill="none"><path d="M8.56963 11.4571L16.9291 3.4921 ..."/></svg>
            </a>
          {%- endif -%}
        </div>
      {% endif %}
    {% endpaginate %}

    <!-- Blog article section -->
    {% assign article_to_show = section.settings.article %}
    {% if article_to_show == blank and section.settings.blog != blank %}
      {% assign blog_obj = blogs[section.settings.blog] %}
      {% assign article_to_show = blog_obj.articles.first %}
    {% endif %}

    {% if article_to_show %}
      <div class="collection-article">
        <h2 class="heading--3">{{ article_to_show.title }}</h2>
        <div class="article-content">
          {{ article_to_show.excerpt_or_content | truncatewords: 60 }}
          <a href="{{ article_to_show.url }}">Read more</a>
        </div>
      </div>
    {% endif %}
  </section>
</div>

<!-- JSON-LD for SEO -->
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {% for product in collection.products limit: 10 %}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "name": "{{ product.title }}",
        "url": "{{ shop.secure_url }}{{ product.url }}"
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>

{% schema %}
{
  "name": "Collection Combo",
  "tag": "section",
  "class": "main-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering (by tag)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_pagination",
      "label": "Enable pagination",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "article",
      "id": "article",
      "label": "Select article (optional)",
      "info": "If none is selected, the latest article from the selected blog will be shown."
    }
  ],
  "presets": [
    {
      "name": "Collection Combo"
    }
  ]
}
{% endschema %}
