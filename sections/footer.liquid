    {
      "type": "header",
      "content": "Legal & Credit"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "2025 Nithya Amirtham Indian Food Pvt Ltd."
    },
    {
      "type": "text",
      "id": "made_by_text",
      "label": "Made By Text",
      "default": "Madarth"
