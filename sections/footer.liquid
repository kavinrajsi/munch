<footer
  class="footer"
  style="--footer-bg: {{ section.settings.bg_color }};--footer-text: {{ section.settings.text_color }};"
  {{ section.shopify_attributes }}
>
  <div class="page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.title != blank -%}
                <h4 class="footer__column-title">{{ block.settings.title }}</h4>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__menu">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'contact' -%}
              {%- if block.settings.title != blank -%}
                <h4 class="footer__column-title">{{ block.settings.title }}</h4>
              {%- endif -%}
              <div class="footer__contact">
                {%- if block.settings.address != blank -%}
                  <p>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {{ block.settings.address }}
                  </p>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <p>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                  </p>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <p>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                  </p>
                {%- endif -%}
              </div>

            {%- when 'newsletter' -%}
              {%- if block.settings.title != blank -%}
                <h4 class="footer__column-title">{{ block.settings.title }}</h4>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="footer__newsletter-text">{{ block.settings.text }}</p>
              {%- endif -%}
              {% form 'customer', class: 'footer__newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input
                  type="email"
                  name="contact[email]"
                  placeholder="{{ 'general.newsletter.placeholder' | t }}"
                  required
                  aria-label="{{ 'general.newsletter.label' | t }}"
                  autocomplete="email"
                >
                <button type="submit" class="btn btn--primary btn--small">{{ 'general.newsletter.submit' | t }}</button>
              {% endform %}

              {%- if section.settings.show_social -%}
                <div class="footer__social">
                  {%- if settings.social_facebook != blank -%}
                    <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_instagram != blank -%}
                    <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_twitter != blank -%}
                    <a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" aria-label="Twitter">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_youtube != blank -%}
                    <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#fff"/></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_whatsapp != blank -%}
                    <a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payments">
          {{ shop.enabled_payment_types | payment_type_svg_tag }}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#cccccc"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Contact Us"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Stay in Touch"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Subscribe for updates, offers, and new arrivals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "title": "Quick Links" } },
        { "type": "menu", "settings": { "title": "Information" } },
        { "type": "contact", "settings": { "title": "Contact Us" } },
        { "type": "newsletter", "settings": { "title": "Stay in Touch" } }
      ]
    }
  ]
}
{% endschema %}
