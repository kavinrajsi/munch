    {
      "type": "url",
      "id": "made_by_url",
      "label": "Made By URL",
      "default": "https://www.madarth.com"
    }
  ],
  "blocks": [
    {
      "type": "footer_menu",
      "name": "Footer Menu",
      "settings": [
        {
          "type": "text",
