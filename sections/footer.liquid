<footer
  class="footer"
  style="
    --footer-bg: {{ section.settings.bg_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-link-color: {{ section.settings.link_color }};
    --footer-title-color: {{ section.settings.title_color }};
    {%- if section.settings.bg_image != blank -%}
      --footer-bg-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="footer__container">

    <!-- Top Section -->
    <div class="footer__top">

      <!-- Brand -->
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }} Home">
          {%- case section.settings.logo_type -%}
            {%- when 'image' -%}
              {%- if section.settings.logo_image != blank -%}
                <img
                  src="{{ section.settings.logo_image | image_url: width: 360 }}"
                  alt="{{ shop.name }}"
                  class="footer__logo-img"
                  width="180"
                  height="50"
                  loading="lazy"
                >
              {%- else -%}
                <span class="footer__logo-text">{{ shop.name }}</span>
              {%- endif -%}
            {%- when 'svg' -%}
              {%- if section.settings.logo_svg != blank -%}
                {{ section.settings.logo_svg }}
              {%- else -%}
                <span class="footer__logo-text">{{ shop.name }}</span>
              {%- endif -%}
            {%- else -%}
              <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endcase -%}
        </a>
      </div>

      <!-- Links Section -->
      <div class="footer__links">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'menu' -%}
              <nav class="footer__nav" {{ block.shopify_attributes }} aria-labelledby="footer-nav-{{ block.id }}">
                {%- if block.settings.title != blank -%}
                  <h2 id="footer-nav-{{ block.id }}" class="footer__title">{{ block.settings.title }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__list">
                    {%- for link in block.settings.menu.links -%}
                      <li class="footer__item">
                        <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </nav>

            {%- when 'contact' -%}
              <div class="footer__contact" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h2 class="footer__title">{{ block.settings.title }}</h2>
                {%- endif -%}
                <address class="footer__address">
                  {%- if block.settings.address != blank -%}
                    <p class="footer__contact-item">
                      <svg class="footer__contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {{ block.settings.address }}
                    </p>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    <p class="footer__contact-item">
                      <svg class="footer__contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                      <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="footer__link">
                        {{ block.settings.phone }}
                      </a>
                    </p>
                  {%- endif -%}
                  {%- if block.settings.email != blank -%}
                    <p class="footer__contact-item">
                      <svg class="footer__contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                      <a href="mailto:{{ block.settings.email }}" class="footer__link">
                        {{ block.settings.email }}
                      </a>
                    </p>
                  {%- endif -%}
                </address>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Middle Section -->
    <div class="footer__middle">

      <!-- Payment Options -->
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payments">
          <h2 class="footer__title">{{ section.settings.payment_title }}</h2>
          <div class="footer__payment-list">
            {%- if section.settings.payment_icons_type == 'custom' and section.settings.payment_icons_svg != blank -%}
              {{ section.settings.payment_icons_svg }}
            {%- else -%}
              {{ shop.enabled_payment_types | payment_type_svg_tag }}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <!-- Social Links -->
      {%- if section.settings.show_social -%}
        <nav class="footer__social" aria-labelledby="footer-social-title">
          <h2 id="footer-social-title" class="footer__title">{{ section.settings.social_title }}</h2>
          <ul class="footer__social-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_icon' -%}
                <li class="footer__social-item" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.social_url }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="{{ block.settings.social_label }}">
                    {%- case block.settings.social_platform -%}
                      {%- when 'instagram' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/></svg>
                      {%- when 'facebook' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'x' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                      {%- when 'youtube' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polygon points="9.75,15.02 15.5,11.75 9.75,8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'whatsapp' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                      {%- when 'pinterest' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
                      {%- when 'custom' -%}
                        {%- if block.settings.social_svg != blank -%}
                          {{ block.settings.social_svg }}
                        {%- endif -%}
                    {%- endcase -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_type",
      "label": "Logo Type",
      "options": [
        {
          "value": "text",
          "label": "Store Name"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "svg",
          "label": "SVG Code"
        }
      ],
      "default": "text"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "html",
      "id": "logo_svg",
      "label": "Logo SVG Code"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Section Title",
      "default": "Follow Us"
    },
    {
      "type": "header",
      "content": "Payment"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_title",
      "label": "Payment Section Title",
      "default": "Payment Options"
    },
    {
      "type": "select",
      "id": "payment_icons_type",
      "label": "Payment Icons Type",
      "options": [
        {
          "value": "shopify",
          "label": "Shopify Default"
        },
        {
          "value": "custom",
          "label": "Custom SVG"
        }
      ],
      "default": "shopify"
    },
    {
      "type": "html",
      "id": "payment_icons_svg",
      "label": "Custom Payment Icons SVG"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Corporate Office"
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "social_icon",
      "name": "Social Icon",
      "settings": [
        {
          "type": "select",
          "id": "social_platform",
          "label": "Platform",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "x", "label": "X (Twitter)" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "custom", "label": "Custom SVG" }
          ],
          "default": "instagram"
        },
        {
          "type": "text",
          "id": "social_label",
          "label": "Label",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "social_url",
          "label": "Link"
        },
        {
          "type": "html",
          "id": "social_svg",
          "label": "Custom SVG Icon Code",
          "info": "Only used when Platform is set to Custom SVG"
        }
      ]
    }
  ]
}
{% endschema %}
