<footer
  class="footer"
  style="
    --footer-bg: {{ section.settings.background_color }};
    --footer-text-color: {{ section.settings.text_color }};
    --footer-link-color: {{ section.settings.link_color }};
    --footer-heading-color: {{ section.settings.heading_color }};
    --footer-pt: {{ section.settings.padding_top_mobile }}px;
    --footer-pb: {{ section.settings.padding_bottom_mobile }}px;
    --footer-pt-desktop: {{ section.settings.padding_top }}px;
    --footer-pb-desktop: {{ section.settings.padding_bottom }}px;
    --footer-font-size: {{ section.settings.font_size }}px;
    --footer-logo-width: {{ section.settings.logo_width }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.logo_svg != blank -%}
      <div class="footer__logo">
        {{ section.settings.logo_svg }}
      </div>
    {%- endif -%}

    <div class="footer__grid">
      {%- if section.settings.menu_1.links.size > 0 -%}
        <div class="footer__column">
          <h4 class="footer__heading">{{ section.settings.menu_1_title }}</h4>
          <ul class="footer__menu">
            {%- for link in section.settings.menu_1.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.menu_2.links.size > 0 -%}
        <div class="footer__column">
          <h4 class="footer__heading">{{ section.settings.menu_2_title }}</h4>
          <ul class="footer__menu">
            {%- for link in section.settings.menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.menu_3.links.size > 0 -%}
        <div class="footer__column">
          <h4 class="footer__heading">{{ section.settings.menu_3_title }}</h4>
          <ul class="footer__menu">
            {%- for link in section.settings.menu_3.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="footer__column">
        <h4 class="footer__heading">{{ section.settings.contact_title }}</h4>
        <div class="footer__contact">
          {%- if section.settings.address != blank -%}
            <p class="footer__contact-item">{{ section.settings.address }}</p>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <p class="footer__contact-item">
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
            </p>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <p class="footer__contact-item">
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- assign has_social = false -%}
    {%- if section.settings.facebook_url != blank or section.settings.instagram_url != blank or section.settings.youtube_url != blank -%}
      {%- assign has_social = true -%}
    {%- endif -%}

    {%- assign has_payments = false -%}
    {%- if section.settings.show_visa or section.settings.show_mastercard or section.settings.show_rupay or section.settings.show_upi or section.settings.show_maestro -%}
      {%- assign has_payments = true -%}
    {%- endif -%}

    {%- if has_social or has_payments -%}
      <div class="footer__bar">
        {%- if has_social -%}
          <div class="footer__social">
            <span class="footer__social-label">Follow Us</span>
            <div class="footer__social-icons">
              {%- if section.settings.facebook_url != blank -%}
                <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer__social-link">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.instagram_url != blank -%}
                <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer__social-link">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.youtube_url != blank -%}
                <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="footer__social-link">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if has_payments -%}
          <div class="footer__payments">
            {%- if section.settings.show_visa -%}
              <span class="footer__payment-icon" aria-label="Visa">
                <svg xmlns="http://www.w3.org/2000/svg" width="38" height="24" viewBox="0 0 38 24" fill="none">
                  <rect width="38" height="24" rx="4" fill="#fff"/>
                  <path d="M15.882 16.454h-2.39l1.496-9.238h2.39l-1.496 9.238z" fill="#00579F"/>
                  <path d="M25.17 7.416c-.473-.187-1.215-.388-2.142-.388-2.362 0-4.025 1.255-4.038 3.053-.014 1.33 1.188 2.07 2.095 2.514.93.454 1.242.744 1.242 1.15-.007.621-.745.905-1.434.905-.957 0-1.466-.14-2.25-.486l-.308-.147-.335 2.074c.559.258 1.593.482 2.665.494 2.511 0 4.142-1.24 4.16-3.16.008-1.053-.628-1.854-2.006-2.514-.835-.428-1.347-.713-1.347-1.147.007-.391.435-.797 1.372-.797.783-.013 1.35.167 1.792.355l.215.107.325-2.013z" fill="#00579F"/>
                  <path d="M28.85 7.216h-1.847c-.572 0-1 .165-1.252.768l-3.548 8.47h2.509l.5-1.384h3.066l.29 1.384h2.214L28.85 7.216zm-2.95 6.618c.198-.534 .955-2.592.955-2.592-.014.024.197-.537.318-.886l.162.8s.459 2.21.555 2.678h-1.99z" fill="#00579F"/>
                  <path d="M12.382 7.216l-2.343 6.302-.25-1.282c-.436-1.479-1.795-3.082-3.315-3.884l2.14 8.089h2.53l3.764-9.225h-2.526z" fill="#00579F"/>
                  <path d="M8.156 7.216H4.34l-.032.2c3.001.767 4.988 2.62 5.81 4.847l-.838-4.254c-.145-.585-.566-.763-1.124-.793z" fill="#FAA61A"/>
                </svg>
              </span>
            {%- endif -%}
            {%- if section.settings.show_mastercard -%}
              <span class="footer__payment-icon" aria-label="Mastercard">
                <svg xmlns="http://www.w3.org/2000/svg" width="38" height="24" viewBox="0 0 38 24" fill="none">
                  <rect width="38" height="24" rx="4" fill="#fff"/>
                  <circle cx="15" cy="12" r="7" fill="#EB001B"/>
                  <circle cx="23" cy="12" r="7" fill="#F79E1B"/>
                  <path d="M19 6.68a6.97 6.97 0 012.5 5.32 6.97 6.97 0 01-2.5 5.32 6.97 6.97 0 01-2.5-5.32A6.97 6.97 0 0119 6.68z" fill="#FF5F00"/>
                </svg>
              </span>
            {%- endif -%}
            {%- if section.settings.show_rupay -%}
              <span class="footer__payment-icon" aria-label="RuPay">
                <svg xmlns="http://www.w3.org/2000/svg" width="38" height="24" viewBox="0 0 38 24" fill="none">
                  <rect width="38" height="24" rx="4" fill="#fff"/>
                  <path d="M5 8h5.5c1.38 0 2.5.9 2.5 2s-1.12 2-2.5 2H7v4H5V8z" fill="#097A44"/>
                  <path d="M14 8h2.2l2.3 4.5L20.8 8H23l-4.5 8L14 8z" fill="#F37421"/>
                  <text x="24" y="15" font-family="Arial,sans-serif" font-size="7" font-weight="700" fill="#097A44">Pay</text>
                </svg>
              </span>
            {%- endif -%}
            {%- if section.settings.show_upi -%}
              <span class="footer__payment-icon" aria-label="UPI">
                <svg xmlns="http://www.w3.org/2000/svg" width="38" height="24" viewBox="0 0 38 24" fill="none">
                  <rect width="38" height="24" rx="4" fill="#fff"/>
                  <path d="M8 7h3v7c0 1.66-1.34 3-3 3H7v-2h1c.55 0 1-.45 1-1V9H8V7zm-1 0v2h1V7H7z" fill="#097A44"/>
                  <path d="M14 7h3c1.66 0 3 1.34 3 3s-1.34 3-3 3h-1v4h-2V7zm2 4h1c.55 0 1-.45 1-1s-.45-1-1-1h-1v2z" fill="#097A44"/>
                  <path d="M22 7h2v10h-2V7z" fill="#097A44"/>
                  <rect x="26" y="6" width="2" height="5" rx="1" transform="rotate(-30 26 6)" fill="#097A44"/>
                  <rect x="28" y="8" width="2" height="5" rx="1" transform="rotate(-30 28 8)" fill="#F37421"/>
                </svg>
              </span>
            {%- endif -%}
            {%- if section.settings.show_maestro -%}
              <span class="footer__payment-icon" aria-label="Maestro">
                <svg xmlns="http://www.w3.org/2000/svg" width="38" height="24" viewBox="0 0 38 24" fill="none">
                  <rect width="38" height="24" rx="4" fill="#fff"/>
                  <circle cx="15" cy="12" r="7" fill="#0099DF"/>
                  <circle cx="23" cy="12" r="7" fill="#000"/>
                  <path d="M19 6.68a6.97 6.97 0 012.5 5.32 6.97 6.97 0 01-2.5 5.32 6.97 6.97 0 01-2.5-5.32A6.97 6.97 0 0119 6.68z" fill="#6C6BBD"/>
                </svg>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}, {{ section.settings.company_name }}
      </p>
      <p class="footer__credit">
        Made by
        {%- if section.settings.credit_url != blank -%}
          <a href="{{ section.settings.credit_url }}" target="_blank" rel="noopener noreferrer" class="footer__credit-link">{{ section.settings.credit_name }}</a>
        {%- else -%}
          <span class="footer__credit-link">{{ section.settings.credit_name }}</span>
        {%- endif -%}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "textarea",
      "id": "logo_svg",
      "label": "Logo SVG",
      "info": "Paste your logo SVG code here"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Menu 1 — Combo"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Heading",
      "default": "Combo"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Menu 2 — About"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Heading",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Menu 3 — Policy"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Heading",
      "default": "Policy"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "header",
      "content": "Follow Us"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rupay",
      "label": "RuPay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_upi",
      "label": "UPI",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_maestro",
      "label": "Maestro",
      "default": true
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "default": "Nithya Amirtham Indian Food Pvt Ltd."
    },
    {
      "type": "text",
      "id": "credit_name",
      "label": "Credit name",
      "default": "Madarth"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Credit link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#999999"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
