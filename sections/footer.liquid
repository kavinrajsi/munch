<footer
  class="footer"
  style="
    --footer-bg: {{ section.settings.bg_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-link-color: {{ section.settings.link_color }};
    --footer-title-color: {{ section.settings.title_color }};
    --footer-divider-color: {{ section.settings.divider_color }};
    --footer-logo-width-desktop: {{ section.settings.logo_width_desktop }}px;
    --footer-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    {%- if section.settings.bg_image != blank -%}
      --footer-bg-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="footer__container container">
    <!-- Brand with lines -->
    <div class="footer__brand" data-animate="fade-up">
      <span class="footer__brand-line" aria-hidden="true">
        <svg
          preserveAspectRatio="none"
          width="100%"
          height="1"
          viewBox="0 0 454 1"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect width="454" height="1" transform="matrix(-1 0 0 1 454 0)" fill="url(#footer-line-left)"/>
          <defs>
            <linearGradient id="footer-line-left" x1="0" y1="0.5" x2="454" y2="0.5" gradientUnits="userSpaceOnUse">
              <stop stop-color="{{ section.settings.divider_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </span>

      <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }} Home">
        {%- case section.settings.logo_type -%}
          {%- when 'image' -%}
            {%- if section.settings.logo_image != blank -%}
              <img
                src="{{ section.settings.logo_image | image_url: width: 600 }}"
                alt="{{ shop.name }}"
                class="footer__logo-img"
                width="{{ section.settings.logo_width_desktop }}"
                height="auto"
                loading="lazy"
              >
            {%- else -%}
              <span class="footer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          {%- when 'svg' -%}
            {%- if section.settings.logo_svg != blank -%}
              {{ section.settings.logo_svg }}
            {%- else -%}
              <span class="footer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
        {%- endcase -%}
      </a>

      <span class="footer__brand-line" aria-hidden="true">
        <svg
          preserveAspectRatio="none"
          width="100%"
          height="1"
          viewBox="0 0 454 1"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect width="454" height="1" fill="url(#footer-line-right)"/>
          <defs>
            <linearGradient id="footer-line-right" x1="0" y1="0.5" x2="454" y2="0.5" gradientUnits="userSpaceOnUse">
              <stop stop-color="{{ section.settings.divider_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
    </div>

    <!-- Links Section -->
    <!-- Links Section -->
    <div class="footer__links">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="footer__nav" data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 }}" {{ block.shopify_attributes }} aria-labelledby="footer-nav-{{ block.id }}">
              {%- if block.settings.title != blank -%}
                <h2 id="footer-nav-{{ block.id }}" class="footer__title">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__list">
                  {%- for link in block.settings.menu.links -%}
                    <li class="footer__item">
                      <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>

          {%- when 'contact' -%}
            <div class="footer__contact-block" data-animate="fade-up" data-animate-delay="{{ forloop.index0 | times: 100 }}" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="footer__title">{{ block.settings.title }}</h2>
              {%- endif -%}

              <address class="footer__address">
                {%- if block.settings.address != blank -%}
                  <div class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" fill="none" viewBox="0 0 15 20">
                        <path fill="#161A1D" fill-rule="evenodd" d="M12.707 11.175C13.37 9.834 13.75 8.577 13.75 7.5a6.25 6.25 0 0 0-12.5 0c0 1.078.381 2.334 1.042 3.675.655 1.327 1.543 2.65 2.45 3.837A39.362 39.362 0 0 0 7.5 18.226l.26-.275a39.364 39.364 0 0 0 2.498-2.938c.907-1.187 1.795-2.51 2.45-3.837ZM7.5 20S15 12.893 15 7.5a7.5 7.5 0 0 0-15 0C0 12.893 7.5 20 7.5 20Z" clip-rule="evenodd"/>
                        <path fill="#161A1D" fill-rule="evenodd" d="M7.5 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm0 1.25a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    <span class="footer__contact-text">{{ block.settings.address }}</span>
                  </div>
                {%- endif -%}

                {%- if block.settings.phone != blank -%}
                  <div class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 20 20">
                        <path fill="#161A1D" fill-rule="evenodd" d="M4.568 1.66a.848.848 0 0 0-1.269-.078L2.007 2.875c-.604.605-.826 1.462-.563 2.213a21.96 21.96 0 0 0 5.21 8.26 21.96 21.96 0 0 0 8.26 5.21c.751.263 1.607.04 2.212-.563l1.293-1.293a.85.85 0 0 0-.079-1.268l-2.884-2.243a.849.849 0 0 0-.725-.152l-2.737.684a2.181 2.181 0 0 1-2.071-.574l-3.07-3.071a2.181 2.181 0 0 1-.575-2.072l.685-2.737a.848.848 0 0 0-.153-.725L4.568 1.66ZM2.356.64A2.181 2.181 0 0 1 5.62.842l2.243 2.882a2.18 2.18 0 0 1 .394 1.868L7.573 8.33a.848.848 0 0 0 .222.804l3.072 3.071a.848.848 0 0 0 .804.223l2.737-.684a2.181 2.181 0 0 1 1.867.394l2.883 2.242a2.18 2.18 0 0 1 .203 3.264l-1.292 1.292c-.925.925-2.308 1.331-3.596.878a23.29 23.29 0 0 1-8.763-5.525A23.292 23.292 0 0 1 .186 5.528c-.453-1.288-.047-2.671.878-3.596L2.357.639h-.001Z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="footer__contact-link">
                      {{ block.settings.phone }}
                    </a>
                  </div>
                {%- endif -%}

                {%- if block.settings.email != blank -%}
                  <div class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="15" fill="none" viewBox="0 0 20 15">
                        <path fill="#161A1D" fill-rule="evenodd" d="M0 2.5A2.5 2.5 0 0 1 2.5 0h15A2.5 2.5 0 0 1 20 2.5v10a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 0 12.5v-10Zm2.5-1.25A1.25 1.25 0 0 0 1.25 2.5v.271L10 8.021l8.75-5.25V2.5a1.25 1.25 0 0 0-1.25-1.25h-15Zm16.25 2.979-5.947 3.569 5.947 3.595V4.228Zm-.043 8.597L11.59 8.525 10 9.479l-1.59-.954-7.117 4.3a1.25 1.25 0 0 0 1.207.925h15a1.25 1.25 0 0 0 1.207-.924ZM1.25 11.392l5.947-3.594-5.947-3.57v7.165Z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    <a href="mailto:{{ block.settings.email }}" class="footer__contact-link">
                      {{ block.settings.email }}
                    </a>
                  </div>
                {%- endif -%}
              </address>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Bottom Section -->
    <div class="footer__bottom" data-animate="fade-up" data-animate-delay="200">
      <span class="footer__bottom-border" aria-hidden="true">
        <svg
          preserveAspectRatio="none"
          width="100%"
          height="1"
          viewBox="0 0 1120 1"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect width="1120" height="1" fill="url(#footer-bottom-border)"/>
          <defs>
            <linearGradient id="footer-bottom-border" x1="0" y1="0.5" x2="1120" y2="0.5" gradientUnits="userSpaceOnUse">
              <stop stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
              <stop offset="0.5" stop-color="{{ section.settings.divider_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
      <div class="footer__bottom-content">
        <!-- Brand Trust -->
        {%- assign trust_block = section.blocks | where: 'type', 'brand_trust' | first -%}
        {%- if trust_block -%}
          <div class="footer__brand-trust" {{ trust_block.shopify_attributes }}>
            {%- if trust_block.settings.title != blank -%}
              <h2 class="footer__brand-trust-title">{{ trust_block.settings.title }}</h2>
            {%- endif -%}

            <div class="footer__brand-trust-icons">
              {%- if trust_block.settings.visa_svg != blank -%}
                <span title="Visa">{{ trust_block.settings.visa_svg }}</span>
              {%- endif -%}
              {%- if trust_block.settings.mastercard_svg != blank -%}
                <span title="Mastercard">{{ trust_block.settings.mastercard_svg }}</span>
              {%- endif -%}
              {%- if trust_block.settings.rupay_svg != blank -%}
                <span title="RuPay">{{ trust_block.settings.rupay_svg }}</span>
              {%- endif -%}
              {%- if trust_block.settings.upi_svg != blank -%}
                <span title="UPI">{{ trust_block.settings.upi_svg }}</span>
              {%- endif -%}
              {%- if trust_block.settings.maestro_svg != blank -%}
                <span title="Maestro">{{ trust_block.settings.maestro_svg }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Social Icons -->
        {%- assign social_block = section.blocks | where: 'type', 'social_icons' | first -%}
        {%- if social_block -%}
          <div class="footer__social" {{ social_block.shopify_attributes }}>
            {%- if social_block.settings.title != blank -%}
              <h2 class="footer__social-title">{{ social_block.settings.title }}</h2>
            {%- endif -%}

            <ul class="footer__social-list">
              {%- if social_block.settings.instagram_svg != blank and social_block.settings.instagram_url != blank -%}
                <li>
                  <a
                    href="{{ social_block.settings.instagram_url }}"
                    target="_blank"
                    rel="noopener"
                    aria-label="Instagram"
                    class="footer__social-link"
                  >
                    {{ social_block.settings.instagram_svg }}
                  </a>
                </li>
              {%- endif -%}
              {%- if social_block.settings.facebook_svg != blank and social_block.settings.facebook_url != blank -%}
                <li>
                  <a
                    href="{{ social_block.settings.facebook_url }}"
                    target="_blank"
                    rel="noopener"
                    aria-label="Facebook"
                    class="footer__social-link"
                  >
                    {{ social_block.settings.facebook_svg }}
                  </a>
                </li>
              {%- endif -%}
              {%- if social_block.settings.youtube_svg != blank and social_block.settings.youtube_url != blank -%}
                <li>
                  <a
                    href="{{ social_block.settings.youtube_url }}"
                    target="_blank"
                    rel="noopener"
                    aria-label="YouTube"
                    class="footer__social-link"
                  >
                    {{ social_block.settings.youtube_svg }}
                  </a>
                </li>
              {%- endif -%}
              {%- if social_block.settings.pinterest_svg != blank and social_block.settings.pinterest_url != blank -%}
                <li>
                  <a
                    href="{{ social_block.settings.pinterest_url }}"
                    target="_blank"
                    rel="noopener"
                    aria-label="Pinterest"
                    class="footer__social-link"
                  >
                    {{ social_block.settings.pinterest_svg }}
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5d6c3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#161A1D"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#161A1D"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#A5161A"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#C61D23"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_type",
      "label": "Logo Type",
      "options": [
        { "value": "text", "label": "Store Name" },
        { "value": "image", "label": "Image" },
        { "value": "svg", "label": "SVG Code" }
      ],
      "default": "text"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "html",
      "id": "logo_svg",
      "label": "Logo SVG Code"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo Width (Desktop)",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo Width (Mobile)",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Brand Trust"
    },
    {
      "type": "text",
      "id": "brand_trust_title",
      "label": "Brand Trust Title",
      "default": "Brand Trust"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Title",
      "default": "Follow Us"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Corporate Office"
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "brand_trust",
      "name": "Brand Trust",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Secure Payments"
        },
        {
          "type": "html",
          "id": "visa_svg",
          "label": "Visa SVG Code"
        },
        {
          "type": "html",
          "id": "mastercard_svg",
          "label": "Mastercard SVG Code"
        },
        {
          "type": "html",
          "id": "rupay_svg",
          "label": "RuPay SVG Code"
        },
        {
          "type": "html",
          "id": "upi_svg",
          "label": "UPI SVG Code"
        },
        {
          "type": "html",
          "id": "maestro_svg",
          "label": "Maestro SVG Code"
        }
      ]
    },
    {
      "type": "social_icons",
      "name": "Social Icons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Follow Us"
        },

        {
          "type": "html",
          "id": "instagram_svg",
          "label": "Instagram SVG Code"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram Profile URL"
        },

        {
          "type": "html",
          "id": "facebook_svg",
          "label": "Facebook SVG Code"
        },
        {
          "type": "url",
          "id": "facebook_url",
          "label": "Facebook Profile URL"
        },

        {
          "type": "html",
          "id": "youtube_svg",
          "label": "YouTube SVG Code"
        },
        {
          "type": "url",
          "id": "youtube_url",
          "label": "YouTube Channel URL"
        },

        {
          "type": "html",
          "id": "pinterest_svg",
          "label": "Pinterest SVG Code"
        },
        {
          "type": "url",
          "id": "pinterest_url",
          "label": "Pinterest Profile URL"
        }
      ]
    }
  ]
}
{% endschema %}
