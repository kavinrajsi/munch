<footer
  class="footer"
  style="
    --footer-bg: {{ section.settings.bg_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-link-color: {{ section.settings.link_color }};
    --footer-title-color: {{ section.settings.title_color }};
    --footer-divider-color: {{ section.settings.divider_color }};
    --footer-logo-width-desktop: {{ section.settings.logo_width_desktop }}px;
    --footer-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    {%- if section.settings.bg_image != blank -%}
      --footer-bg-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="footer__container container">

    <!-- Brand -->
    <div class="footer__brand">

      <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }} Home">
        {%- case section.settings.logo_type -%}
          {%- when 'image' -%}
            {%- if section.settings.logo_image != blank -%}
              <img
                src="{{ section.settings.logo_image | image_url: width: 600 }}"
                alt="{{ shop.name }}"
                loading="lazy"
              >
            {%- else -%}
              <span>{{ shop.name }}</span>
            {%- endif -%}

          {%- when 'svg' -%}
            {%- if section.settings.logo_svg != blank -%}
              {{ section.settings.logo_svg }}
            {%- else -%}
              <span>{{ shop.name }}</span>
            {%- endif -%}

          {%- else -%}
            <span>{{ shop.name }}</span>
        {%- endcase -%}
      </a>

    </div>


    <!-- Links Section -->
    <div class="footer__links">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'menu' -%}
            <nav {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2>{{ block.settings.title }}</h2>
              {%- endif -%}

              {%- if block.settings.menu != blank -%}
                <ul>
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>


          {%- when 'contact' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2>{{ block.settings.title }}</h2>
              {%- endif -%}

              <address>

                {%- if block.settings.address != blank -%}
                  <div>{{ block.settings.address }}</div>
                {%- endif -%}

                {%- if block.settings.phone != blank -%}
                  <div>
                    <a href="tel:{{ block.settings.phone | remove: ' ' }}">
                      {{ block.settings.phone }}
                    </a>
                  </div>
                {%- endif -%}

                {%- if block.settings.email != blank -%}
                  <div>
                    <a href="mailto:{{ block.settings.email }}">
                      {{ block.settings.email }}
                    </a>
                  </div>
                {%- endif -%}

              </address>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>


    <hr>


    <!-- Bottom Section -->
    <div class="footer__bottom">

      <!-- Brand Trust -->
      {%- assign trust_blocks = section.blocks | where: "type", "brand_trust" -%}
      {%- if trust_blocks.size > 0 -%}
        <div class="footer__brand-trust">

          {%- if section.settings.brand_trust_title != blank -%}
            <h2>{{ section.settings.brand_trust_title }}</h2>
          {%- endif -%}

          <div>
            {%- for block in trust_blocks -%}
              <span {{ block.shopify_attributes }} title="{{ block.settings.trust_label }}">
                {{ block.settings.trust_svg }}
              </span>
            {%- endfor -%}
          </div>

        </div>
      {%- endif -%}


      <!-- Social Icons -->
      {%- assign social_blocks = section.blocks | where: "type", "social_icon" -%}
      {%- if social_blocks.size > 0 -%}
        <div class="footer__social">

          {%- if section.settings.social_title != blank -%}
            <h2>{{ section.settings.social_title }}</h2>
          {%- endif -%}

          <ul>
            {%- for block in social_blocks -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.social_url }}"
                   target="{{ block.settings.social_target }}"
                   rel="noopener"
                   aria-label="{{ block.settings.social_label }}">
                  {{ block.settings.social_svg }}
                </a>
              </li>
            {%- endfor -%}
          </ul>

        </div>
      {%- endif -%}

    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5d6c3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#C61D23"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#C61D23"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_type",
      "label": "Logo Type",
      "options": [
        { "value": "text", "label": "Store Name" },
        { "value": "image", "label": "Image" },
        { "value": "svg", "label": "SVG Code" }
      ],
      "default": "text"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "html",
      "id": "logo_svg",
      "label": "Logo SVG Code"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo Width (Desktop)",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo Width (Mobile)",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Brand Trust"
    },
    {
      "type": "text",
      "id": "brand_trust_title",
      "label": "Brand Trust Title",
      "default": "Brand Trust"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Title",
      "default": "Follow Us"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Corporate Office"
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "brand_trust",
      "name": "Brand Trust Icon",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "trust_label",
          "label": "Payment Type",
          "options": [
            { "value": "Visa", "label": "Visa" },
            { "value": "Mastercard", "label": "Mastercard" },
            { "value": "RuPay", "label": "RuPay" },
            { "value": "UPI", "label": "UPI" },
            { "value": "Maestro", "label": "Maestro" }
          ],
          "default": "Visa"
        },
        {
          "type": "html",
          "id": "trust_svg",
          "label": "Upload SVG Code"
        }
      ]
    },
    {
      "type": "social_icon",
      "name": "Social Icon",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "social_label",
          "label": "Platform",
          "options": [
            { "value": "Instagram", "label": "Instagram" },
            { "value": "Facebook", "label": "Facebook" },
            { "value": "YouTube", "label": "YouTube" },
            { "value": "Pinterest", "label": "Pinterest" }
          ],
          "default": "Instagram"
        },
        {
          "type": "html",
          "id": "social_svg",
          "label": "Upload SVG Code"
        },
        {
          "type": "url",
          "id": "social_url",
          "label": "Profile URL"
        },
        {
          "type": "select",
          "id": "social_target",
          "label": "Open Link In",
          "options": [
            { "value": "_blank", "label": "New Tab" },
            { "value": "_self", "label": "Same Tab" }
          ],
          "default": "_blank"
        }
      ]
    }
  ]
}
{% endschema %}