<footer
  class="footer"
  style="
    --footer-bg: {{ section.settings.bg_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-link-color: {{ section.settings.link_color }};
    --footer-title-color: {{ section.settings.title_color }};
    --footer-divider-color: {{ section.settings.divider_color }};
    --footer-logo-width-desktop: {{ section.settings.logo_width_desktop }}px;
    --footer-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    {%- if section.settings.bg_image != blank -%}
      --footer-bg-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="footer__container container">
    <!-- Brand with lines -->
    <div class="footer__brand">
      <span class="footer__brand-line" aria-hidden="true">
        <svg
          preserveAspectRatio="none"
          width="100%"
          height="1"
          viewBox="0 0 454 1"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect width="454" height="1" transform="matrix(-1 0 0 1 454 0)" fill="url(#footer-line-left)"/>
          <defs>
            <linearGradient id="footer-line-left" x1="0" y1="0.5" x2="454" y2="0.5" gradientUnits="userSpaceOnUse">
              <stop stop-color="{{ section.settings.divider_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </span>

      <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }} Home">
        {%- case section.settings.logo_type -%}
          {%- when 'image' -%}
            {%- if section.settings.logo_image != blank -%}
              <img
                src="{{ section.settings.logo_image | image_url: width: 600 }}"
                alt="{{ shop.name }}"
                class="footer__logo-img"
                width="{{ section.settings.logo_width_desktop }}"
                height="auto"
                loading="lazy"
              >
            {%- else -%}
              <span class="footer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          {%- when 'svg' -%}
            {%- if section.settings.logo_svg != blank -%}
              {{ section.settings.logo_svg }}
            {%- else -%}
              <span class="footer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
        {%- endcase -%}
      </a>

      <span class="footer__brand-line" aria-hidden="true">
        <svg
          preserveAspectRatio="none"
          width="100%"
          height="1"
          viewBox="0 0 454 1"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect width="454" height="1" fill="url(#footer-line-right)"/>
          <defs>
            <linearGradient id="footer-line-right" x1="0" y1="0.5" x2="454" y2="0.5" gradientUnits="userSpaceOnUse">
              <stop stop-color="{{ section.settings.divider_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
    </div>

    <!-- Links Section -->
    <!-- Links Section -->
    <div class="footer__links">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="footer__nav" {{ block.shopify_attributes }} aria-labelledby="footer-nav-{{ block.id }}">
              {%- if block.settings.title != blank -%}
                <h2 id="footer-nav-{{ block.id }}" class="footer__title">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__list">
                  {%- for link in block.settings.menu.links -%}
                    <li class="footer__item">
                      <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>

          {%- when 'contact' -%}
            <div class="footer__contact-block" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="footer__title">{{ block.settings.title }}</h2>
              {%- endif -%}

              <address class="footer__address">
                {%- if block.settings.address != blank -%}
                  <div class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg width="15" height="20" viewBox="0 0 15 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12.7075 11.175C13.37 9.83375 13.75 8.5775 13.75 7.5C13.75 5.8424 13.0915 4.25269 11.9194 3.08058C10.7473 1.90848 9.1576 1.25 7.5 1.25C5.8424 1.25 4.25269 1.90848 3.08058 3.08058C1.90848 4.25269 1.25 5.8424 1.25 7.5C1.25 8.5775 1.63125 9.83375 2.2925 11.175C2.9475 12.5025 3.835 13.825 4.7425 15.0125C5.60336 16.132 6.52385 17.2044 7.5 18.225L7.76 17.95C8.63998 17.0122 9.47348 16.0319 10.2575 15.0125C11.165 13.825 12.0525 12.5025 12.7075 11.175ZM7.5 20C7.5 20 15 12.8925 15 7.5C15 5.51088 14.2098 3.60322 12.8033 2.1967C11.3968 0.790176 9.48912 0 7.5 0C5.51088 0 3.60322 0.790176 2.1967 2.1967C0.790176 3.60322 0 5.51088 0 7.5C0 12.8925 7.5 20 7.5 20Z" fill="currentColor"/>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M7.5 10C8.16304 10 8.79893 9.73661 9.26777 9.26777C9.73661 8.79893 10 8.16304 10 7.5C10 6.83696 9.73661 6.20107 9.26777 5.73223C8.79893 5.26339 8.16304 5 7.5 5C6.83696 5 6.20107 5.26339 5.73223 5.73223C5.26339 6.20107 5 6.83696 5 7.5C5 8.16304 5.26339 8.79893 5.73223 9.26777C6.20107 9.73661 6.83696 10 7.5 10ZM7.5 11.25C8.49456 11.25 9.44839 10.8549 10.1517 10.1517C10.8549 9.44839 11.25 8.49456 11.25 7.5C11.25 6.50544 10.8549 5.55161 10.1517 4.84835C9.44839 4.14509 8.49456 3.75 7.5 3.75C6.50544 3.75 5.55161 4.14509 4.84835 4.84835C4.14509 5.55161 3.75 6.50544 3.75 7.5C3.75 8.49456 4.14509 9.44839 4.84835 10.1517C5.55161 10.8549 6.50544 11.25 7.5 11.25Z" fill="currentColor"/>
                      </svg>
                    </span>
                    <span class="footer__contact-text">{{ block.settings.address }}</span>
                  </div>
                {%- endif -%}

                {%- if block.settings.phone != blank -%}
                  <div class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M4.56795 1.66033C4.49416 1.56541 4.40101 1.48727 4.29471 1.43111C4.1884 1.37496 4.07136 1.34206 3.95136 1.33461C3.83137 1.32717 3.71116 1.34534 3.59872 1.38792C3.48629 1.4305 3.3842 1.49651 3.29924 1.58158L2.00678 2.8753C1.40304 3.48028 1.18055 4.33651 1.44429 5.08774C2.53893 8.19715 4.31957 11.0202 6.65413 13.3475C8.98146 15.6821 11.8045 17.4627 14.9139 18.5574C15.6651 18.8212 16.5213 18.5987 17.1263 17.9949L18.4188 16.7025C18.5038 16.6175 18.5698 16.5154 18.6124 16.403C18.655 16.2905 18.6732 16.1703 18.6657 16.0503C18.6583 15.9303 18.6254 15.8133 18.5692 15.707C18.5131 15.6007 18.4349 15.5075 18.34 15.4337L15.4564 13.1913C15.3549 13.1126 15.237 13.058 15.1114 13.0316C14.9858 13.0052 14.8559 13.0077 14.7314 13.0388L11.994 13.7225C11.6286 13.8139 11.2458 13.809 10.8828 13.7085C10.5198 13.6079 10.1891 13.4151 9.92278 13.1488L6.85287 10.0776C6.58634 9.81143 6.3933 9.48074 6.29253 9.11777C6.19177 8.7548 6.18672 8.37192 6.27789 8.00642L6.96287 5.26899C6.994 5.14449 6.99645 5.01454 6.97004 4.88895C6.94362 4.76337 6.88903 4.64542 6.81038 4.54401L4.56795 1.66033ZM2.35551 0.639103C2.57425 0.420295 2.83703 0.250526 3.12641 0.141067C3.41579 0.0316081 3.72515-0.0150349 4.03394 0.00423494C4.34273 0.0235048 4.64388 0.108247 4.91741 0.252833C5.19094 0.39742 5.43058 0.598544 5.62041 0.842848L7.86284 3.72528C8.27408 4.25401 8.41907 4.94275 8.25658 5.59273L7.57285 8.33017C7.5375 8.47195 7.53941 8.62046 7.5784 8.76129C7.61738 8.90212 7.69212 9.03048 7.79534 9.1339L10.8665 12.2051C10.97 12.3085 11.0986 12.3834 11.2397 12.4224C11.3807 12.4614 11.5295 12.4631 11.6715 12.4276L14.4076 11.7438C14.7284 11.6636 15.0632 11.6574 15.3867 11.7256C15.7102 11.7938 16.014 11.9347 16.2751 12.1376L19.1575 14.38C20.1937 15.1862 20.2887 16.7175 19.3612 17.6437L18.0688 18.9362C17.1438 19.8611 15.7613 20.2674 14.4726 19.8136C11.1742 18.6531 8.17942 16.7648 5.71041 14.2888C3.2346 11.8201 1.34631 8.82573 0.185583 5.52773C-0.266903 4.24027 0.139334 2.85655 1.06431 1.93157L2.35676 0.639103H2.35551Z" fill="currentColor"/>
                      </svg>
                    </span>
                    <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="footer__contact-link">
                      {{ block.settings.phone }}
                    </a>
                  </div>
                {%- endif -%}

                {%- if block.settings.email != blank -%}
                  <div class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg width="20" height="15" viewBox="0 0 20 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M0 2.5C0 1.83696 0.263392 1.20107 0.732233 0.732233C1.20107 0.263392 1.83696 0 2.5 0H17.5C18.163 0 18.7989 0.263392 19.2678 0.732233C19.7366 1.20107 20 1.83696 20 2.5V12.5C20 13.163 19.7366 13.7989 19.2678 14.2678C18.7989 14.7366 18.163 15 17.5 15H2.5C1.83696 15 1.20107 14.7366 0.732233 14.2678C0.263392 13.7989 0 13.163 0 12.5V2.5ZM2.5 1.25C2.16848 1.25 1.85054 1.3817 1.61612 1.61612C1.3817 1.85054 1.25 2.16848 1.25 2.5V2.77125L10 8.02125L18.75 2.77125V2.5C18.75 2.16848 18.6183 1.85054 18.3839 1.61612C18.1495 1.3817 17.8315 1.25 17.5 1.25H2.5ZM18.75 4.22875L12.8025 7.7975L18.75 11.3925V4.23V4.22875ZM18.7075 12.8262L11.5887 8.525L10 9.47875L8.41 8.525L1.2925 12.825C1.364 13.0905 1.52106 13.3251 1.73936 13.4923C1.95766 13.6595 2.22501 13.7501 2.5 13.75H17.5C17.7748 13.7502 18.0421 13.6598 18.2603 13.4928C18.4786 13.3258 18.6358 13.0915 18.7075 12.8262ZM1.25 11.3925L7.1975 7.7975L1.25 4.22875V11.3912V11.3925Z" fill="currentColor"/>
                      </svg>
                    </span>
                    <a href="mailto:{{ block.settings.email }}" class="footer__contact-link">
                      {{ block.settings.email }}
                    </a>
                  </div>
                {%- endif -%}
              </address>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Bottom Section -->
    <div class="footer__bottom">
      <!-- Brand Trust -->
      {%- assign trust_block = section.blocks | where: 'type', 'brand_trust' | first -%}
      {%- if trust_block -%}
        <div class="footer__brand-trust" {{ trust_block.shopify_attributes }}>
          {%- if trust_block.settings.title != blank -%}
            <h2>{{ trust_block.settings.title }}</h2>
          {%- endif -%}

          <div class="footer__brand-trust-icons">
            {%- if trust_block.settings.visa_svg != blank -%}
              <span title="Visa">{{ trust_block.settings.visa_svg }}</span>
            {%- endif -%}
            {%- if trust_block.settings.mastercard_svg != blank -%}
              <span title="Mastercard">{{ trust_block.settings.mastercard_svg }}</span>
            {%- endif -%}
            {%- if trust_block.settings.rupay_svg != blank -%}
              <span title="RuPay">{{ trust_block.settings.rupay_svg }}</span>
            {%- endif -%}
            {%- if trust_block.settings.upi_svg != blank -%}
              <span title="UPI">{{ trust_block.settings.upi_svg }}</span>
            {%- endif -%}
            {%- if trust_block.settings.maestro_svg != blank -%}
              <span title="Maestro">{{ trust_block.settings.maestro_svg }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <!-- Social Icons -->
      {%- assign social_block = section.blocks | where: 'type', 'social_icons' | first -%}
      {%- if social_block -%}
        <div class="footer__social" {{ social_block.shopify_attributes }}>
          {%- if social_block.settings.title != blank -%}
            <h2>{{ social_block.settings.title }}</h2>
          {%- endif -%}

          <ul class="footer__social-list">
            {%- if social_block.settings.instagram_svg != blank and social_block.settings.instagram_url != blank -%}
              <li>
                <a
                  href="{{ social_block.settings.instagram_url }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Instagram"
                  class="footer__social-link"
                >
                  {{ social_block.settings.instagram_svg }}
                </a>
              </li>
            {%- endif -%}
            {%- if social_block.settings.facebook_svg != blank and social_block.settings.facebook_url != blank -%}
              <li>
                <a
                  href="{{ social_block.settings.facebook_url }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Facebook"
                  class="footer__social-link"
                >
                  {{ social_block.settings.facebook_svg }}
                </a>
              </li>
            {%- endif -%}
            {%- if social_block.settings.youtube_svg != blank and social_block.settings.youtube_url != blank -%}
              <li>
                <a
                  href="{{ social_block.settings.youtube_url }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="YouTube"
                  class="footer__social-link"
                >
                  {{ social_block.settings.youtube_svg }}
                </a>
              </li>
            {%- endif -%}
            {%- if social_block.settings.pinterest_svg != blank and social_block.settings.pinterest_url != blank -%}
              <li>
                <a
                  href="{{ social_block.settings.pinterest_url }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Pinterest"
                  class="footer__social-link"
                >
                  {{ social_block.settings.pinterest_svg }}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5d6c3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#161A1D"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#161A1D"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#A5161A"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#C61D23"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_type",
      "label": "Logo Type",
      "options": [
        { "value": "text", "label": "Store Name" },
        { "value": "image", "label": "Image" },
        { "value": "svg", "label": "SVG Code" }
      ],
      "default": "text"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "html",
      "id": "logo_svg",
      "label": "Logo SVG Code"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo Width (Desktop)",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo Width (Mobile)",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Brand Trust"
    },
    {
      "type": "text",
      "id": "brand_trust_title",
      "label": "Brand Trust Title",
      "default": "Brand Trust"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Title",
      "default": "Follow Us"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Corporate Office"
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "brand_trust",
      "name": "Brand Trust",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Secure Payments"
        },
        {
          "type": "html",
          "id": "visa_svg",
          "label": "Visa SVG Code"
        },
        {
          "type": "html",
          "id": "mastercard_svg",
          "label": "Mastercard SVG Code"
        },
        {
          "type": "html",
          "id": "rupay_svg",
          "label": "RuPay SVG Code"
        },
        {
          "type": "html",
          "id": "upi_svg",
          "label": "UPI SVG Code"
        },
        {
          "type": "html",
          "id": "maestro_svg",
          "label": "Maestro SVG Code"
        }
      ]
    },
    {
      "type": "social_icons",
      "name": "Social Icons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Follow Us"
        },

        {
          "type": "html",
          "id": "instagram_svg",
          "label": "Instagram SVG Code"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram Profile URL"
        },

        {
          "type": "html",
          "id": "facebook_svg",
          "label": "Facebook SVG Code"
        },
        {
          "type": "url",
          "id": "facebook_url",
          "label": "Facebook Profile URL"
        },

        {
          "type": "html",
          "id": "youtube_svg",
          "label": "YouTube SVG Code"
        },
        {
          "type": "url",
          "id": "youtube_url",
          "label": "YouTube Channel URL"
        },

        {
          "type": "html",
          "id": "pinterest_svg",
          "label": "Pinterest SVG Code"
        },
        {
          "type": "url",
          "id": "pinterest_url",
          "label": "Pinterest Profile URL"
        }
      ]
    }
  ]
}
{% endschema %}
