<footer
  class="footer"
  style="
    --footer-bg: {{ section.settings.bg_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-link-color: {{ section.settings.link_color }};
    --footer-title-color: {{ section.settings.title_color }};
    --footer-divider-color: {{ section.settings.divider_color }};
    --footer-logo-width-desktop: {{ section.settings.logo_width_desktop }}px;
    --footer-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    {%- if section.settings.bg_image != blank -%}
      --footer-bg-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="footer__container container">

    <!-- Brand with lines -->
    <div class="footer__brand">
      <span class="footer__brand-line" aria-hidden="true">
        <svg preserveAspectRatio="none" width="100%" height="1" viewBox="0 0 454 1" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="454" height="1" transform="matrix(-1 0 0 1 454 0)" fill="url(#footer-line-left)"/>
          <defs>
            <linearGradient id="footer-line-left" x1="0" y1="0.5" x2="454" y2="0.5" gradientUnits="userSpaceOnUse">
              <stop stop-color="{{ section.settings.divider_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </span>

      <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }} Home">
        {%- case section.settings.logo_type -%}
          {%- when 'image' -%}
            {%- if section.settings.logo_image != blank -%}
              <img
                src="{{ section.settings.logo_image | image_url: width: 600 }}"
                alt="{{ shop.name }}"
                class="footer__logo-img"
                loading="lazy"
              >
            {%- else -%}
              <span class="footer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          {%- when 'svg' -%}
            {%- if section.settings.logo_svg != blank -%}
              {{ section.settings.logo_svg }}
            {%- else -%}
              <span class="footer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
        {%- endcase -%}
      </a>

      <span class="footer__brand-line" aria-hidden="true">
        <svg preserveAspectRatio="none" width="100%" height="1" viewBox="0 0 454 1" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="454" height="1" fill="url(#footer-line-right)"/>
          <defs>
            <linearGradient id="footer-line-right" x1="0" y1="0.5" x2="454" y2="0.5" gradientUnits="userSpaceOnUse">
              <stop stop-color="{{ section.settings.divider_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.divider_color }}" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
    </div>

    <!-- Links Section -->
    <div class="footer__links">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'menu' -%}
            <nav class="footer__nav" {{ block.shopify_attributes }} aria-labelledby="footer-nav-{{ block.id }}">
              {%- if block.settings.title != blank -%}
                <h2 id="footer-nav-{{ block.id }}" class="footer__title">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__list">
                  {%- for link in block.settings.menu.links -%}
                    <li class="footer__item">
                      <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>

          {%- when 'contact' -%}
            <div class="footer__contact" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="footer__title">{{ block.settings.title }}</h2>
              {%- endif -%}
              <address class="footer__address">
                {%- if block.settings.address != blank -%}
                  <p class="footer__contact-item">
                    <svg class="footer__contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span>{{ block.settings.address }}</span>
                  </p>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <p class="footer__contact-item">
                    <svg class="footer__contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="footer__link">{{ block.settings.phone }}</a>
                  </p>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <p class="footer__contact-item">
                    <svg class="footer__contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <a href="mailto:{{ block.settings.email }}" class="footer__link">{{ block.settings.email }}</a>
                  </p>
                {%- endif -%}
              </address>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Divider -->
    <hr class="footer__divider">

    <!-- Bottom Section: Payment + Social -->
    <div class="footer__bottom">

      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payments">
          {%- if section.settings.payment_title != blank -%}
            <h2 class="footer__title">{{ section.settings.payment_title }}</h2>
          {%- endif -%}
          <div class="footer__payment-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'payment_icon' and block.settings.payment_svg != blank -%}
                <span class="footer__payment-icon" {{ block.shopify_attributes }} title="{{ block.settings.payment_label }}">
                  {{ block.settings.payment_svg }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        <div class="footer__social">
          {%- if section.settings.social_title != blank -%}
            <h2 class="footer__title">{{ section.settings.social_title }}</h2>
          {%- endif -%}
          <ul class="footer__social-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_icon' and block.settings.social_url != blank -%}
                <li class="footer__social-item" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.social_url }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="{{ block.settings.social_label }}">
                    {%- case block.settings.social_platform -%}
                      {%- when 'instagram' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/></svg>
                      {%- when 'facebook' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'x' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                      {%- when 'youtube' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polygon points="9.75,15.02 15.5,11.75 9.75,8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'whatsapp' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                      {%- when 'pinterest' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
                      {%- when 'tiktok' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.3 0 .59.04.86.12V9.01a6.27 6.27 0 0 0-.86-.06 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.55a8.19 8.19 0 0 0 4.77 1.52V6.69h-1.01z"/></svg>
                      {%- when 'linkedin' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                      {%- when 'telegram' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                      {%- when 'threads' -%}
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.187.408-2.26 1.33-3.02.88-.724 2.147-1.134 3.664-1.19 1.07-.04 2.054.05 2.953.262-.08-.794-.32-1.415-.72-1.848-.492-.53-1.27-.817-2.256-.83l-.077-.001c-.735 0-1.727.209-2.29.852l-1.568-1.3c.9-1.028 2.235-1.57 3.858-1.57l.095.001c2.87.043 4.584 1.707 4.785 4.619.06.038.12.077.177.117 1.212.83 2.108 1.86 2.593 2.98.77 1.778.837 4.705-1.473 6.967-1.792 1.756-3.96 2.517-7.028 2.54zm-.326-7.97c-1.37.052-2.593.48-2.593 1.652 0 .9.893 1.5 2.216 1.5l.235-.006c1.26-.068 2.789-.752 2.916-3.39a10.704 10.704 0 0 0-2.774-.757z"/></svg>
                      {%- when 'custom' -%}
                        {%- if block.settings.social_svg != blank -%}
                          {{ block.settings.social_svg }}
                        {%- endif -%}
                    {%- endcase -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5d6c3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#C61D23"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#C61D23"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_type",
      "label": "Logo Type",
      "options": [
        {
          "value": "text",
          "label": "Store Name"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "svg",
          "label": "SVG Code"
        }
      ],
      "default": "text"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "html",
      "id": "logo_svg",
      "label": "Logo SVG Code"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo Width (Desktop)",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo Width (Mobile)",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Payment"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_title",
      "label": "Payment Section Title",
      "default": "Payment Options"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Section Title",
      "default": "Follow Us"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Corporate Office"
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "payment_icon",
      "name": "Payment Icon",
      "settings": [
        {
          "type": "text",
          "id": "payment_label",
          "label": "Label",
          "default": "Visa",
          "info": "Name of the payment method (e.g. Visa, Mastercard, RuPay)"
        },
        {
          "type": "html",
          "id": "payment_svg",
          "label": "SVG Icon Code",
          "info": "Paste the SVG code for the payment icon"
        }
      ]
    },
    {
      "type": "social_icon",
      "name": "Social Icon",
      "settings": [
        {
          "type": "select",
          "id": "social_platform",
          "label": "Platform",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "x", "label": "X (Twitter)" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "linkedin", "label": "LinkedIn" },
            { "value": "telegram", "label": "Telegram" },
