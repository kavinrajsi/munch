  <input id="search-input" class="search-box" type="text" placeholder="Search places...">
  <div id="map"></div>

  <script>
    let map;

    function initMap() {
      map = new google.maps.Map(document.getElementById('map'), {
        center: { lat: 13.0827, lng: 80.2707 }, // Chennai center
        zoom: 10,
      });

      const locations = [
        { name: 'Aminjikarai', lat: 13.0784, lng: 80.2304 },
        { name: 'Anna Nagar East', lat: 13.0902, lng: 80.2165 },
        { name: 'Arumbakkam', lat: 13.0773, lng: 80.2173 },
        { name: 'Kanchipuram', lat: 12.8342, lng: 79.7036 },
        { name: 'Kilpauk', lat: 13.0826, lng: 80.2445 },
        { name: 'Mylapore', lat: 13.0331, lng: 80.2694 },
        { name: 'Nerkundram', lat: 13.0692, lng: 80.1864 },
        { name: 'Nungambakkam', lat: 13.0595, lng: 80.24 },
        { name: 'Nithya Amirtham', lat: 13.0595, lng: 80.24 },
        { name: 'Perambur', lat: 13.1162, lng: 80.2301 },
        { name: 'Saligramam', lat: 13.0542, lng: 80.2084 },
        { name: 'Thiruvallur', lat: 13.1401, lng: 79.9093 },
        { name: 'Washermenpet', lat: 13.1176, lng: 80.2909 },
      ];

      // Add markers for all store locations
      locations.forEach((loc) => {
        new google.maps.Marker({
          position: { lat: loc.lat, lng: loc.lng },
          map: map,
          title: loc.name,
        });
      });

      // Add search box
      const input = document.getElementById('search-input');
      const searchBox = new google.maps.places.SearchBox(input);

      // Bias results to current map's viewport
      map.addListener('bounds_changed', () => {
        searchBox.setBounds(map.getBounds());
      });

      // On selecting a place
      searchBox.addListener('places_changed', () => {
        const places = searchBox.getPlaces();

        if (places.length === 0) return;

        // Zoom to first result
        const bounds = new google.maps.LatLngBounds();
        places.forEach((place) => {
          if (!place.geometry) return;
          bounds.extend(place.geometry.location);
        });
        map.fitBounds(bounds);
      });
    }
  </script>

