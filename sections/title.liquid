<div
  class="title-section section-padding"
  style="text-align: {{ section.settings.alignment }};"
  {{ section.shopify_attributes }}
>
  <div class="container">
    {%- if section.settings.title != blank -%}
      <{{ section.settings.heading_tag }} class="title-section__heading">
        {{ section.settings.title }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.show_separator -%}
      {%- liquid
        case section.settings.alignment
          when 'left'
            assign separator_svg = section.settings.separator_svg_left
          when 'right'
            assign separator_svg = section.settings.separator_svg_right
          when 'center'
            assign separator_svg = section.settings.separator_svg_center
        endcase
      -%}

      {%- if separator_svg != blank -%}
        <div class="title-section__separator" style="
          {%- case section.settings.alignment -%}
            {%- when 'left' -%}
              margin-right: auto;
            {%- when 'right' -%}
              margin-left: auto;
            {%- when 'center' -%}
              margin-left: auto;
              margin-right: auto;
          {%- endcase -%}
        ">
          {{ separator_svg }}
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Title",
  "tag": "section",
  "class": "title-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Section Title"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
{
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator",
      "default": true
    },
    {
      "type": "html",
      "id": "separator_svg_left",
      "label": "Separator SVG (Left)",
      "info": "Paste SVG code for left-aligned separator"
    },
    {
      "type": "html",
      "id": "separator_svg_center",
      "label": "Separator SVG (Center)",
      "info": "Paste SVG code for center-aligned separator"
    },
    {
      "type": "html",
      "id": "separator_svg_right",
      "label": "Separator SVG (Right)",
      "info": "Paste SVG code for right-aligned separator"
    }
  ],
  "presets": [
    {
      "name": "Title",
      "category": "Text"
    }
  ]
}
{% endschema %}
