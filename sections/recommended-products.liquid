<div
  class="recommended-products"
  data-recommended-products
  data-section-id="{{ section.id }}"
  data-products-to-show="{{ section.settings.products_to_show }}"
  {% if product != blank %}data-product-id="{{ product.id }}"{% endif %}
  {{ section.shopify_attributes }}
>
  {%- if section.settings.heading != blank -%}
    <h2 class="recommended-products__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="recommended-products__grid" data-recommended-products-grid>
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for product in recommendations.products -%}
        <div class="recommended-products__item">
          <a href="{{ product.url }}" class="recommended-products__link">
            <div class="recommended-products__image-wrapper">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 832, height: 1032, crop: 'center' }}"
                  srcset="
                    {{ product.featured_image | image_url: width: 416, height: 516, crop: 'center' }} 416w,
                    {{ product.featured_image | image_url: width: 624, height: 774, crop: 'center' }} 624w,
                    {{ product.featured_image | image_url: width: 832, height: 1032, crop: 'center' }} 832w
                  "
                  sizes="(max-width: 749px) 50vw, 25vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="832"
                  height="1032"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'recommended-products__placeholder' }}
              {%- endif -%}
            </div>
            <div class="recommended-products__content">
              {%- if section.settings.show_vendor -%}
                <p class="recommended-products__vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <h3 class="recommended-products__title">{{ product.title }}</h3>
              {%- if section.settings.show_price -%}
                <p class="recommended-products__price">{{ product.price | money }}</p>
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="recommended-products__item recommended-products__item--placeholder">
          <div class="recommended-products__image-wrapper">
            {{ 'product-1' | placeholder_svg_tag: 'recommended-products__placeholder' }}
          </div>
          <div class="recommended-products__content">
            <h3 class="recommended-products__title">Product title</h3>
            <p class="recommended-products__price">$0.00</p>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var section = document.querySelector('[data-recommended-products]');
    if (!section) return;

    var productId = section.dataset.productId;
    if (!productId) return;

    var limit = section.dataset.productsToShow || 4;
    var sectionId = section.dataset.sectionId;
    var grid = section.querySelector('[data-recommended-products-grid]');
    if (!grid) return;

    fetch(
      '/recommendations/products?section_id=' + sectionId +
      '&product_id=' + productId +
      '&limit=' + limit
    )
      .then(function (res) { return res.text(); })
      .then(function (html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var newGrid = doc.querySelector('[data-recommended-products-grid]');
        if (newGrid) grid.innerHTML = newGrid.innerHTML;
      })
      .catch(function () {});
  })();
</script>

{% schema %}
{
  "name": "Recommended products",
  "tag": "section",
  "class": "recommended-products-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 2,
      "default": 4
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Recommended products",
      "category": "Products"
    }
  ]
}
{% endschema %}
