{%- style -%}
  .countdown-timer {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 750px) {
    .countdown-timer {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .countdown-timer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  @media (min-width: 990px) {
    .countdown-timer__inner {
      flex-direction: row;
      justify-content: center;
      gap: 40px;
    }
  }

  .countdown-timer__title {
    font-family: var(--font-heading-family, "Aller", sans-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-headings, inherit);
    margin: 0;
    white-space: nowrap;
  }
  @media (min-width: 750px) {
    .countdown-timer__title {
      font-size: 1.75rem;
    }
  }

  .countdown-timer__grid {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .countdown-timer__group {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 16px;
  }
  @media (min-width: 750px) {
    .countdown-timer__group {
      padding: 0 24px;
    }
  }

  .countdown-timer__group + .countdown-timer__group {
    border-left: 1px solid var(--color-headings, currentColor);
    opacity: 1;
  }

  .countdown-timer__digit {
    font-family: var(--font-heading-family, "Aller", sans-serif);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-headings, inherit);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 750px) {
    .countdown-timer__digit {
      font-size: 3rem;
    }
  }

  .countdown-timer__label {
    margin-top: 4px;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-headings, inherit);
  }
  @media (min-width: 750px) {
    .countdown-timer__label {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }
  }

  .countdown-timer__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  @media (min-width: 990px) {
    .countdown-timer__right {
      flex-direction: row;
      gap: 32px;
    }
  }

  .countdown-timer__description {
    font-size: 0.875rem;
    color: var(--color-text, inherit);
    margin: 0;
    text-align: center;
  }
  @media (min-width: 990px) {
    .countdown-timer__description {
      font-size: 1rem;
      text-align: left;
    }
  }

  .countdown-timer__cta .btn--outline {
    background: transparent;
    border: 1px solid var(--color-headings, currentColor);
    color: var(--color-headings, inherit);
    border-radius: 0;
    padding: 12px 28px;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .countdown-timer__cta .btn--outline:hover {
    background: var(--color-headings, currentColor);
    color: var(--color-background, #fff);
  }

  .countdown-timer__expired {
    font-size: 1.25rem;
    color: var(--color-text, inherit);
    padding: 16px 0;
  }
{%- endstyle -%}

<div class="countdown-timer color-{{ section.settings.color_scheme }}" data-countdown-section data-end-date="{{ section.settings.end_date }}" data-end-time="{{ section.settings.end_time }}" data-expiry-action="{{ section.settings.expiry_action }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="countdown-timer__inner" data-countdown-content>
      {%- if section.settings.title != blank -%}
        <h2 class="countdown-timer__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      <div class="countdown-timer__grid" data-countdown-grid>
        <div class="countdown-timer__group">
          <span class="countdown-timer__digit" data-countdown-days>0</span>
          <span class="countdown-timer__label">Days</span>
        </div>
        <div class="countdown-timer__group">
          <span class="countdown-timer__digit" data-countdown-hours>00</span>
          <span class="countdown-timer__label">Hours</span>
        </div>
        <div class="countdown-timer__group">
          <span class="countdown-timer__digit" data-countdown-mins>00</span>
          <span class="countdown-timer__label">Minutes</span>
        </div>
        <div class="countdown-timer__group">
          <span class="countdown-timer__digit" data-countdown-secs>00</span>
          <span class="countdown-timer__label">Seconds</span>
        </div>
      </div>

      <div class="countdown-timer__right">
        {%- if section.settings.description != blank -%}
          <p class="countdown-timer__description">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div class="countdown-timer__cta" data-countdown-cta>
            <a href="{{ section.settings.button_link }}" class="btn btn--outline">
              {{ section.settings.button_text }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="countdown-timer__expired" data-countdown-expired style="display:none;">
      {{ section.settings.expired_message }}
    </div>
  </div>
</div>

<script>
  (function() {
    var section = document.querySelector('[{{ section.shopify_attributes }}]');
    if (!section) return;

    var endDate = section.dataset.endDate;
    var endTime = section.dataset.endTime || '00:00';
    if (!endDate) return;

    var target = new Date(endDate + 'T' + endTime + ':00').getTime();
    var contentEl = section.querySelector('[data-countdown-content]');
    var expiredEl = section.querySelector('[data-countdown-expired]');
    var daysEl = section.querySelector('[data-countdown-days]');
    var hoursEl = section.querySelector('[data-countdown-hours]');
    var minsEl = section.querySelector('[data-countdown-mins]');
    var secsEl = section.querySelector('[data-countdown-secs]');
    var expiryAction = section.dataset.expiryAction;

    function pad(n) { return n < 10 ? '0' + n : n; }

    function update() {
      var now = Date.now();
      var diff = target - now;

      if (diff <= 0) {
        clearInterval(timer);
        if (expiryAction === 'hide') {
          section.style.display = 'none';
        } else {
          contentEl.style.display = 'none';
          expiredEl.style.display = '';
        }
        return;
      }

      var days = Math.floor(diff / 86400000);
      var hours = Math.floor((diff % 86400000) / 3600000);
      var mins = Math.floor((diff % 3600000) / 60000);
      var secs = Math.floor((diff % 60000) / 1000);

      daysEl.textContent = days;
      hoursEl.textContent = pad(hours);
      minsEl.textContent = pad(mins);
      secsEl.textContent = pad(secs);
    }

    update();
    var timer = setInterval(update, 1000);
  })();
</script>

{% schema %}
{
  "name": "Countdown Timer",
  "tag": "section",
  "class": "countdown-timer-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Annual Sale Event"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Save on all best selling and exclusive styles"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date",
      "info": "Format: YYYY-MM-DD (e.g. 2026-12-31)",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time (24h)",
      "info": "Format: HH:MM (e.g. 18:00)",
      "default": "00:00"
    },
    {
      "type": "select",
      "id": "expiry_action",
      "label": "When countdown ends",
      "options": [
        { "value": "hide", "label": "Hide section" },
        { "value": "show_message", "label": "Show expired message" }
      ],
      "default": "show_message"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "This offer has ended."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "GET NOTIFIED"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F0EB"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
