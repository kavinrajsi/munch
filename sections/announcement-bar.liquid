{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar{% if section.settings.pause_on_hover %} announcement-bar--pause-hover{% endif %}{% if section.settings.pause_on_focus %} announcement-bar--pause-focus{% endif %}"
    data-announcement-bar
    data-section-id="{{ section.id }}"
    data-dismiss-duration="{{ section.settings.dismiss_duration }}"
    data-announcement-speed="{{ section.settings.scroll_speed }}s"
    data-announcement-bg="{{ section.settings.bg_color }}"
    data-announcement-text="{{ section.settings.text_color }}"
    data-announcement-pt="{{ section.settings.padding_top_desktop }}px"
    data-announcement-pb="{{ section.settings.padding_bottom_desktop }}px"
    data-announcement-pt-m="{{ section.settings.padding_top_mobile }}px"
    data-announcement-pb-m="{{ section.settings.padding_bottom_mobile }}px"
    style="
      --announcement-speed: {{ section.settings.scroll_speed }}s;
      --announcement-bg-color: {{ section.settings.bg_color }};
      --announcement-text-color: {{ section.settings.text_color }};
      --announcement-padding-top: {{ section.settings.padding_top_desktop }}px;
      --announcement-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      --announcement-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --announcement-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --announcement-gap: {{ section.settings.gap_desktop }}px;
      --announcement-gap-mobile: {{ section.settings.gap_mobile }}px;
      --announcement-font-size: {{ section.settings.font_size_desktop }}px;
      --announcement-font-size-mobile: {{ section.settings.font_size_mobile }}px;
    "
    role="region"
    aria-label="{{ 'sections.announcement_bar.close' | t }}"
  >
    <div class="announcement-bar__inner{% if section.settings.container_type == 'box' %} container{% endif %}">
      <div class="announcement-bar__rotator" data-announcement-rotator>
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </a>
          {%- else -%}
            <span class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button
        class="announcement-bar__close"
        data-announcement-close
        aria-label="{{ 'sections.announcement_bar.close' | t }}"
        type="button"
      >
        {%- if section.settings.close_icon_svg != blank -%}
          {{ section.settings.close_icon_svg }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        {%- endif -%}
      </button>
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    var bar = document.querySelector('[data-announcement-bar]');
    if (!bar) return;

    var sectionId = bar.dataset.sectionId;
    var storageKey = 'announcement-dismissed-' + sectionId;
    var dismissDuration = parseInt(bar.dataset.dismissDuration, 10);
    var dismissed = localStorage.getItem(storageKey);

    if (dismissed && dismissDuration > 0) {
      var dismissedAt = parseInt(dismissed, 10);
      if (Date.now() - dismissedAt < dismissDuration) {
        bar.style.display = 'none';
        return;
      }
      localStorage.removeItem(storageKey);
    }

    var closeBtn = bar.querySelector('[data-announcement-close]');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        bar.style.display = 'none';
        if (dismissDuration > 0) {
          localStorage.setItem(storageKey, Date.now().toString());
        }
      });
    }

    // Text rotator
    var rotator = bar.querySelector('[data-announcement-rotator]');
    if (rotator) {
      var slides = rotator.querySelectorAll('.announcement-bar__slide');
      if (slides.length > 1) {
        var current = 0;
        var speed = (parseInt(bar.dataset.announcementSpeed, 10) || 6) * 1000;
        var paused = false;

        bar.addEventListener('mouseenter', function () { paused = true; });
        bar.addEventListener('mouseleave', function () { paused = false; });

        setInterval(function () {
          if (paused) return;
          slides[current].classList.remove('is-active');
          current = (current + 1) % slides.length;
          slides[current].classList.add('is-active');
        }, speed);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 3,
      "max": 30,
      "step": 1,
      "default": 6,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_focus",
      "label": "Pause on Focus",
      "default": true
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container",
      "options": [
        { "value": "fluid", "label": "Full Width" },
        { "value": "box", "label": "Boxed" }
      ],
      "default": "fluid"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Marquee Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 10,
      "max": 100,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Font Size"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile",
      "min": 8,
      "max": 20,
      "step": 1,
      "default": 11,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#C61D23"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "dismiss_duration",
      "label": "Stay hidden after close",
      "options": [
        { "value": "0", "label": "Until page reload" },
        { "value": "86400000", "label": "24 hours" },
        { "value": "604800000", "label": "1 week" },
        { "value": "2592000000", "label": "30 days" }
      ],
      "default": "604800000"
    },
    {
      "type": "textarea",
      "id": "close_icon_svg",
      "label": "Custom Close Icon (SVG)",
      "info": "Leave blank for default"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Announcement text here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        }
      ]
    }
  ]
}
{% endschema %}
