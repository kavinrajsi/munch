{%- capture announcement_items -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="announcement-bar__item" {{ block.shopify_attributes }}>
        {{- block.settings.text -}}
      </a>
    {%- else -%}
      <span class="announcement-bar__item" {{ block.shopify_attributes }}>
        {{- block.settings.text -}}
      </span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if section.blocks.size > 0 and announcement_items != blank -%}
  <div
    class="announcement-bar"
    data-section-id="{{ section.id }}"
    data-speed="{{ section.settings.scroll_speed }}"
    data-text-color="{{ section.settings.text_color }}"
    data-bg-color="{{ section.settings.bg_color }}"
    data-padding-top="{{ section.settings.padding_top_desktop }}"
    data-padding-bottom="{{ section.settings.padding_bottom_desktop }}"
    data-padding-top-mobile="{{ section.settings.padding_top_mobile }}"
    data-padding-bottom-mobile="{{ section.settings.padding_bottom_mobile }}"
  >
    <div class="announcement-bar__inner{% if section.settings.container_type == 'box' %} page-width{% endif %}">
      <div class="announcement-bar__scroll" role="region" aria-label="Announcement" aria-live="off">
        <div class="announcement-bar__track">
          <div class="announcement-bar__group">
            {{ announcement_items }}
          </div>
          <div class="announcement-bar__group" aria-hidden="true">
            {{ announcement_items }}
          </div>
        </div>
      </div>
      <button type="button" class="announcement-bar__close" aria-label="Close announcement" data-announcement-close>
        {%- if section.settings.close_icon_svg != blank -%}
          {{ section.settings.close_icon_svg }}
        {%- else -%}
          &times;
        {%- endif -%}
      </button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds)",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 46
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "options": [
        { "value": "fluid", "label": "Fluid" },
        { "value": "box", "label": "Box" }
      ],
      "default": "fluid",
      "info": "Box uses the page width from theme settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "close_icon_svg",
      "label": "Close icon (SVG code)",
      "info": "Paste full SVG markup, e.g. <svg ...>...</svg>"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Announcement text here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Enjoy FREE delivery on orders above ₹999. Order now!"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Website orders: Delivery in 3–5 days across India and 4–7 days internationally"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Freshly made, preservative-free sweets delivered to your doorstep"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Authentic South Indian snacks crafted in small batches"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Festive gift boxes available — limited stock"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Need help? Call us or WhatsApp for quick support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
