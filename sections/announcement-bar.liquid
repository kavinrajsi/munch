{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "id": "text",
          "type": "text",
          "label": "Announcement text",
          "default": "Welcome to our store!"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_color",
      "label": "Background color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Default announcement bar",
      "category": "Header",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping on orders over $50!"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New arrivals just landed!"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Subscribe to our newsletter for 10% off!"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% if section.settings.show_announcement %}
  <div
    class="announcement-bar"
    style="background-color: {{ section.settings.announcement_color }}; color: {{ section.settings.announcement_text_color }}; text-align: center; padding: 10px; overflow: hidden; position: relative;"
  >
    <div
      id="announcement-wrapper-{{ section.id }}"
      class="announcement-scroll"
      style="white-space: nowrap; overflow: hidden;"
    >
      {% for block in section.blocks %}
        <span
          class="announcement-text "
        >
          {{ block.settings.text }}
        </span>
      {% endfor %}
    </div>
  </div>
{% endif %}
