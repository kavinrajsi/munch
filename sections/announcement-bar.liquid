{%- capture announcement_items -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="announcement-bar__item" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
      </a>
    {%- else -%}
      <span class="announcement-bar__item" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
      </span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar{% if section.settings.pause_on_hover %} announcement-bar--pause-hover{% endif %}{% if section.settings.pause_on_focus %} announcement-bar--pause-focus{% endif %}"
    data-announcement-bar
    data-section-id="{{ section.id }}"
    data-announcement-speed="{{ section.settings.scroll_speed }}s"
    data-announcement-bg="{{ section.settings.bg_color }}"
    data-announcement-text="{{ section.settings.text_color }}"
    data-announcement-pt="{{ section.settings.padding_top_desktop }}px"
    data-announcement-pb="{{ section.settings.padding_bottom_desktop }}px"
    data-announcement-pt-m="{{ section.settings.padding_top_mobile }}px"
    data-announcement-pb-m="{{ section.settings.padding_bottom_mobile }}px"
    style="
      --announcement-speed: {{ section.settings.scroll_speed }}s;
      --announcement-bg-color: {{ section.settings.bg_color }};
      --announcement-text-color: {{ section.settings.text_color }};
      --announcement-padding-top: {{ section.settings.padding_top_desktop }}px;
      --announcement-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      --announcement-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --announcement-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    "
    role="region"
    aria-label="{{ 'sections.announcement_bar.close' | t }}"
  >
    <div class="announcement-bar__inner{% if section.settings.container_type == 'box' %} page-width{% endif %}">
      <div class="announcement-bar__scroll">
        <div class="announcement-bar__track">
          {{ announcement_items }}
          {{ announcement_items }}
        </div>
      </div>

      <button
        class="announcement-bar__close"
        data-announcement-close
        aria-label="{{ 'sections.announcement_bar.close' | t }}"
        type="button"
      >
        {%- if section.settings.close_icon_svg != blank -%}
          {{ section.settings.close_icon_svg }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        {%- endif -%}
      </button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 46,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_focus",
      "label": "Pause on Focus",
      "default": true
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container",
      "options": [
        { "value": "fluid", "label": "Full Width" },
        { "value": "box", "label": "Boxed" }
      ],
      "default": "fluid"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "close_icon_svg",
      "label": "Custom Close Icon (SVG)",
      "info": "Leave blank for default"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Announcement text here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Enjoy FREE delivery on orders above ₹999. Order now!" } },
        { "type": "announcement", "settings": { "text": "Website orders: Delivery in 3–5 days across India and 4–7 days internationally" } },
        { "type": "announcement", "settings": { "text": "Freshly made, preservative-free sweets delivered to your doorstep" } },
        { "type": "announcement", "settings": { "text": "Authentic South Indian snacks crafted in small batches" } },
        { "type": "announcement", "settings": { "text": "Festive gift boxes available — limited stock" } },
        { "type": "announcement", "settings": { "text": "Need help? Call us or WhatsApp for quick support" } }
      ]
    }
  ]
}
{% endschema %}
