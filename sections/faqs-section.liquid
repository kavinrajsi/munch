{% schema %}
{
  "name": "FAQs Section",
  "tag": "section",
  "class": "faqs-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "You can return any item within 30 days of purchase."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Default FAQs",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}

<section style="max-width: 800px; margin: 0 auto; padding: 2rem;">
  <h1>{{ section.settings.heading }}</h1>
  <div class="faq-items">
    {% for block in section.blocks %}
      {% if block.type == 'question' %}
        <div class="faq-item" style="margin-bottom: 1.5rem;">
          <h3>{{ block.settings.question }}</h3>
          <p>{{ block.settings.answer }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
