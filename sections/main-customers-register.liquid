<div class="customer-register section-padding">
  <div class="page-width">
    <h1>{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}

      <div class="field">
        <label class="field__label" for="FirstName">{{ 'customer.register.first_name' | t }}</label>
        <input class="field__input" type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
      </div>

      <div class="field">
        <label class="field__label" for="LastName">{{ 'customer.register.last_name' | t }}</label>
        <input class="field__input" type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
      </div>

      <div class="field">
        <label class="field__label" for="Email">{{ 'customer.register.email' | t }}</label>
        <input class="field__input" type="email" name="customer[email]" id="Email" autocomplete="email">
      </div>

      <div class="field">
        <label class="field__label" for="Password">{{ 'customer.register.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="Password">
      </div>

      <button type="submit" class="btn btn--primary">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "tag": "section",
  "settings": []
}
{% endschema %}
