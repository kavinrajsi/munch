<div class="article-page" {{ section.shopify_attributes }}>
  <div class="container">
    {%- comment -%} Hero Image {%- endcomment -%}
    {%- if article.image -%}
      <div class="article-page__hero">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          class="article-page__hero-img"
          width="1120"
          height="450"
          loading="eager"
        >
      </div>
    {%- endif -%}

    {%- comment -%} Title & Date {%- endcomment -%}
    <div class="article-page__header">
      <h1 class="article-page__title">{{ article.title }}</h1>
      <p class="article-page__date">{{ article.published_at | date: '%d %b %Y' }}</p>
    </div>

    {%- comment -%} Article Body {%- endcomment -%}
    <div class="article-page__content rte">
      {{ article.content }}
    </div>

    {%- comment -%} Tags {%- endcomment -%}
    {%- if article.tags.size > 0 -%}
      <div class="article-page__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-page__tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Comments {%- endcomment -%}
    {%- if blog.comments_enabled? -%}
      <div class="article-page__comments">
        <h3 class="article-page__comments-title">
          Comments
          {%- if article.comments_count > 0 -%}
            ({{ article.comments_count }})
          {%- endif -%}
        </h3>

        {%- paginate article.comments by 10 -%}
          {%- for comment in article.comments -%}
            <div class="article-page__comment">
              <p class="article-page__comment-meta">
                <strong>{{ comment.author }}</strong>
                <span>{{ comment.created_at | date: '%d %b %Y' }}</span>
              </p>
              <div class="article-page__comment-body">{{ comment.content }}</div>
            </div>
          {%- endfor -%}
        {%- endpaginate -%}

        <div class="article-page__comment-form">
          <h4 class="article-page__comment-form-title">Leave a comment</h4>

          {% form 'new_comment', article %}
            {%- if form.posted_successfully? -%}
              {%- if blog.moderated? -%}
                <p class="article-page__success">Your comment was posted successfully. We will publish it shortly.</p>
              {%- else -%}
                <p class="article-page__success">Your comment was posted successfully.</p>
              {%- endif -%}
            {%- endif -%}

            {%- if form.errors -%}
              <div class="article-page__errors">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="article-page__form-row">
              <input type="text" id="CommentAuthor" name="comment[author]" placeholder="Name*" value="{{ form.author }}" required class="article-page__input">
              <input type="email" id="CommentEmail" name="comment[email]" placeholder="Email*" value="{{ form.email }}" required class="article-page__input">
            </div>
            <textarea id="CommentBody" name="comment[body]" placeholder="Message" required class="article-page__textarea">{{ form.body }}</textarea>
            <button type="submit" class="article-page__submit-btn">Post Comment</button>
          {% endform %}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Navigation {%- endcomment -%}
    <div class="article-page__nav">
      {%- if blog.previous_article -%}
        <a href="{{ blog.previous_article }}" class="article-page__nav-link">← Previous</a>
      {%- else -%}
        <span></span>
      {%- endif -%}
      {%- if blog.next_article -%}
        <a href="{{ blog.next_article }}" class="article-page__nav-link">Next →</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Article Page",
  "tag": "section",
  "class": "main-article-section",
  "settings": []
}
{% endschema %}
