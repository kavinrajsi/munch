<div class="article-page" {{ section.shopify_attributes }}>
  <div class="container">
    {%- comment -%} Hero Image {%- endcomment -%}
    {%- if article.image -%}
      <div class="article-page__hero">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          srcset="{{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 900 }} 900w, {{ article.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 750px) 930px, calc(100vw - 32px)"
          alt="{{ article.image.alt | default: article.title | escape }}"
          class="article-page__hero-img"
          width="1120"
          height="450"
          loading="eager"
        >
      </div>
    {%- endif -%}

    {%- comment -%} Title & Date {%- endcomment -%}
    <div class="article-page__header">
      <h1 class="article-page__title">{{ article.title }}</h1>
      <p class="article-page__date">{{ article.published_at | date: '%d %b %Y' }}</p>
    </div>

    {%- comment -%} Article Body {%- endcomment -%}
    <div class="article-page__content rte">
      {{ article.content }}
    </div>

    {%- comment -%} Tags {%- endcomment -%}
    {%- if article.tags.size > 0 -%}
      <div class="article-page__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-page__tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Comments {%- endcomment -%}
    {%- if blog.comments_enabled? -%}
      <div class="article-page__comments">
        <h3 class="article-page__comments-title">
          {{ 'templates.blog.comments.title' | t }}
          {%- if article.comments_count > 0 -%}
            ({{ article.comments_count }})
          {%- endif -%}
        </h3>

        {%- paginate article.comments by 10 -%}
          {%- for comment in article.comments -%}
            <div class="article-page__comment">
              <p class="article-page__comment-meta">
                <strong>{{ comment.author }}</strong>
                <span>{{ comment.created_at | date: '%d %b %Y' }}</span>
              </p>
              <div class="article-page__comment-body">{{ comment.content }}</div>
            </div>
          {%- endfor -%}
        {%- endpaginate -%}

        <div class="article-page__comment-form">
          <h4 class="article-page__comment-form-title">{{ 'templates.blog.comments.leave_comment' | t }}</h4>

          {% form 'new_comment', article %}
            {%- if form.posted_successfully? -%}
              {%- if blog.moderated? -%}
                <p class="article-page__success">{{ 'templates.blog.comments.success_moderated' | t }}</p>
              {%- else -%}
                <p class="article-page__success">{{ 'templates.blog.comments.success' | t }}</p>
              {%- endif -%}
            {%- endif -%}

            {%- if form.errors -%}
              <div class="article-page__errors">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="article-page__form-row">
              <div class="article-page__field">
                <label for="CommentAuthor" class="visually-hidden">{{ 'templates.blog.comments.name' | t }}</label>
                <input type="text" id="CommentAuthor" name="comment[author]" placeholder="{{ 'templates.blog.comments.name_placeholder' | t }}" value="{{ form.author }}" required class="article-page__input">
              </div>
              <div class="article-page__field">
                <label for="CommentEmail" class="visually-hidden">{{ 'templates.blog.comments.email' | t }}</label>
                <input type="email" id="CommentEmail" name="comment[email]" placeholder="{{ 'templates.blog.comments.email_placeholder' | t }}" value="{{ form.email }}" required class="article-page__input">
              </div>
            </div>
            <div class="article-page__field">
              <label for="CommentBody" class="visually-hidden">{{ 'templates.blog.comments.body' | t }}</label>
              <textarea id="CommentBody" name="comment[body]" placeholder="{{ 'templates.blog.comments.message_placeholder' | t }}" required class="article-page__textarea">{{ form.body }}</textarea>
            </div>
            <button type="submit" class="article-page__submit-btn">{{ 'templates.blog.comments.submit' | t }}</button>
          {% endform %}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Navigation {%- endcomment -%}
    <div class="article-page__nav">
      {%- if blog.previous_article -%}
        <a href="{{ blog.previous_article }}" class="article-page__nav-link">&larr; {{ 'templates.blog.previous' | t }}</a>
      {%- else -%}
        <span></span>
      {%- endif -%}
      {%- if blog.next_article -%}
        <a href="{{ blog.next_article }}" class="article-page__nav-link">{{ 'templates.blog.next' | t }} &rarr;</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Article Page",
  "tag": "section",
  "class": "main-article-section",
  "settings": []
}
{% endschema %}
