<div class="customer-form section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <h1 class="customer-form__title">{{ 'customer.reset_password.title' | t }}</h1>

    {% form 'reset_customer_password' %}
      {%- if form.errors -%}
        <div class="customer-form__errors">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-group">
        <label for="Password">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="Password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="form-group">
        <label for="PasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="PasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t }}</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Reset Password",
  "tag": "section",
  "class": "main-customers-reset-section",
  "settings": []
}
{% endschema %}
