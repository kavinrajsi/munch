<div class="customer-reset-password section-padding">
  <div class="page-width">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>

    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}

      <div class="field">
        <label class="field__label" for="Password">{{ 'customer.reset_password.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="Password">
      </div>

      <div class="field">
        <label class="field__label" for="PasswordConfirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input class="field__input" type="password" name="customer[password_confirmation]" id="PasswordConfirmation">
      </div>

      <button type="submit" class="btn btn--primary">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Reset Password",
  "tag": "section",
  "settings": []
}
{% endschema %}
