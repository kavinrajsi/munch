<div
  class="collection-carousel"
  data-collection-carousel
  {{ section.shopify_attributes }}
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign collection = block.settings.collection
      assign image = block.settings.image | default: collection.featured_image
      assign title = collection.title
      assign url = collection.url | default: '#'
    -%}

    <div class="collection-carousel__item" {{ block.shopify_attributes }}>
      <a href="{{ url }}" class="collection-carousel__link" aria-label="{{ title | escape }}">
        <div class="collection-carousel__image-wrapper">
          {%- if image != blank -%}
            <picture>
              <source
                media="(min-width: 750px)"
                srcset="
                  {{ image | image_url: width: 416, height: 516, crop: 'center' }} 416w,
                  {{ image | image_url: width: 624, height: 774, crop: 'center' }} 624w,
                  {{ image | image_url: width: 832, height: 1032, crop: 'center' }} 832w
                "
                sizes="25vw"
                width="832"
                height="1032"
              >
              <img
                src="{{ image | image_url: width: 316, height: 396, crop: 'center' }}"
                srcset="
                  {{ image | image_url: width: 316, height: 396, crop: 'center' }} 316w,
                  {{ image | image_url: width: 632, height: 792, crop: 'center' }} 632w
                "
                sizes="70vw"
                alt="{{ image.alt | default: title | escape }}"
                width="316"
                height="396"
                loading="lazy"
              >
            </picture>
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-carousel__placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if title != blank -%}
          <p class="collection-carousel__title">{{ title }}</p>
        {%- endif -%}
      </a>
    </div>
  {%- endfor -%}
</div>

<script>
  (function () {
    var el = document.querySelector('[data-collection-carousel]');
    if (!el || typeof $ === 'undefined') return;
    $(el).slick({
      slidesToShow: 4,
      slidesToScroll: 1,
      arrows: true,
      dots: false,
      infinite: false,
      responsive: [
        { breakpoint: 1024, settings: { slidesToShow: 3 } },
        { breakpoint: 768, settings: { slidesToShow: 2 } },
        { breakpoint: 480, settings: { slidesToShow: 1, dots: true } }
      ]
    });
  })();
</script>

{% schema %}
{
  "name": "Collection list: Carousel",
  "tag": "section",
  "class": "collection-carousel-section",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the collection image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list: Carousel",
      "category": "Collection",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
