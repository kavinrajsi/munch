  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "header",
        "content": "Logo"
      },
      {
        "type": "select",
        "id": "logo_type",
        "label": "Logo Type",
        "options": [
          { "value": "text", "label": "Text" },
          { "value": "image", "label": "PNG / Image" },
          { "value": "svg", "label": "SVG" }
        ],
        "default": "text"
      },
      {
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logo Image (PNG)",
        "info": "Used when Logo Type is set to PNG / Image"
      },
      {
        "type": "textarea",
        "id": "logo_svg",
        "label": "Logo SVG Code",
        "info": "Paste your SVG markup here. Used when Logo Type is set to SVG"
      },
      {
        "type": "range",
        "id": "logo_mobile_width",
        "label": "Logo Mobile Width",
        "min": 40,
        "max": 200,
        "step": 10,
        "default": 100,
        "unit": "px",
        "info": "Applies to PNG and SVG logos on mobile"
      },
      {
        "type": "range",
        "id": "logo_desktop_width",
        "label": "Logo Desktop Width",
        "min": 40,
        "max": 300,
        "step": 10,
        "default": 140,
        "unit": "px",
        "info": "Applies to PNG and SVG logos on desktop"
      },
      {
        "type": "header",
        "content": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32x32px .png recommended"
      }
    ]
  },
