{%- comment -%}
  Renders a featured collection carousel product card.
  Usage: {% render 'fcc-product-card', product: product, show_vendor: false, show_price: true %}
{%- endcomment -%}

<div class="feat-collection-carousel__item">
  <a href="{{ product.url }}" class="feat-collection-carousel__link">
    <div class="feat-collection-carousel__image-wrapper">
      {%- if product.featured_image != blank -%}
        {{ product.featured_image
          | image_url: width: 1100
          | image_tag:
              widths: '165, 360, 535, 750, 940, 1100',
              sizes: '313px',
              loading: 'lazy',
              fetchpriority: 'low',
              class: 'm:w-full m:h-full',
              alt: product.title
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'feat-collection-carousel__placeholder' }}
      {%- endif -%}
    </div>
    <div class="feat-collection-carousel__content">
      {%- if show_vendor -%}
        <p class="feat-collection-carousel__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h3 class="feat-collection-carousel__title">{{ product.title }}</h3>
      {%- if settings.judgeme_enabled -%}
        <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" style="margin: 4px 0;">
          {{ product.metafields.judgeme.badge }}
        </div>
      {%- endif -%}
      {%- if show_price -%}
        <p class="feat-collection-carousel__price">{{ product.first_available_variant.price | money }}</p>
      {%- endif -%}
    </div>
  </a>
  <div class="feat-collection-carousel__controls" data-fcc-controls>
    <div class="feat-collection-carousel__buy-row">
      {%- if product.variants.size > 1 -%}
        <div class="feat-collection-carousel__variant-select-wrap">
          <select class="feat-collection-carousel__variant-select" data-fcc-variant-select>
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                data-variant-price="{{ variant.price | money }}"
                data-variant-available="{{ variant.available }}"
                {% if variant.id == product.first_available_variant.id %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} – {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>
          <svg class="feat-collection-carousel__variant-chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="1 1 5 5 9 1"/>
          </svg>
        </div>
      {%- else -%}
        <div class="feat-collection-carousel__variant-select-wrap">
          <select class="feat-collection-carousel__variant-select" data-fcc-variant-select>
            <option value="{{ product.first_available_variant.id }}">
              {{ product.first_available_variant.title }} – {{ product.first_available_variant.price | money }}
            </option>
          </select>
          <svg class="feat-collection-carousel__variant-chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="1 1 5 5 9 1"/>
          </svg>
        </div>
      {%- endif -%}

      {%- if product.available -%}
        <button
          class="feat-collection-carousel__atc"
          type="button"
          data-variant-id="{{ product.first_available_variant.id }}"
          data-fcc-add-to-cart
        >
          Add to cart
        </button>
      {%- else -%}
        <button class="feat-collection-carousel__atc feat-collection-carousel__atc--sold-out" type="button" disabled>
          Sold Out
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
