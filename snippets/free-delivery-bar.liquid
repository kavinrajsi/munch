{%- liquid
  assign fd_enabled = settings.cart_free_delivery_enabled
  unless fd_enabled
    break
  endunless

  assign threshold_rupees = settings.cart_free_delivery_threshold | default: '1000' | times: 1
  assign free_delivery_threshold = threshold_rupees | times: 100
  assign cart_total = cart.total_price
  assign remaining = free_delivery_threshold | minus: cart_total
  if remaining < 0
    assign remaining = 0
  endif

  assign success_msg = settings.cart_free_delivery_success_message | default: "You've unlocked free delivery!"
-%}

<div
  class="free-delivery-bar{% if cart.item_count > 0 and remaining > 0 %} is-visible{% endif %}"
  data-free-delivery-bar
  data-threshold="{{ free_delivery_threshold }}"
  data-success-msg="{{ success_msg | escape }}"
>
  <p class="free-delivery-bar__message" data-free-delivery-message>
    {%- if remaining > 0 -%}
      Order for {{ remaining | money }} more for unlocking free delivery
    {%- endif -%}
  </p>
</div>
