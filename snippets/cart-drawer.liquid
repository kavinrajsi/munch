{%- liquid
  assign show_image = settings.cart_show_product_image | default: true
  assign show_variant = settings.cart_show_variant | default: true
  assign empty_btn_link = settings.cart_empty_btn_link | default: '/collections/all'
-%}

<div
  class="cart-drawer"
  id="CartDrawer"
  data-cart-drawer
  data-show-image="{{ show_image }}"
  data-show-variant="{{ show_variant }}"
  data-empty-btn-link="{{ empty_btn_link }}"
>
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h3 class="cart-drawer__title">Shopping Cart</h3>
      <button class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="#0B090A" stroke-width="1.5">
          <line x1="1" y1="1" x2="10" y2="10"/>
          <line x1="10" y1="1" x2="1" y2="10"/>
        </svg>
      </button>
    </div>

    <div class="cart-drawer__items" data-cart-items>
      {%- if cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          <div class="cart-drawer__item" data-cart-item data-line="{{ forloop.index }}">
            {%- if show_image -%}
              <a href="{{ item.url }}" class="cart-drawer__item-image">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 190 }}"
                    alt="{{ item.title | escape }}"
                    width="95"
                    height="95"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>
            {%- endif -%}
            <div class="cart-drawer__item-info">
              <div class="cart-drawer__item-details">
                <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
                {%- if show_variant and item.variant.title != 'Default Title' -%}
                  <p class="cart-drawer__item-variant">Weight : <span>{{ item.variant.title }}</span></p>
                {%- endif -%}
                <p class="cart-drawer__item-price">{{ item.final_line_price | money }}</p>
              </div>
              <div class="cart-drawer__item-actions">
                <div class="cart-drawer__item-quantity">
                  <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
                  <span class="cart-drawer__qty-value" data-qty-input-display>{{ item.quantity }}</span>
                  <input type="number" value="{{ item.quantity }}" min="1" data-qty-input aria-label="Quantity">
                  <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                </div>
                <button class="cart-drawer__item-remove" data-remove-item type="button">Remove</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="cart-drawer__empty"></div>
      {%- endif -%}
    </div>

    <div class="cart-drawer__footer" {% if cart.item_count == 0 %}data-cart-empty-footer{% endif %}>
      {%- if cart.item_count > 0 -%}
        <div class="cart-drawer__subtotal">
          <span class="cart-drawer__subtotal-label">Subtotal</span>
          <span class="cart-drawer__subtotal-price" data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-drawer__footer-actions">
          <a href="{{ routes.cart_url }}/checkout" class="cart-drawer__checkout-btn">Check Out</a>
          <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">View Cart</a>
        </div>
      {%- else -%}
        <div class="cart-drawer__footer-actions">
          <a href="{{ empty_btn_link }}" class="cart-drawer__checkout-btn">Continue Shopping</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
