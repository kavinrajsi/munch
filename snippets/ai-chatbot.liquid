let isOpen = false, conversationHistory = [], isLoading = false;

window.addEventListener('DOMContentLoaded', () => {
  initChat();
});

function initChat() {
  addBotMessage(
    "Vanakkam! 🙏 Welcome to **Nithya Amirtham**! We have over 189 handcrafted traditional sweets, snacks, pickles, baklava, and gift hampers. What are you looking for today?",
    ['Popular Sweets 🍬', 'Crispy Snacks 🥨', 'Gift Hampers 🎁', 'Under ₹200 💰', 'Baklava 🌟']
  );
}

function naToggleChat() {
  isOpen = !isOpen;
  document.getElementById('na-chat-widget').classList.toggle('open', isOpen);
  document.documentElement.classList.toggle('chatbot-open', isOpen);
  document.body.classList.toggle('chatbot-open', isOpen);
  if (isOpen) {
    const b = document.getElementById('na-badge');
    if (b) b.style.display = 'none';
    setTimeout(() => document.getElementById('na-input')?.focus(), 350);
  }
}

function addBotMessage(text, quickReplies = []) {
  const msgs = document.getElementById('na-messages');
  const msgEl = document.createElement('div');
  msgEl.className = 'na-msg bot';
  let cleanText = text.replace(/\[PRODUCT:[^\]]+\]/g, '').trim();
  cleanText = cleanText.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  cleanText = cleanText.replace(/([\w.+-]+@[\w-]+\.[\w.]+)/g, '<a href="mailto:$1" style="color:#c61d23;text-decoration:underline;">$1</a>');
  cleanText = cleanText.replace(/(\+?[\d][\d\s\-]{7,}[\d])/g, (m) => `<a href="tel:${m.replace(/\s/g,'')}" style="color:#c61d23;text-decoration:underline;">${m}</a>`);
  const productMatches = [...text.matchAll(/\[PRODUCT:([^\]]+)\]/g)];
  const handles = productMatches.map(m => m[1].trim());
  let html = `<div class="na-msg-avatar"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="26" viewBox="0 0 30 48" fill="none"><g clip-path="url(#nai-sm)"><path fill="white" d="M14.45 0c1.013 2.375 2.646 7.949-.633 14.299-.989 1.916-2.245 3.727-3.461 5.479C6.8 24.9 3.15 30.162 5.508 38.58 1.075 32.47 0 27.439 0 23.998 0 12.889 10.91 2.939 14.45 0Z"/><path fill="white" d="M29.707 23.999c0-10.51-9.759-19.979-13.812-23.46.948 2.717 1.878 7.511-.406 12.928.126.275.256.551.401.83.989 1.915 2.245 3.727 3.461 5.478C22.906 24.9 26.555 30.16 24.2 38.578c4.435-6.11 5.51-11.142 5.51-14.582"/><path fill="white" d="M21.425 25.136c-.665 1.05-1.373 2.07-2.076 3.086-1.216 1.752-2.473 3.563-3.461 5.48-3.277 6.35-1.646 11.922-.633 14.298a55.748 55.748 0 0 0 6.723-6.642c3.011-7.098 1.827-11.936-.553-16.222Z"/><path fill="white" d="M13.82 33.701c-.99-1.916-2.246-3.727-3.462-5.479-.703-1.016-1.411-2.036-2.076-3.086-2.38 4.286-3.564 9.122-.556 16.219a56.035 56.035 0 0 0 6.086 6.103c-.947-2.716-1.878-7.51.406-12.927a17.293 17.293 0 0 0-.401-.83"/></g><defs><clipPath id="nai-sm"><path fill="#fff" d="M0 0h30v48H0z"/></clipPath></defs></svg></div><div><div class="na-msg-bubble">${cleanText}</div>`;
  handles.forEach(handle => {
    const p = PRODUCTS.find(x => x.handle === handle);
    if (p) html += `
      <div class="na-product-card">
        <img class="na-product-img" src="${p.image}" alt="${p.title}" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,'"/>
        <div class="na-product-info">
          <div class="na-product-name">${p.title}</div>
          <div class="na-product-price">${p.price}</div>
          <a class="na-product-link" href="https://nithyaamirtham.com/products/${p.handle}" target="_blank">View product →</a>
        </div>
      </div>`;
  });
  if (quickReplies.length) {
    html += '<div class="na-quick-replies">';
    quickReplies.forEach(qr => { html += `<button class="na-quick-btn" onclick="naQuickReply('${qr.replace(/'/g,"\'")}')"> ${qr}</button>`; });
    html += '</div>';
  }
  html += '</div>';
  msgEl.innerHTML = html;
  msgs.appendChild(msgEl);
  msgs.scrollTop = msgs.scrollHeight;
}

function addUserMessage(text) {
  const msgs = document.getElementById('na-messages');
