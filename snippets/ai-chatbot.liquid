{% if settings.chatbot_enabled and settings.chatbot_api_key != blank %}
  {%- capture system_prompt_base -%}
You are a helpful assistant for {{ shop.name }}.
Store description: {{ shop.description | strip_html | strip_newlines }}
Currency: {{ cart.currency.iso_code }}
{%- if shop.shipping_policy.body != blank %}
Shipping policy: {{ shop.shipping_policy.body | strip_html | strip_newlines | truncate: 500 }}
{%- endif -%}
{%- if shop.refund_policy.body != blank %}
Refund policy: {{ shop.refund_policy.body | strip_html | strip_newlines | truncate: 500 }}
{%- endif -%}
  {%- endcapture -%}

  <div
    class="chatbot"
    id="AiChatbot"
    data-chatbot
    data-model="{{ settings.chatbot_model }}"
    data-title="{{ settings.chatbot_title | escape }}"
    data-greeting="{{ settings.chatbot_greeting | escape }}"
    data-icon="{{ settings.chatbot_icon }}"
    style="--chatbot-accent: {{ settings.chatbot_accent_color }};"
  >
    <script type="application/json" data-chatbot-config>
      {
        "apiKey": "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",
        "systemPrompt": {{ system_prompt_base | strip | json }},
        "customPrompt": {{ settings.chatbot_system_prompt | json }}
      }
    </script>

    {%- comment -%} Floating trigger button {%- endcomment -%}
    <button class="chatbot__trigger" data-chatbot-toggle aria-label="Open chat">
      {% if settings.chatbot_icon == 'robot' %}
        <svg class="chatbot__trigger-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><line x1="12" y1="7" x2="12" y2="11"/><circle cx="8" cy="16" r="1"/><circle cx="16" cy="16" r="1"/>
        </svg>
      {% else %}
        <svg class="chatbot__trigger-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      {% endif %}
      <svg class="chatbot__trigger-close" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    {%- comment -%} Chat panel {%- endcomment -%}
    <div class="chatbot__panel">
      <div class="chatbot__header">
        <div class="chatbot__header-info">
          <h3 class="chatbot__title">{{ settings.chatbot_title }}</h3>
          <span class="chatbot__badge">Claude</span>
        </div>
        <button class="chatbot__close" data-chatbot-toggle aria-label="Close chat">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="chatbot__messages" data-chatbot-messages>
        {%- comment -%} Messages are appended via JS {%- endcomment -%}
      </div>

      <form class="chatbot__form" data-chatbot-form>
        <input
          class="chatbot__input"
          type="text"
          placeholder="Type a message..."
          data-chatbot-input
          autocomplete="off"
        />
        <button class="chatbot__send" type="submit" aria-label="Send message">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </form>
    </div>
  </div>
{% endif %}
