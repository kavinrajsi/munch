  el.innerHTML = '<div class="na-msg-avatar"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="26" viewBox="0 0 30 48" fill="none"><g clip-path="url(#nai-sm)"><path fill="white" d="M14.45 0c1.013 2.375 2.646 7.949-.633 14.299-.989 1.916-2.245 3.727-3.461 5.479C6.8 24.9 3.15 30.162 5.508 38.58 1.075 32.47 0 27.439 0 23.998 0 12.889 10.91 2.939 14.45 0Z"/><path fill="white" d="M29.707 23.999c0-10.51-9.759-19.979-13.812-23.46.948 2.717 1.878 7.511-.406 12.928.126.275.256.551.401.83.989 1.915 2.245 3.727 3.461 5.478C22.906 24.9 26.555 30.16 24.2 38.578c4.435-6.11 5.51-11.142 5.51-14.582"/><path fill="white" d="M21.425 25.136c-.665 1.05-1.373 2.07-2.076 3.086-1.216 1.752-2.473 3.563-3.461 5.48-3.277 6.35-1.646 11.922-.633 14.298a55.748 55.748 0 0 0 6.723-6.642c3.011-7.098 1.827-11.936-.553-16.222Z"/><path fill="white" d="M13.82 33.701c-.99-1.916-2.246-3.727-3.462-5.479-.703-1.016-1.411-2.036-2.076-3.086-2.38 4.286-3.564 9.122-.556 16.219a56.035 56.035 0 0 0 6.086 6.103c-.947-2.716-1.878-7.51.406-12.927a17.293 17.293 0 0 0-.401-.83"/></g><defs><clipPath id="nai-sm"><path fill="#fff" d="M0 0h30v48H0z"/></clipPath></defs></svg></div><div class="na-typing"><span></span><span></span><span></span></div>';
  msgs.appendChild(el);
  msgs.scrollTop = msgs.scrollHeight;
}
function hideTyping() { document.getElementById('na-typing-indicator')?.remove(); }

function naQuickReply(text) { document.getElementById('na-input').value = text; naSend(); }

async function naSend() {
  if (isLoading) return;
  const input = document.getElementById('na-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = ''; naAutoResize(input);
  addUserMessage(text);
  conversationHistory.push({ role: 'user', content: text });
  isLoading = true;
  document.getElementById('na-send-btn').disabled = true;
  showTyping();
  try {
    const resp = await fetch('/apps/chatbot/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        messages: conversationHistory,
        system: SYSTEM_PROMPT
      })
    });
    const data = await resp.json();
    hideTyping();
    if (data.error) {
      addBotMessage(`<span class="na-error">Error: ${data.error.message || 'Something went wrong. Please try again.'}</span>`);
    } else {
      const reply = data.content?.[0]?.text || "Sorry, I couldn't process that. Please try again.";
      conversationHistory.push({ role: 'assistant', content: reply });
      addBotMessage(reply);
    }
  } catch(err) {
    hideTyping();
    addBotMessage('<span class="na-error">Connection error. Please check your internet and try again.</span>');
  } finally {
    isLoading = false;
    document.getElementById('na-send-btn').disabled = false;
    input.focus();
  }
}

function naHandleKey(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); naSend(); } }
function naAutoResize(el) { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 80) + 'px'; }

// ── Voice Input (Web Speech API) ─────────────────────────────────
const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
let naRecognition = null;
let naIsRecording = false;

(function naInitVoice() {
  const micBtn = document.getElementById('na-mic-btn');
  if (!SpeechRecognition && micBtn) {
    micBtn.style.display = 'none';
  }
})();

function naToggleVoice() {
  if (!SpeechRecognition) return;
  if (naIsRecording) {
    naRecognition.stop();
    return;
  }
  naRecognition = new SpeechRecognition();
  naRecognition.lang = 'en-IN';
  naRecognition.interimResults = false;
  naRecognition.maxAlternatives = 1;

  const micBtn = document.getElementById('na-mic-btn');
  micBtn.classList.add('recording');
  naIsRecording = true;

  naRecognition.onresult = function(event) {
    const transcript = event.results[0][0].transcript;
    const input = document.getElementById('na-input');
    input.value = transcript;
    naAutoResize(input);
  };
  naRecognition.onend = function() {
    micBtn.classList.remove('recording');
    naIsRecording = false;
  };
  naRecognition.onerror = function() {
    micBtn.classList.remove('recording');
    naIsRecording = false;
  };
  naRecognition.start();
}

