{%- if settings.chatbot_enabled -%}
{% raw %}
<style>
  :root {
    --saffron: #c61d23; --gold: #c61d23; --cream: #FDF6EC;
    --deep-brown: #2D1A0E; --warm-brown: #5C3317;
    --light-sand: #F7EDD8; --accent-red: #C0392B;
  }

  /* Widget */
  #na-chat-widget { position:fixed; bottom:76px; right:24px; z-index:9999; font-family:"DM Sans",sans-serif; }

  #na-chat-toggle {
    width:62px; height:62px; border-radius:50%;
    background:#c61d23;
    border:none; cursor:pointer;
    box-shadow:0 4px 20px rgba(198,29,35,.4),0 2px 8px rgba(0,0,0,.15);
    display:flex; align-items:center; justify-content:center;
    transition:transform .3s cubic-bezier(.34,1.56,.64,1),box-shadow .3s;
    position:relative;
  }
  #na-chat-toggle::before { content:""; }
  #na-chat-toggle:hover { transform:scale(1.08); box-shadow:0 6px 28px rgba(198,29,35,.5); }
  #na-chat-toggle svg { transition:opacity .2s,transform .3s; }
  #na-chat-toggle .icon-chat { opacity:1; transform:scale(1) rotate(0deg); }
  #na-chat-toggle .icon-close { opacity:0; transform:scale(.5) rotate(-90deg); position:absolute; }
  #na-chat-widget.open #na-chat-toggle .icon-chat { opacity:0; transform:scale(.5) rotate(90deg); }
  #na-chat-widget.open #na-chat-toggle .icon-close { opacity:1; transform:scale(1) rotate(0deg); }
  #na-chat-toggle::after { content:""; }
  @keyframes pulse-ring { 0%{transform:scale(.9);opacity:1} 100%{transform:scale(1.4);opacity:0} }
  .na-badge { position:absolute; top:-2px; right:-2px; width:18px; height:18px; background:var(--accent-red); border-radius:50%; border:2px solid white; font-size:10px; color:white; display:flex; align-items:center; justify-content:center; font-weight:700; animation:bounce-in .5s cubic-bezier(.34,1.56,.64,1); }
  @keyframes bounce-in { 0%{transform:scale(0)} 100%{transform:scale(1)} }

  #na-chat-window {
    position:absolute; bottom:78px; right:0; width:390px; max-height:620px;
    background:#fff; border-radius:20px;
    box-shadow:0 24px 80px rgba(45,26,14,.18),0 8px 32px rgba(45,26,14,.12),0 0 0 1px rgba(200,147,26,.15);
    display:flex; flex-direction:column; overflow:hidden;
    transform-origin:bottom right; transform:scale(.85) translateY(10px);
    opacity:0; pointer-events:none;
    transition:transform .35s cubic-bezier(.34,1.4,.64,1),opacity .25s ease;
  }
  #na-chat-widget.open #na-chat-window { transform:scale(1) translateY(0); opacity:1; pointer-events:all; max-height:initial; }

  .na-header { background:#c61d23; padding:16px 20px; display:flex; align-items:center; gap:12px; position:relative; }
  .na-header::before { content:""; position:absolute; top:-20px; right:-20px; width:100px; height:100px; background:radial-gradient(circle,rgba(255,255,255,.1),transparent 70%); border-radius:50%; pointer-events:none; }
  .na-header-avatar { width:44px; height:44px; border-radius:50%; background:#ffffff; display:flex; align-items:center; justify-content:center; font-family:"Playfair Display",serif; font-size:18px; color:white; font-weight:700; flex-shrink:0; box-shadow:0 2px 8px rgba(0,0,0,.2); position:relative; }
  .na-status-dot { position:absolute; bottom:1px; right:1px; width:10px; height:10px; background:#2ECC71; border-radius:50%; border:2px solid var(--warm-brown); }
  .na-header-info { flex:1; }
  .na-header-name { font-family:"DM Sans",sans-serif; font-size:15px; color:#fff; font-weight:600; line-height:1.2; }
  .na-header-sub { font-size:11px; color:rgba(255,255,255,.6); margin-top:1px; }

  .na-messages { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:12px; background:linear-gradient(180deg,#fdf8f2,#fff); max-height:420px; min-height:280px; }
  .na-messages::-webkit-scrollbar { width:4px; }
  .na-messages::-webkit-scrollbar-thumb { background:rgba(200,147,26,.3); border-radius:2px; }

  .na-msg { display:flex; gap:8px; animation:msg-in .3s cubic-bezier(.34,1.3,.64,1); }
  @keyframes msg-in { from{opacity:0;transform:translateY(8px) scale(.96)} to{opacity:1;transform:translateY(0) scale(1)} }
  .na-msg.user { flex-direction:row-reverse; }
  .na-msg-avatar { width:28px; height:28px; border-radius:50%; background:linear-gradient(145deg,#c61d23,#c61d23); display:flex; align-items:center; justify-content:center; font-size:12px; color:white; flex-shrink:0; align-self:flex-end; font-family:"Playfair Display",serif; font-weight:700; }
  .na-msg-bubble { max-width:75%; padding:10px 14px; border-radius:16px; font-size:13.5px; line-height:1.5; color:var(--deep-brown); }
  .na-msg.bot .na-msg-bubble { background:var(--light-sand); border-bottom-left-radius:4px; border:1px solid rgba(200,147,26,.15); }
  .na-msg.user .na-msg-bubble { background:linear-gradient(135deg,#c61d23,#c61d23); color:white; border-bottom-right-radius:4px; }

  .na-product-card { background:white; border:1px solid rgba(200,147,26,.2); border-radius:12px; overflow:hidden; margin-top:8px; display:flex; gap:10px; padding:10px; transition:box-shadow .2s; }
  .na-product-card:hover { box-shadow:0 4px 16px rgba(200,147,26,.15); }
  .na-product-img { width:52px; height:52px; border-radius:8px; object-fit:cover; flex-shrink:0; background:var(--light-sand); }
  .na-product-info { flex:1; min-width:0; }
  .na-product-name { font-size:12px; font-weight:600; color:var(--deep-brown); overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
  .na-product-price { font-size:12px; color:var(--saffron); font-weight:700; margin-top:2px; }
  .na-product-link { font-size:11px; color:var(--gold); text-decoration:none; display:inline-flex; align-items:center; gap:3px; margin-top:4px; }

  .na-typing { display:flex; align-items:center; gap:4px; padding:10px 14px; background:var(--light-sand); border-radius:16px; border-bottom-left-radius:4px; width:fit-content; border:1px solid rgba(200,147,26,.15); }
  .na-typing span { width:6px; height:6px; background:var(--saffron); border-radius:50%; animation:typing-bounce 1.2s ease-in-out infinite; opacity:.6; }
  .na-typing span:nth-child(2){animation-delay:.2s} .na-typing span:nth-child(3){animation-delay:.4s}
  @keyframes typing-bounce { 0%,60%,100%{transform:translateY(0);opacity:.4} 30%{transform:translateY(-5px);opacity:1} }

  .na-quick-replies { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .na-quick-btn { padding:5px 11px; border-radius:20px; border:1.5px solid rgba(200,147,26,.4); background:white; font-size:12px; color:var(--warm-brown); cursor:pointer; transition:all .2s; font-family:"DM Sans",sans-serif; white-space:nowrap; }
  .na-quick-btn:hover { background:var(--light-sand); border-color:var(--saffron); color:var(--saffron); }

  .na-input-area { padding:12px 16px; border-top:1px solid rgba(200,147,26,.12); background:#fff; display:flex; gap:8px; align-items:flex-end; }
  .na-input-wrap { flex:1; background:#f9f3eb; border-radius:20px; border:1.5px solid rgba(200,147,26,.2); display:flex; align-items:center; padding:8px 14px; transition:border-color .2s; }
  .na-input-wrap:focus-within { border-color:var(--saffron); background:#fdf8f2; }
  #na-input { flex:1; border:none; background:transparent; font-size:13.5px; font-family:"DM Sans",sans-serif; color:var(--deep-brown); outline:none; resize:none; max-height:80px; min-height:22px; line-height:1.5; overflow-y:auto; }
  #na-input::-webkit-scrollbar { display:none; }
  #na-input { scrollbar-width:none; }
  #na-input::placeholder { color:#b09070; }
  #na-send-btn { width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,#c61d23,#c61d23); border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:transform .2s,box-shadow .2s; flex-shrink:0; box-shadow:0 2px 10px rgba(232,115,10,.3); }
  #na-send-btn:hover { transform:scale(1.08); }
  #na-send-btn:disabled { opacity:.5; cursor:not-allowed; transform:none; }

  .na-mic-btn { width:40px; height:40px; border-radius:50%; background:#f9f3eb; border:1.5px solid rgba(200,147,26,.3); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .2s; flex-shrink:0; }
  .na-mic-btn:hover { background:var(--light-sand); border-color:var(--saffron); }
  .na-mic-btn.recording { background:#c61d23; border-color:#c61d23; animation:mic-pulse 1.5s ease-in-out infinite; }
  .na-mic-btn.recording svg { stroke:white; }
  @keyframes mic-pulse { 0%,100%{box-shadow:0 0 0 0 rgba(198,29,35,.4)} 50%{box-shadow:0 0 0 8px rgba(198,29,35,0)} }

  .na-footer { padding:6px 16px 10px; text-align:center; font-size:10.5px; color:#b09070; background:#fff; }
  .na-footer a { color:var(--gold); text-decoration:none; }

  .na-error { color:var(--accent-red) !important; font-style:italic; }

  @media(max-width:480px){ #na-chat-widget { bottom:68px; right:16px; }
    #na-chat-window { position:fixed; top:0; left:0; right:0; bottom:0; width:100vw; height:100vh; border-radius:0; transform-origin:bottom right; }
    .na-messages { max-height:none; flex:1; } }
</style>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<div id="na-chat-widget">
  <button id="na-chat-toggle" onclick="naToggleChat()" aria-label="Open chat">
    <svg class="icon-chat" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><line x1="12" y1="7" x2="12" y2="11"></line><circle cx="8" cy="16" r="1"></circle><circle cx="16" cy="16" r="1"></circle></svg>
    <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span class="na-badge" id="na-badge">1</span>
  </button>

  <div id="na-chat-window">
    <div class="na-header">
      <div class="na-header-avatar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="38" viewBox="0 0 30 48" fill="none"><g clip-path="url(#nai-lg)"><path fill="#c61d23" d="M14.45 0c1.013 2.375 2.646 7.949-.633 14.299-.989 1.916-2.245 3.727-3.461 5.479C6.8 24.9 3.15 30.162 5.508 38.58 1.075 32.47 0 27.439 0 23.998 0 12.889 10.91 2.939 14.45 0Z"/><path fill="#c61d23" d="M29.707 23.999c0-10.51-9.759-19.979-13.812-23.46.948 2.717 1.878 7.511-.406 12.928.126.275.256.551.401.83.989 1.915 2.245 3.727 3.461 5.478C22.906 24.9 26.555 30.16 24.2 38.578c4.435-6.11 5.51-11.142 5.51-14.582"/><path fill="#c61d23" d="M21.425 25.136c-.665 1.05-1.373 2.07-2.076 3.086-1.216 1.752-2.473 3.563-3.461 5.48-3.277 6.35-1.646 11.922-.633 14.298a55.748 55.748 0 0 0 6.723-6.642c3.011-7.098 1.827-11.936-.553-16.222Z"/><path fill="#c61d23" d="M13.82 33.701c-.99-1.916-2.246-3.727-3.462-5.479-.703-1.016-1.411-2.036-2.076-3.086-2.38 4.286-3.564 9.122-.556 16.219a56.035 56.035 0 0 0 6.086 6.103c-.947-2.716-1.878-7.51.406-12.927a17.293 17.293 0 0 0-.401-.83"/></g><defs><clipPath id="nai-lg"><path fill="#fff" d="M0 0h30v48H0z"/></clipPath></defs></svg><div class="na-status-dot"></div></div>
      <div class="na-header-info">
        <div class="na-header-name">Nithya Amirtham Assistant</div>

      </div>
      <button id="na-close-btn" onclick="naToggleChat()" aria-label="Close chat" style="background:none;border:none;cursor:pointer;padding:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;transition:background .2s;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;pointer-events:none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>


    <div class="na-messages" id="na-messages"></div>

    <div class="na-input-area" id="na-input-area">
      <div class="na-input-wrap">
        <textarea id="na-input" placeholder="Ask about our sweets & snacks..." rows="1" onkeydown="naHandleKey(event)" oninput="naAutoResize(this)"></textarea>
      </div>
      <button id="na-mic-btn" class="na-mic-btn" onclick="naToggleVoice()" aria-label="Voice input">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--warm-brown)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
      </button>
      <button id="na-send-btn" onclick="naSend()" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>
</div>

