{%- if product.featured_image != blank -%}
  {{ product.featured_image
    | image_url: width: 1100
    | image_tag:
        widths: '165, 360, 535, 750, 940, 1100',
        sizes: '313px',
        loading: 'lazy',
        fetchpriority: 'low',
        class: 'm:w-full m:h-full',
        alt: product.title
  }}
{%- else -%}
  {{ 'product-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
{%- endif -%}
