{%- if settings.newsletter_popup_enabled and customer == nil -%}
<div
  class="newsletter-popup"
  id="NewsletterPopup"
  data-newsletter-popup
  data-trigger="{{ settings.newsletter_popup_trigger }}"
  data-delay="{{ settings.newsletter_popup_delay }}"
  data-scroll-pct="{{ settings.newsletter_popup_scroll_pct }}"
  data-dismiss-days="{{ settings.newsletter_popup_dismiss_days }}"
  aria-hidden="true"
  role="dialog"
  aria-label="{{ settings.newsletter_popup_heading | escape }}"
>
  <div class="newsletter-popup__card">
    <button type="button" class="newsletter-popup__close" data-newsletter-close aria-label="Close popup">&times;</button>

    {%- if settings.newsletter_popup_image != blank -%}
      <div class="newsletter-popup__image" style="background-image: url('{{ settings.newsletter_popup_image | image_url: width: 800 }}');" role="img" aria-label="Newsletter popup image"></div>
    {%- endif -%}

    <div class="newsletter-popup__content">
      {%- if settings.newsletter_popup_subtitle != blank -%}
        <p class="newsletter-popup__subtitle">{{ settings.newsletter_popup_subtitle }}</p>
      {%- endif -%}

      {%- if settings.newsletter_popup_heading != blank -%}
        <h2 class="newsletter-popup__heading">{{ settings.newsletter_popup_heading }}</h2>
      {%- endif -%}

      {%- if settings.newsletter_popup_description != blank -%}
        <p class="newsletter-popup__description">{{ settings.newsletter_popup_description }}</p>
      {%- endif -%}

      <div class="newsletter-popup__form-wrap" data-newsletter-form-wrap>
        {%- form 'customer', id: 'NewsletterPopupForm' -%}
          <input type="hidden" name="customer[accepts_marketing]" value="true">
          <input type="hidden" name="customer[tags]" value="newsletter-popup">

          <div class="newsletter-popup__form">
            <p class="newsletter-popup__error" data-newsletter-error></p>
            <input
              type="email"
              name="customer[email]"
              class="newsletter-popup__input"
              placeholder="{{ settings.newsletter_popup_placeholder | default: 'Your email' }}"
              required
              autocomplete="email"
              aria-label="Email address"
            >
            <button type="submit" class="newsletter-popup__submit">
              {{ settings.newsletter_popup_button_text | default: 'Get offer' }}
            </button>
          </div>
        {%- endform -%}

        <button type="button" class="newsletter-popup__dismiss" data-newsletter-close>
          {{ settings.newsletter_popup_dismiss_text | default: 'No thanks' }}
        </button>
      </div>

      <div class="newsletter-popup__success" data-newsletter-success>
        <p>{{ settings.newsletter_popup_success_heading | default: 'Thank you!' }}</p>
        <span>{{ settings.newsletter_popup_success_text | default: 'Check your inbox for your discount code.' }}</span>
      </div>

      {%- if settings.newsletter_popup_disclaimer != blank -%}
        <p class="newsletter-popup__disclaimer">{{ settings.newsletter_popup_disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function() {
  var el = document.getElementById('NewsletterPopup');
  if (!el) return;

  var trigger = el.dataset.trigger;
  var delay = parseInt(el.dataset.delay, 10) || 5;
  var scrollPct = parseInt(el.dataset.scrollPct, 10) || 50;
  var dismissDays = parseInt(el.dataset.dismissDays, 10) || 14;
  var DISMISS_KEY = 'newsletter_popup_dismissed';
  var SIGNUP_KEY = 'newsletter_popup_signed_up';
  var shown = false;

  function getCookie(name) {
    var m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return m ? m[2] : null;
  }

  function setCookie(name, value, days) {
    var d = new Date();
    d.setTime(d.getTime() + days * 86400000);
    document.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
  }

  if (localStorage.getItem(SIGNUP_KEY) === 'true') return;
  if (getCookie(DISMISS_KEY) === '1') return;

  function open() {
    if (shown) return;
    shown = true;
    el.classList.add('is-open');
    el.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    el.classList.remove('is-open');
    el.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setCookie(DISMISS_KEY, '1', dismissDays);
    cleanup();
  }

  function cleanup() {
    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    if (exitHandler) document.removeEventListener('mouseout', exitHandler);
  }

  // Close buttons & backdrop
  el.querySelectorAll('[data-newsletter-close]').forEach(function(btn) {
    btn.addEventListener('click', close);
  });
  el.addEventListener('click', function(e) {
    if (e.target === el) close();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && el.classList.contains('is-open')) close();
  });

  // Trigger: delay
  var scrollHandler = null;
  var exitHandler = null;

  if (trigger === 'delay') {
    setTimeout(open, delay * 1000);
  }

  // Trigger: scroll
  if (trigger === 'scroll') {
    scrollHandler = function() {
      var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      var docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight > 0 && (scrollTop / docHeight) * 100 >= scrollPct) {
        open();
      }
    };
    window.addEventListener('scroll', scrollHandler, { passive: true });
  }

  // Trigger: exit intent
  if (trigger === 'exit_intent') {
    var isMobile = /Mobi|Android/i.test(navigator.userAgent);
    if (isMobile) {
      setTimeout(open, delay * 1000);
    } else {
      exitHandler = function(e) {
        if (e.clientY <= 0) open();
      };
      document.addEventListener('mouseout', exitHandler);
    }
  }

  // Form submit
  var form = document.getElementById('NewsletterPopupForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value;
      var errorEl = el.querySelector('[data-newsletter-error]');

      if (!email) {
        if (errorEl) {
          errorEl.textContent = 'Please enter your email address.';
          errorEl.classList.add('is-visible');
        }
        return;
      }

      var formData = new FormData(form);
      fetch('/account', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      }).then(function() {
        localStorage.setItem(SIGNUP_KEY, 'true');
        el.querySelector('[data-newsletter-form-wrap]').classList.add('is-hidden');
        el.querySelector('[data-newsletter-success]').classList.add('is-visible');
        setTimeout(function() { close(); }, 4000);
      }).catch(function() {
        if (errorEl) {
          errorEl.textContent = 'Something went wrong. Please try again.';
          errorEl.classList.add('is-visible');
        }
      });
    });
  }
})();
</script>
{%- endif -%}
