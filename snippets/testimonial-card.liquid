{%- comment -%}
  Renders a testimonial card.
  Usage: {% render 'testimonial-card', block: block %}
{%- endcomment -%}

<div class="testimonial-card" {{ block.shopify_attributes }}>
  <div class="testimonial-card__quote-icon">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/></svg>
  </div>

  <p class="testimonial-card__text">{{ block.settings.text }}</p>

  {%- if block.settings.rating > 0 -%}
    <div class="testimonial-card__rating">
      {%- for i in (1..block.settings.rating) -%}
        <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="testimonial-card__footer">
    {%- if block.settings.avatar -%}
      <div class="testimonial-card__avatar">
        <img
          src="{{ block.settings.avatar | image_url: width: 80, height: 80, crop: 'center' }}"
          alt="{{ block.settings.author | escape }}"
          width="40"
          height="40"
          loading="lazy"
        >
      </div>
    {%- endif -%}
    <div>
      {%- if block.settings.author != blank -%}
        <div class="testimonial-card__author">{{ block.settings.author }}</div>
      {%- endif -%}
      {%- if block.settings.location != blank -%}
        <div class="testimonial-card__location">{{ block.settings.location }}</div>
      {%- endif -%}
    </div>
  </div>
</div>
