            <path d="M12 0C5.37391 0 0 5.37391 0 12C0 18.6261 5.37391 24 12 24C18.6261 24 24 18.6261 24 12C24 5.37391 18.6261 0 12 0ZM12 22.9565C5.94783 22.9565 1.04348 18.0522 1.04348 12C1.04348 5.94783 5.94783 1.04348 12 1.04348C18.0522 1.04348 22.9565 5.94783 22.9565 12C22.9565 18.0522 18.0522 22.9565 12 22.9565Z" fill="black"/>
            </g>
            <defs>
            <clipPath id="clip0_742_11003">
            <rect width="24" height="24" fill="white"/>
            </clipPath>
            </defs>
          </svg>
          <a
            href="tel:{{ block.settings.phone | split: ',' | first | replace: ' ', '' | replace: '-', '' }}"
            class="store-card__info-text"
          >
            {{- block.settings.phone -}}
          </a>
        </div>
      {%- endif -%}

      {%- if block.settings.hours != blank -%}
        <div class="store-card__info">
          <svg
            class="store-card__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <g clip-path="url(#a)">
