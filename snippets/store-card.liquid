{% doc %}
  Renders a store location card with image, name, address, phone, hours, and directions link.

  @param {Block} block - The block object with settings (image, name, address, phone, hours, directions_url)

  @example
  {% render 'store-card', block: block %}
{% enddoc %}

<div class="store-card" {{ block.shopify_attributes }}>
  <div class="store-card__image-wrapper">
    {%- if block.settings.image -%}
      {{
        block.settings.image
        | image_url: width: 750
        | image_tag:
          widths: '360, 535, 750',
          sizes: '(min-width: 750px) calc((100vw - 64px - 40px) / 3), calc(100vw - 32px)',
          class: 'store-card__image',
          loading: 'lazy'
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'store-card__image store-card__image--placeholder' }}
    {%- endif -%}
  </div>

  <div class="store-card__content">
    {%- if block.settings.name != blank -%}
      <h3 class="store-card__name">{{ block.settings.name }}</h3>
    {%- endif -%}

    <div class="store-card__details">
      {%- if block.settings.address != blank -%}
        <p class="store-card__address">{{ block.settings.address }}</p>
      {%- endif -%}

      {%- if block.settings.phone != blank -%}
        <div class="store-card__info">
          <svg
            class="store-card__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <g clip-path="url(#a)">
              <path fill="#000" d="M13.661 0a.469.469 0 1 0 0 .937c5.184 0 9.402 4.218 9.402 9.402a.469.469 0 0 0 .937 0C24 4.638 19.362 0 13.661 0Z"/>
              <path fill="#000" d="M20.711 10.808c.26 0 .47-.21.47-.47 0-4.145-3.374-7.518-7.52-7.518a.469.469 0 0 0 0 .937 6.589 6.589 0 0 1 6.582 6.582c0 .259.21.469.468.469Z"/>
              <path fill="#000" d="M17.422 10.34a.469.469 0 0 0 .938 0 4.704 4.704 0 0 0-4.699-4.7.469.469 0 1 0 0 .938 3.765 3.765 0 0 1 3.761 3.761Zm-4.229-1.41c0 .258.21.468.468.468.52 0 .941.422.941.941a.469.469 0 0 0 .938 0 1.88 1.88 0 0 0-1.879-1.879.469.469 0 0 0-.468.47Zm-4.407 6.29a.469.469 0 1 1-.938 0 .469.469 0 0 1 .938 0Z"/>
              <path fill="#000" d="M12.845 23.431a5.573 5.573 0 0 0 6.39-1.077l.97-.97a1.345 1.345 0 0 0 0-1.902l-3.745-3.745a1.344 1.344 0 0 0-1.903 0l-1.591 1.591c-.312.312-.793.375-1.144.152a17.6 17.6 0 0 1-1.654-1.199.469.469 0 1 0-.593.726c.554.452 1.14.877 1.743 1.262.718.46 1.69.342 2.31-.278L15.22 16.4c.16-.16.417-.16.577 0l3.745 3.744c.16.16.16.418 0 .578l-.97.97a4.635 4.635 0 0 1-5.314.897c-6.496-3.185-10.03-8.235-11.85-11.911-.871-1.758-.51-3.886.9-5.295l.948-.948a.407.407 0 0 1 .576 0l3.746 3.746a.407.407 0 0 1 0 .576L5.985 10.35c-.62.62-.737 1.592-.278 2.311.27.423.562.84.867 1.24a.469.469 0 1 0 .745-.567 17.72 17.72 0 0 1-.822-1.178c-.224-.35-.16-.832.151-1.143L8.24 9.42a1.344 1.344 0 0 0 0-1.903L4.495 3.773a1.344 1.344 0 0 0-1.902 0l-.948.947C-.05 6.414-.482 8.975.568 11.094 2.453 14.9 6.113 20.13 12.845 23.431Z"/>
            </g>
            <defs>
              <clipPath id="a">
                <path fill="#fff" d="M0 0h24v24H0z"/>
              </clipPath>
            </defs>
          </svg>

          <a
            href="tel:{{ block.settings.phone | split: ',' | first | replace: ' ', '' | replace: '-', '' }}"
            class="store-card__info-text"
          >
            {{- block.settings.phone -}}
          </a>
        </div>
      {%- endif -%}

      {%- if block.settings.hours != blank -%}
        <div class="store-card__info">
          <svg
            class="store-card__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <g clip-path="url(#a)">
              <path fill="#000" d="M12 3.913a.523.523 0 0 0 .522-.521V3.13A.523.523 0 0 0 12 2.609a.523.523 0 0 0-.522.522v.26c0 .287.235.522.522.522Zm0 16.174a.523.523 0 0 0-.522.522v.26c0 .288.235.522.522.522a.523.523 0 0 0 .522-.521v-.261a.523.523 0 0 0-.522-.522Zm-8.609-8.609h-.26a.523.523 0 0 0-.522.522c0 .287.234.521.521.521h.261A.523.523 0 0 0 3.913 12a.523.523 0 0 0-.522-.522Zm17.479 0h-.261a.523.523 0 0 0-.522.522c0 .287.235.521.522.521h.26a.523.523 0 0 0 .522-.521.523.523 0 0 0-.521-.522ZM6.104 5.374a.504.504 0 0 0-.73 0 .504.504 0 0 0 0 .73l.183.183a.515.515 0 0 0 .365.156c.13 0 .26-.052.365-.156a.504.504 0 0 0 0-.73l-.183-.183Zm-.547 12.339-.183.183a.504.504 0 0 0 0 .73.515.515 0 0 0 .365.157c.13 0 .261-.052.365-.157l.183-.182a.504.504 0 0 0 0-.73.504.504 0 0 0-.73 0ZM17.896 5.374l-.183.182a.504.504 0 0 0 0 .73.515.515 0 0 0 .365.157.52.52 0 0 0 .366-.156l.182-.183a.504.504 0 0 0 0-.73.504.504 0 0 0-.73 0Zm-5.374 6.417V7.044A.523.523 0 0 0 12 6.522a.523.523 0 0 0-.522.522V12c0 .13.052.261.157.366l5.713 5.712a.515.515 0 0 0 .365.157c.13 0 .26-.052.365-.157a.504.504 0 0 0 0-.73l-5.556-5.556Z"/>
              <path fill="#000" d="M12 0C5.374 0 0 5.374 0 12s5.374 12 12 12 12-5.374 12-12S18.626 0 12 0Zm0 22.956C5.948 22.956 1.043 18.052 1.043 12S5.948 1.043 12 1.043c6.052 0 10.956 4.905 10.956 10.957 0 6.052-4.904 10.956-10.956 10.956Z"/>
            </g>
            <defs>
              <clipPath id="a">
                <path fill="#fff" d="M0 0h24v24H0z"/>
              </clipPath>
            </defs>
          </svg>

          <span class="store-card__info-text">{{ block.settings.hours }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if block.settings.directions_url != blank -%}
      <a href="{{ block.settings.directions_url }}" class="store-card__btn" target="_blank" rel="noopener noreferrer">
        {{ 'sections.store_locator.get_direction' | t }}
      </a>
    {%- endif -%}
  </div>
</div>
