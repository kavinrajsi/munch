{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_media = current_variant.featured_media | default: product.featured_image %}

<div class="product__slider--card">
  <!-- Product image or media preview -->
  <a href="{{ product.url }}">
    {% if featured_media.media_type == 'image' or featured_media.media_type == blank %}
      <picture>
        <source srcset="{{ featured_media | image_url: width: 265, format: 'pjpg' }}" type="image/pjpg">
        <source srcset="{{ featured_media | image_url: width: 265, format: 'webp' }}" type="image/webp">
        <img
          src="{{ featured_media | image_url: width: 265 }}"
          width="265"
          height="320"
          loading="lazy"
          decoding="async"
          alt="{{ product.title }}"
        >
      </picture>
    {% endif %}
  </a>

  <!-- Product information block -->
  <div class="product__info">
    <h4 class="heading--4 product__title">{{ product.title }}</h4>

    <!-- Compare at price (if discounted) -->
    <div class="prpdice">
      {% if product.compare_at_price > product.price %}
        <span class="product__compare-price">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
    </div>

    <!-- Current price -->
    <div class="product__price">
      {% if product.price < product.compare_at_price %}
        <span class="product__sale-price">
          {{ product.price | money }}
        </span>
      {% else %}
        <span class="product__regular-price">
          {{ product.price | money }}
        </span>
      {% endif %}
    </div>

    <!-- Select Option button for multi-variant products -->

    <button
      class="product__select-option-button select-option-button"
      data-product-handle="{{ product.handle }}"
      type="button"
      onclick="openProductModal({{ product.id }})"
    >
      Select Option
    </button>
  </div>

  <!-- Product JSON for JS -->
  <script type="application/json" id="ProductJson-{{ product.id }}">
    {{ product | json }}
  </script>

  <!-- Product Modal -->
  <div id="product-modal-{{ product.id }}" class="product-modal">
    <div class="product-modal__overlay"></div>
    <div class="product-modal__content">
      <div class="product-modal__header">
        <h3 class="product-modal__title">{{ product.title }}</h3>
        <span class="product-modal__close" onclick="closeProductModal({{ product.id }})">
          <svg width="11" height="12" viewBox="0 0 11 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.718143 0.969211C0.787811 0.899366 0.870575 0.843952 0.961693 0.806142C1.05281 0.768332 1.15049 0.748871 1.24914 0.748871C1.34779 0.748871 1.44548 0.768332 1.53659 0.806142C1.62771 0.843952 1.71047 0.899366 1.78014 0.969211L5.74914 4.93971L9.71814 0.969211C9.78787 0.899479 9.87066 0.844165 9.96177 0.806426C10.0529 0.768687 10.1505 0.749264 10.2491 0.749264C10.3478 0.749264 10.4454 0.768687 10.5365 0.806426C10.6276 0.844165 10.7104 0.899479 10.7801 0.969211C10.8499 1.03894 10.9052 1.12173 10.9429 1.21284C10.9807 1.30394 11.0001 1.4016 11.0001 1.50021C11.0001 1.59883 10.9807 1.69648 10.9429 1.78759C10.9052 1.8787 10.8499 1.96148 10.7801 2.03121L6.80964 6.00021L10.7801 9.96921C10.8499 10.0389 10.9052 10.1217 10.9429 10.2128C10.9807 10.3039 11.0001 10.4016 11.0001 10.5002C11.0001 10.5988 10.9807 10.6965 10.9429 10.7876C10.9052 10.8787 10.8499 10.9615 10.7801 11.0312C10.7104 11.1009 10.6276 11.1563 10.5365 11.194C10.4454 11.2317 10.3478 11.2512 10.2491 11.2512C10.1505 11.2512 10.0529 11.2317 9.96177 11.194C9.87066 11.1563 9.78787 11.1009 9.71814 11.0312L5.74914 7.06071L1.78014 11.0312C1.71041 11.1009 1.62763 11.1563 1.53652 11.194C1.44541 11.2317 1.34776 11.2512 1.24914 11.2512C1.15053 11.2512 1.05288 11.2317 0.961768 11.194C0.870659 11.1563 0.787875 11.1009 0.718143 11.0312C0.648411 10.9615 0.593097 10.8787 0.555358 10.7876C0.517619 10.6965 0.498195 10.5988 0.498195 10.5002C0.498195 10.4016 0.517619 10.3039 0.555358 10.2128C0.593097 10.1217 0.648411 10.0389 0.718143 9.96921L4.68864 6.00021L0.718143 2.03121C0.648298 1.96154 0.592884 1.87878 0.555074 1.78766C0.517264 1.69654 0.497803 1.59886 0.497803 1.50021C0.497803 1.40156 0.517264 1.30388 0.555074 1.21276C0.592884 1.12164 0.648298 1.03888 0.718143 0.969211Z" fill="#A5161A"/>
          </svg>
        </span>
      </div>
      <!-- Dynamic Price -->
      <div class="product-modal__price">
        <span class="price-reg" id="price-{{ product.id }}">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="price-sale" id="compare-price-{{ product.id }}">
            <s>{{ current_variant.compare_at_price | money }}</s>
          </span>
        {% else %}
          <span class="price-sale" id="compare-price-{{ product.id }}" style="display:none;"></span>
        {% endif %}
      </div>
      <!-- Stock Display -->
      <div class="product-modal__stock-status" id="stock-status-{{ product.id }}" style="display: none;">
        {% if current_variant.available and current_variant.inventory_management == 'shopify' %}
          {% if current_variant.inventory_quantity > 0 %}
            In Stock ({{ current_variant.inventory_quantity }})
          {% else %}
            Out of Stock
          {% endif %}
        {% elsif current_variant.available %}
          In Stock
        {% else %}
          Out of Stock
        {% endif %}
      </div>
      <!-- Product Media -->
      {% if featured_media.media_type == 'image' or featured_media.media_type == blank %}
        <div class="product-modal__media" data-media-id="{{ featured_media.id }}">
          <picture>
            <!-- WebP Source -->
            <source srcset="{{ featured_media | image_url: width: 2048, format: 'webp' }}" type="image/webp">

            <!-- Fallback Source -->
            <source srcset="{{ featured_media | image_url: width: 2048 }}" type="image/{{ featured_media.media_type }}">

            <!-- Fallback Image -->
            <img
              src="{{ featured_media | image_url: width: 2048 }}"
              alt="{{ featured_media.alt | escape }}"
              width="345"
              height="280"
              style="width: 345px; height: 280px;"
            >
          </picture>
        </div>
      {% endif %}
      <!-- Product Form -->
      <form class="product-form-ajax" data-product-id="{{ product.id }}">
        <!-- Swatch Radio Buttons -->
        <div class="product-options">
          {% for option in product.options_with_values %}
            {% unless option.name == 'Title' %}
              <fieldset class="product-option" data-option-index="{{ forloop.index0 }}">
                <legend>{{ option.name }}</legend>
                <div class="option-values">
                  {% for value in option.values %}
                    <label class="swatch">
                      <input
                        type="radio"
                        name="option-{{ forloop.parent.index0 }}"
                        value="{{ value }}"
                        {% if option.selected_value == value %}
                          checked
                        {% endif %}
                      >
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endunless %}
          {% endfor %}
        </div>
        <!-- Hidden Selected Variant ID -->
        <input type="hidden" name="id" value="{{ current_variant.id }}" class="selected-variant-id">
        <!-- Quantity Selector -->
        <div class="quantity-container">
          <label for="quantity-{{ product.id }}" class="quantity-label">Quantity:</label>
          <div class="quantity-wrapper">
            <button type="button" class="qty-btn minus" onclick="updateQty(this, -1)">−</button>
            <input type="text" name="quantity" value="1" min="1" class="qty-input">
            <button type="button" class="qty-btn plus" onclick="updateQty(this, 1)">+</button>
          </div>
        </div>
        <!-- Buttons -->
        <div class="product-modal__buttons">
          <button type="submit" class="product-modal__buttons--buy">Buy Now</button>
          <button type="button" class="product-modal__buttons--cart" >Add to Cart</button>
          <a type="button" href="{{ product.url }}" class="product-modal__buttons--view">View in Detail</a>
        </div>
        <div class="ajax-cart-response" style="display:none;"></div>
      </form>
    </div>
  </div>
</div>
