<article class="product-card" style="border: 1px solid #eee; padding: 1rem; border-radius: 8px; text-align: center;">
  <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | img_url: '400x400' }}" alt="{{ product.title | escape }}" style="width: 100%; border-radius: 6px;" />
    {% else %}
      <div style="background: #f5f5f5; width: 100%; height: 300px; border-radius: 6px;">No Image</div>
    {% endif %}

    <h3 style="margin: 0.5rem 0 0;">{{ product.title }}</h3>

    {% if product.compare_at_price > product.price %}
      <p style="color: red;">
        <span style="text-decoration: line-through;">{{ product.compare_at_price | money }}</span>
        <span style="margin-left: 0.5rem;">{{ product.price | money }}</span>
      </p>
    {% else %}
      <p>{{ product.price | money }}</p>
    {% endif %}

    {% if product.available %}
      <p style="font-size: 0.9rem; color: #4CAF50;">In stock</p>
    {% else %}
      <p style="font-size: 0.9rem; color: #999;">Sold out</p>
    {% endif %}
  </a>
</article>
