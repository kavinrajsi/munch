{%- capture product_json -%}
{
  "id": {{ product.id }},
  "title": {{ product.title | json }},
  "url": {{ product.url | json }},
  "available": {{ product.available }},
  "price": {{ product.price }},
  "compare_at_price": {{ product.compare_at_price | default: 0 }},
  "featured_image": {{ product.featured_image | image_url: width: 400 | json }},
  "description": {{ product.description | json }},
  "options_with_values": {{ product.options_with_values | json }},
  "variants": {{ product.variants | json }}
}
{%- endcapture -%}
<div class="product-card product-card--{{ settings.card_layout }}" data-product-json='{{ product_json | strip_newlines | escape }}'>
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__image-link">
      {%- if product.featured_image -%}
        <picture class="product-card__image product-card__image--primary">
          <source type="image/avif" srcset="{{ product.featured_image | image_url: width: 400, format: 'avif' }}">
          <source type="image/webp" srcset="{{ product.featured_image | image_url: width: 400, format: 'webp' }}">
          <img
            src="{{ product.featured_image | image_url: width: 400 }}"
            alt="{{ product.featured_image.alt | escape }}"
            width="400"
            height="auto"
            loading="lazy"
          >
        </picture>
        {%- if settings.card_enable_secondary_image and product.images.size > 1 -%}
          {%- assign second_image = product.images[1] -%}
          <picture class="product-card__image product-card__image--secondary">
            <source type="image/avif" srcset="{{ second_image | image_url: width: 400, format: 'avif' }}">
            <source type="image/webp" srcset="{{ second_image | image_url: width: 400, format: 'webp' }}">
            <img
              src="{{ second_image | image_url: width: 400 }}"
              alt="{{ second_image.alt | escape }}"
              width="400"
              height="auto"
              loading="lazy"
            >
          </picture>
        {%- endif -%}
      {%- endif -%}

      {%- if settings.card_enable_tag -%}
        <div class="product-card__tags">
          {%- if product.compare_at_price > product.price -%}
            {%- assign save_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
            <span class="product-card__tag product-card__tag--sale">Sale</span>
          {%- endif -%}

          {%- assign product_created = product.created_at | date: '%s' -%}
          {%- assign now = 'now' | date: '%s' -%}
          {%- assign diff_seconds = now | minus: product_created -%}
          {%- assign thirty_days = 2592000 -%}
          {%- if diff_seconds < thirty_days -%}
            <span class="product-card__tag product-card__tag--new">New</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-card__overlay">
        <h4 class="product-card__title">{{ product.title }}</h4>
        {%- if settings.card_enable_price -%}
          {%- assign lowest_variant = product.variants | sort: 'price' | first -%}
          {%- assign lv_price = lowest_variant.price -%}
          {%- assign lv_compare = lowest_variant.compare_at_price -%}
          <div class="product-card__pricing">
            {%- if lv_compare > lv_price -%}
              {%- assign save_percent = lv_compare | minus: lv_price | times: 100 | divided_by: lv_compare -%}
              <span class="product-card__compare-price">{{ lv_compare | money }}</span>
              <span class="product-card__sale-price">{{ lv_price | money }}</span>
              <span class="product-card__save">Save {{ save_percent }}%</span>
            {%- else -%}
              <span class="product-card__regular-price">{{ lv_price | money }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </a>
  </div>

  <div class="product-card__info">

    {% comment %} Opens the product quickview drawer with image, title, price, variants, qty, and add-to-cart. Shown for all products regardless of variant count. {% endcomment %}
    <button type="button" class="product-card__select-option" data-open-product-drawer>Select Option</button>

    <div class="product-card__variants">
      {%- if settings.card_enable_variant -%}
        {%- unless product.has_only_default_variant -%}
          {%- assign sorted_variants = product.variants | sort: 'price' -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_index = forloop.index0 -%}
            <div class="product-card__variant-group">
              {%- if settings.card_enable_variant_label -%}
                <span class="product-card__variant-label">{{ option.name }}:</span>
              {%- endif -%}
              <div class="product-card__variant-options">
                {%- assign seen = '|||' -%}
                {%- assign first_value = true -%}
                {%- for variant in sorted_variants -%}
                  {%- assign opt_val = variant.options[option_index] -%}
                  {%- assign check = '|||' | append: opt_val | append: '|||' -%}
                  {%- unless seen contains check -%}
                    {%- assign seen = seen | append: opt_val | append: '|||' -%}
                    <button
                      type="button"
                      class="product-card__variant-btn{% if first_value %} product-card__variant-btn--active{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-value="{{ opt_val }}"
                    >
                      {{ opt_val }}
                    </button>
                    {%- assign first_value = false -%}
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}
      {%- endif -%}
    </div>

    {%- assign cheapest_variant = product.variants | sort: 'price' | first -%}
    <form class="product-card__form" data-product-form data-ajax-cart>
      <input type="hidden" name="id" value="{{ cheapest_variant.id }}" data-variant-id>
      {%- if settings.card_enable_qty -%}
        <div class="product-card__qty">
          <button type="button" class="product-card__qty-btn" data-card-qty-minus>-</button>
          <input type="text" name="quantity" value="1" min="1" class="product-card__qty-input" data-card-qty-input readonly>
          <button type="button" class="product-card__qty-btn" data-card-qty-plus>+</button>
        </div>
      {%- endif -%}
      <button type="submit" class="product-card__atc" {% unless product.available %}disabled{% endunless %}>
        {%- if product.available -%}
          Add to cart
        {%- else -%}
          Sold out
        {%- endif -%}
      </button>
    </form>

    <script type="application/json" data-product-variants>
      {{ product.variants | json }}
    </script>
  </div>
</div>
