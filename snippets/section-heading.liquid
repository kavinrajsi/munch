{% doc %}
  Renders a section heading with decorative lines and icons.

  @param {String} title - The heading text
  @param {String} [heading_tag] - HTML tag (default: h5)
  @param {Boolean} [show_left_line] - Show left gradient line
  @param {Boolean} [show_right_line] - Show right gradient line
  @param {Boolean} [show_left_icon] - Show left decorative icon
  @param {Boolean} [show_right_icon] - Show right decorative icon
  @param {Number} [margin_bottom_desktop] - Bottom margin on desktop in px (default: 40)
  @param {Number} [margin_bottom_mobile] - Bottom margin on mobile in px (default: 25)

  @example
  {% render 'section-heading', title: 'Our Products', heading_tag: 'h2', show_left_line: true, show_left_icon: true, show_right_icon: true, show_right_line: true %}
{% enddoc %}

{%- liquid
  assign heading_tag = heading_tag | default: 'h5'
  assign margin_bottom_desktop = margin_bottom_desktop | default: 40
  assign margin_bottom_mobile = margin_bottom_mobile | default: 25
-%}

<div class="section-heading" style="--section-heading-mb-mobile: {{ margin_bottom_mobile }}px; --section-heading-mb-desktop: {{ margin_bottom_desktop }}px;">
  {%- if show_left_line -%}
    <span class="section-heading__line--left"></span>
  {%- endif -%}

  {%- if show_left_icon -%}
    <span class="section-heading__icon section-heading__icon--left">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" viewBox="0 0 20 24" fill="currentColor" aria-hidden="true">
        <path d="M16.4909 1.13572C15.8347 2.18556 15.1355 3.20637 14.441 4.22234C13.2407 5.97369 11.9998 7.78551 11.0238 9.70135C7.78544 16.0512 9.39863 21.6245 10.3985 24C11.816 22.8098 14.4291 20.4658 17.0374 17.3574C20.0108 10.2601 18.8415 5.42216 16.4909 1.13572Z"/>
        <path d="M8.97863 9.70135C8.0026 7.78551 6.76169 5.97369 5.56134 4.22234C4.86691 3.20637 4.1677 2.18556 3.51144 1.13572C1.16086 5.42216 -0.00846096 10.2577 2.96496 17.355C5.22248 20.0449 7.48715 22.1664 8.97386 23.4581C8.0384 20.7416 7.11964 15.9472 9.37477 10.5311C9.25068 10.2553 9.12181 9.97953 8.97863 9.70135Z"/>
      </svg>
    </span>
  {%- endif -%}

  <{{ heading_tag }} class="section-heading__title">
    {{- title | escape -}}
  </{{ heading_tag }}>

  {%- if show_right_icon -%}
    <span class="section-heading__icon section-heading__icon--right">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" viewBox="0 0 20 24" fill="currentColor" aria-hidden="true">
        <path d="M16.4909 1.13572C15.8347 2.18556 15.1355 3.20637 14.441 4.22234C13.2407 5.97369 11.9998 7.78551 11.0238 9.70135C7.78544 16.0512 9.39863 21.6245 10.3985 24C11.816 22.8098 14.4291 20.4658 17.0374 17.3574C20.0108 10.2601 18.8415 5.42216 16.4909 1.13572Z"/>
        <path d="M8.97863 9.70135C8.0026 7.78551 6.76169 5.97369 5.56134 4.22234C4.86691 3.20637 4.1677 2.18556 3.51144 1.13572C1.16086 5.42216 -0.00846096 10.2577 2.96496 17.355C5.22248 20.0449 7.48715 22.1664 8.97386 23.4581C8.0384 20.7416 7.11964 15.9472 9.37477 10.5311C9.25068 10.2553 9.12181 9.97953 8.97863 9.70135Z"/>
      </svg>
    </span>
  {%- endif -%}

  {%- if show_right_line -%}
    <span class="section-heading__line--right"></span>
  {%- endif -%}
</div>
