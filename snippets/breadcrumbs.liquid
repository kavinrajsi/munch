<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a href="/" class="breadcrumbs__link">Home</a>
    </li>

    {%- if template.name == 'collection' -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ collection.title }}
      </li>

    {%- elsif template.name == 'product' -%}
      {%- if collection -%}
        <li class="breadcrumbs__item">
          <a href="{{ collection.url }}" class="breadcrumbs__link">{{ collection.title }}</a>
        </li>
      {%- elsif product.collections.size > 0 -%}
        {%- assign first_collection = product.collections | first -%}
        <li class="breadcrumbs__item">
          <a href="{{ first_collection.url }}" class="breadcrumbs__link">{{ first_collection.title }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ product.title }}
      </li>

    {%- elsif template.name == 'blog' -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ blog.title }}
      </li>

    {%- elsif template.name == 'article' -%}
      <li class="breadcrumbs__item">
        <a href="{{ blog.url }}" class="breadcrumbs__link">{{ blog.title }}</a>
      </li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ article.title }}
      </li>

    {%- elsif template.name == 'page' -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ page.title }}
      </li>

    {%- elsif template.name == 'search' -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        Search
      </li>

    {%- elsif template.name == 'cart' -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        Cart
      </li>

    {%- endif -%}
  </ol>
</nav>
