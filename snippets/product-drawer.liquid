<div class="product-drawer" id="ProductDrawer" data-product-drawer>
  <div class="product-drawer__overlay" data-product-drawer-close></div>
  <div class="product-drawer__panel">
    <div class="product-drawer__header">
      <h3>{{ 'products.product.view_full_details' | t }}</h3>
      <button class="product-drawer__close" data-product-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="product-drawer__body" data-product-drawer-body>
      <div class="product-drawer__loading" style="text-align:center;padding:40px;">
        <div class="spinner"></div>
      </div>
    </div>
  </div>
</div>
