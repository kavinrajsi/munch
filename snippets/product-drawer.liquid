<div class="product-drawer" id="ProductDrawer" aria-hidden="true">
  <div class="product-drawer__overlay" data-product-drawer-close></div>
  <div class="product-drawer__panel">
    <div class="product-drawer__header">
      <div class="product-drawer__header-info">
        <h3 class="product-drawer__title" id="ProductDrawerTitle"></h3>
        <div class="product-drawer__pricing" id="ProductDrawerPricing"></div>
      </div>
      <button class="product-drawer__close" data-product-drawer-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="product-drawer__body" id="ProductDrawerBody"></div>
    <div class="product-drawer__footer" id="ProductDrawerFooter"></div>
  </div>
</div>
