<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'social-meta-tags' %}
    {% render 'json-ld' %}

    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {%- if collection.image -%}
      <link rel="preload" as="image" href="{{ collection.image | image_url: width: 1600 }}">
    {%- endif -%}

    {%- if product.images.size > 0 -%}
      {%- for image in product.images -%}
        <link rel="preload" as="image" href="{{ image | image_url: width: 900, format: 'webp' }}" type="image/webp">
      {%- endfor -%}
    {%- endif -%}

    <style>
      @font-face {
        font-family: 'minion_pro_cond_caption';
        src: url('{{ "minion_pro_cond_caption-webfont.woff2" | asset_url }}') format('woff2'),
             url('{{ "minion_pro_cond_caption-webfont.woff" | asset_url }}') format('woff');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --page-width: {{ settings.page_width }}px;
        --color-primary: {{ settings.color_primary }};
        --color-primary-dark: #333333;
        --color-primary-contrast: #ffffff;
        --color-secondary: {{ settings.color_secondary | default: '#666666' }};
        --color-text: {{ settings.color_text | default: '#333333' }};
        --color-heading: {{ settings.color_heading | default: '#000000' }};
        --color-background: {{ settings.color_background | default: '#ffffff' }};
        --color-border: {{ settings.color_border | default: '#e0e0e0' }};
        --card-image-radius: {{ settings.card_image_border_radius }}px;
        --card-image-radius-mobile: {{ settings.card_image_border_radius_mobile }}px;
        --card-title-font-size: {{ settings.card_title_font_size }}px;
        --card-title-line-height: {{ settings.card_title_line_height }}px;
        --card-title-font-size-mobile: {{ settings.card_title_font_size_mobile }}px;
        --card-title-line-height-mobile: {{ settings.card_title_line_height_mobile }}px;
        --card-title-color: {{ settings.card_title_color }};
        --card-title-text-align: {{ settings.card_title_text_align }};
        --card-title-text-align-mobile: {{ settings.card_title_text_align_mobile }};
        --card-price-font-size: {{ settings.card_price_font_size }}px;
        --card-price-line-height: {{ settings.card_price_line_height }}px;
        --card-price-font-size-mobile: {{ settings.card_price_font_size_mobile }}px;
        --card-price-line-height-mobile: {{ settings.card_price_line_height_mobile }}px;
        --card-price-color: {{ settings.card_price_color }};
        --card-price-text-align: {{ settings.card_price_text_align }};
        --card-price-text-align-mobile: {{ settings.card_price_text_align_mobile }};
        --card-price-justify: {% if settings.card_price_text_align == 'left' %}flex-start{% elsif settings.card_price_text_align == 'right' %}flex-end{% else %}center{% endif %};
        --card-price-justify-mobile: {% if settings.card_price_text_align_mobile == 'left' %}flex-start{% elsif settings.card_price_text_align_mobile == 'right' %}flex-end{% else %}center{% endif %};
        --card-title-price-gap: {{ settings.card_title_price_gap }}px;
        --card-title-price-gap-mobile: {{ settings.card_title_price_gap_mobile }}px;
        --card-price-variant-gap: {{ settings.card_price_variant_gap }}px;
        --card-price-variant-gap-mobile: {{ settings.card_price_variant_gap_mobile }}px;
        --card-variant-qty-gap: {{ settings.card_variant_qty_gap }}px;
        --card-variant-qty-gap-mobile: {{ settings.card_variant_qty_gap_mobile }}px;
        --card-qty-atc-gap: {{ settings.card_qty_atc_gap }}px;
        --card-qty-atc-gap-mobile: {{ settings.card_qty_atc_gap_mobile }}px;
        --card-atc-font-size: {{ settings.card_atc_font_size }}px;
        --card-atc-line-height: {{ settings.card_atc_line_height }}px;
        --card-atc-font-size-mobile: {{ settings.card_atc_font_size_mobile }}px;
        --card-atc-line-height-mobile: {{ settings.card_atc_line_height_mobile }}px;
        --card-atc-text-align: {{ settings.card_atc_text_align }};
        --card-atc-text-align-mobile: {{ settings.card_atc_text_align_mobile }};
        --card-atc-color: {{ settings.card_atc_color }};
        --card-atc-bg: {{ settings.card_atc_bg }};
        --card-atc-border-radius: {{ settings.card_atc_border_radius }}px;
        --card-atc-border-radius-mobile: {{ settings.card_atc_border_radius_mobile }}px;
        --card-atc-padding-y: {{ settings.card_atc_padding_y }}px;
        --card-atc-padding-x: {{ settings.card_atc_padding_x }}px;
        --card-atc-padding-y-mobile: {{ settings.card_atc_padding_y_mobile }}px;
        --card-atc-padding-x-mobile: {{ settings.card_atc_padding_x_mobile }}px;
        --card-loading-width: {{ settings.card_loading_width }}px;
        --card-loading-height: {{ settings.card_loading_height }}px;

        /* Button – Primary (desktop) */
        --btn-primary-font-size: {{ settings.btn_primary_font_size }}px;
        --btn-primary-line-height: {{ settings.btn_primary_line_height }}px;
        --btn-primary-text-align: {{ settings.btn_primary_text_align }};
        --btn-primary-color: {{ settings.btn_primary_color }};
        --btn-primary-bg: {{ settings.btn_primary_bg }};
        --btn-primary-border-radius: {{ settings.btn_primary_border_radius }}px;
        --btn-primary-padding-top: {{ settings.btn_primary_padding_top }}px;
        --btn-primary-padding-bottom: {{ settings.btn_primary_padding_bottom }}px;
        --btn-primary-padding-left: {{ settings.btn_primary_padding_left }}px;
        --btn-primary-padding-right: {{ settings.btn_primary_padding_right }}px;

        /* Button – Primary (mobile) */
        --btn-primary-font-size-mobile: {{ settings.btn_primary_font_size_mobile }}px;
        --btn-primary-line-height-mobile: {{ settings.btn_primary_line_height_mobile }}px;
        --btn-primary-text-align-mobile: {{ settings.btn_primary_text_align_mobile }};
        --btn-primary-color-mobile: {{ settings.btn_primary_color_mobile }};
        --btn-primary-bg-mobile: {{ settings.btn_primary_bg_mobile }};
        --btn-primary-border-radius-mobile: {{ settings.btn_primary_border_radius_mobile }}px;
        --btn-primary-padding-top-mobile: {{ settings.btn_primary_padding_top_mobile }}px;
        --btn-primary-padding-bottom-mobile: {{ settings.btn_primary_padding_bottom_mobile }}px;
        --btn-primary-padding-left-mobile: {{ settings.btn_primary_padding_left_mobile }}px;
        --btn-primary-padding-right-mobile: {{ settings.btn_primary_padding_right_mobile }}px;

        /* Button – Secondary (desktop) */
        --btn-secondary-font-size: {{ settings.btn_secondary_font_size }}px;
        --btn-secondary-line-height: {{ settings.btn_secondary_line_height }}px;
        --btn-secondary-text-align: {{ settings.btn_secondary_text_align }};
        --btn-secondary-color: {{ settings.btn_secondary_color }};
        --btn-secondary-bg: {{ settings.btn_secondary_bg }};
        --btn-secondary-border-radius: {{ settings.btn_secondary_border_radius }}px;
        --btn-secondary-padding-top: {{ settings.btn_secondary_padding_top }}px;
        --btn-secondary-padding-bottom: {{ settings.btn_secondary_padding_bottom }}px;
        --btn-secondary-padding-left: {{ settings.btn_secondary_padding_left }}px;
        --btn-secondary-padding-right: {{ settings.btn_secondary_padding_right }}px;

        /* Button – Secondary (mobile) */
        --btn-secondary-font-size-mobile: {{ settings.btn_secondary_font_size_mobile }}px;
        --btn-secondary-line-height-mobile: {{ settings.btn_secondary_line_height_mobile }}px;
        --btn-secondary-text-align-mobile: {{ settings.btn_secondary_text_align_mobile }};
        --btn-secondary-color-mobile: {{ settings.btn_secondary_color_mobile }};
        --btn-secondary-bg-mobile: {{ settings.btn_secondary_bg_mobile }};
        --btn-secondary-border-radius-mobile: {{ settings.btn_secondary_border_radius_mobile }}px;
        --btn-secondary-padding-top-mobile: {{ settings.btn_secondary_padding_top_mobile }}px;
        --btn-secondary-padding-bottom-mobile: {{ settings.btn_secondary_padding_bottom_mobile }}px;
        --btn-secondary-padding-left-mobile: {{ settings.btn_secondary_padding_left_mobile }}px;
        --btn-secondary-padding-right-mobile: {{ settings.btn_secondary_padding_right_mobile }}px;

        /* Button – Ghost (desktop) */
        --btn-ghost-font-size: {{ settings.btn_ghost_font_size }}px;
        --btn-ghost-line-height: {{ settings.btn_ghost_line_height }}px;
        --btn-ghost-text-align: {{ settings.btn_ghost_text_align }};
        --btn-ghost-color: {{ settings.btn_ghost_color }};
        --btn-ghost-bg: {{ settings.btn_ghost_bg }};
        --btn-ghost-border-radius: {{ settings.btn_ghost_border_radius }}px;
        --btn-ghost-padding-top: {{ settings.btn_ghost_padding_top }}px;
        --btn-ghost-padding-bottom: {{ settings.btn_ghost_padding_bottom }}px;
        --btn-ghost-padding-left: {{ settings.btn_ghost_padding_left }}px;
        --btn-ghost-padding-right: {{ settings.btn_ghost_padding_right }}px;

        /* Button – Ghost (mobile) */
        --btn-ghost-font-size-mobile: {{ settings.btn_ghost_font_size_mobile }}px;
        --btn-ghost-line-height-mobile: {{ settings.btn_ghost_line_height_mobile }}px;
        --btn-ghost-text-align-mobile: {{ settings.btn_ghost_text_align_mobile }};
        --btn-ghost-color-mobile: {{ settings.btn_ghost_color_mobile }};
        --btn-ghost-bg-mobile: {{ settings.btn_ghost_bg_mobile }};
        --btn-ghost-border-radius-mobile: {{ settings.btn_ghost_border_radius_mobile }}px;
        --btn-ghost-padding-top-mobile: {{ settings.btn_ghost_padding_top_mobile }}px;
        --btn-ghost-padding-bottom-mobile: {{ settings.btn_ghost_padding_bottom_mobile }}px;
        --btn-ghost-padding-left-mobile: {{ settings.btn_ghost_padding_left_mobile }}px;
        --btn-ghost-padding-right-mobile: {{ settings.btn_ghost_padding_right_mobile }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'slick.css' | asset_url | stylesheet_tag }}
    {{ 'slick-theme.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.3.2/dist/photoswipe.css">

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-{{ template.name }}">
    <a class="visually-hidden-focusable" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'product-drawer' %}
    {% render 'search-overlay' %}

    <script>
      window.theme = window.theme || {};
      theme.moneyFormat = {{ shop.money_format | json }};
      {%- if settings.card_loading_image -%}
        theme.loadingImage = '{{ settings.card_loading_image | image_url: width: 60 }}';
      {%- endif -%}
    </script>
    {{ 'jquery.js' | asset_url | script_tag }}
    {{ 'slick.min.js' | asset_url | script_tag }}
    {{ 'global.js' | asset_url | script_tag }}
    {%- if request.page_type == 'customers/addresses' -%}
      {{ 'customer_area.js' | shopify_asset_url | script_tag }}
    {%- endif -%}
  </body>
</html>
