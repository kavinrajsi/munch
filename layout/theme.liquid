{%- liquid
  assign header_font = settings.type_header
  assign body_font = settings.type_body
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1d5d31">
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}
    <title>
      {{ page_title }}
      {% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
      {% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% comment %} {% render 'social-meta-tags' %} {% endcomment %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {{ 'slick.css' | asset_url | preload_tag: as: 'style' }}
    {{ 'slick-theme.css' | asset_url | preload_tag: as: 'style' }}
    {{ 'base.css' | asset_url | preload_tag: as: 'style' }}

    {{ 'jquery.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'shopify-money.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'predictive-search.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'quick-view-main.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'global.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'drawer.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'slick.min.js' | asset_url | preload_tag: as: 'script' }}

    {{ content_for_header }}

    {% style %}
      {{ header_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}

      :root {
      --font-playfair: {{ header_font.family }}, {{ header_font.fallback_families }};
      --font-montserrat: {{ body_font.family }}, {{ body_font.fallback_families }};
    {% endstyle %}

    <link rel="stylesheet" href="{{'slick.css' | asset_url }}">
    <link rel="stylesheet" href="{{'slick-theme.css' | asset_url }}">
    <link rel="stylesheet" href="{{'base.css' | asset_url }}">

    <style>
.product-modal {
  display: none;
  position: fixed;
  z-index: 1000;
  padding-top: 60px;
  left: 0; top: 0;
  width: 100%; height: 100%;
  overflow: auto;
  background-color: rgba(0,0,0,0.5);
}

.product-modal-content {
  background-color: #fff;
  margin: auto;
  padding: 20px;
  width: 90%;
  max-width: 600px;
  border-radius: 8px;
  position: relative;
}

.product-modal-close {
  position: absolute;
  top: 10px; right: 15px;
  font-size: 28px;
  cursor: pointer;
}

.product-modal-section {
  margin-top: 20px;
}
</style>

  </head>

  <body class="template-{{ template | split : '.' | first }}  {{ page_title | handleize }}">
    <!--[if IE]>
      <p class="browserupgrade">You are using an <strong>outdated</strong> browser. Please <a href="http://browsehappy.com/">upgrade your browser</a> to improve your experience.</p>
    <![endif]-->
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main class="content-for-layout">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% section 'drawer' %}
    {% section 'quickview-modal' %}
    {% assign potential_action_target = request.origin
      | append: routes.search_url
      | append: '?q={search_term_string}'
    %}
    <script type="application/ld+json">
      {
        "@context": "http://schema.org",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ potential_action_target | json }},
          "query-input": "required name=search_term_string"
        },
        "url": {{ request.origin | append: page.url | json }}
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "http://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        {% if settings.brand_logo != blank %}
        "logo": "https://cdn.shopify.com/s/files/1/0490/1158/9282/files/sundari-silks-logo.png",
        {% endif %}
        "sameAs": [
          {{ settings.social_twitter_link | json }},
          {{ settings.social_facebook_link | json }},
          {{ settings.social_pinterest_link | json }},
          {{ settings.social_instagram_link | json }},
          {{ settings.social_youtube_link | json }}
        ],
        "url": {{ request.origin | append: page.url | json }}
      }
    </script>
    <script defer src="{{ 'jquery.js' | asset_url }}"></script>
    <script defer src="{{ 'shopify-money.js' | asset_url }}"></script>
    <script defer src="{{ 'predictive-search.js' | asset_url }}"></script>
    <script defer src="{{ 'quick-view-main.js' | asset_url }}"></script>
    <script defer src="{{ 'drawer.js' | asset_url }}"></script>
    <script defer src="{{ 'slick.min.js' | asset_url }}"></script>
    <script defer src="{{ 'global.js' | asset_url }}"></script>

    <script>
  function openProductModal(productId) {
    var modal = document.getElementById('product-modal-' + productId);
    if (modal) modal.style.display = 'block';
  }

  function closeProductModal(productId) {
    var modal = document.getElementById('product-modal-' + productId);
    if (modal) modal.style.display = 'none';
  }

  // Optional: close modal when clicking outside the content
  window.onclick = function(event) {
    const modals = document.querySelectorAll('.product-modal');
    modals.forEach(function(modal) {
      if (event.target === modal) {
        modal.style.display = 'none';
      }
    });
  };
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.product-form-ajax').forEach(form => {
    form.addEventListener('submit', function (e) {
      e.preventDefault();

      const formElement = e.target;
      const variantId = formElement.querySelector('.variant-select').value;
      const responseBox = formElement.querySelector('.ajax-cart-response');

      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: [{ id: variantId, quantity: 1 }]
        })
      })
      .then(res => res.json())
      .then(data => {
        responseBox.textContent = '✅ Added to cart!';
        responseBox.style.display = 'block';
        responseBox.style.color = 'green';

        // Optional: update cart icon, close modal, etc.
        // Example: refresh cart count
        // updateCartCount();
      })
      .catch(error => {
        responseBox.textContent = '❌ Error adding to cart.';
        responseBox.style.display = 'block';
        responseBox.style.color = 'red';
        console.error('Cart error:', error);
      });
    });
  });
});
</script>


  </body>
</html>
