<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if settings.rtl_enabled %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">

  <title>{{ shop.name }}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" href="data:,">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,400;0,700;1,400;1,700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    @font-face {
      font-family: 'allerbold';
      src: url('{{ "aller_std_bd-webfont.woff2" | asset_url }}') format('woff2'),
           url('{{ "aller_std_bd-webfont.woff" | asset_url }}') format('woff');
      font-weight: normal;
      font-style: normal;
    }
    @font-face {
      font-family: 'allerregular';
      src: url('{{ "aller_std_rg-webfont.woff2" | asset_url }}') format('woff2'),
           url('{{ "aller_std_rg-webfont.woff" | asset_url }}') format('woff');
      font-weight: normal;
      font-style: normal;
    }
  </style>

  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>

<body class="template-password">
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
