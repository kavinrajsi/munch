    "about_story_i6KYHw": {
      "type": "about-story",
      "name": "About Story",
      "settings": {
        "story_heading": "A Timeless Journey of Taste and Tradition",
        "story_paragraph_1": "<p>At Nithya Amirtham, we believe food is more than sustenance, it's a celebration of life, culture, and togetherness. Our name itself reflects what we stand for: \"Nithya\" meaning eternal, and \"Amirtham\" meaning divine nectar.</p>",
        "story_paragraph_2": "<p>From humble beginnings rooted in age-old family recipes, we've grown into a brand that cherishes purity, taste, and authenticity. Every product we offer is a reflection of the rich culinary heritage of South India, crafted with care and devotion.</p>",
        "story_image_main": "shopify://shop_images/Group_17.png"
      }
    },
    "about_tradition_eBMY37": {
      "type": "about-tradition",
      "name": "About Tradition",
      "settings": {
        "tradition_heading": "A Touch of Tradition in Every Bite",
        "tradition_paragraph_1": "<p>Our journey begins at the source in the hands of traditional artisans and farmers who have preserved ancient methods of preparation for generations. From sun-dried appalams to hand-pounded masalas, we retain the essence of how our ancestors cooked: with patience, reverence, and love.</p>",
        "tradition_paragraph_2": "<p>Clay pots, stone grinders, cold-pressed oils — these are not just tools for us, they are keepers of tradition.</p>",
        "tradition_image": "shopify://shop_images/bite.png"
      }
    },
