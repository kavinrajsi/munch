<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t }} — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    .gift-card {
      max-width: 480px;
      margin: 40px auto;
      padding: 40px 20px;
      text-align: center;
    }
    .gift-card__image {
      max-width: 300px;
      margin: 0 auto 24px;
    }
    .gift-card__image img {
      width: 100%;
      border-radius: 8px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.12);
    }
    .gift-card__heading {
      font-size: 28px;
      margin-bottom: 8px;
    }
    .gift-card__amount {
      font-size: 36px;
      font-weight: 700;
      color: var(--color-primary, #C61D23);
      margin-bottom: 24px;
    }
    .gift-card__code {
      display: inline-block;
      padding: 12px 24px;
      background: #f5f5f5;
      border: 2px dashed var(--color-border, #e0e0e0);
      border-radius: 8px;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 2px;
      font-family: monospace;
      margin-bottom: 24px;
      user-select: all;
    }
    .gift-card__shop-link {
      display: inline-block;
      margin-top: 16px;
    }
    .gift-card__qr {
      margin: 24px auto 0;
    }
    .gift-card__balance {
      font-size: 14px;
      color: var(--color-secondary, #666);
      margin-top: 8px;
    }
  </style>
</head>
<body>
  <div class="gift-card">
    <div class="gift-card__image">
      <img src="{{ 'gift-card/card.jpg' | shopify_asset_url }}" alt="Gift Card" loading="eager">
    </div>

    <h1 class="gift-card__heading">{{ shop.name }}</h1>
    <p class="gift-card__amount">{{ gift_card.balance | money }}</p>

    <div class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</div>

    {%- if gift_card.balance != gift_card.initial_value -%}
      <p class="gift-card__balance">
        Initial value: {{ gift_card.initial_value | money }}
      </p>
    {%- endif -%}

    {%- if gift_card.expired -%}
      <p style="color:#c62828;margin-top:12px;">This gift card has expired.</p>
    {%- elsif gift_card.enabled -%}
      <div class="gift-card__qr">
        {{ gift_card | qr_code: 120 }}
      </div>
    {%- endif -%}

    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" style="display:inline-block;margin-top:16px;">
        <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="Add to Apple Wallet" width="140">
      </a>
    {%- endif -%}

    <a href="{{ shop.url }}" class="btn btn--primary gift-card__shop-link">Start Shopping</a>

    <p style="font-size:12px;color:var(--color-secondary);margin-top:24px;">
      Print this page for your records.
    </p>
  </div>
</body>
</html>
