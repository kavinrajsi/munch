<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t }} — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="gift-card">
    <div class="gift-card__image">
      <img src="{{ 'gift-card/card.jpg' | shopify_asset_url }}" alt="Gift Card" loading="eager">
    </div>

    <h1 class="gift-card__heading">{{ shop.name }}</h1>
    <p class="gift-card__amount">{{ gift_card.balance | money }}</p>

    <div class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</div>

    {%- if gift_card.balance != gift_card.initial_value -%}
      <p class="gift-card__balance">
        Initial value: {{ gift_card.initial_value | money }}
      </p>
    {%- endif -%}

    {%- if gift_card.expired -%}
      <p class="gift-card__expired">This gift card has expired.</p>
    {%- elsif gift_card.enabled -%}
      <div class="gift-card__qr">
        {{ gift_card | qr_code: 120 }}
      </div>
    {%- endif -%}

    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" class="gift-card__wallet-link">
        <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="Add to Apple Wallet" width="140">
      </a>
    {%- endif -%}

    <a href="{{ shop.url }}" class="btn btn--primary gift-card__shop-link">Start Shopping</a>

    <p class="gift-card__print-note">
      Print this page for your records.
    </p>
  </div>
</body>
</html>
